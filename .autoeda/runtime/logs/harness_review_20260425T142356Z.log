CC   := gcc
CXX  := g++
AR   := ar
LD   := $(CXX)

# Auto-enable ccache if available
CCACHE := $(shell command -v ccache 2>/dev/null)
ifneq ($(CCACHE),)
  CC := $(CCACHE) $(CC)
  CXX := $(CCACHE) $(CXX)
endif

MSG_PREFIX ?=
ABCSRC ?= .
VPATH = $(ABCSRC)

