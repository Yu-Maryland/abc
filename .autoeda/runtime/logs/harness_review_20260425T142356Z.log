from __future__ import annotations

import argparse
import json
from pathlib import Path

from . import __version__
from .harness import run_harness
from .layout import workspace_paths
from .runtime import launch_campaign, run_preflight, status_report, supervise_loop
from .workspace import detect_git_defaults, init_workspace, validate_workspace


def _print_json(data: object) -> None:
    print(json.dumps(data, indent=2))


def _guided_text(prompt: str, default: str) -> str:
    value = input(f"{prompt} [{default}]: ").strip()
    return value or default


def cmd_init(args: argparse.Namespace) -> int:
    repo_root_default = args.repo_root or str(Path.cwd())
    if args.guided:
        project_name = _guided_text("Project name", args.project_name or Path(args.workspace).name)
        repo_root = _guided_text("Repo root", repo_root_default)
        git_defaults = detect_git_defaults(repo_root)
        remote = _guided_text("Git remote", args.remote or str(git_defaults["remote"]))
        branch = _guided_text("Git branch", args.branch or str(git_defaults["branch"]))
    else:
        git_defaults = detect_git_defaults(repo_root_default)
        project_name = args.project_name or Path(args.workspace).name
        repo_root = repo_root_default
        remote = args.remote or str(git_defaults["remote"])
        branch = args.branch or str(git_defaults["branch"])

    paths = init_workspace(
        args.workspace,
        project_name=project_name,
        repo_root=repo_root,
        remote=remote,
        branch=branch,
        backend=args.backend,
        force=args.force,
    )
    _print_json({"ok": True, "workspace": str(paths.root)})
    return 0


def cmd_validate(args: argparse.Namespace) -> int:
    paths = workspace_paths(args.workspace)
    result = validate_workspace(paths)
    _print_json(result.as_dict())
    return 0 if result.ok else 1


def cmd_preflight(args: argparse.Namespace) -> int:
    paths = workspace_paths(args.workspace)
    report = run_preflight(paths)
    _print_json(report)
    return 0 if report.get("ready", False) else 1


def cmd_status(args: argparse.Namespace) -> int:
    paths = workspace_paths(args.workspace)
    _print_json(status_report(paths))
    return 0


def cmd_launch(args: argparse.Namespace) -> int:
    paths = workspace_paths(args.workspace)
    result = launch_campaign(paths, canary=args.canary)
    _print_json(result)
    return 0 if result.get("ok", False) else 1


def cmd_supervise(args: argparse.Namespace) -> int:
    paths = workspace_paths(args.workspace)
    return supervise_loop(paths, once=args.once, dry_run=args.dry_run, canary=args.canary)


def cmd_harness(args: argparse.Namespace) -> int:
    result = run_harness(
        args.workspace,
        project_name=args.project_name or Path(args.workspace).name,
        repo_root=args.repo_root or Path.cwd(),
        agent_md=args.agent_md,
        backend_binary=args.backend_binary,
        force_init=args.force_init,
        skip_review=args.skip_review,
        run_checks=not args.skip_checks,
        dry_run=args.dry_run,
    )
    _print_json(result)
    if not result.get("ok", False):
        return 1
    if args.supervise:
        if args.dry_run:
            _print_json({"ok": True, "action": "dry_run_skipped_supervise"})
            return 0
        paths = workspace_paths(args.workspace)
        return supervise_loop(paths, once=args.once, dry_run=False, canary=args.canary)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="autoeda", description="AutoEDA CLI")
    parser.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    sub = parser.add_subparsers(dest="command", required=True)

    init_p = sub.add_parser("init", help="Scaffold a new workspace")
    init_p.add_argument("--workspace", required=True)
    init_p.add_argument("--project-name")
    init_p.add_argument("--repo-root")
    init_p.add_argument("--remote")
    init_p.add_argument("--branch")
    init_p.add_argument("--backend", default="codex", choices=["codex"])
    init_p.add_argument("--guided", action="store_true")
    init_p.add_argument("--force", action="store_true")
    init_p.set_defaults(func=cmd_init)

    validate_p = sub.add_parser("validate-pack", help="Validate a workspace project pack")
    validate_p.add_argument("--workspace", required=True)
    validate_p.set_defaults(func=cmd_validate)

    preflight_p = sub.add_parser("preflight", help="Run preflight checks")
    preflight_p.add_argument("--workspace", required=True)
    preflight_p.set_defaults(func=cmd_preflight)

    status_p = sub.add_parser("status", help="Show campaign status")
    status_p.add_argument("--workspace", required=True)
    status_p.set_defaults(func=cmd_status)

    launch_p = sub.add_parser("launch", help="Launch the campaign agent")
    launch_p.add_argument("--workspace", required=True)
    launch_p.add_argument("--canary", action="store_true")
    launch_p.set_defaults(func=cmd_launch)

    supervise_p = sub.add_parser("supervise", help="Run the supervisor loop")
    supervise_p.add_argument("--workspace", required=True)
    supervise_p.add_argument("--once", action="store_true")
    supervise_p.add_argument("--dry-run", action="store_true")
    supervise_p.add_argument("--canary", action="store_true")
    supervise_p.set_defaults(func=cmd_supervise)

    harness_p = sub.add_parser("harness", help="Infer AutoEDA setup from a provided agent.md")
    harness_p.add_argument("--workspace", required=True)
    harness_p.add_argument("--agent-md", required=True)
    harness_p.add_argument("--project-name")
    harness_p.add_argument("--repo-root")
    harness_p.add_argument("--backend-binary", default="codex")
    harness_p.add_argument("--force-init", action="store_true")
    harness_p.add_argument("--skip-review", action="store_true")
    harness_p.add_argument("--skip-checks", action="store_true")
    harness_p.add_argument("--supervise", action="store_true", help="After harness setup, start the supervisor loop")
    harness_p.add_argument("--once", action="store_true", help="With --supervise, run one supervisor cycle")
    harness_p.add_argument("--canary", action="store_true", help="With --supervise, launch the campaign in canary mode")
    harness_p.add_argument("--dry-run", action="store_true")
    harness_p.set_defaults(func=cmd_harness)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)

