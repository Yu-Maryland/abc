def _kill_launcher(paths: WorkspacePaths) -> None:
    state = load_state(paths)
    pid = state.get("launcher_pid")
    if pid and _is_pid_alive(pid):
        try:
            os.killpg(pid, signal.SIGTERM)
        except Exception:
            try:
                os.kill(pid, signal.SIGTERM)
            except Exception:
                pass
    state["launcher_pid"] = None
    save_state(paths, state)
    if paths.launch_pid.exists():
        paths.launch_pid.unlink()


def status_report(paths: WorkspacePaths) -> dict[str, Any]:
    state = load_state(paths)
    pid = state.get("launcher_pid")
    heartbeat_payload = _heartbeat_payload(paths)
    alive = _is_pid_alive(pid)
    if str(heartbeat_payload.get("status", "")).startswith("exited:"):
        alive = False
    heartbeat_age = _heartbeat_age_seconds(paths)
    repo_root = Path(state.get("repo_root") or paths.root)
    git_summary = _git_runtime_summary(repo_root)
    latest_runtime_log = _latest_file(paths.logs_dir)
    return {
        "state": state,
        "launcher_alive": alive,
        "heartbeat_age_seconds": heartbeat_age,
        "heartbeat": heartbeat_payload,
        "git": git_summary,
        "usage": _codex_usage_summary(paths.logs_dir, latest_runtime_log),
        "artifacts": {
            "version_log": str(paths.versions_md),
            "results_dir": str(paths.results_dir),
            "plots_dir": str(paths.plots_dir),
            "final_report": str(paths.final_report_md),
            "launcher_log": state.get("launcher_log"),
            "latest_runtime_log": latest_runtime_log,
            "latest_result_dir": _latest_result_dir(paths.results_dir),
        },
    }


def supervisor_cycle(paths: WorkspacePaths, *, dry_run: bool = False, canary: bool = False) -> dict[str, Any]:
    validation = validate_workspace(paths)
    if not validation.ok:
        return {"ok": False, "action": "blocked", "validation": validation.as_dict()}

    supervisor = validation.data["supervisor"]
    state = load_state(paths)
    supervisor_state = _load_supervisor_state(paths)

    window = int(supervisor["fast_failure_window_seconds"])
    max_failures = int(supervisor["max_fast_failures"])
    now = datetime.now(UTC)
    recent_failures = _filtered_failure_timestamps(supervisor_state, window=window, now=now)
    supervisor_state["failure_timestamps"] = recent_failures
    if not dry_run:
        _save_supervisor_state(paths, supervisor_state)

    target_reached = state["completed_iterations"] >= state["target_iterations"] and state["target_iterations"] > 0
    report_required = bool(state.get("report_required", False))
    report_generated = bool(state.get("report_generated", False))
    if target_reached and report_required and not report_generated and state.get("status") == "complete":
        state["status"] = "report-pending"
        save_state(paths, state)
    if target_reached and (not report_required or report_generated):
        state["status"] = "complete"
        save_state(paths, state)
        return {"ok": True, "action": "complete"}
    if target_reached and report_required and not report_generated and state["status"] not in {
        "agent-running",
        "report-pending",
        "report-failed",
    }:
        state["status"] = "report-pending"
        save_state(paths, state)

    pid = state.get("launcher_pid")
    heartbeat = _heartbeat_payload(paths)
    exited = str(heartbeat.get("status", "")).startswith("exited:")
    alive = _is_pid_alive(pid)
    if exited:
        alive = False
        if pid is not None and state["status"] != "agent-running":
            state["launcher_pid"] = None
            save_state(paths, state)
            pid = None
    heartbeat_age = _heartbeat_age_seconds(paths)
    timeout = int(supervisor["progress_timeout_seconds"])

    if alive and (heartbeat_age is None or heartbeat_age <= timeout):
        return {"ok": True, "action": "active", "pid": pid, "heartbeat_age_seconds": heartbeat_age}

