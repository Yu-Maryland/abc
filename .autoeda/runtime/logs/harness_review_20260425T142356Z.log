from __future__ import annotations

from datetime import UTC, datetime
from pathlib import Path
from typing import Any

from .layout import WorkspacePaths
from .yamlio import dump_json, load_json


def utc_now() -> str:
    return datetime.now(UTC).replace(microsecond=0).isoformat()


def initial_state(paths: WorkspacePaths, evaluation: dict, git_cfg: dict, backend: str) -> dict[str, Any]:
    reporting = evaluation.get("reporting", {})
    report_required = bool(reporting.get("enabled", False))
    repo_root = ""
    if git_cfg.get("repo_root"):
        candidate = Path(git_cfg["repo_root"]).expanduser()
        if not candidate.is_absolute():
            candidate = (paths.root / candidate).resolve()
        else:
            candidate = candidate.resolve()
        repo_root = str(candidate)
    return {
        "version": 1,
        "workspace_root": str(paths.root),
        "repo_root": repo_root,
        "family": evaluation.get("family", "version"),
        "target_iterations": int(evaluation.get("target_iterations", 0)),
        "completed_iterations": 0,
        "next_iteration": 0,
        "status": "initialized",
        "active_iteration": None,
        "active_version": None,
        "last_completed_iteration": None,
        "last_completed_version": None,
        "last_successful_commit": None,
        "last_launch_time": None,
        "last_heartbeat_time": None,
        "launcher_pid": None,
        "launcher_log": None,
        "selected_backend": backend,
        "report_required": report_required,
        "report_generated": False,
        "report_status": "pending" if report_required else "not-required",
        "final_report_path": str(reporting.get("final_report", paths.final_report_md)),
        "plots_dir": str(reporting.get("plots_dir", paths.plots_dir)),
        "last_report_time": None,
        "notes": [],
        "updated_at": utc_now(),
    }


def load_state(paths: WorkspacePaths) -> dict[str, Any]:
    return load_json(paths.state_json)


def save_state(paths: WorkspacePaths, state: dict[str, Any]) -> None:
    state["updated_at"] = utc_now()
    dump_json(paths.state_json, state)

