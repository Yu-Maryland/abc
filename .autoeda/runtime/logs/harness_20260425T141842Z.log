def launch_campaign(paths: WorkspacePaths, *, canary: bool = False) -> dict[str, Any]:
    validation = validate_workspace(paths)
    if not validation.ok:
        return {"ok": False, "reason": "validation_failed", "validation": validation.as_dict()}

    state = load_state(paths)
    if state["status"] == "complete":
        return {"ok": True, "message": "campaign already complete"}

    launchable_states = {
        "initialized",
        "preflight-failed",
        "preflight-complete",
        "iteration-prepared",
        "agent-failed",
        "evaluation-failed",
        "evaluation-complete",
        "iteration-complete",
        "report-pending",
        "report-failed",
    }
    if state["status"] not in launchable_states:
        return {"ok": False, "reason": f"state_not_launchable:{state['status']}"}

    previous_status = state["status"]
    preflight = run_preflight(paths)
    if not preflight.get("ready"):
        return {"ok": False, "reason": "preflight_failed", "preflight": preflight}
    state = load_state(paths)
    if previous_status not in {"initialized", "preflight-complete"} and state["status"] == "preflight-complete":
        state["status"] = previous_status
        save_state(paths, state)

    if not _acquire_launch_lock(paths):
        return {"ok": False, "reason": "launch_lock_held"}

    try:
        secrets = validation.data["secrets"]
        git_cfg = validation.data["git"]
        repo_root = resolve_repo_root(paths, git_cfg["repo_root"])
        backend = secrets["agent_auth"]["selected_backend"]
        if backend != "codex":
            return {"ok": False, "reason": f"backend_not_implemented:{backend}"}
        backend_cfg = secrets["agent_auth"].get("codex", {})
        launch_cfg = backend_cfg.get("launch", {})
        backend_binary = launch_cfg.get("binary", "codex")
        backend_args = list(
            launch_cfg.get(
                "args",
                ["exec", "--enable", "multi_agent", "--dangerously-bypass-approvals-and-sandbox"],
            )
        )

        prompt = build_agent_prompt(paths, validation, canary=canary)
        paths.prompt_txt.write_text(prompt, encoding="utf-8")
        if paths.heartbeat.exists():
            paths.heartbeat.unlink()

        log_name = f"launch_{datetime.now(UTC).strftime('%Y%m%dT%H%M%SZ')}.log"
        log_file = paths.logs_dir / log_name
        worker_cmd = [
            sys.executable,
            "-m",
            "autoeda.launcher_worker",
            "--workspace",
            str(paths.root),
            "--repo-root",
            str(repo_root),
            "--backend",
            backend,
            "--backend-binary",
            backend_binary,
            "--log-file",
            str(log_file),
            "--heartbeat-file",
            str(paths.heartbeat),
            "--prompt-file",
            str(paths.prompt_txt),
        ]
        for arg in backend_args:
            worker_cmd.append(f"--backend-arg={arg}")
        proc = subprocess.Popen(worker_cmd, start_new_session=True)

        state["status"] = "agent-running"
        state["launcher_pid"] = proc.pid
        state["launcher_log"] = str(log_file)
        state["last_launch_time"] = utc_now()
        warning = None
        if any("--dangerously-bypass-approvals-and-sandbox" == arg for arg in backend_args):

