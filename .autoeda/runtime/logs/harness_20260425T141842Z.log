def _check_required_yaml_fields(data: dict[str, Any], required: list[str]) -> list[str]:
    missing = []
    for field in required:
        current: Any = data
        for part in field.split("."):
            if not isinstance(current, dict) or part not in current:
                missing.append(field)
                break
            current = current[part]
    return missing


def _contains_raw_secret_text(text: str) -> bool:
    return any(pattern.search(text) for pattern in SECRET_PATTERNS)


def _flow_placeholders(template: str) -> set[str]:
    return set(FLOW_PLACEHOLDER_RE.findall(template))


