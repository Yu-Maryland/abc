/**Function*************************************************************

  Synopsis    [Runs the stmap0 mapper probe.]

  Description [stmap0 tests whether aligning the mapper's SCL-derived genlib
  gain estimate with the downstream buffer/sizer default improves final stime
  timing. It keeps the classic map command's behavior and options otherwise.]

  SideEffects []

  SeeAlso     []

***********************************************************************/
int Abc_CommandStmap0( Abc_Frame_t * pAbc, int argc, char ** argv )
{
    Abc_Ntk_t * pNtk, * pNtkRes;
    char Buffer[100];
    double DelayTarget;
    double AreaMulti;
    double DelayMulti;
    float LogFan = 0;
    float Slew = 0; // choose based on the library
    float Gain = 300; // align with downstream buffer/sizer default gain ratio
    int nGatesMin = 0;
    int fAreaOnly;
    int fRecovery;
    int fSweep;
    int fSwitching;
    int fSkipFanout;
    int fUseProfile;
    int fUseBuffs;
    int fVerbose;
    int c;
