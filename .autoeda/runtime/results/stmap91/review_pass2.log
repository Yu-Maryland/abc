    extern int Map_Stmap88ChildPhaseTargetConfigured( void );
    extern void Map_Stmap88SetChildPhaseTargetActive( int fActive, const char * pPassLabel );
    extern int Map_Stmap89ConsumerPhaseTargetConfigured( void );
