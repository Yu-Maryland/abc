   141	def write_csv(path, rows, preferred=None):
   142	    rows = list(rows)
   143	    if preferred is None:
   144	        preferred = []
   145	    fields = []
   146	    for field in preferred:
   147	        if field not in fields:
   148	            fields.append(field)
   149	    for row in rows:
   150	        for field in row:
   151	            if field not in fields:
