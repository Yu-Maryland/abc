    63	/**Function*************************************************************
    64	
    65	  Synopsis    [Runs the stmap84 dual phase-survival probe.]
    66	
    67	  Description [stmap84 reuses the stmap81 child-phase-0 parent candidate
    68	  bias and the stmap82 same-node/same-phase sticky guard, but raises the
    69	  timing-release window high enough that watched child-missing replacements
    70	  are effectively blocked. It also watches both the child and downstream
    71	  parent AIG IDs in final phase-survival/reconstruction diagnostics.]
    72	
    73	  SideEffects []
    74	
    75	  SeeAlso     []
    76	
    77	***********************************************************************/
    78	int Abc_CommandStmap84( Abc_Frame_t * pAbc, int argc, char ** argv )
    79	{
    80	    Abc_Ntk_t * pNtk, * pNtkRes;
    81	    int i, RetValue, ChildAigId, ParentAigId, WatchAigs[2], nWatchAigs = 0;
    82	    extern int Abc_CommandStmap65( Abc_Frame_t * pAbc, int argc, char ** argv );
    83	    extern void Map_Stmap75SetFinalCriticalAigDiag( int fEnable, int WatchAigId );
