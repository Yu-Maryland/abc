     1	#!/usr/bin/env python3
     2	import concurrent.futures
     3	import csv
     4	import json
     5	import re
     6	import subprocess
     7	from pathlib import Path
     8	
     9	ROOT = Path(__file__).resolve().parents[4]
    10	RESULTS = ROOT / ".autoeda" / "runtime" / "results" / "stmap84"
    11	ABC = ROOT / "abc"
    12	LIB = "7nm_lvt_ff.lib"
    13	COMMAND = "stmap84"
    14	BENCHMARKS = [
    15	    "benchmarks/i10.aig",
    16	    "benchmarks/ode.abc.blif",
    17	    "benchmarks/or1200.abc.blif",
    18	    "benchmarks/syn2.abc.blif",
    19	]
    20	TIMEOUT = 600
    21	ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
    22	STIME_RE = re.compile(
    23	    r'WireLoad\s*=\s*"[^"]*".*Area\s*=\s*([0-9]+(?:\.[0-9]+)?).*Delay\s*=\s*([0-9]+(?:\.[0-9]+)?)\s*ps'
    24	)
    25	STMAP_LINE_RE = re.compile(r"^stmap84 ([^:]+):\s*(.*)$")
    26	KV_RE = re.compile(r"([A-Za-z0-9_-]+) = (.*?)(?=  [A-Za-z0-9_-]+ = |$)")
    27	
    28	
    29	def safe_name(path):
    30	    return path.replace("/", "_").replace(".", "_")
    31	
    32	
    33	def clean(text):
    34	    return ANSI_RE.sub("", text)
    35	
    36	
    37	def key_name(text):
    38	    return text.strip().replace("-", "_").replace(" ", "_")
    39	
    40	
    41	def run_abc(flow, log, exit_file):
    42	    cmd = [str(ABC), "-c", flow]
    43	    try:
    44	        proc = subprocess.run(
    45	            cmd,
    46	            cwd=ROOT,
    47	            stdout=subprocess.PIPE,
    48	            stderr=subprocess.STDOUT,
    49	            text=True,
    50	            encoding="utf-8",
    51	            errors="replace",
    52	            timeout=TIMEOUT,
    53	        )
    54	        text = proc.stdout
    55	        rc = proc.returncode
    56	    except subprocess.TimeoutExpired as exc:
    57	        text = (exc.stdout or "") + f"\nTIMEOUT after {TIMEOUT}s\n"
    58	        rc = 124
    59	    log.write_text(text)
    60	    exit_file.write_text(f"{rc}\n")
    61	    return rc, text
    62	
    63	
    64	def parse_stime(text):
    65	    matches = list(STIME_RE.finditer(clean(text)))
    66	    if not matches:
    67	        return {}
    68	    m = matches[-1]
    69	    return {"stime_area": float(m.group(1)), "stime_delay_ps": float(m.group(2))}
    70	
    71	
    72	def parse_stmap84_rows(bench, text):
    73	    rows_by_kind = {}
    74	    for line in clean(text).splitlines():
    75	        m = STMAP_LINE_RE.match(line)
    76	        if not m:
    77	            continue
    78	        kind = key_name(m.group(1))
    79	        row = {"benchmark": bench}
    80	        for key, value in KV_RE.findall(m.group(2)):
    81	            row[key_name(key)] = value.strip()
    82	        rows_by_kind.setdefault(kind, []).append(row)
    83	    return rows_by_kind
    84	
    85	
    86	def run_flow(kind, bench):
    87	    safe = safe_name(bench)
    88	    if kind == "baseline":
    89	        flow = f"read_lib {LIB}; read {bench}; resyn; resyn2; dch -v; map; topo; buffer; upsize -v; dnsize -v; stime"
    90	    else:
    91	        flow = f"read_lib {LIB}; read {bench}; resyn; resyn2; dch -v; {COMMAND}; topo; buffer; upsize -v; dnsize -v; stime"
    92	    log = RESULTS / f"{kind}_{safe}.log"
    93	    exit_file = RESULTS / f"{kind}_{safe}.exit"
    94	    rc, text = run_abc(flow, log, exit_file)
    95	    return {
    96	        "benchmark": bench,
    97	        "kind": kind,
    98	        "returncode": rc,
    99	        "metrics": parse_stime(text),
   100	        "diagnostics": parse_stmap84_rows(bench, text) if kind == "candidate" else {},
   101	        "log": str(log.relative_to(ROOT)),
   102	        "command": f"./abc -c \"{flow}\"",
   103	    }
