   123	    if rc_orig != 0 or rc_cand != 0:
   124	        log.write_text(f"write failed: orig={rc_orig} candidate={rc_cand}\n")
   125	        exit_file.write_text("1\n")
   126	        return {"benchmark": bench, "passed": False, "returncode": 1, "log": str(log.relative_to(ROOT))}
   127	    rc, text = run_abc(f"cec {orig} {cand}", log, exit_file)
   128	    passed = rc == 0 and (
   129	        "Networks are equivalent" in text or "Networks are equivalent after structural hashing" in text
   130	    )
   131	    return {
   132	        "benchmark": bench,
