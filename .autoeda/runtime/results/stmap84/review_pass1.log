    88	    extern void Abc_Stmap77SetReconstructionDiag( int fEnable, const char * pLabel, int * pWatchAigIds, int nWatchAigs );
    89	    extern void Abc_Stmap77PrintReconstructionSummary( void );
    90	    extern void Abc_Stmap78SetDemandPathDiag( int fEnable, const char * pLabel, int WatchAigId, int DownstreamAigId );
    91	    extern void Abc_Stmap78PrintDemandPathSummary( void );
    92	    extern void Abc_Stmap79SetParentCutDiag( int fEnable, const char * pLabel, int ChildAigId, int ParentAigId );
    93	    extern void Abc_Stmap79PrintParentCutSummary( void );
    94	    extern void Map_Stmap80SetCandidateCutDiag( int fEnable, const char * pLabel, int ParentAigId, int ChildAigId );
    95	    extern void Map_Stmap80PrintCandidateCutSummary( void );
    96	    extern void Map_Stmap81SetParentPhaseBias( int fEnable, const char * pLabel, int ParentAigId, int ChildAigId );
    97	    extern void Map_Stmap81PrintParentPhaseBiasSummary( void );
    98	    extern void Map_Stmap82SetStickyParentPhase( int fEnable, const char * pLabel, int ParentAigId, int ChildAigId );
    99	    extern void Map_Stmap82SetStickyParentPhaseTimingWindow( float TimingHoldWindow );
   100	    extern void Map_Stmap82PrintStickyParentPhaseSummary( void );
   101	
   102	    for ( i = 1; i < argc; i++ )
   103	    {
   104	        if ( !strcmp( argv[i], "-h" ) )
   105	            goto usage;
   106	    }
   107	
   108	    pNtk = Abc_FrameReadNtk( pAbc );
   109	    Abc_Stmap84WatchAigsForNetwork( pNtk, &ChildAigId, &ParentAigId );
   110	    if ( ChildAigId >= 0 )
   111	        WatchAigs[nWatchAigs++] = ChildAigId;
   112	    if ( ParentAigId >= 0 )
   113	        WatchAigs[nWatchAigs++] = ParentAigId;
   114	    printf( "stmap84 diagnostic: inherited-policy = stmap65  mapper-selected-match-watch = %d  network = %s  child-aig = %d  parent-aig = %d  dual-phase-survival-watch-count = %d  source = stmap83-final-critical-phase-split-probe  reconstruction-phase-trace = 1  demand-path-trace = 1  parent-cut-trace = 1  candidate-cut-trace = 1  parent-phase-bias = 1  sticky-parent-phase = 1  final-phase-survival = 1  mapping-policy-change = watched-parent-child-phase0-strict-sticky\n",
   115	        ChildAigId >= 0, pNtk && Abc_NtkName(pNtk) ? Abc_NtkName(pNtk) : "?",
   116	        ChildAigId, ParentAigId, nWatchAigs );
   117	    Map_Stmap75SetFinalCriticalAigDiag( ChildAigId >= 0, ChildAigId );
   118	    Map_Stmap75SetFinalCriticalAigDiagLabel( "stmap84" );
   119	    Abc_Stmap77SetReconstructionDiag( nWatchAigs > 0, "stmap84", WatchAigs, nWatchAigs );
   120	    Abc_Stmap78SetDemandPathDiag( ChildAigId >= 0, "stmap84", ChildAigId, ParentAigId );
   121	    Abc_Stmap79SetParentCutDiag( ChildAigId >= 0, "stmap84", ChildAigId, ParentAigId );
   122	    Map_Stmap80SetCandidateCutDiag( ChildAigId >= 0, "stmap84", ParentAigId, ChildAigId );
   123	    Map_Stmap81SetParentPhaseBias( ChildAigId >= 0, "stmap84", ParentAigId, ChildAigId );
   124	    Map_Stmap82SetStickyParentPhase( ChildAigId >= 0, "stmap84", ParentAigId, ChildAigId );
   125	    Map_Stmap82SetStickyParentPhaseTimingWindow( 100000.00f );
   126	    RetValue = Abc_CommandStmap65( pAbc, argc, argv );
   127	    Abc_Stmap77PrintReconstructionSummary();
   128	    Abc_Stmap78PrintDemandPathSummary();
   129	    Abc_Stmap79PrintParentCutSummary();
   130	    Map_Stmap80PrintCandidateCutSummary();
   131	    Map_Stmap81PrintParentPhaseBiasSummary();
   132	    Map_Stmap82PrintStickyParentPhaseSummary();
   133	    Map_Stmap82SetStickyParentPhase( 0, "stmap84", -1, -1 );
   134	    Map_Stmap81SetParentPhaseBias( 0, "stmap84", -1, -1 );
   135	    Map_Stmap80SetCandidateCutDiag( 0, "stmap84", -1, -1 );
   136	    Abc_Stmap79SetParentCutDiag( 0, "stmap84", -1, -1 );
   137	    Abc_Stmap78SetDemandPathDiag( 0, "stmap84", -1, -1 );
   138	    Abc_Stmap77SetReconstructionDiag( 0, "stmap84", NULL, 0 );
   139	    Map_Stmap75PrintFinalCriticalAigSummary();
   140	    Map_Stmap75SetFinalCriticalAigDiag( 0, -1 );
   141	    if ( RetValue == 0 )
   142	    {
   143	        pNtkRes = Abc_FrameReadNtk( pAbc );
   144	        Abc_Stmap74EnableFinalCriticalScope( pNtkRes, "stmap84" );
   145	        Abc_Stmap76EnablePhaseSurvivalScope( pNtkRes, "stmap84", WatchAigs, nWatchAigs );
   146	    }
   147	    return RetValue;
   148	
   149	usage:
   150	    Abc_Print( -2, "usage: stmap84 [-DABFSG float] [-M num] [-arspfuovh]\n" );
   151	    Abc_Print( -2, "\t              performs stmap84 bounded-pressure mapping with strict sticky retention and dual child/parent phase-survival diagnostics\n" );
   152	    Abc_Print( -2, "\t-D float : sets the global required times [default = not used]\n" );
   153	    Abc_Print( -2, "\t-A float : \"area multiplier\" to bias gate selection [default = 0.00]\n" );
   154	    Abc_Print( -2, "\t-B float : \"delay multiplier\" to bias gate selection [default = 0.00]\n" );
   155	    Abc_Print( -2, "\t-F float : the logarithmic fanout delay parameter [default = 0.00]\n" );
   156	    Abc_Print( -2, "\t-S float : the slew parameter used to generate the library [default = 0.00]\n" );
   157	    Abc_Print( -2, "\t-G float : the SCL/genlib gain parameter used to generate the library [default = 250.00]\n" );
   158	    Abc_Print( -2, "\t-M num   : skip gate classes whose size is less than this [default = 0]\n" );
   159	    Abc_Print( -2, "\t-a       : toggles area-only mapping [default = no]\n" );
   160	    Abc_Print( -2, "\t-r       : toggles area recovery [default = yes]\n" );
   161	    Abc_Print( -2, "\t-s       : toggles sweep after mapping [default = no]\n" );
   162	    Abc_Print( -2, "\t-p       : optimizes power by minimizing switching [default = no]\n" );
   163	    Abc_Print( -2, "\t-f       : disables the bounded-pressure SCL feedback mapper mode [default = yes]\n" );
   164	    Abc_Print( -2, "\t-u       : use standard-cell profile [default = no]\n" );
   165	    Abc_Print( -2, "\t-o       : toggles using buffers to decouple combinational outputs [default = no]\n" );
   166	    Abc_Print( -2, "\t-v       : toggles verbose output [default = no]\n" );
   167	    Abc_Print( -2, "\t-h       : print the command usage\n" );
   168	    return 1;
   169	}
