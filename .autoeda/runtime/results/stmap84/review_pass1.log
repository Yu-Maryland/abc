   115	def run_cec(bench):
   116	    safe = safe_name(bench)
   117	    orig_flow = f"read_lib {LIB}; read {bench}"
   118	    cand_flow = f"read_lib {LIB}; read {bench}; resyn; resyn2; dch -v; {COMMAND}; topo; buffer; upsize -v; dnsize -v; stime"
   119	    rc_orig, orig = write_aig(bench, "orig", orig_flow)
   120	    rc_cand, cand = write_aig(bench, COMMAND, cand_flow)
   121	    log = RESULTS / f"cec_{safe}.log"
