   176	def summarize_candidate_cuts(rows):
   177	    out = []
   178	    by_bench = {bench: [] for bench in BENCHMARKS}
   179	    for row in rows:
   180	        by_bench.setdefault(row.get("benchmark"), []).append(row)
   181	    for bench in BENCHMARKS:
   182	        bench_rows = by_bench.get(bench, [])
   183	        stats = {}
   184	        for row in bench_rows:
   185	            if "rows" in row and "viable" in row and "accepted_updates" in row:
   186	                stats = row
   187	        data_rows = [r for r in bench_rows if "cut_ordinal" in r]
   188	        viable = [r for r in data_rows if as_int(r, "viable") == 1]
   189	        accepted = [r for r in data_rows if as_int(r, "selected_update") == 1]
   190	        phase0 = [r for r in viable if r.get("child_requested_phase") == "0"]
   191	        phase1 = [r for r in viable if r.get("child_requested_phase") == "1"]
   192	        accepted_phase0 = [r for r in accepted if r.get("child_requested_phase") == "0"]
   193	        accepted_phase1 = [r for r in accepted if r.get("child_requested_phase") == "1"]
   194	        nonselected_phase0 = [r for r in phase0 if r.get("reason") == "nonselected"]
   195	        phase0_arrivals = [as_float(r, "arrival") for r in phase0 if as_float(r, "arrival") is not None]
   196	        phase0_areas = [as_float(r, "area_flow") for r in phase0 if as_float(r, "area_flow") is not None]
   197	        phase1_arrivals = [as_float(r, "arrival") for r in phase1 if as_float(r, "arrival") is not None]
   198	        phase1_areas = [as_float(r, "area_flow") for r in phase1 if as_float(r, "area_flow") is not None]
   199	        out.append(
   200	            {
   201	                "benchmark": bench,
   202	                "parent_aig": stats.get("parent_aig", data_rows[0].get("parent_aig") if data_rows else "-1"),
   203	                "child_aig": stats.get("child_aig", data_rows[0].get("child_aig") if data_rows else "-1"),
   204	                "rows": stats.get("rows", str(len(data_rows))),
   205	                "viable": stats.get("viable", str(len(viable))),
   206	                "accepted_updates": stats.get("accepted_updates", str(len(accepted))),
   207	                "child_phase0": stats.get("child_phase0", ""),
   208	                "child_phase1": stats.get("child_phase1", ""),
   209	                "child_unknown": stats.get("child_unknown", ""),
   210	                "child_missing": stats.get("child_missing", ""),
   211	                "viable_child_phase0": len(phase0),
   212	                "viable_child_phase1": len(phase1),
   213	                "accepted_child_phase0": len(accepted_phase0),
   214	                "accepted_child_phase1": len(accepted_phase1),
   215	                "nonselected_child_phase0": len(nonselected_phase0),
   216	                "phase0_gates": "+".join(sorted({r.get("gate", "?") for r in phase0})),
   217	                "phase1_gates": "+".join(sorted({r.get("gate", "?") for r in phase1})),
   218	                "phase0_min_arrival": min(phase0_arrivals) if phase0_arrivals else "",
   219	                "phase0_min_area_flow": min(phase0_areas) if phase0_areas else "",
   220	                "phase1_min_arrival": min(phase1_arrivals) if phase1_arrivals else "",
   221	                "phase1_min_area_flow": min(phase1_areas) if phase1_areas else "",
   222	            }
   223	        )
   224	    return out
