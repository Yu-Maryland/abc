   106	def write_aig(bench, suffix, flow):
   107	    safe = safe_name(bench)
   108	    aig = RESULTS / f"cec_{safe}_{suffix}.aig"
   109	    log = RESULTS / f"cec_{safe}_{suffix}_write.log"
   110	    exit_file = RESULTS / f"cec_{safe}_{suffix}_write.exit"
   111	    rc, _ = run_abc(f"{flow}; strash; write_aiger {aig}", log, exit_file)
