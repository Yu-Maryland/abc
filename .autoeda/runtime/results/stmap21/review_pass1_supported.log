   641	/**Function*************************************************************
   642	
   643	  Synopsis    [Compares two matches.]
   644	
   645	  Description [Returns 1 if the second match is better. Otherwise returns 0.]
   646	               
   647	  SideEffects []
   648	
   649	  SeeAlso     []
   650	
   651	***********************************************************************/
   652	int Map_MatchCompare( Map_Man_t * pMan, Map_Match_t * pM1, Map_Match_t * pM2, int fDoingArea )
   653	{
   654	//    if ( pM1->pSuperBest == pM2->pSuperBest )
   655	//        return 0;
   656	    if ( !fDoingArea )
   657	    {
   658	        // compare the arrival times
   659	        if ( pM1->tArrive.Worst < pM2->tArrive.Worst - pMan->fEpsilon )
   660	            return 0;
   661	        if ( pM1->tArrive.Worst > pM2->tArrive.Worst + pMan->fEpsilon )
   662	            return 1;
   663	        // compare the areas or area flows
   664	        if ( pM1->AreaFlow < pM2->AreaFlow - pMan->fEpsilon )
   665	            return 0;
   666	        if ( pM1->AreaFlow > pM2->AreaFlow + pMan->fEpsilon )
   667	            return 1;
   668	        // compare the fanout limits
   669	        if ( pM1->pSuperBest->nFanLimit > pM2->pSuperBest->nFanLimit )
   670	            return 0;
   671	        if ( pM1->pSuperBest->nFanLimit < pM2->pSuperBest->nFanLimit )
   672	            return 1;
   673	        // compare the number of leaves
   674	        if ( pM1->pSuperBest->nFanins < pM2->pSuperBest->nFanins )
   675	            return 0;
   676	        if ( pM1->pSuperBest->nFanins > pM2->pSuperBest->nFanins )
   677	            return 1;
   678	        // otherwise prefer the old cut
   679	        return 0;
   680	    }
   681	    else
   682	    {
   683	        // compare the areas or area flows
   684	        if ( pM1->AreaFlow < pM2->AreaFlow - pMan->fEpsilon )
   685	            return 0;
   686	        if ( pM1->AreaFlow > pM2->AreaFlow + pMan->fEpsilon )
   687	            return 1;
   688	
   689	        // make decision based on cell profile
   690	        if ( pMan->fUseProfile && pM1->pSuperBest && pM1->pSuperBest )
   691	        {
   692	            int M1req = Mio_GateReadProfile(pM1->pSuperBest->pRoot);
   693	            int M2req = Mio_GateReadProfile(pM2->pSuperBest->pRoot);
   694	            int M1act = Mio_GateReadProfile2(pM1->pSuperBest->pRoot);
