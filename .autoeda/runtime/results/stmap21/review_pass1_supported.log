   747	    for ( pSuper = pMatch->pSupers, Counter = 0; pSuper; pSuper = pSuper->pNext, Counter++ )
   748	    {
   749	        p->nMatches++;
   750	        // this is an attempt to reduce the runtime of matching and area 
