   819	/**Function*************************************************************
   820	
   821	  Synopsis    [Find the matching of one polarity of the node.]
   822	
   823	  Description []
   824	               
   825	  SideEffects []
   826	
   827	  SeeAlso     []
   828	
   829	***********************************************************************/
   830	int Map_MatchNodePhase( Map_Man_t * p, Map_Node_t * pNode, int fPhase )
   831	{
   832	    Map_Match_t MatchBest, * pMatch;
   833	    Map_Cut_t * pCut, * pCutBest;
   834	    float Area1 = 0.0; // Suppress "might be used uninitialized
   835	    float Area2, fWorstLimit;
   836	
   837	    // skip the cuts that have been unassigned during area recovery
   838	    pCutBest = pNode->pCutBest[fPhase];
   839	    if ( p->fMappingMode != 0 && pCutBest == NULL )
   840	        return 1;
   841	
   842	    // recompute the arrival times of the current best match 
   843	    // because the arrival times of the fanins may have changed 
   844	    // as a result of remapping fanins in the topological order
   845	    if ( p->fMappingMode != 0 )
   846	    {
   847	        Map_TimeCutComputeArrival( pNode, pCutBest, fPhase, MAP_FLOAT_LARGE );
   848	        // make sure that the required times are met
   849	//        assert( pCutBest->M[fPhase].tArrive.Rise < pNode->tRequired[fPhase].Rise + p->fEpsilon );
   850	//        assert( pCutBest->M[fPhase].tArrive.Fall < pNode->tRequired[fPhase].Fall + p->fEpsilon );
   851	    }
   852	
   853	    // recompute the exact area of the current best match
   854	    // because the exact area of the fanins may have changed
   855	    // as a result of remapping fanins in the topological order
   856	    if ( p->fMappingMode == 2 || p->fMappingMode == 3 )
   857	    {
   858	        pMatch = pCutBest->M + fPhase;
   859	        if ( pNode->nRefAct[fPhase] > 0 || 
   860	            (pNode->pCutBest[!fPhase] == NULL && pNode->nRefAct[!fPhase] > 0) )
   861	            pMatch->AreaFlow = Area1 = Map_CutDeref( pCutBest, fPhase, p->fUseProfile );
   862	        else
   863	            pMatch->AreaFlow = Area1 = Map_CutGetAreaDerefed( pCutBest, fPhase );
   864	    }
   865	    else if ( p->fMappingMode == 4 )
   866	    {
   867	        pMatch = pCutBest->M + fPhase;
   868	        if ( pNode->nRefAct[fPhase] > 0 || 
   869	            (pNode->pCutBest[!fPhase] == NULL && pNode->nRefAct[!fPhase] > 0) )
   870	            pMatch->AreaFlow = Area1 = Map_SwitchCutDeref( pNode, pCutBest, fPhase );
   871	        else
   872	            pMatch->AreaFlow = Area1 = Map_SwitchCutGetDerefed( pNode, pCutBest, fPhase );
   873	    }
   874	
   875	    // save the old mapping
   876	    if ( pCutBest )
   877	        MatchBest = pCutBest->M[fPhase];
   878	    else
   879	        Map_MatchClean( &MatchBest );
   880	 
   881	    // select the new best cut
   882	    fWorstLimit = pNode->tRequired[fPhase].Worst;
   883	    for ( pCut = pNode->pCuts->pNext; pCut; pCut = pCut->pNext )
   884	    {
   885	        // limit gate sizes based on fanout count
   886	        if ( Map_MatchSkipCutForFanout( p, pNode, pCut, fPhase ) )
   887	            continue;
   888	        pMatch = pCut->M + fPhase;
   889	        if ( pMatch->pSupers == NULL )
   890	            continue;
   891	
   892	        // find the matches for the cut
   893	        Map_MatchNodeCut( p, pNode, pCut, fPhase, fWorstLimit );
   894	        if ( pMatch->pSuperBest == NULL || pMatch->tArrive.Worst > fWorstLimit + p->fEpsilon )
   895	            continue;
   896	        if ( Map_MatchSkipAreaSensitiveFanout( p, pNode, pCut, fPhase, &MatchBest, pMatch ) )
   897	            continue;
   898	
   899	        // if the cut can be matched compare the matchings
   900	        if ( Map_MatchCompare( p, &MatchBest, pMatch, p->fMappingMode ) )
   901	        {
   902	            pCutBest  =  pCut;
   903	            MatchBest = *pMatch;
   904	            // if we are mapping for delay, the worst-case limit should be tightened
   905	            if ( p->fMappingMode == 0 )
   906	                fWorstLimit = MatchBest.tArrive.Worst;
   907	        }
   908	    }
   909	
   910	    if ( pCutBest == NULL )
   911	        return 1;
   912	
   913	    // set the new mapping
   914	    pNode->pCutBest[fPhase] = pCutBest;
   915	    pCutBest->M[fPhase]     = MatchBest;
   916	
   917	    // reference the new cut if it used
   918	    if ( p->fMappingMode >= 2 && 
   919	         (pNode->nRefAct[fPhase] > 0 || 
   920	         (pNode->pCutBest[!fPhase] == NULL && pNode->nRefAct[!fPhase] > 0)) )
   921	    {
   922	        if ( p->fMappingMode == 2 || p->fMappingMode == 3 )
   923	            Area2 = Map_CutRef( pNode->pCutBest[fPhase], fPhase, p->fUseProfile );
   924	        else if ( p->fMappingMode == 4 )
   925	            Area2 = Map_SwitchCutRef( pNode, pNode->pCutBest[fPhase], fPhase );
   926	        else 
   927	            assert( 0 );
   928	//        assert( Area2 < Area1 + p->fEpsilon );
   929	    }
   930	
   931	    // make sure that the requited times are met
   932	//    assert( MatchBest.tArrive.Rise < pNode->tRequired[fPhase].Rise + p->fEpsilon );
   933	//    assert( MatchBest.tArrive.Fall < pNode->tRequired[fPhase].Fall + p->fEpsilon );
   934	    return 1;
   935	}
