   474	/**Function*************************************************************
   475	
   476	  Synopsis    [Returns 1 if an stmap area-sensitive mode should reject a cut.]
   477	
   478	  Description [The area-sensitive guards are evaluated after matching the
   479	  candidate cut because their hypotheses need the candidate's actual mapper
   480	  area. In stmap6 exact-area recovery, a wide high-fanout cut is rejected only
   481	  when the existing match has slack and the candidate does not save at least
   482	  half an inverter area. In stmap7, the area-saving override additionally
   483	  requires more than two inverter delays of slack and excludes the highest
   484	  fanout-risk bucket. In stmap8, the override is further rejected when the
   485	  candidate match worsens mapper arrival by more than one quarter of an
   486	  inverter delay. In stmap9, middle-slack candidates can recover area only
   487	  when they are outside the highest fanout bucket, do not worsen mapper
   488	  arrival, and save at least one inverter area. In stmap10, that middle-slack
   489	  relief also requires the mapper node to be no deeper than level 96. In
   490	  stmap11, that depth window is tightened to level 64. In stmap12, the same
   491	  tight-depth relief is allowed only in the lower moderate fanout bucket. In
   492	  stmap13, the same decision path also records exact-area guard statistics. In
   493	  stmap14, the lower-moderate middle-slack relief must save two inverter areas
   494	  instead of one. In stmap15, one-inverter relief is restored only after the
   495	  mapper observes a high lower-moderate/middle-slack profile. In stmap16, the
   496	  same behavior also reports each admitted relief choice. In stmap17, the
   497	  adaptive one-inverter relief threshold also requires a material mapper-arrival
   498	  improvement; arrival-neutral choices keep the stricter two-inverter fallback.
   499	  In stmap18, the same decisions are preserved while near-miss rejected
   500	  middle-slack candidates are logged. In stmap19, pre-profile one-inverter
   501	  relief is seeded only by candidates with the same material arrival gain. In
   502	  stmap20, the pre-profile seed is further limited to shallow nodes. In
   503	  stmap21, deeper pre-profile seeds are allowed only with a much larger mapper
   504	  arrival gain.]
   505	
   506	  SideEffects []
   507	
   508	  SeeAlso     []
   509	
   510	***********************************************************************/
   511	static int Map_MatchSkipAreaSensitiveFanout( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase, Map_Match_t * pMatchBest, Map_Match_t * pMatch )
   512	{
   513	    float Slack, SlackMargin, SlackGate, ArrivalMargin, ArrivalDelta, ArrivalGainMargin, AreaMargin, AreaSave, OneInvArea;
   514	    const char * pReason;
   515	    int fMiddleReliefWindow, fStmap13, fProfileOpen, fArrivalQuality, fStrictFallback;
   516	
   517	    if ( p->fSkipFanout != 7 && p->fSkipFanout != 8 && p->fSkipFanout != 9 && p->fSkipFanout != 10 && p->fSkipFanout != 11 && p->fSkipFanout != 12 && p->fSkipFanout != 13 && p->fSkipFanout != 14 && p->fSkipFanout != 15 && p->fSkipFanout != 16 && p->fSkipFanout != 17 && p->fSkipFanout != 18 && p->fSkipFanout != 19 && p->fSkipFanout != 20 && p->fSkipFanout != 21 && p->fSkipFanout != 22 )
   518	        return 0;
   519	    if ( p->fMappingMode < 2 || p->fMappingMode > 3 )
   520	        return 0;
   521	    if ( p->vMapObjs->nSize <= 8000 )
   522	        return 0;
   523	    if ( !Map_MatchCutHasStmapFanoutRisk( pNode, pCut ) )
   524	        return 0;
   525	    fStmap13 = (p->fSkipFanout == 14 || p->fSkipFanout == 15 || p->fSkipFanout == 16 || p->fSkipFanout == 17 || p->fSkipFanout == 18 || p->fSkipFanout == 19 || p->fSkipFanout == 20 || p->fSkipFanout == 21 || p->fSkipFanout == 22);
   526	    Map_MatchStmap13CountRisk( p, pNode, pCut );
   527	    if ( pMatchBest == NULL || pMatchBest->pSuperBest == NULL || pMatch == NULL || pMatch->pSuperBest == NULL )
   528	        return 0;
   529	    Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   530	    SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   531	    ArrivalDelta = pMatch->tArrive.Worst - pMatchBest->tArrive.Worst;
   532	    ArrivalGainMargin = 0.25 * SlackMargin;
   533	    fArrivalQuality = ArrivalDelta <= -ArrivalGainMargin - p->fEpsilon;
   534	    if ( p->fSkipFanout == 8 || p->fSkipFanout == 9 || p->fSkipFanout == 10 || p->fSkipFanout == 11 || p->fSkipFanout == 12 || p->fSkipFanout == 13 || p->fSkipFanout == 14 || p->fSkipFanout == 15 || p->fSkipFanout == 16 || p->fSkipFanout == 17 || p->fSkipFanout == 18 || p->fSkipFanout == 19 || p->fSkipFanout == 20 || p->fSkipFanout == 21 || p->fSkipFanout == 22 )
   535	    {
   536	        SlackGate = 2.0 * SlackMargin;
   537	        fMiddleReliefWindow =
   538	             (p->fSkipFanout == 10 || p->fSkipFanout == 11 || p->fSkipFanout == 12 || p->fSkipFanout == 13 || p->fSkipFanout == 14 || p->fSkipFanout == 15 || p->fSkipFanout == 16 || p->fSkipFanout == 17 || p->fSkipFanout == 18 || p->fSkipFanout == 19 || p->fSkipFanout == 20 || p->fSkipFanout == 21 || p->fSkipFanout == 22) &&
   539	             Slack > SlackMargin + p->fEpsilon &&
   540	             Slack <= SlackGate + p->fEpsilon &&
   541	             !Map_MatchCutHasStmapHighestFanoutRisk( pNode, pCut ) &&
   542	             Map_MatchNodeHasStmapMiddleSlackRelief( p->fSkipFanout, pNode ) &&
   543	             (p->fSkipFanout != 13 || Map_MatchCutHasStmapLowerModerateFanoutRisk( pNode, pCut )) &&
   544	             (p->fSkipFanout != 14 || Map_MatchCutHasStmapLowerModerateFanoutRisk( pNode, pCut )) &&
   545	             (p->fSkipFanout != 15 || Map_MatchCutHasStmapLowerModerateFanoutRisk( pNode, pCut )) &&
   546	             (p->fSkipFanout != 16 || Map_MatchCutHasStmapLowerModerateFanoutRisk( pNode, pCut )) &&
   547	             (p->fSkipFanout != 17 || Map_MatchCutHasStmapLowerModerateFanoutRisk( pNode, pCut )) &&
   548	             (p->fSkipFanout != 18 || Map_MatchCutHasStmapLowerModerateFanoutRisk( pNode, pCut )) &&
   549	             (p->fSkipFanout != 19 || Map_MatchCutHasStmapLowerModerateFanoutRisk( pNode, pCut )) &&
   550	             (p->fSkipFanout != 20 || Map_MatchCutHasStmapLowerModerateFanoutRisk( pNode, pCut )) &&
   551	             (p->fSkipFanout != 21 || Map_MatchCutHasStmapLowerModerateFanoutRisk( pNode, pCut )) &&
   552	             (p->fSkipFanout != 22 || Map_MatchCutHasStmapLowerModerateFanoutRisk( pNode, pCut )) &&
   553	             pMatch->tArrive.Worst <= pMatchBest->tArrive.Worst + p->fEpsilon;
   554	        if ( fMiddleReliefWindow )
   555	        {
   556	            if ( fStmap13 )
   557	                p->nStmap13MiddleSlack++;
   558	            fProfileOpen = Map_MatchHasStmap15ReliefProfile( p );
   559	            fStrictFallback =
   560	                p->fSkipFanout == 15 ||
   561	                ((p->fSkipFanout == 16 || p->fSkipFanout == 17) && !fProfileOpen) ||
   562	                ((p->fSkipFanout == 18 || p->fSkipFanout == 19) && (!fProfileOpen || !fArrivalQuality)) ||
   563	                (p->fSkipFanout == 20 && !fArrivalQuality) ||
   564	                (p->fSkipFanout == 21 && (!fArrivalQuality || (!fProfileOpen && !Map_MatchNodeHasStmap20EarlySeedDepth( pNode )))) ||
   565	                (p->fSkipFanout == 22 && (!fArrivalQuality || (!fProfileOpen && !Map_MatchNodeHasStmap20EarlySeedDepth( pNode ) && !Map_MatchHasStmap21DeepSeedGain( ArrivalDelta, ArrivalGainMargin, p->fEpsilon ))));
   566	            AreaMargin = p->pSuperLib ? (fStrictFallback ? 2.0 : 1.0) * p->pSuperLib->AreaInv : 0.0;
   567	            AreaSave = pMatchBest->AreaFlow - pMatch->AreaFlow;
   568	            OneInvArea = p->pSuperLib ? p->pSuperLib->AreaInv : 0.0;
   569	            if ( AreaSave > AreaMargin + p->fEpsilon )
   570	            {
   571	                if ( fStmap13 )
   572	                    p->nStmap13MiddleRelief++;
   573	                if ( p->fSkipFanout == 17 )
   574	                    printf( "stmap16 relief diag: index = %d  profile-open = %d  node = %d  level = %u  refs = %d  leaves = %d  phase = %d  slack = %.6f  area-save = %.6f  arrival-delta = %.6f  area-margin = %.6f\n",
   575	                        p->nStmap13MiddleRelief, fProfileOpen, pNode->Num, pNode->Level, pNode->nRefs,
   576	                        pCut->nLeaves, fPhase, Slack, pMatchBest->AreaFlow - pMatch->AreaFlow,
   577	                        pMatch->tArrive.Worst - pMatchBest->tArrive.Worst, AreaMargin );
   578	                if ( p->fSkipFanout == 18 || p->fSkipFanout == 19 || p->fSkipFanout == 20 || p->fSkipFanout == 21 || p->fSkipFanout == 22 )
   579	                    printf( "stmap%d relief diag: index = %d  profile-open = %d  node = %d  level = %u  refs = %d  leaves = %d  phase = %d  slack = %.6f  area-save = %.6f  arrival-delta = %.6f  arrival-gain-margin = %.6f  area-margin = %.6f\n",
   580	                        p->fSkipFanout - 1, p->nStmap13MiddleRelief, fProfileOpen, pNode->Num, pNode->Level, pNode->nRefs,
   581	                        pCut->nLeaves, fPhase, Slack, pMatchBest->AreaFlow - pMatch->AreaFlow,
   582	                        ArrivalDelta, ArrivalGainMargin, AreaMargin );
   583	                if ( (p->fSkipFanout == 20 || p->fSkipFanout == 21 || p->fSkipFanout == 22) && !fProfileOpen && !fStrictFallback )
   584	                    p->nStmap19EarlySeed++;
   585	                return 0;
   586	            }
   587	            if ( (p->fSkipFanout == 19 || p->fSkipFanout == 20 || p->fSkipFanout == 21 || p->fSkipFanout == 22) && fStrictFallback && AreaSave > OneInvArea + p->fEpsilon )
   588	            {
   589	                if ( p->fSkipFanout == 19 )
   590	                    pReason = fProfileOpen ? "timing-gate" : "profile-closed";
   591	                else if ( p->fSkipFanout == 20 )
   592	                    pReason = "arrival-gate";
   593	                else if ( p->fSkipFanout == 22 )
   594	                    pReason = fArrivalQuality ? "deep-gain-gate" : "arrival-gate";
   595	                else
   596	                    pReason = fArrivalQuality ? "depth-gate" : "arrival-gate";
   597	                p->nStmap18NearMiss++;
   598	                if ( p->nStmap18NearMiss <= 128 )
   599	                    printf( "stmap%d near-miss diag: index = %d  reason = %s  profile-open = %d  node = %d  level = %u  refs = %d  leaves = %d  phase = %d  slack = %.6f  area-save = %.6f  arrival-delta = %.6f  arrival-gain-margin = %.6f  area-margin = %.6f  one-inv-area = %.6f\n",
   600	                        p->fSkipFanout - 1, p->nStmap18NearMiss, pReason,
   601	                        fProfileOpen, pNode->Num, pNode->Level, pNode->nRefs, pCut->nLeaves,
   602	                        fPhase, Slack, AreaSave, ArrivalDelta, ArrivalGainMargin, AreaMargin, OneInvArea );
   603	            }
   604	            if ( fStmap13 )
   605	                p->nStmap13RejectArea++;
   606	            return 1;
   607	        }
   608	        if ( Slack <= SlackGate + p->fEpsilon )
   609	        {
   610	            if ( fStmap13 )
   611	                p->nStmap13RejectSlack++;
   612	            return 1;
   613	        }
   614	        if ( Map_MatchCutHasStmapHighestFanoutRisk( pNode, pCut ) )
   615	        {
   616	            if ( fStmap13 )
   617	                p->nStmap13RejectHighest++;
   618	            return 1;
   619	        }
   620	    }
   621	    if ( Slack <= SlackMargin + p->fEpsilon )
   622	        return 0;
   623	    if ( p->fSkipFanout == 9 || p->fSkipFanout == 10 || p->fSkipFanout == 11 || p->fSkipFanout == 12 || p->fSkipFanout == 13 || p->fSkipFanout == 14 || p->fSkipFanout == 15 || p->fSkipFanout == 16 || p->fSkipFanout == 17 || p->fSkipFanout == 18 || p->fSkipFanout == 19 || p->fSkipFanout == 20 || p->fSkipFanout == 21 || p->fSkipFanout == 22 )
   624	    {
   625	        ArrivalMargin = 0.25 * SlackMargin;
   626	        if ( pMatch->tArrive.Worst > pMatchBest->tArrive.Worst + ArrivalMargin + p->fEpsilon )
   627	        {
   628	            if ( fStmap13 )
   629	                p->nStmap13RejectArrival++;
   630	            return 1;
   631	        }
   632	    }
   633	    AreaMargin = p->pSuperLib ? 0.5 * p->pSuperLib->AreaInv : 0.0;
   634	    if ( pMatch->AreaFlow < pMatchBest->AreaFlow - AreaMargin - p->fEpsilon )
   635	        return 0;
   636	    if ( fStmap13 )
   637	        p->nStmap13RejectArea++;
   638	    return 1;
   639	}
