   257	
   258	/**Function*************************************************************
   259	
   260	  Synopsis    [Returns 1 if a fanout/load proxy should reject this cut.]
   261	
   262	  Description [Mode 1 is the classic map -f guard. Mode 2 is the stmap1
   263	  selective guard, which only rejects wider cuts when the node has higher
   264	  estimated fanout. Mode 3 is the stmap2 guard, which uses the same fanout
   265	  thresholds only during area recovery and only when the current phase has
   266	  slack over the mapper required time. Mode 4 is the stmap3 guard, which
   267	  narrows the intervention to high-fanout nodes with only shallow positive
   268	  slack. Mode 5 is the stmap4 split-phase guard: stmap1-style guarding in
   269	  delay matching and stmap2-style slack-aware guarding in area recovery.
   270	  Mode 6 is the stmap5 shape-gated split-phase guard: the delay pass only
   271	  uses stmap1-style guarding in very large mapper graphs, while area recovery
   272	  keeps the stmap2 slack-aware guard. Mode 7 is the stmap6 area-sensitive
   273	  shape-gated guard: the delay pass keeps the stmap5 graph-size gate, small
   274	  mapper graphs keep the stmap2 slack-aware recovery guard, and exact-area
   275	  recovery on larger graphs checks the cut after matching so materially cheaper
   276	  cuts can override the fanout/load proxy. Mode 8 is the stmap7 criticality-
   277	  sensitive version of mode 7: exact-area recovery on larger graphs allows the
   278	  override only with deeper mapper slack and outside the highest fanout bucket.
   279	  Mode 9 is the stmap8 arrival-bounded version of mode 8: the area-saving
   280	  override also requires the candidate match to stay within one quarter of an
   281	  inverter delay of the existing mapper arrival. Mode 10 is the stmap9
   282	  middle-slack area-relief version of mode 9: it keeps the highest fanout
   283	  bucket protected, but in the one-to-two inverter slack bucket it allows a
   284	  wide cut only when it is arrival-neutral and saves at least one inverter
   285	  area. Mode 11 is the stmap10 depth-qualified version of mode 10: the
   286	  middle-slack relief is allowed only for shallow and medium-depth nodes.
   287	  Mode 12 is the stmap11 tight-depth version of mode 11: the middle-slack
   288	  relief is allowed only for shallower nodes. Mode 13 is the stmap12
   289	  fanout-bucket split version of mode 12: the tight-depth middle-slack relief
   290	  is allowed only in the lower moderate fanout bucket. Mode 14 is stmap13,
   291	  which keeps mode 13 behavior while recording guard-hit counters. Mode 15 is
   292	  stmap14, which keeps the same bucket and counters but requires a stronger
   293	  middle-slack area-flow saving. Mode 16 is stmap15, which restores the
   294	  one-inverter relief threshold only after the current run has observed a high
   295	  lower-moderate/middle-slack exact-area profile. Mode 17 is stmap16, which
   296	  keeps mode 16 behavior and prints per-relief diagnostics. Mode 18 is stmap17,
   297	  which uses the one-inverter post-profile threshold only for candidates with
   298	  materially better mapper arrival. Mode 19 is stmap18, which keeps mode 18
   299	  decisions and adds near-miss diagnostics for candidates rejected by the
   300	  timing-quality/profile fallback. Mode 20 is stmap19, which allows the
   301	  one-inverter threshold before profile-open only for candidates with the same
   302	  material mapper-arrival improvement. Mode 21 is stmap20, which keeps the
   303	  mode 20 pre-profile seed but restricts it to shallow nodes. Mode 22 is
   304	  stmap21, which keeps the shallow seed and admits deeper pre-profile seeds
   305	  only when the arrival gain is unusually large.]
   306	
   307	  SideEffects []
   308	
   309	  SeeAlso     []
   310	
   311	***********************************************************************/
   312	static int Map_MatchSkipCutForFanout( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase )
   313	{
   314	    Map_Cut_t * pCutBest;
   315	    Map_Match_t * pMatchBest;
   316	    float Slack, SlackMargin, SlackLimit;
   317	
   318	    if ( !p->fSkipFanout )
   319	        return 0;
   320	    if ( p->fSkipFanout == 2 )
   321	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   322	    if ( p->fSkipFanout == 3 )
   323	    {
   324	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   325	            return 0;
   326	        pCutBest = pNode->pCutBest[fPhase];
   327	        if ( pCutBest == NULL )
   328	            return 0;
   329	        pMatchBest = pCutBest->M + fPhase;
   330	        if ( pMatchBest->pSuperBest == NULL )
   331	            return 0;
   332	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   333	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   334	        if ( Slack <= SlackMargin + p->fEpsilon )
   335	            return 0;
   336	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   337	    }
   338	    if ( p->fSkipFanout == 4 )
