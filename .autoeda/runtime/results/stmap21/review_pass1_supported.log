   986	float Map_TimeMatchWithInverter( Map_Man_t * p, Map_Match_t * pMatch )
   987	{
   988	    Map_Time_t tArrInv;
   989	    tArrInv.Fall  = pMatch->tArrive.Rise + p->pSuperLib->tDelayInv.Fall;
   990	    tArrInv.Rise  = pMatch->tArrive.Fall + p->pSuperLib->tDelayInv.Rise;
   991	    tArrInv.Worst = MAP_MAX( tArrInv.Rise, tArrInv.Fall ); 
   992	    return tArrInv.Worst;
   993	}
