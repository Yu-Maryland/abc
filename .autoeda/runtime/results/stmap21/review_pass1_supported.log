   757	        pMatch->pSuperBest = pSuper;
   758	        for ( i = 0; i < (int)pSuper->nPhases; i++ )
   759	        {
   760	            p->nPhases++;
   761	            // find the overall phase of this match
   762	            pMatch->uPhaseBest = pMatch->uPhase ^ pSuper->uPhases[i];
   763	            if ( p->fMappingMode == 0 )
   764	            {
   765	                // get the arrival time
   766	                Map_TimeCutComputeArrival( pNode, pCut, fPhase, fWorstLimit );
   767	                // skip the cut if the arrival times exceed the required times
   768	                if ( pMatch->tArrive.Worst > fWorstLimit + p->fEpsilon )
   769	                    continue;
   770	                // get the area (area flow)
   771	                pMatch->AreaFlow = Map_CutGetAreaFlow( pCut, fPhase );
   772	            }
   773	            else
   774	            {
   775	                // get the area (area flow)
   776	                if ( p->fMappingMode == 2 || p->fMappingMode == 3 )
   777	                    pMatch->AreaFlow = Map_CutGetAreaDerefed( pCut, fPhase );
   778	                else if ( p->fMappingMode == 4 )
   779	                    pMatch->AreaFlow = Map_SwitchCutGetDerefed( pNode, pCut, fPhase );
   780	                else 
   781	                    pMatch->AreaFlow = Map_CutGetAreaFlow( pCut, fPhase );
   782	                // skip if the cut is too large
   783	                if ( pMatch->AreaFlow > MatchBest.AreaFlow + p->fEpsilon )
   784	                    continue;
   785	                // get the arrival time
   786	                Map_TimeCutComputeArrival( pNode, pCut, fPhase, fWorstLimit );
   787	                // skip the cut if the arrival times exceed the required times
   788	                if ( pMatch->tArrive.Worst > fWorstLimit + p->fEpsilon )
   789	                    continue;
   790	            }
   791	
   792	            // if the cut is non-trivial, compare it
   793	            if ( Map_MatchCompare( p, &MatchBest, pMatch, p->fMappingMode ) )
   794	            {
   795	                MatchBest = *pMatch;
   796	                // if we are mapping for delay, the worst-case limit should be reduced
   797	                if ( p->fMappingMode == 0 )
   798	                    fWorstLimit = MatchBest.tArrive.Worst;
   799	            }
   800	        }
   801	    }
   802	    // set the best match
   803	    *pMatch = MatchBest;
   804	
   805	    // recompute the arrival time and area (area flow) of this cut
   806	    if ( pMatch->pSuperBest )
   807	    {
   808	        Map_TimeCutComputeArrival( pNode, pCut, fPhase, MAP_FLOAT_LARGE );
   809	        if ( p->fMappingMode == 2 || p->fMappingMode == 3 )
   810	            pMatch->AreaFlow = Map_CutGetAreaDerefed( pCut, fPhase );
   811	        else if ( p->fMappingMode == 4 )
   812	            pMatch->AreaFlow = Map_SwitchCutGetDerefed( pNode, pCut, fPhase );
   813	        else 
   814	            pMatch->AreaFlow = Map_CutGetAreaFlow( pCut, fPhase );
   815	    }
   816	    return 1;
   817	}
