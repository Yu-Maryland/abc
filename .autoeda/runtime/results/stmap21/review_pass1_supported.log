   995	/**Function*************************************************************
   996	
   997	  Synopsis    [Attempts dropping one phase of the node.]
   998	
   999	  Description []
  1000	               
  1001	  SideEffects []
  1002	
  1003	  SeeAlso     []
  1004	
  1005	***********************************************************************/
  1006	void Map_NodeTryDroppingOnePhase( Map_Man_t * p, Map_Node_t * pNode )
  1007	{
  1008	    Map_Match_t * pMatchBest0, * pMatchBest1;
  1009	    float tWorst0Using1, tWorst1Using0; 
  1010	    int fUsePhase1, fUsePhase0;
  1011	
  1012	    // nothing to do if one of the phases is already dropped
  1013	    if ( pNode->pCutBest[0] == NULL || pNode->pCutBest[1] == NULL )
  1014	        return;
  1015	
  1016	    // do not drop while recovering area flow
  1017	    if ( p->fMappingMode == 1 )//|| p->fMappingMode == 2 )
  1018	        return;
  1019	
  1020	    // get the pointers to the matches of the best cuts
  1021	    pMatchBest0 = pNode->pCutBest[0]->M + 0;
  1022	    pMatchBest1 = pNode->pCutBest[1]->M + 1;
  1023	
  1024	    // get the worst arrival times of each phase
  1025	    // implemented using the other phase with inverter added
  1026	    tWorst0Using1 = Map_TimeMatchWithInverter( p, pMatchBest1 );
  1027	    tWorst1Using0 = Map_TimeMatchWithInverter( p, pMatchBest0 );
  1028	
  1029	    // consider the case of mapping for delay
  1030	    if ( p->fMappingMode == 0 && p->DelayTarget < ABC_INFINITY )
  1031	    { 
  1032	        // if the arrival time of a phase is larger than the arrival time 
  1033	        // of the opposite phase plus the inverter, drop this phase
  1034	        if ( pMatchBest0->tArrive.Worst > tWorst0Using1 + p->fEpsilon ) 
  1035	            pNode->pCutBest[0] = NULL;
  1036	        else if ( pMatchBest1->tArrive.Worst > tWorst1Using0 + p->fEpsilon ) 
  1037	            pNode->pCutBest[1] = NULL;
  1038	        return;
  1039	    }
  1040	
  1041	    // do not perform replacement if one of the phases is unused
  1042	    if ( pNode->nRefAct[0] == 0 || pNode->nRefAct[1] == 0 )
  1043	        return;
  1044	 
  1045	    // check if replacement of each phase is possible using required times
  1046	    fUsePhase0 = fUsePhase1 = 0;
  1047	    if ( p->fMappingMode == 2 )
  1048	    {
  1049	        fUsePhase0 = (pNode->tRequired[1].Worst > tWorst1Using0 + 3*p->pSuperLib->tDelayInv.Worst + p->fEpsilon);
  1050	        fUsePhase1 = (pNode->tRequired[0].Worst > tWorst0Using1 + 3*p->pSuperLib->tDelayInv.Worst + p->fEpsilon);
  1051	    }
  1052	    else if ( p->fMappingMode == 3 || p->fMappingMode == 4 )
  1053	    {
  1054	        fUsePhase0 = (pNode->tRequired[1].Worst > tWorst1Using0 + p->fEpsilon);
  1055	        fUsePhase1 = (pNode->tRequired[0].Worst > tWorst0Using1 + p->fEpsilon);
  1056	    }
  1057	    if ( !fUsePhase0 && !fUsePhase1 )
  1058	        return;
  1059	
  1060	    // if replacement is possible both ways, use the one that works better
  1061	    if ( fUsePhase0 && fUsePhase1 )
  1062	    {
  1063	        if ( pMatchBest0->AreaFlow < pMatchBest1->AreaFlow )
  1064	            fUsePhase1 = 0;
  1065	        else
  1066	            fUsePhase0 = 0;
  1067	    }
  1068	    // only one phase should be used
  1069	    assert( fUsePhase0 ^ fUsePhase1 );
  1070	
  1071	    // set the corresponding cut to NULL
  1072	    if ( fUsePhase0 )
  1073	    {
  1074	        // deref phase 1 cut if necessary
  1075	        if ( p->fMappingMode >= 2 && pNode->nRefAct[1] > 0 )
  1076	            Map_CutDeref( pNode->pCutBest[1], 1, p->fUseProfile );
  1077	        // get rid of the cut
  1078	        pNode->pCutBest[1] = NULL;
  1079	        // ref phase 0 cut if necessary
  1080	        if ( p->fMappingMode >= 2 && pNode->nRefAct[0] == 0 )
  1081	            Map_CutRef( pNode->pCutBest[0], 0, p->fUseProfile );
  1082	    }
  1083	    else
  1084	    {
  1085	        // deref phase 0 cut if necessary
  1086	        if ( p->fMappingMode >= 2 && pNode->nRefAct[0] > 0 )
  1087	            Map_CutDeref( pNode->pCutBest[0], 0, p->fUseProfile );
  1088	        // get rid of the cut
  1089	        pNode->pCutBest[0] = NULL;
  1090	        // ref phase 1 cut if necessary
  1091	        if ( p->fMappingMode >= 2 && pNode->nRefAct[1] == 0 )
  1092	            Map_CutRef( pNode->pCutBest[1], 1, p->fUseProfile );
  1093	    }
  1094	}
