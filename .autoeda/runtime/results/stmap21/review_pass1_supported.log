   937	/**Function*************************************************************
   938	
   939	  Synopsis    [Sets the PI arrival times.]
   940	
   941	  Description []
   942	               
   943	  SideEffects []
   944	
   945	  SeeAlso     []
   946	
   947	***********************************************************************/
   948	void Map_MappingSetPiArrivalTimes( Map_Man_t * p )
   949	{
   950	    Map_Node_t * pNode;
   951	    int i;
   952	    for ( i = 0; i < p->nInputs; i++ )
   953	    {
   954	        pNode = p->pInputs[i];
   955	        // set the arrival time of the positive phase
   956	        if ( Scl_ConIsRunning() )
   957	        {
   958	            float Time = Scl_ConGetInArrFloat( i );
   959	            pNode->tArrival[1].Fall  = Time;
   960	            pNode->tArrival[1].Rise  = Time;
   961	            pNode->tArrival[1].Worst = Time;
   962	        }
   963	        else
   964	            pNode->tArrival[1] = p->pInputArrivals[i];
   965	        pNode->tArrival[1].Rise  += p->pNodeDelays ? p->pNodeDelays[pNode->Num] : 0;
   966	        pNode->tArrival[1].Fall  += p->pNodeDelays ? p->pNodeDelays[pNode->Num] : 0;
   967	        pNode->tArrival[1].Worst += p->pNodeDelays ? p->pNodeDelays[pNode->Num] : 0;
   968	        // set the arrival time of the negative phase
   969	        pNode->tArrival[0].Rise  = pNode->tArrival[1].Fall + p->pSuperLib->tDelayInv.Rise;
   970	        pNode->tArrival[0].Fall  = pNode->tArrival[1].Rise + p->pSuperLib->tDelayInv.Fall;
   971	        pNode->tArrival[0].Worst = MAP_MAX(pNode->tArrival[0].Rise, pNode->tArrival[0].Fall);
   972	    }
   973	}
