  1108	void Map_NodeTransferArrivalTimes( Map_Man_t * p, Map_Node_t * pNode )
  1109	{
  1110	    // if both phases are available, set their arrival times
  1111	    if ( pNode->pCutBest[0] && pNode->pCutBest[1] )
  1112	    {
  1113	        pNode->tArrival[0] = pNode->pCutBest[0]->M[0].tArrive;
  1114	        pNode->tArrival[1] = pNode->pCutBest[1]->M[1].tArrive;
  1115	    }
  1116	    // if only one phase is available, compute the arrival time of other phase
  1117	    else if ( pNode->pCutBest[0] )
  1118	    {
  1119	        pNode->tArrival[0] = pNode->pCutBest[0]->M[0].tArrive;
  1120	        pNode->tArrival[1].Rise  = pNode->tArrival[0].Fall + p->pSuperLib->tDelayInv.Rise;
  1121	        pNode->tArrival[1].Fall  = pNode->tArrival[0].Rise + p->pSuperLib->tDelayInv.Fall;
  1122	        pNode->tArrival[1].Worst = MAP_MAX(pNode->tArrival[1].Rise, pNode->tArrival[1].Fall);
  1123	    }
  1124	    else if ( pNode->pCutBest[1] )
  1125	    {
  1126	        pNode->tArrival[1] = pNode->pCutBest[1]->M[1].tArrive;
  1127	        pNode->tArrival[0].Rise  = pNode->tArrival[1].Fall + p->pSuperLib->tDelayInv.Rise;
  1128	        pNode->tArrival[0].Fall  = pNode->tArrival[1].Rise + p->pSuperLib->tDelayInv.Fall;
  1129	        pNode->tArrival[0].Worst = MAP_MAX(pNode->tArrival[0].Rise, pNode->tArrival[0].Fall);
  1130	    }
  1131	    else 
  1132	    {
  1133	        assert( 0 );
  1134	    }
  1135	
  1136	//    assert( pNode->tArrival[0].Rise < pNode->tRequired[0].Rise + p->fEpsilon );
  1137	//    assert( pNode->tArrival[0].Fall < pNode->tRequired[0].Fall + p->fEpsilon );
  1138	
  1139	//    assert( pNode->tArrival[1].Rise < pNode->tRequired[1].Rise + p->fEpsilon );
  1140	//    assert( pNode->tArrival[1].Fall < pNode->tRequired[1].Fall + p->fEpsilon );
  1141	}
