   352	            return 0;
   353	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   354	    }
   355	    if ( p->fSkipFanout == 5 )
   356	    {
   357	        if ( p->fMappingMode == 0 )
   358	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   359	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   360	            return 0;
   361	        pCutBest = pNode->pCutBest[fPhase];
   362	        if ( pCutBest == NULL )
   363	            return 0;
   364	        pMatchBest = pCutBest->M + fPhase;
   365	        if ( pMatchBest->pSuperBest == NULL )
   366	            return 0;
   367	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   368	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   369	        if ( Slack <= SlackMargin + p->fEpsilon )
   370	            return 0;
   371	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   372	    }
   373	    if ( p->fSkipFanout == 6 )
   374	    {
   375	        if ( p->fMappingMode == 0 )
   376	        {
   377	            if ( p->vMapObjs->nSize <= 20000 )
   378	                return 0;
   379	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   380	        }
   381	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   382	            return 0;
   383	        pCutBest = pNode->pCutBest[fPhase];
   384	        if ( pCutBest == NULL )
   385	            return 0;
   386	        pMatchBest = pCutBest->M + fPhase;
   387	        if ( pMatchBest->pSuperBest == NULL )
   388	            return 0;
   389	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   390	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   391	        if ( Slack <= SlackMargin + p->fEpsilon )
   392	            return 0;
   393	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   394	    }
   395	    if ( p->fSkipFanout == 7 )
   396	    {
   397	        if ( p->fMappingMode == 0 )
   398	        {
   399	            if ( p->vMapObjs->nSize <= 20000 )
   400	                return 0;
   401	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   402	        }
   403	        if ( p->fMappingMode >= 1 && p->fMappingMode <= 3 && p->vMapObjs->nSize <= 8000 )
   404	        {
   405	            pCutBest = pNode->pCutBest[fPhase];
   406	            if ( pCutBest == NULL )
   407	                return 0;
   408	            pMatchBest = pCutBest->M + fPhase;
   409	            if ( pMatchBest->pSuperBest == NULL )
   410	                return 0;
   411	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   412	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   413	            if ( Slack <= SlackMargin + p->fEpsilon )
   414	                return 0;
   415	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   416	        }
   417	        if ( p->fMappingMode == 1 )
   418	        {
   419	            pCutBest = pNode->pCutBest[fPhase];
   420	            if ( pCutBest == NULL )
   421	                return 0;
   422	            pMatchBest = pCutBest->M + fPhase;
   423	            if ( pMatchBest->pSuperBest == NULL )
   424	                return 0;
   425	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   426	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   427	            if ( Slack <= SlackMargin + p->fEpsilon )
   428	                return 0;
   429	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   430	        }
   431	        return 0;
   432	    }
   433	    if ( p->fSkipFanout == 8 || p->fSkipFanout == 9 || p->fSkipFanout == 10 || p->fSkipFanout == 11 || p->fSkipFanout == 12 || p->fSkipFanout == 13 || p->fSkipFanout == 14 || p->fSkipFanout == 15 || p->fSkipFanout == 16 || p->fSkipFanout == 17 || p->fSkipFanout == 18 || p->fSkipFanout == 19 || p->fSkipFanout == 20 || p->fSkipFanout == 21 || p->fSkipFanout == 22 )
   434	    {
   435	        if ( p->fMappingMode == 0 )
   436	        {
   437	            if ( p->vMapObjs->nSize <= 20000 )
   438	                return 0;
   439	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   440	        }
   441	        if ( p->fMappingMode >= 1 && p->fMappingMode <= 3 && p->vMapObjs->nSize <= 8000 )
   442	        {
   443	            pCutBest = pNode->pCutBest[fPhase];
   444	            if ( pCutBest == NULL )
   445	                return 0;
   446	            pMatchBest = pCutBest->M + fPhase;
   447	            if ( pMatchBest->pSuperBest == NULL )
   448	                return 0;
   449	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   450	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   451	            if ( Slack <= SlackMargin + p->fEpsilon )
   452	                return 0;
   453	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   454	        }
   455	        if ( p->fMappingMode == 1 )
   456	        {
   457	            pCutBest = pNode->pCutBest[fPhase];
   458	            if ( pCutBest == NULL )
   459	                return 0;
   460	            pMatchBest = pCutBest->M + fPhase;
   461	            if ( pMatchBest->pSuperBest == NULL )
   462	                return 0;
   463	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   464	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   465	            if ( Slack <= SlackMargin + p->fEpsilon )
   466	                return 0;
   467	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   468	        }
   469	        return 0;
   470	    }
   471	    return (pNode->nRefs > 3 && pCut->nLeaves > 2) || (pNode->nRefs > 1 && pCut->nLeaves > 3);
   472	}
