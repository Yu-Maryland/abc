   738	int Map_MatchNodeCut( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase, float fWorstLimit )
   739	{
   740	    Map_Match_t MatchBest, * pMatch = pCut->M + fPhase;
   741	    Map_Super_t * pSuper;
   742	    int i, Counter;
   743	
   744	    // save the current match of the cut
   745	    MatchBest = *pMatch;
