   688	/**Function*************************************************************
   689	
   690	  Synopsis    [Runs the stmap64 mapper probe.]
   691	
   692	  Description [stmap64 keeps the stmap63 load-drop cut-only policy and records
   693	  admitted cut-only seeds so the downstream stime call can report whether they
   694	  remain visible, loaded, and timing-critical after buffering and sizing.]
   695	
   696	  SideEffects []
   697	
   698	  SeeAlso     []
   699	
   700	***********************************************************************/
   701	int Abc_CommandStmap64( Abc_Frame_t * pAbc, int argc, char ** argv )
   702	{
   703	    Abc_Ntk_t * pNtk, * pNtkMap, * pNtkRes, * pNtkFirst;
   704	    Abc_Stmap64LoadStats_t LoadStats;
   705	    Abc_Stmap64BoundedStats_t BoundedStats;
   706	    float * pBoundedPressureRatios = NULL;
   707	    char Buffer[100];
   708	    double DelayTarget;
   709	    double AreaMulti;
   710	    double DelayMulti;
   711	    float LogFan = 0;
   712	    float Slew = 0; // choose based on the library
   713	    float Gain = 250; // base SCL/genlib gain for low and moderate pressure
   714	    float LowGain, SelectedGain;
   715	    int nGatesMin = 0;
   716	    int fAreaOnly;
   717	    int fRecovery;
   718	    int fSweep;
   719	    int fSwitching;
   720	    int fSkipFanout;
   800	            globalUtilOptind++;
   801	            if ( Slew <= 0.0 )
   802	                goto usage;
   803	            break;
   804	        case 'G':
   805	            if ( globalUtilOptind >= argc )
   806	            {
   807	                Abc_Print( -1, "Command line switch \"-G\" should be followed by a floating point number.\n" );
   808	                goto usage;
   809	            }
   810	            Gain = (float)atof(argv[globalUtilOptind]);
   811	            globalUtilOptind++;
   812	            if ( Gain <= 0.0 )
   813	                goto usage;
   814	            break;
   815	        case 'M':
   816	            if ( globalUtilOptind >= argc )
   817	            {
   818	                Abc_Print( -1, "Command line switch \"-M\" should be followed by a positive integer.\n" );
   819	                goto usage;
   820	            }
   821	            nGatesMin = atoi(argv[globalUtilOptind]);
   822	            globalUtilOptind++;
   823	            if ( nGatesMin < 0 )
   824	                goto usage;
   825	            break;
   826	        case 'a':
   827	            fAreaOnly ^= 1;
   828	            break;
   829	        case 'r':
   830	            fRecovery ^= 1;
   831	            break;
   832	        case 's':
   833	            fSweep ^= 1;
   834	            break;
   835	        case 'p':
   836	            fSwitching ^= 1;
   837	            break;
   838	        case 'f':
   839	            fSkipFanout = fSkipFanout ? 0 : 57;
   840	            break;
   841	        case 'u':
   842	            fUseProfile ^= 1;
   843	            break;
   844	        case 'o':
   845	            fUseBuffs ^= 1;
   846	            break;
   847	        case 'v':
   848	            fVerbose ^= 1;
   849	            break;
   850	        case 'h':
   851	            goto usage;
   852	        default:
   853	            goto usage;
   854	        }
   855	    }
   856	
   857	    if ( pNtk == NULL )
   858	    {
   859	        Abc_Print( -1, "Empty network.\n" );
   860	        return 1;
   861	    }
   862	
   863	    if ( fAreaOnly )
   864	        DelayTarget = ABC_INFINITY;
   865	
   866	    Map_Stmap45SetSclLoadFeedbackWithEntries( 0.0, 0.0, 0.0, NULL, 0, 0 );
   867	    Map_Stmap60SetNearMissLeafDiag( 0, -1 );
   868	    Map_Stmap61SetCutOnlyGateDiag( 0, -1 );
   869	    Map_Stmap62SetCutOnlyOrdering( 0 );
   870	    Map_Stmap63SetCutOnlyLoadDropGuard( 0 );
   871	    Abc_Stmap64ClearFinalWitnessScope();
   872	    pNtkMap = pNtk;
   873	    if ( !Abc_NtkIsStrash(pNtk) )
   874	    {
   875	        pNtkMap = Abc_NtkStrash( pNtk, 0, 0, 0 );
   876	        if ( pNtkMap == NULL )
   877	        {
   878	            Abc_Print( -1, "Strashing before stmap64 has failed.\n" );
   879	            return 1;
   880	        }
   881	        pNtkMap = Abc_NtkBalance( pNtkRes = pNtkMap, 0, 0, 1 );
   882	        Abc_NtkDelete( pNtkRes );
   883	        if ( pNtkMap == NULL )
   884	        {
   885	            Abc_Print( -1, "Balancing before stmap64 has failed.\n" );
   886	            return 1;
   887	        }
   888	        fTempMap = 1;
   889	        Abc_Print( 0, "The network was strashed and balanced before stmap64.\n" );
   890	    }
   891	
   892	    if ( fSkipFanout )
   893	    {
   894	        pNtkFirst = Abc_NtkMap( pNtkMap, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, Gain, nGatesMin, fRecovery, fSwitching, 36, fUseProfile, fUseBuffs, fVerbose );
   895	        if ( pNtkFirst == NULL )
   896	        {
   897	            if ( fTempMap )
   898	                Abc_NtkDelete( pNtkMap );
   899	            Abc_Print( -1, "stmap64 has failed.\n" );
   900	            return 1;
   901	        }
   902	        Abc_Stmap64CollectSclLoadStats( pNtkFirst, &LoadStats );
   903	        Abc_Stmap64PrintSclLoadStats( "feedback-load", &LoadStats );
   904	        Abc_Stmap64PrintHotspots( &LoadStats );
   905	        OverFrac = LoadStats.nMatched ? (float)LoadStats.nOver / (float)LoadStats.nMatched : 0.0;
   906	        Feedback = Abc_Stmap64FeedbackSeverity( &LoadStats );
   907	        LowGain = 0.90 * Gain;
   908	        SelectedGain = Gain;
   909	        fUseReducedGain = Feedback >= ABC_STMAP64_SEVERE_THRESHOLD && LoadStats.nPressureEntries >= ABC_STMAP64_PRESSURE_ENTRY_THRESHOLD;
   910	        fSevereTransfer = fUseReducedGain;
   911	        if ( fUseReducedGain && LowGain > 0.0 )
   912	            SelectedGain = LowGain;
   913	        pBoundedPressureRatios = Abc_Stmap64BuildBoundedPressures( &LoadStats, fSevereTransfer, &BoundedStats );
   914	        if ( pBoundedPressureRatios == NULL && LoadStats.nAigPressureRatios > 0 )
   915	        {
   916	            Abc_NtkDelete( pNtkFirst );
   917	            Abc_Stmap64LoadStatsFree( &LoadStats );
   918	            if ( fTempMap )
   919	                Abc_NtkDelete( pNtkMap );
   920	            Abc_Print( -1, "stmap64 bounded-pressure allocation has failed.\n" );
   921	            return 1;
   922	        }
   923	        printf( "stmap64 feedback: remap = 1  active = %d  max-load-ratio = %.3f  over-max-frac = %.6f  severity = %.3f  raw-pressure-entries = %d  sink-pressure-entries = %d  pressure-capacity = %d\n",
   924	            Feedback > 0.0 && LoadStats.nPressureEntries > 0, LoadStats.RatioMax, OverFrac,
   925	            Feedback, LoadStats.nPressureEntries, LoadStats.nSinkPressureEntries,
   926	            LoadStats.nAigPressureRatios );
   927	        printf( "stmap64 blended-gain: base-gain = %.2f  blend-gain = %.2f  selected-gain = %.2f  severity-threshold = 0.850  raw-pressure-threshold = 8000  selected-blend-gain = %d\n",
   928	            Gain, LowGain, SelectedGain, fUseReducedGain );
   929	        Abc_Stmap64PrintBoundedPressures( &LoadStats, &BoundedStats );
   930	        printf( "stmap64 mapper-mode: bounded-pressure-transfer-mode = 57  cut-only-before-moderate = 0  load-drop-cut-only-guard = 1  final-stime-witness = 1  blended-gain = %.2f  pressure-feed = %s  raw-weight = %.2f  bounded-ratio-cap = %.3f  inherited-cut-only-area-save-cap = 1.35x-inverter  tracked-near-miss-node = %d  cut-only-gate-diag = 1\n",
   931	            SelectedGain, fSevereTransfer ? "bounded-raw" : "sink-fallback",
   932	            ABC_STMAP64_BOUND_RAW_WEIGHT, ABC_STMAP64_BOUND_RATIO_CAP,
   933	            ABC_STMAP64_TRACK_NODE );
   934	        Abc_NtkDelete( pNtkFirst );
   935	        Map_Stmap45SetSclLoadFeedbackWithEntries( LoadStats.RatioMax, OverFrac, Feedback, pBoundedPressureRatios, LoadStats.nAigPressureRatios, BoundedStats.nEntries );
   936	        Map_Stmap60SetNearMissLeafDiag( 1, ABC_STMAP64_TRACK_NODE );
   937	        Map_Stmap61SetCutOnlyGateDiag( 1, ABC_STMAP64_TRACK_NODE );
   938	        Map_Stmap62SetCutOnlyOrdering( 0 );
   939	        Map_Stmap63SetCutOnlyLoadDropGuard( 1 );
   940	        Map_Stmap64SetCutOnlyWitnessDiag( 1 );
   941	        pNtkRes = Abc_NtkMap( pNtkMap, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, SelectedGain, nGatesMin, fRecovery, fSwitching, 57, fUseProfile, fUseBuffs, fVerbose );
   942	        Map_Stmap64SetCutOnlyWitnessDiag( 0 );
   943	        Map_Stmap63SetCutOnlyLoadDropGuard( 0 );
   944	        Map_Stmap62SetCutOnlyOrdering( 0 );
   945	        Map_Stmap61SetCutOnlyGateDiag( 0, -1 );
   946	        Map_Stmap60SetNearMissLeafDiag( 0, -1 );
   947	        Map_Stmap45SetSclLoadFeedbackWithEntries( 0.0, 0.0, 0.0, NULL, 0, 0 );
   948	        ABC_FREE( pBoundedPressureRatios );
   949	        Abc_Stmap64LoadStatsFree( &LoadStats );
   950	        if ( pNtkRes == NULL )
   951	        {
   952	            Abc_Stmap64ClearFinalWitnessScope();
   953	            if ( fTempMap )
   954	                Abc_NtkDelete( pNtkMap );
   955	            Abc_Print( -1, "stmap64 feedback remap has failed.\n" );
   956	            return 1;
   957	        }
   958	        Abc_Stmap64SetFinalWitnessScope( pNtkRes );
   959	    }
   960	    else
   961	    {
   962	        pNtkRes = Abc_NtkMap( pNtkMap, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, Gain, nGatesMin, fRecovery, fSwitching, 0, fUseProfile, fUseBuffs, fVerbose );
   963	        if ( pNtkRes == NULL )
   964	        {
   965	            if ( fTempMap )
   966	                Abc_NtkDelete( pNtkMap );
   967	            Abc_Print( -1, "stmap64 has failed.\n" );
   968	            return 1;
   969	        }
   970	    }
   450	    {
   451	        if ( Abc_ObjFanoutNum(pNet) == 0 )
   452	            Abc_NtkDeleteObj(pNet);
   453	        else if ( Abc_ObjFaninNum(pNet) == 0 )
   454	            Abc_ObjAddFanin( pNet, Abc_NtkCreateNodeConst1(pNtk) );
   455	    }
   456	    // fix the net drivers
   457	    Abc_NtkFixNonDrivenNets( pNtk );
   458	
   459	    // reorder the CI/COs to PI/POs first
   460	    Abc_NtkOrderCisCos( pNtk );
   461	}
   462	
   463	static void Abc_NtkDupOrigNodeIds( Abc_Ntk_t * pNtkNew, Abc_Ntk_t * pNtk )
   464	{
   465	    Abc_Obj_t * pObj;
   466	    int i, Lit;
   467	    if ( pNtk == NULL || pNtkNew == NULL || pNtk->vOrigNodeIds == NULL )
   468	        return;
   469	    if ( pNtkNew->vOrigNodeIds )
   470	        Vec_IntFree( pNtkNew->vOrigNodeIds );
   471	    pNtkNew->vOrigNodeIds = Vec_IntStartFull( Abc_NtkObjNumMax(pNtkNew) );
   472	    Abc_NtkForEachObj( pNtk, pObj, i )
   473	    {
   474	        if ( pObj->pCopy == NULL || pObj->Id >= Vec_IntSize(pNtk->vOrigNodeIds) )
   475	            continue;
   476	        Lit = Vec_IntEntry( pNtk->vOrigNodeIds, pObj->Id );
   477	        if ( Lit >= 0 )
   478	            Vec_IntWriteEntry( pNtkNew->vOrigNodeIds, pObj->pCopy->Id, Lit );
   479	    }
   480	    Abc_Stmap64UpdateFinalWitnessOrigIds( pNtk, pNtk->vOrigNodeIds, pNtkNew, pNtkNew->vOrigNodeIds );
   481	}
   482	
   483	/**Function*************************************************************
   484	
   485	  Synopsis    [Duplicate the network.]
   486	
   487	  Description []
   488	               
   489	  SideEffects []
   490	
   491	  SeeAlso     []
   492	
   493	***********************************************************************/
   494	Abc_Ntk_t * Abc_NtkDup( Abc_Ntk_t * pNtk )
   495	{
   496	    Abc_Ntk_t * pNtkNew; 
   497	    Abc_Obj_t * pObj, * pFanin;
   498	    int i, k;
   499	    if ( pNtk == NULL )
   500	        return NULL;
   501	    // start the network
   502	    pNtkNew = Abc_NtkStartFrom( pNtk, pNtk->ntkType, pNtk->ntkFunc );
   503	    // copy the internal nodes
   504	    if ( Abc_NtkIsStrash(pNtk) )
   505	    {
   506	        // copy the AND gates
   507	        Abc_AigForEachAnd( pNtk, pObj, i )
   508	            pObj->pCopy = Abc_AigAnd( (Abc_Aig_t *)pNtkNew->pManFunc, Abc_ObjChild0Copy(pObj), Abc_ObjChild1Copy(pObj) );
   509	        // relink the choice nodes
   510	        Abc_AigForEachAnd( pNtk, pObj, i )
   511	            if ( pObj->pData )
   512	                pObj->pCopy->pData = ((Abc_Obj_t *)pObj->pData)->pCopy;
   513	        // relink the CO nodes
   514	        Abc_NtkForEachCo( pNtk, pObj, i )
   515	            Abc_ObjAddFanin( pObj->pCopy, Abc_ObjChild0Copy(pObj) );
   516	        // get the number of nodes before and after
   517	        if ( Abc_NtkNodeNum(pNtk) != Abc_NtkNodeNum(pNtkNew) )
   518	            printf( "Warning: Structural hashing during duplication reduced %d nodes (this is a minor bug).\n",
   519	                Abc_NtkNodeNum(pNtk) - Abc_NtkNodeNum(pNtkNew) );
   520	    }
   521	    else
   522	    {
   523	        // duplicate the nets and nodes (CIs/COs/latches already dupped)
   524	        Abc_NtkForEachObj( pNtk, pObj, i )
   525	            if ( pObj->pCopy == NULL )
   526	                Abc_NtkDupObj(pNtkNew, pObj, Abc_NtkHasBlackbox(pNtk) && Abc_ObjIsNet(pObj));
   527	        // reconnect all objects (no need to transfer attributes on edges)
   528	        Abc_NtkForEachObj( pNtk, pObj, i )
   529	            if ( !Abc_ObjIsBox(pObj) && !Abc_ObjIsBo(pObj) )
   530	                Abc_ObjForEachFanin( pObj, pFanin, k )
   531	                    Abc_ObjAddFanin( pObj->pCopy, pFanin->pCopy );
   532	        Abc_NtkDupOrigNodeIds( pNtkNew, pNtk );
   533	    }
   534	    // duplicate the EXDC Ntk
   535	    if ( pNtk->pExdc )
   536	        pNtkNew->pExdc = Abc_NtkDup( pNtk->pExdc );
   537	    if ( pNtk->pExcare )
   538	        pNtkNew->pExcare = Abc_NtkDup( (Abc_Ntk_t *)pNtk->pExcare );
   539	    // duplicate timing manager
   540	    if ( pNtk->pManTime )
   541	        Abc_NtkTimeInitialize( pNtkNew, pNtk );
   542	    if ( pNtk->vPhases )
   543	        Abc_NtkTransferPhases( pNtkNew, pNtk );
   544	    if ( pNtk->pWLoadUsed )
   545	        pNtkNew->pWLoadUsed = Abc_UtilStrsav( pNtk->pWLoadUsed );
   546	    // check correctness
   547	    if ( !Abc_NtkCheck( pNtkNew ) )
   548	        fprintf( stdout, "Abc_NtkDup(): Network check has failed.\n" );
   549	    pNtk->pCopy = pNtkNew;
   550	    return pNtkNew;
   551	}
   552	Abc_Ntk_t * Abc_NtkDupDfs( Abc_Ntk_t * pNtk )
   553	{
   554	    Vec_Ptr_t * vNodes;
   555	    Abc_Ntk_t * pNtkNew; 
   556	    Abc_Obj_t * pObj, * pFanin;
   557	    int i, k;
   558	    if ( pNtk == NULL )
   559	        return NULL;
   560	    assert( !Abc_NtkIsStrash(pNtk) && !Abc_NtkIsNetlist(pNtk) );
   561	    // start the network
   562	    pNtkNew = Abc_NtkStartFrom( pNtk, pNtk->ntkType, pNtk->ntkFunc );
   563	    // copy the internal nodes
   564	    vNodes = Abc_NtkDfs( pNtk, 0 );
   565	    Vec_PtrForEachEntry( Abc_Obj_t *, vNodes, pObj, i )
   566	        Abc_NtkDupObj( pNtkNew, pObj, 0 );
   567	    Vec_PtrFree( vNodes );
   568	    // reconnect all objects (no need to transfer attributes on edges)
   569	    Abc_NtkForEachObj( pNtk, pObj, i )
   570	        if ( !Abc_ObjIsBox(pObj) && !Abc_ObjIsBo(pObj) )
   571	            Abc_ObjForEachFanin( pObj, pFanin, k )
   572	                if ( pObj->pCopy && pFanin->pCopy )
   573	                    Abc_ObjAddFanin( pObj->pCopy, pFanin->pCopy );
   574	    Abc_NtkDupOrigNodeIds( pNtkNew, pNtk );
   575	    // duplicate the EXDC Ntk
   576	    if ( pNtk->pExdc )
   577	        pNtkNew->pExdc = Abc_NtkDup( pNtk->pExdc );
   578	    if ( pNtk->pExcare )
   579	        pNtkNew->pExcare = Abc_NtkDup( (Abc_Ntk_t *)pNtk->pExcare );
   580	    // duplicate timing manager
   581	    if ( pNtk->pManTime )
   582	        Abc_NtkTimeInitialize( pNtkNew, pNtk );
   583	    if ( pNtk->vPhases )
   584	        Abc_NtkTransferPhases( pNtkNew, pNtk );
   585	    if ( pNtk->pWLoadUsed )
