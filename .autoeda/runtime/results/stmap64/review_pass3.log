   612	}
   613	
   614	void Abc_Stmap64PrintFinalWitness( SC_Man * pTime )
   615	{
   616	    Abc_Ntk_t * pNtk;
   617	    Abc_Obj_t * pObj, * pBestObj;
   618	    Mio_Gate_t * pGate;
   619	    float SeedNodePressure, SeedCutPressure, SeedSlack, SeedAreaSave;
   620	    float SeedArrivalDelta, SeedArrivalGainMargin, SeedFeedback;
   621	    float Load, MaxCap, LoadRatio, Criticality, Slack;
   622	    float BestLoad, BestMaxCap, BestLoadRatio, BestCriticality, BestSlack;
   623	    int i, k, AigId, SeedNode, nWitnesses, nMatched = 0, nCritical = 0;
   624	    int Fanouts;
   625	    extern int Map_Stmap64CutOnlyWitnessCount( void );
   626	    extern int Map_Stmap64ReadCutOnlyWitness( int i, int * pAigId, int * pNode, float * pNodePressureRatio, float * pCutPressureRatio, float * pSlack, float * pAreaSave, float * pArrivalDelta, float * pArrivalGainMargin, float * pFeedback );
   627	
   628	    nWitnesses = Map_Stmap64CutOnlyWitnessCount();
   629	    if ( nWitnesses <= 0 )
   630	    {
   631	        Abc_Stmap64ClearFinalWitnessScope();
   632	        return;
   633	    }
   634	    if ( pTime == NULL || pTime->pNtk == NULL || !s_fStmap64FinalWitnessScope ||
   635	         pTime->pNtk != s_pStmap64FinalWitnessNtk ||
   636	         pTime->pNtk->vOrigNodeIds == NULL || pTime->pNtk->vOrigNodeIds != s_pStmap64FinalWitnessOrigIds )
   637	    {
   638	        Abc_Stmap64ClearFinalWitnessScope();
   639	        return;
   640	    }
   641	    pNtk = pTime->pNtk;
   642	    printf( "stmap64 final-witness stats: witnesses = %d  final-delay = %.3f\n", nWitnesses, pTime->MaxDelay );
   643	    for ( i = 0; i < nWitnesses; i++ )
   644	    {
   645	        if ( !Map_Stmap64ReadCutOnlyWitness( i, &AigId, &SeedNode, &SeedNodePressure, &SeedCutPressure, &SeedSlack, &SeedAreaSave, &SeedArrivalDelta, &SeedArrivalGainMargin, &SeedFeedback ) )
   646	            continue;
   647	        pBestObj = NULL;
   648	        BestLoad = BestMaxCap = BestLoadRatio = BestCriticality = BestSlack = 0.0;
   649	        Abc_NtkForEachNode( pNtk, pObj, k )
   650	        {
   651	            if ( Abc_Stmap64MappedObjAigId( pNtk, pObj ) != AigId )
   652	                continue;
   653	            LoadRatio = Abc_Stmap64FinalLoadRatio( pTime, pObj, &Load, &MaxCap );
   654	            Criticality = Abc_Stmap64FinalCriticality( pTime, pObj, &Slack );
   655	            if ( pBestObj == NULL || Criticality > BestCriticality || (Criticality == BestCriticality && LoadRatio > BestLoadRatio) )
   656	            {
   657	                pBestObj = pObj;
   658	                BestLoad = Load;
   659	                BestMaxCap = MaxCap;
   660	                BestLoadRatio = LoadRatio;
   661	                BestCriticality = Criticality;
   662	                BestSlack = Slack;
   663	            }
   664	        }
   665	        if ( pBestObj == NULL )
   666	        {
   667	            printf( "stmap64 final-witness: index = %d  aig-id = %d  seed-node = %d  final-node = -1  matched = 0  seed-node-pressure-ratio = %.3f  seed-cut-pressure-ratio = %.3f  seed-slack = %.6f  seed-area-save = %.6f  seed-arrival-delta = %.6f  seed-arrival-gain-margin = %.6f  scl-feedback = %.3f\n",
   668	                i + 1, AigId, SeedNode, SeedNodePressure, SeedCutPressure,
   669	                SeedSlack, SeedAreaSave, SeedArrivalDelta, SeedArrivalGainMargin,
   670	                SeedFeedback );
   671	            continue;
   672	        }
   673	        nMatched++;
   674	        if ( BestCriticality >= 0.50 )
   675	            nCritical++;
   676	        Fanouts = Abc_ObjFanoutNum(pBestObj);
   677	        pGate = (Mio_Gate_t *)pBestObj->pData;
   678	        printf( "stmap64 final-witness: index = %d  aig-id = %d  seed-node = %d  final-node = %d  matched = 1  final-gate = %s  final-fanouts = %d  final-load = %.3f  final-max-cap = %.3f  final-load-ratio = %.3f  final-criticality = %.3f  final-slack = %.6f  seed-node-pressure-ratio = %.3f  seed-cut-pressure-ratio = %.3f  seed-slack = %.6f  seed-area-save = %.6f  seed-arrival-delta = %.6f  seed-arrival-gain-margin = %.6f  scl-feedback = %.3f\n",
   679	            i + 1, AigId, SeedNode, Abc_ObjId(pBestObj), pGate ? Mio_GateReadName(pGate) : "?",
   680	            Fanouts, BestLoad, BestMaxCap, BestLoadRatio, BestCriticality, BestSlack,
   681	            SeedNodePressure, SeedCutPressure, SeedSlack, SeedAreaSave,
   682	            SeedArrivalDelta, SeedArrivalGainMargin, SeedFeedback );
   683	    }
   684	    printf( "stmap64 final-witness summary: witnesses = %d  matched = %d  criticality-ge-0p50 = %d\n", nWitnesses, nMatched, nCritical );
   685	    Abc_Stmap64ClearFinalWitnessScope();
   686	}
