+            {
+                pBestObj = pObj;
+                BestLoad = Load;
+                BestMaxCap = MaxCap;
+                BestLoadRatio = LoadRatio;
+                BestCriticality = Criticality;
+                BestSlack = Slack;
+            }
+        }
+        if ( pBestObj == NULL )
+        {
+            printf( "stmap63 final-witness: index = %d  aig-id = %d  phase = %d  seed-node = %d  final-node = -1  matched = 0  seed-node-pressure-ratio = %.3f  seed-cut-pressure-ratio = %.3f  seed-slack = %.6f  seed-area-save = %.6f  seed-arrival-delta = %.6f  seed-arrival-gain-margin = %.6f  scl-feedback = %.3f\n",
+                i + 1, AigId, SeedPhase, SeedNode, SeedNodePressure, SeedCutPressure,
+                SeedSlack, SeedAreaSave, SeedArrivalDelta, SeedArrivalGainMargin,
+                SeedFeedback );
+            continue;
+        }
+        nMatched++;
+        if ( BestCriticality >= 0.50 )
