+        pBestObj = NULL;
+        BestLoad = BestMaxCap = BestLoadRatio = BestCriticality = BestSlack = 0.0;
+        Abc_NtkForEachNode( pNtk, pObj, k )
+        {
+            if ( Abc_Stmap63MappedObjAigLit( pNtk, pObj ) != SeedLit )
