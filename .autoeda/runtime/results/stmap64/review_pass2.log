        AigId = Abc_Stmap63MappedObjAigId( pNtk, pFanout );
        if ( AigId >= 0 )
        {
            pStats->nHotspotFanout++;
            Abc_Stmap63PressureInsert( pStats, AigId, Abc_ObjId(pFanout), Ratio, FanoutCriticality );
