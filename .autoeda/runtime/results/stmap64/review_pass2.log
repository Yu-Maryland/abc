static void Abc_Stmap64InsertConsumerFanins( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap64LoadStats_t * pStats, float Ratio, float SinkCriticality, int Depth )
{
    Abc_Obj_t * pFanin;
