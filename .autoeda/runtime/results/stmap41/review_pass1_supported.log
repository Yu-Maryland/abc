static void Abc_Stmap41LoadStatsClear( Abc_Stmap41LoadStats_t * pStats )
{
    memset( pStats, 0, sizeof(Abc_Stmap41LoadStats_t) );
}

static void Abc_Stmap41LoadStatsFree( Abc_Stmap41LoadStats_t * pStats )
{
    ABC_FREE( pStats->pAigPressureRatios );
    ABC_FREE( pStats->pAigCriticalPressureRatios );
    pStats->nAigPressureRatios = 0;
}

/**Function*************************************************************

