        if ( pLeaf == NULL )
            continue;
        Ratio = Map_MatchStmap38HotspotLookup( Map_NodeReadAigId( pLeaf ) );
        if ( RatioMax < Ratio )
            RatioMax = Ratio;
    }
    return RatioMax;
}

