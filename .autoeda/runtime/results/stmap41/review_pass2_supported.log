static float Map_MatchStmap38HotspotLookup( int AigId )
{
    int i;
    if ( AigId < 0 || s_Stmap38SclFeedback <= 0.0 || s_pStmap38SclHotspotIds == NULL || s_pStmap38SclHotspotRatios == NULL )
        return 0.0;
    for ( i = 0; i < s_nStmap38SclHotspots; i++ )
