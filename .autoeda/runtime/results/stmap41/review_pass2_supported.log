static float Map_MatchStmap38CutHotspotRatio( Map_Cut_t * pCut )
{
    Map_Node_t * pLeaf;
    float Ratio, RatioMax = 0.0;
    int i;
    if ( pCut == NULL )
        return 0.0;
    for ( i = 0; i < (int)pCut->nLeaves; i++ )
