/**CFile****************************************************************

  FileName    [abcStmap_40.c]

  SystemName  [ABC: Logic synthesis and verification system.]

  PackageName [Versioned AutoEDA standard-cell mapper experiments.]

  Synopsis    [stmap40 command.]

***********************************************************************/

#include "base/abc/abc.h"
#include "base/main/main.h"
#include "map/mio/mio.h"
#include "map/scl/sclLib.h"
#include "misc/extra/extra.h"
#include <string.h>

ABC_NAMESPACE_IMPL_START

#define ABC_STMAP40_TOP_PRESSURES 10
#define ABC_STMAP40_TRACK_AIG_ID 5548

typedef struct Abc_Stmap40LoadStats_t_
{
    int fAvailable;
    int nNodes;
    int nMatched;
    int nPins;
    int nOver;
    int nHotspotRoots;
    int nHotspotFanin;
    int nHotspotFanout;
    int nPressureEntries;
    int nPressureUpdates;
    int nPressureMissed;
    int nAigPressureRatios;
    int TrackedNode;
    float RatioSum;
    float RatioMax;
    float TrackedRatio;
    float * pAigPressureRatios;
    float TopRatios[5];
    float TopLoads[5];
    float TopCaps[5];
    const char * pTopGates[5];
    int TopNodes[5];
    int TopFanouts[5];
    int TopPressureAigIds[ABC_STMAP40_TOP_PRESSURES];
    int TopPressureNodes[ABC_STMAP40_TOP_PRESSURES];
    float TopPressureRatios[ABC_STMAP40_TOP_PRESSURES];
} Abc_Stmap40LoadStats_t;

static void Abc_Stmap40LoadStatsClear( Abc_Stmap40LoadStats_t * pStats )
{
    memset( pStats, 0, sizeof(Abc_Stmap40LoadStats_t) );
}

static void Abc_Stmap40LoadStatsFree( Abc_Stmap40LoadStats_t * pStats )
{
    ABC_FREE( pStats->pAigPressureRatios );
    pStats->nAigPressureRatios = 0;
}

/**Function*************************************************************

  Synopsis    [Inserts one mapped-load diagnostic into the top list.]

  Description []

  SideEffects []

  SeeAlso     []

***********************************************************************/
static void Abc_Stmap40TopInsert( float * pRatios, int * pNodes, const char ** ppGates, int * pFanouts, float * pLoads, float * pCaps, float Ratio, int Node, const char * pGate, int Fanouts, float Load, float Cap )
{
    int i, k;
    if ( Ratio <= pRatios[4] )
        return;
    for ( i = 0; i < 5; i++ )
    {
        if ( Ratio <= pRatios[i] )
            continue;
        for ( k = 4; k > i; k-- )
        {
            pRatios[k] = pRatios[k-1];
            pNodes[k] = pNodes[k-1];
            ppGates[k] = ppGates[k-1];
            pFanouts[k] = pFanouts[k-1];
            pLoads[k] = pLoads[k-1];
            pCaps[k] = pCaps[k-1];
        }
        pRatios[i] = Ratio;
        pNodes[i] = Node;
        ppGates[i] = pGate;
        pFanouts[i] = Fanouts;
        pLoads[i] = Load;
        pCaps[i] = Cap;
        return;
    }
}

static int Abc_Stmap40MappedObjAigId( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj )
{
    int Lit;
    if ( pNtk == NULL || pObj == NULL || pNtk->vOrigNodeIds == NULL )
        return -1;
    if ( Abc_ObjId(pObj) >= Vec_IntSize(pNtk->vOrigNodeIds) )
        return -1;
    Lit = Vec_IntEntry( pNtk->vOrigNodeIds, Abc_ObjId(pObj) );
    return Lit >= 0 ? Abc_Lit2Var(Lit) : -1;
}

static void Abc_Stmap40PressureTopInsert( Abc_Stmap40LoadStats_t * pStats, int AigId, int NodeId, float Ratio )
{
    int i, k;
    if ( Ratio <= pStats->TopPressureRatios[ABC_STMAP40_TOP_PRESSURES-1] )
        return;
    for ( i = 0; i < ABC_STMAP40_TOP_PRESSURES; i++ )
    {
        if ( Ratio <= pStats->TopPressureRatios[i] )
            continue;
        for ( k = ABC_STMAP40_TOP_PRESSURES - 1; k > i; k-- )
        {
            pStats->TopPressureRatios[k] = pStats->TopPressureRatios[k-1];
            pStats->TopPressureAigIds[k] = pStats->TopPressureAigIds[k-1];
            pStats->TopPressureNodes[k] = pStats->TopPressureNodes[k-1];
        }
        pStats->TopPressureRatios[i] = Ratio;
        pStats->TopPressureAigIds[i] = AigId;
        pStats->TopPressureNodes[i] = NodeId;
        return;
    }
}

static int Abc_Stmap40EnsurePressureCapacity( Abc_Stmap40LoadStats_t * pStats, int AigId )
{
    float * pNew;
    int i, nOld, nNew;
    if ( AigId < 0 )
        return 0;
    if ( AigId < pStats->nAigPressureRatios )
        return 1;
    nOld = pStats->nAigPressureRatios;
    nNew = nOld ? nOld : 1024;
    while ( nNew <= AigId )
        nNew *= 2;
    pNew = ABC_REALLOC( float, pStats->pAigPressureRatios, nNew );
    if ( pNew == NULL )
        return 0;
    pStats->pAigPressureRatios = pNew;
    for ( i = nOld; i < nNew; i++ )
        pStats->pAigPressureRatios[i] = 0.0;
    pStats->nAigPressureRatios = nNew;
    return 1;
}

static void Abc_Stmap40PressureInsert( Abc_Stmap40LoadStats_t * pStats, int AigId, int NodeId, float Ratio )
{
    float OldRatio;
    if ( AigId < 0 || Ratio <= 1.0 )
        return;
    if ( AigId == ABC_STMAP40_TRACK_AIG_ID && Ratio > pStats->TrackedRatio )
    {
        pStats->TrackedRatio = Ratio;
        pStats->TrackedNode = NodeId;
    }
    if ( !Abc_Stmap40EnsurePressureCapacity( pStats, AigId ) )
    {
        pStats->nPressureMissed++;
        return;
    }
    OldRatio = pStats->pAigPressureRatios[AigId];
    if ( OldRatio == 0.0 )
        pStats->nPressureEntries++;
    else if ( Ratio > OldRatio )
        pStats->nPressureUpdates++;
    if ( Ratio <= OldRatio )
        return;
    pStats->pAigPressureRatios[AigId] = Ratio;
    Abc_Stmap40PressureTopInsert( pStats, AigId, NodeId, Ratio );
}

static void Abc_Stmap40InsertConsumerFanins( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap40LoadStats_t * pStats, float Ratio, int Depth )
{
    Abc_Obj_t * pFanin;
    int i, AigId;
    if ( pObj == NULL || Ratio <= 1.0 || Depth <= 0 )
        return;
    Abc_ObjForEachFanin( pObj, pFanin, i )
    {
        AigId = Abc_Stmap40MappedObjAigId( pNtk, pFanin );
        if ( AigId >= 0 )
        {
            pStats->nHotspotFanin++;
            Abc_Stmap40PressureInsert( pStats, AigId, Abc_ObjId(pFanin), Ratio );
        }
        Abc_Stmap40InsertConsumerFanins( pNtk, pFanin, pStats, 0.78 * Ratio, Depth - 1 );
    }
}

static void Abc_Stmap40CollectHotspotCone( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap40LoadStats_t * pStats, float Ratio )
{
    Abc_Obj_t * pFanout, * pFanout2;
    int i, k, AigId;
    if ( Ratio <= 1.0 )
        return;
    AigId = Abc_Stmap40MappedObjAigId( pNtk, pObj );
    if ( AigId >= 0 )
    {
        pStats->nHotspotRoots++;
        Abc_Stmap40PressureInsert( pStats, AigId, Abc_ObjId(pObj), 0.90 * Ratio );
    }
    Abc_ObjForEachFanout( pObj, pFanout, i )
    {
        AigId = Abc_Stmap40MappedObjAigId( pNtk, pFanout );
        if ( AigId >= 0 )
        {
            pStats->nHotspotFanout++;
            Abc_Stmap40PressureInsert( pStats, AigId, Abc_ObjId(pFanout), Ratio );
        }
        Abc_Stmap40InsertConsumerFanins( pNtk, pFanout, pStats, 0.86 * Ratio, 3 );
        Abc_ObjForEachFanout( pFanout, pFanout2, k )
        {
            AigId = Abc_Stmap40MappedObjAigId( pNtk, pFanout2 );
            if ( AigId < 0 )
                continue;
            pStats->nHotspotFanout++;
            Abc_Stmap40PressureInsert( pStats, AigId, Abc_ObjId(pFanout2), 0.66 * Ratio );
        }
    }
}

/**Function*************************************************************

  Synopsis    [Returns direct SCL input-pin load driven by a mapped node.]

  Description []

  SideEffects []

  SeeAlso     []

***********************************************************************/
static float Abc_Stmap40FanoutLoad( SC_Lib * pLib, Abc_Obj_t * pObj, int * pFanouts, int * pPins )
{
    Abc_Obj_t * pFanout;
    Mio_Gate_t * pGateFan;
    SC_Cell * pCellFan;
    float Load = 0.0;
    int i, iFanin, CellId;
    *pFanouts = 0;
    *pPins = 0;
    Abc_ObjForEachFanout( pObj, pFanout, i )
    {
        (*pFanouts)++;
        if ( !Abc_ObjIsNode(pFanout) || pFanout->pData == NULL )
            continue;

