  CFLAGS += -DABC_USE_PTHREADS
  LIBS += -lpthread
  $(call abc_info,$(MSG_PREFIX)Using pthreads)
endif

# whether to compile into position independent code
ifdef ABC_USE_PIC
  CFLAGS += -fPIC
  LIBS += -fPIC
  $(call abc_info,$(MSG_PREFIX)Compiling position independent code)
endif

