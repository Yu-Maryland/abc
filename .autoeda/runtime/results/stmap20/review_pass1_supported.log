  Synopsis    [Returns 1 if the node is shallow enough for a stmap20 seed.]

  Description []

  SideEffects []

  SeeAlso     []

***********************************************************************/
static int Map_MatchNodeHasStmap20EarlySeedDepth( Map_Node_t * pNode )
