    float Gain = 250; // base SCL/genlib gain for low and moderate pressure
    float LowGain, SelectedGain;
    int nGatesMin = 0;
    int fAreaOnly;
    int fRecovery;
    int fSweep;
    int fSwitching;
    int fSkipFanout;
    int fUseProfile;
    int fUseBuffs;
    int fVerbose;
