    29	extern int Map_Stmap60NearMissLeafDiagEnabled( void );
    30	extern int Map_Stmap60NearMissLeafDiagTarget( void );
    31	extern int Map_Stmap61CutOnlyGateDiagEnabled( void );
    32	extern int Map_Stmap61CutOnlyGateDiagTarget( void );
