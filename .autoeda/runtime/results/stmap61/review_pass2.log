    34	////////////////////////////////////////////////////////////////////////
    35	///                     FUNCTION DEFINITIONS                         ///
    36	////////////////////////////////////////////////////////////////////////
    37	
    38	/**Function*************************************************************
    39	
    40	  Synopsis    [Performs technology mapping for the given object graph.]
    41	
    42	  Description [The object graph is stored in the mapping manager.
    43	  First, the AND nodes that fanout into POs are collected in the DFS order.
    44	  Two preprocessing steps are performed: the k-feasible cuts are computed 
    45	  for each node and the truth tables are computed for each cut. Next, the 
    46	  delay-optimal matches are assigned for each node, followed by several 
    47	  iterations of area recoveryd: using area flow (global optimization) 
    48	  and using exact area at a node (local optimization).]
    49	               
    50	  SideEffects []
    51	
    52	  SeeAlso     []
    53	
    54	***********************************************************************/
    55	int Map_Mapping( Map_Man_t * p )
    56	{
    57	    int fShowSwitching         = 0;
    58	    int fUseAreaFlow           = 1;
    59	    int fUseExactArea          = !p->fSwitching;
    60	    int fUseExactAreaWithPhase = !p->fSwitching;
    61	    abctime clk;
    62	
    63	    //////////////////////////////////////////////////////////////////////
    64	    // perform pre-mapping computations
    65	    if ( p->fVerbose )
    66	        Map_MappingReportChoices( p ); 
    67	    Map_MappingSetChoiceLevels( p ); // should always be called before mapping!
    68	//    return 1;
    69	
    70	    // compute the cuts of nodes in the DFS order
    71	    clk = Abc_Clock();
    72	    Map_MappingCuts( p );
    73	    p->timeCuts = Abc_Clock() - clk;
    74	    // derive the truth tables 
    75	    clk = Abc_Clock();
    76	    Map_MappingTruths( p );
    77	    p->timeTruth = Abc_Clock() - clk;
    78	    //////////////////////////////////////////////////////////////////////
    79	//ABC_PRT( "Truths", Abc_Clock() - clk );
    80	

