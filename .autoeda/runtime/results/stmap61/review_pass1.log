  1547	static int Map_MatchStmap45HasPressureAgreement( float NodePressureRatio, float CutPressureRatio )
  1548	{
  1549	    float PressureSpread;
  1550	    if ( s_Stmap45SclFeedback <= 0.0 || NodePressureRatio <= 1.75 || CutPressureRatio <= 1.75 )
  1551	        return 0;
  1552	    PressureSpread = NodePressureRatio > CutPressureRatio ? NodePressureRatio / CutPressureRatio : CutPressureRatio / NodePressureRatio;
  1553	    return PressureSpread <= 1.25;
  1554	}
