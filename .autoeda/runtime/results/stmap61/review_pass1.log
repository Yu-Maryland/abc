  1556	static const char * Map_MatchStmap61CutOnlyFirstBlocker( int fModerateSoftSeed, int fModeratePenaltyCandidate, int fPressureAgreement, int fPressureNear, int fFeedbackGate, int fEntryGate, int fModerateGainGate, int fNodeZeroGate, int fCutBandGate, int fArrivalStrongGate, int fSlackGate, int fAreaCapGate )
