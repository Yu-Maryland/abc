        }
    }

    Abc_Stmap65CollectSclLoadStats( pNtkRes, &LoadStats );
    Abc_Stmap65PrintSclLoadStats( "scl-load", &LoadStats );
    Abc_Stmap65LoadStatsFree( &LoadStats );
    Abc_FrameReplaceCurrentNetwork( pAbc, pNtkRes );
    return 0;

usage:
