+static void Abc_Stmap65LoadStatsClear( Abc_Stmap65LoadStats_t * pStats )
+{
+    memset( pStats, 0, sizeof(Abc_Stmap65LoadStats_t) );
+    pStats->TrackedNode = -1;
+}
