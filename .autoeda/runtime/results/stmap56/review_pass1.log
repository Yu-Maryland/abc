    Abc_Stmap55PrintSclLoadStats( "scl-load", &LoadStats );
    Abc_Stmap55LoadStatsFree( &LoadStats );
    Abc_FrameReplaceCurrentNetwork( pAbc, pNtkRes );
    return 0;

usage:
