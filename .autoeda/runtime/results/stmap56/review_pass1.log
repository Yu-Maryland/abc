static float Map_MatchStmap44NodePressureRatio( Map_Node_t * pNode, int * pAigId )
{
    int AigId;
    if ( pAigId )
        *pAigId = -1;
    if ( pNode == NULL || pNode->Num < 0 )
        return 0.0;
