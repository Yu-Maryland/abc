   430	        pStats->TrackedRatio, pStats->TrackedSinkRatio );
   431	    for ( i = 0; i < ABC_STMAP56_TOP_PRESSURES && pStats->TopPressureRatios[i] > 0.0; i++ )
   432	        printf( "stmap56 sink-pressure: rank = %d  aig-id = %d  mapped-node = %d  sink-pressure-ratio = %.3f\n",
