   177	static float Abc_Stmap49ObjCriticality( SC_Man * pTime, Abc_Obj_t * pObj )
   178	{
   179	    float Slack, Window, Criticality;
   180	    if ( pTime == NULL || pObj == NULL || pTime->MaxDelay <= 0.0 )
   181	        return 0.0;
   182	    if ( Abc_ObjId(pObj) < 0 || Abc_ObjId(pObj) >= pTime->nObjs )
   183	        return 0.0;
   184	    Slack = Abc_SclObjGetSlack( pTime, pObj, pTime->MaxDelay );
   185	    if ( Slack < 0.0 )
   186	        Slack = 0.0;
   187	    Window = 0.18 * pTime->MaxDelay;
   188	    if ( Window < 10.0 )
   189	        Window = 10.0;
   190	    Criticality = 1.0 - Slack / Window;
   191	    if ( Criticality < 0.0 )
   192	        return 0.0;
   193	    return Criticality > 1.0 ? 1.0 : Criticality;
   194	}
   195	
   196	static void Abc_Stmap49PressureInsert( Abc_Stmap49LoadStats_t * pStats, int AigId, int NodeId, float Ratio, float SinkCriticality )
   197	{
   198	    float OldRatio, OldSinkRatio, SinkWeight, SinkRatio;
   199	    if ( AigId < 0 || Ratio <= 1.0 )
   200	        return;
   201	    if ( SinkCriticality < 0.0 )
   202	        SinkCriticality = 0.0;
   203	    if ( SinkCriticality > 1.0 )
   204	        SinkCriticality = 1.0;
   205	    SinkWeight = 0.35 + 0.65 * SinkCriticality;
   206	    SinkRatio = 1.0 + (Ratio - 1.0) * SinkWeight;
   207	    if ( AigId == ABC_STMAP49_TRACK_AIG_ID && Ratio > pStats->TrackedRatio )
   208	    {
   209	        pStats->TrackedRatio = Ratio;
   210	        pStats->TrackedNode = NodeId;
   211	    }
   212	    if ( AigId == ABC_STMAP49_TRACK_AIG_ID && SinkRatio > pStats->TrackedSinkRatio )
   213	        pStats->TrackedSinkRatio = SinkRatio;
   214	    if ( !Abc_Stmap49EnsurePressureCapacity( pStats, AigId ) )
   215	    {
   216	        pStats->nPressureMissed++;
   217	        return;
   218	    }
   219	    OldRatio = pStats->pAigPressureRatios[AigId];
   220	    OldSinkRatio = pStats->pAigSinkPressureRatios[AigId];
   221	    if ( OldRatio == 0.0 )
   222	        pStats->nPressureEntries++;
   223	    else if ( Ratio > OldRatio )
   224	        pStats->nPressureUpdates++;
   225	    if ( Ratio > OldRatio )
   226	        pStats->pAigPressureRatios[AigId] = Ratio;
   227	    if ( SinkRatio <= 1.0 || SinkRatio <= OldSinkRatio )
   228	        return;
   229	    if ( OldSinkRatio == 0.0 )
   230	        pStats->nSinkPressureEntries++;
   231	    else
   232	        pStats->nSinkPressureUpdates++;
   233	    pStats->pAigSinkPressureRatios[AigId] = SinkRatio;
   234	    Abc_Stmap49PressureTopInsert( pStats, AigId, NodeId, SinkRatio );
   235	}
