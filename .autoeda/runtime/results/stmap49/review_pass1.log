   609	            break;
   610	        case 'h':
   611	            goto usage;
   612	        default:
   613	            goto usage;
   614	        }
   615	    }
   616	
   617	    if ( pNtk == NULL )
   618	    {
   619	        Abc_Print( -1, "Empty network.\n" );
   620	        return 1;
   621	    }
   622	
   623	    if ( fAreaOnly )
   624	        DelayTarget = ABC_INFINITY;
   625	
   626	    Map_Stmap45SetSclLoadFeedback( 0.0, 0.0, 0.0, NULL, 0 );
   627	    pNtkMap = pNtk;
   628	    if ( !Abc_NtkIsStrash(pNtk) )
   629	    {
   630	        pNtkMap = Abc_NtkStrash( pNtk, 0, 0, 0 );
   631	        if ( pNtkMap == NULL )
