   640	            Abc_Print( -1, "Balancing before stmap49 has failed.\n" );
   641	            return 1;
   642	        }
   643	        fTempMap = 1;
   644	        Abc_Print( 0, "The network was strashed and balanced before stmap49.\n" );
   645	    }
   646	
   647	    if ( fSkipFanout )
   648	    {
   649	        pNtkFirst = Abc_NtkMap( pNtkMap, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, Gain, nGatesMin, fRecovery, fSwitching, 36, fUseProfile, fUseBuffs, fVerbose );
   650	        if ( pNtkFirst == NULL )
   651	        {
   652	            if ( fTempMap )
   653	                Abc_NtkDelete( pNtkMap );
   654	            Abc_Print( -1, "stmap49 has failed.\n" );
   655	            return 1;
   656	        }
   657	        Abc_Stmap49CollectSclLoadStats( pNtkFirst, &LoadStats );
   658	        Abc_Stmap49PrintSclLoadStats( "feedback-load", &LoadStats );
   659	        Abc_Stmap49PrintHotspots( &LoadStats );
   660	        OverFrac = LoadStats.nMatched ? (float)LoadStats.nOver / (float)LoadStats.nMatched : 0.0;
   661	        Feedback = Abc_Stmap49FeedbackSeverity( &LoadStats );
   662	        LowGain = 0.90 * Gain;
   663	        SelectedGain = Gain;
   664	        fUseReducedGain = Feedback >= 0.85 && LoadStats.nSinkPressureEntries >= 8000;
   665	        if ( fUseReducedGain && LowGain > 0.0 )
   666	            SelectedGain = LowGain;
   667	        printf( "stmap49 feedback: remap = 1  active = %d  max-load-ratio = %.3f  over-max-frac = %.6f  severity = %.3f  raw-pressure-entries = %d  sink-pressure-entries = %d  pressure-capacity = %d\n",
   668	            Feedback > 0.0 && LoadStats.nSinkPressureEntries > 0, LoadStats.RatioMax, OverFrac,
   669	            Feedback, LoadStats.nPressureEntries, LoadStats.nSinkPressureEntries,
   670	            LoadStats.nAigPressureRatios );
   671	        printf( "stmap49 blended-gain: base-gain = %.2f  blend-gain = %.2f  selected-gain = %.2f  severity-threshold = 0.850  sink-pressure-threshold = 8000  selected-blend-gain = %d\n",
   672	            Gain, LowGain, SelectedGain, fUseReducedGain );
   673	        printf( "stmap49 mapper-mode: reused-stmap45-mode = 46  blended-gain = %.2f\n", SelectedGain );
   674	        Abc_NtkDelete( pNtkFirst );
   675	        Map_Stmap45SetSclLoadFeedback( LoadStats.RatioMax, OverFrac, Feedback, LoadStats.pAigSinkPressureRatios, LoadStats.nAigPressureRatios );
   676	        pNtkRes = Abc_NtkMap( pNtkMap, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, SelectedGain, nGatesMin, fRecovery, fSwitching, 46, fUseProfile, fUseBuffs, fVerbose );
   677	        Map_Stmap45SetSclLoadFeedback( 0.0, 0.0, 0.0, NULL, 0 );
   678	        Abc_Stmap49LoadStatsFree( &LoadStats );
   679	        if ( pNtkRes == NULL )
