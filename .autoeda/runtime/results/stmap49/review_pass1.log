   452	/**Function*************************************************************
   453	
   454	  Synopsis    [Runs the stmap49 mapper probe.]
   455	
   456	  Description [stmap49 measures direct SCL load/max-cap pressure after an
   457	  initial base-gain map, then reuses the stmap45 pressure-agreement mapper
   458	  mode with an intermediate SCL/genlib gain only for high-severity, large
   459	  pressure cases. The hypothesis is that the severe-pressure path can recover
   460	  most of the stmap48 timing win while spending less area than the 0.80 gain
   461	  drop.]
   462	
   463	  SideEffects []
   464	
   465	  SeeAlso     []
   466	
   467	***********************************************************************/
   468	int Abc_CommandStmap49( Abc_Frame_t * pAbc, int argc, char ** argv )
   469	{
   470	    Abc_Ntk_t * pNtk, * pNtkMap, * pNtkRes, * pNtkFirst;
   471	    Abc_Stmap49LoadStats_t LoadStats;
   472	    char Buffer[100];
   473	    double DelayTarget;
   474	    double AreaMulti;
   475	    double DelayMulti;
   476	    float LogFan = 0;
   477	    float Slew = 0; // choose based on the library
   478	    float Gain = 250; // base SCL/genlib gain for low and moderate pressure
   479	    float LowGain, SelectedGain;
   480	    int nGatesMin = 0;
   481	    int fAreaOnly;
   482	    int fRecovery;
   483	    int fSweep;
   484	    int fSwitching;
   485	    int fSkipFanout;
   486	    int fUseProfile;
   487	    int fUseBuffs;
   488	    int fVerbose;
   489	    int c, fTempMap = 0;
   490	    int fUseReducedGain;
   491	    float OverFrac, Feedback;
   492	    extern Abc_Ntk_t * Abc_NtkMap( Abc_Ntk_t * pNtk, Mio_Library_t* userLib, double DelayTarget, double AreaMulti, double DelayMulti, float LogFan, float Slew, float Gain, int nGatesMin, int fRecovery, int fSwitching, int fSkipFanout, int fUseProfile, int fUseBuffs, int fVerbose );
   493	    extern int Abc_NtkFraigSweep( Abc_Ntk_t * pNtk, int fUseInv, int fExdc, int fVerbose, int fVeryVerbose );
   494	    extern void Map_Stmap45SetSclLoadFeedback( float MaxLoadRatio, float OverFrac, float Severity, float * pAigPressureRatios, int nAigPressureRatios );
   495	
   496	    pNtk = Abc_FrameReadNtk(pAbc);
   497	    DelayTarget = -1;
   498	    AreaMulti   = 0;
   499	    DelayMulti  = 0;
   500	    fAreaOnly   = 0;
   501	    fRecovery   = 1;
   502	    fSweep      = 0;
   503	    fSwitching  = 0;
   504	    fSkipFanout = 46; // stmap45 agreement-admitted mapper mode with blended SCL gain; -f disables it
   505	    fUseProfile = 0;
   506	    fUseBuffs   = 0;
   507	    fVerbose    = 0;
   508	    Extra_UtilGetoptReset();
   509	    while ( ( c = Extra_UtilGetopt( argc, argv, "DABFSGMarspfuovh" ) ) != EOF )
   510	    {
   511	        switch ( c )
   512	        {
   513	        case 'D':
   514	            if ( globalUtilOptind >= argc )
   515	            {
   516	                Abc_Print( -1, "Command line switch \"-D\" should be followed by a floating point number.\n" );
   517	                goto usage;
   518	            }
   519	            DelayTarget = (float)atof(argv[globalUtilOptind]);
   520	            globalUtilOptind++;
   521	            if ( DelayTarget <= 0.0 )
   522	                goto usage;
   523	            break;
   524	        case 'A':
   525	            if ( globalUtilOptind >= argc )
   526	            {
   527	                Abc_Print( -1, "Command line switch \"-A\" should be followed by a floating point number.\n" );
   528	                goto usage;
   529	            }
   530	            AreaMulti = (float)atof(argv[globalUtilOptind]);
   531	            globalUtilOptind++;
   532	            break;
   533	        case 'B':
   534	            if ( globalUtilOptind >= argc )
   535	            {
   536	                Abc_Print( -1, "Command line switch \"-B\" should be followed by a floating point number.\n" );
   537	                goto usage;
   538	            }
   539	            DelayMulti = (float)atof(argv[globalUtilOptind]);
   540	            globalUtilOptind++;
   541	            break;
   542	        case 'F':
   543	            if ( globalUtilOptind >= argc )
   544	            {
   545	                Abc_Print( -1, "Command line switch \"-F\" should be followed by a floating point number.\n" );
   546	                goto usage;
   547	            }
   548	            LogFan = (float)atof(argv[globalUtilOptind]);
   549	            globalUtilOptind++;
   550	            if ( LogFan < 0.0 )
   551	                goto usage;
   552	            break;
   553	        case 'S':
   554	            if ( globalUtilOptind >= argc )
   555	            {
   556	                Abc_Print( -1, "Command line switch \"-S\" should be followed by a floating point number.\n" );
   557	                goto usage;
   558	            }
   559	            Slew = (float)atof(argv[globalUtilOptind]);
   560	            globalUtilOptind++;
   561	            if ( Slew <= 0.0 )
   562	                goto usage;
   563	            break;
   564	        case 'G':
   565	            if ( globalUtilOptind >= argc )
   566	            {
   567	                Abc_Print( -1, "Command line switch \"-G\" should be followed by a floating point number.\n" );
   568	                goto usage;
   569	            }
   570	            Gain = (float)atof(argv[globalUtilOptind]);
   571	            globalUtilOptind++;
   572	            if ( Gain <= 0.0 )
   573	                goto usage;
   574	            break;
   575	        case 'M':
   576	            if ( globalUtilOptind >= argc )
   577	            {
   578	                Abc_Print( -1, "Command line switch \"-M\" should be followed by a positive integer.\n" );
   579	                goto usage;
   580	            }
   581	            nGatesMin = atoi(argv[globalUtilOptind]);
   582	            globalUtilOptind++;
   583	            if ( nGatesMin < 0 )
   584	                goto usage;
   585	            break;
   586	        case 'a':
