   589	        case 'r':
   590	            fRecovery ^= 1;
   591	            break;
   592	        case 's':
   593	            fSweep ^= 1;
   594	            break;
   595	        case 'p':
   596	            fSwitching ^= 1;
   597	            break;
   598	        case 'f':
