   419	static void Abc_Stmap49PrintHotspots( Abc_Stmap49LoadStats_t * pStats )
   420	{
   421	    int i;
   422	    if ( !pStats->fAvailable )
   423	        return;
   424	    printf( "stmap49 sink-pressure stats: roots = %d  consumer-fanin = %d  consumer-fanout = %d  raw-pressure-entries = %d  raw-pressure-updates = %d  sink-pressure-entries = %d  sink-pressure-updates = %d  pressure-missed = %d  pressure-capacity = %d  tracked-aig = %d  tracked-node = %d  tracked-raw-ratio = %.3f  tracked-sink-ratio = %.3f\n",
   425	        pStats->nHotspotRoots, pStats->nHotspotFanin, pStats->nHotspotFanout,
   426	        pStats->nPressureEntries, pStats->nPressureUpdates,
   427	        pStats->nSinkPressureEntries, pStats->nSinkPressureUpdates,
   428	        pStats->nPressureMissed,
   429	        pStats->nAigPressureRatios, ABC_STMAP49_TRACK_AIG_ID, pStats->TrackedNode,
   430	        pStats->TrackedRatio, pStats->TrackedSinkRatio );
   431	    for ( i = 0; i < ABC_STMAP49_TOP_PRESSURES && pStats->TopPressureRatios[i] > 0.0; i++ )
   432	        printf( "stmap49 sink-pressure: rank = %d  aig-id = %d  mapped-node = %d  sink-pressure-ratio = %.3f\n",
   433	            i + 1, pStats->TopPressureAigIds[i], pStats->TopPressureNodes[i], pStats->TopPressureRatios[i] );
   434	}
   435	
   436	static float Abc_Stmap49FeedbackSeverity( Abc_Stmap49LoadStats_t * pStats )
   437	{
   438	    float OverFrac, MaxPart, OverPart, Severity;
   439	    if ( !pStats->fAvailable || pStats->nMatched == 0 )
   440	        return 0.0;
   441	    OverFrac = (float)pStats->nOver / (float)pStats->nMatched;
   442	    MaxPart = pStats->RatioMax > 4.0 ? (pStats->RatioMax - 4.0) / 8.0 : 0.0;
   443	    OverPart = OverFrac > 0.002 ? (OverFrac - 0.002) / 0.006 : 0.0;
   444	    if ( MaxPart > 1.0 )
   445	        MaxPart = 1.0;
   446	    if ( OverPart > 1.0 )
   447	        OverPart = 1.0;
   448	    Severity = 0.65 * MaxPart + 0.35 * OverPart;
   449	    return Severity > 1.0 ? 1.0 : Severity;
   450	}
