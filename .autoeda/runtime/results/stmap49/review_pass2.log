   120	    if ( Abc_ObjId(pObj) >= Vec_IntSize(pNtk->vOrigNodeIds) )
   121	        return -1;
   122	    Lit = Vec_IntEntry( pNtk->vOrigNodeIds, Abc_ObjId(pObj) );
   123	    return Lit >= 0 ? Abc_Lit2Var(Lit) : -1;
   124	}
   125	
   126	static void Abc_Stmap49PressureTopInsert( Abc_Stmap49LoadStats_t * pStats, int AigId, int NodeId, float Ratio )
   127	{
   128	    int i, k;
   129	    if ( Ratio <= pStats->TopPressureRatios[ABC_STMAP49_TOP_PRESSURES-1] )
   130	        return;
   131	    for ( i = 0; i < ABC_STMAP49_TOP_PRESSURES; i++ )
   132	    {
   133	        if ( Ratio <= pStats->TopPressureRatios[i] )
   134	            continue;
   135	        for ( k = ABC_STMAP49_TOP_PRESSURES - 1; k > i; k-- )
   136	        {
   137	            pStats->TopPressureRatios[k] = pStats->TopPressureRatios[k-1];
   138	            pStats->TopPressureAigIds[k] = pStats->TopPressureAigIds[k-1];
   139	            pStats->TopPressureNodes[k] = pStats->TopPressureNodes[k-1];
   140	        }
   141	        pStats->TopPressureRatios[i] = Ratio;
   142	        pStats->TopPressureAigIds[i] = AigId;
   143	        pStats->TopPressureNodes[i] = NodeId;
   144	        return;
   145	    }
   146	}
   147	
   148	static int Abc_Stmap49EnsurePressureCapacity( Abc_Stmap49LoadStats_t * pStats, int AigId )
   149	{
   150	    float * pNew, * pNewSink;
   151	    int i, nOld, nNew;
   152	    if ( AigId < 0 )
   153	        return 0;
   154	    if ( AigId < pStats->nAigPressureRatios )
   155	        return 1;
   156	    nOld = pStats->nAigPressureRatios;
   157	    nNew = nOld ? nOld : 1024;
   158	    while ( nNew <= AigId )
   159	        nNew *= 2;
   160	    pNew = ABC_REALLOC( float, pStats->pAigPressureRatios, nNew );
   161	    if ( pNew == NULL )
   162	        return 0;
   163	    pStats->pAigPressureRatios = pNew;
   164	    pNewSink = ABC_REALLOC( float, pStats->pAigSinkPressureRatios, nNew );
   165	    if ( pNewSink == NULL )
   166	        return 0;
   167	    pStats->pAigSinkPressureRatios = pNewSink;
   168	    for ( i = nOld; i < nNew; i++ )
   169	    {
   170	        pStats->pAigPressureRatios[i] = 0.0;
   171	        pStats->pAigSinkPressureRatios[i] = 0.0;
   172	    }
   173	    pStats->nAigPressureRatios = nNew;
   174	    return 1;
   175	}
   176	
   177	static float Abc_Stmap49ObjCriticality( SC_Man * pTime, Abc_Obj_t * pObj )
   178	{
   179	    float Slack, Window, Criticality;
   180	    if ( pTime == NULL || pObj == NULL || pTime->MaxDelay <= 0.0 )
   181	        return 0.0;
   182	    if ( Abc_ObjId(pObj) < 0 || Abc_ObjId(pObj) >= pTime->nObjs )
   183	        return 0.0;
   184	    Slack = Abc_SclObjGetSlack( pTime, pObj, pTime->MaxDelay );
   185	    if ( Slack < 0.0 )
   186	        Slack = 0.0;
   187	    Window = 0.18 * pTime->MaxDelay;
   188	    if ( Window < 10.0 )
   189	        Window = 10.0;
   190	    Criticality = 1.0 - Slack / Window;
   191	    if ( Criticality < 0.0 )
   192	        return 0.0;
   193	    return Criticality > 1.0 ? 1.0 : Criticality;
   194	}
   195	
   196	static void Abc_Stmap49PressureInsert( Abc_Stmap49LoadStats_t * pStats, int AigId, int NodeId, float Ratio, float SinkCriticality )
   197	{
   198	    float OldRatio, OldSinkRatio, SinkWeight, SinkRatio;
   199	    if ( AigId < 0 || Ratio <= 1.0 )
   200	        return;
   201	    if ( SinkCriticality < 0.0 )
   202	        SinkCriticality = 0.0;
   203	    if ( SinkCriticality > 1.0 )
   204	        SinkCriticality = 1.0;
   205	    SinkWeight = 0.35 + 0.65 * SinkCriticality;
   206	    SinkRatio = 1.0 + (Ratio - 1.0) * SinkWeight;
   207	    if ( AigId == ABC_STMAP49_TRACK_AIG_ID && Ratio > pStats->TrackedRatio )
   208	    {
   209	        pStats->TrackedRatio = Ratio;
   210	        pStats->TrackedNode = NodeId;
   211	    }
   212	    if ( AigId == ABC_STMAP49_TRACK_AIG_ID && SinkRatio > pStats->TrackedSinkRatio )
   213	        pStats->TrackedSinkRatio = SinkRatio;
   214	    if ( !Abc_Stmap49EnsurePressureCapacity( pStats, AigId ) )
   215	    {
   216	        pStats->nPressureMissed++;
   217	        return;
   218	    }
   219	    OldRatio = pStats->pAigPressureRatios[AigId];
   220	    OldSinkRatio = pStats->pAigSinkPressureRatios[AigId];
   221	    if ( OldRatio == 0.0 )
   222	        pStats->nPressureEntries++;
   223	    else if ( Ratio > OldRatio )
   224	        pStats->nPressureUpdates++;
   225	    if ( Ratio > OldRatio )
   226	        pStats->pAigPressureRatios[AigId] = Ratio;
   227	    if ( SinkRatio <= 1.0 || SinkRatio <= OldSinkRatio )
   228	        return;
   229	    if ( OldSinkRatio == 0.0 )
   230	        pStats->nSinkPressureEntries++;
   231	    else
   232	        pStats->nSinkPressureUpdates++;
   233	    pStats->pAigSinkPressureRatios[AigId] = SinkRatio;
   234	    Abc_Stmap49PressureTopInsert( pStats, AigId, NodeId, SinkRatio );
   235	}
   236	
   237	static void Abc_Stmap49InsertConsumerFanins( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap49LoadStats_t * pStats, float Ratio, float SinkCriticality, int Depth )
   238	{
   239	    Abc_Obj_t * pFanin;
   240	    int i, AigId;
   241	    if ( pObj == NULL || Ratio <= 1.0 || Depth <= 0 )
   242	        return;
   243	    Abc_ObjForEachFanin( pObj, pFanin, i )
   244	    {
   245	        AigId = Abc_Stmap49MappedObjAigId( pNtk, pFanin );
   246	        if ( AigId >= 0 )
   247	        {
   248	            pStats->nHotspotFanin++;
   249	            Abc_Stmap49PressureInsert( pStats, AigId, Abc_ObjId(pFanin), Ratio, SinkCriticality );
   250	        }
   251	        Abc_Stmap49InsertConsumerFanins( pNtk, pFanin, pStats, 0.78 * Ratio, SinkCriticality, Depth - 1 );
   252	    }
   253	}
   254	
   255	static void Abc_Stmap49CollectHotspotCone( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap49LoadStats_t * pStats, SC_Man * pTime, float Ratio )
   256	{
   257	    Abc_Obj_t * pFanout, * pFanout2;
   258	    float FanoutCriticality;
   259	    int i, k, AigId;
   260	    if ( Ratio <= 1.0 )
   261	        return;
   262	    AigId = Abc_Stmap49MappedObjAigId( pNtk, pObj );
   263	    if ( AigId >= 0 )
   264	    {
   265	        pStats->nHotspotRoots++;
   266	        Abc_Stmap49PressureInsert( pStats, AigId, Abc_ObjId(pObj), 0.90 * Ratio, Abc_Stmap49ObjCriticality( pTime, pObj ) );
   267	    }
   268	    Abc_ObjForEachFanout( pObj, pFanout, i )
   269	    {
   270	        FanoutCriticality = Abc_Stmap49ObjCriticality( pTime, pFanout );
   271	        AigId = Abc_Stmap49MappedObjAigId( pNtk, pFanout );
   272	        if ( AigId >= 0 )
   273	        {
   274	            pStats->nHotspotFanout++;
   275	            Abc_Stmap49PressureInsert( pStats, AigId, Abc_ObjId(pFanout), Ratio, FanoutCriticality );
   276	        }
   277	        Abc_Stmap49InsertConsumerFanins( pNtk, pFanout, pStats, 0.86 * Ratio, FanoutCriticality, 3 );
   278	        Abc_ObjForEachFanout( pFanout, pFanout2, k )
   279	        {
   280	            FanoutCriticality = Abc_Stmap49ObjCriticality( pTime, pFanout2 );
   281	            AigId = Abc_Stmap49MappedObjAigId( pNtk, pFanout2 );
   282	            if ( AigId < 0 )
   283	                continue;
   284	            pStats->nHotspotFanout++;
   285	            Abc_Stmap49PressureInsert( pStats, AigId, Abc_ObjId(pFanout2), 0.66 * Ratio, FanoutCriticality );
   286	        }
   287	    }
   288	}
   289	
   290	/**Function*************************************************************
   291	
   292	  Synopsis    [Returns direct SCL input-pin load driven by a mapped node.]
   293	
   294	  Description []
   295	
   296	  SideEffects []
   297	
   298	  SeeAlso     []
   299	
   300	***********************************************************************/
   301	static float Abc_Stmap49FanoutLoad( SC_Lib * pLib, Abc_Obj_t * pObj, int * pFanouts, int * pPins )
   302	{
   303	    Abc_Obj_t * pFanout;
   304	    Mio_Gate_t * pGateFan;
   305	    SC_Cell * pCellFan;
   306	    float Load = 0.0;
   307	    int i, iFanin, CellId;
   308	    *pFanouts = 0;
   309	    *pPins = 0;
   310	    Abc_ObjForEachFanout( pObj, pFanout, i )
   311	    {
   312	        (*pFanouts)++;
   313	        if ( !Abc_ObjIsNode(pFanout) || pFanout->pData == NULL )
   314	            continue;
   315	        iFanin = Abc_NodeFindFanin( pFanout, pObj );
   316	        if ( iFanin < 0 )
   317	            continue;
   318	        pGateFan = (Mio_Gate_t *)pFanout->pData;
   319	        CellId = Abc_SclCellFind( pLib, Mio_GateReadName(pGateFan) );
   320	        if ( CellId < 0 )
   321	            continue;
   322	        pCellFan = SC_LibCell( pLib, CellId );
   323	        if ( pCellFan == NULL || iFanin >= pCellFan->n_inputs )
   324	            continue;
   325	        Load += SC_CellPinCap( pCellFan, iFanin );
   326	        (*pPins)++;
   327	    }
   328	    return Load;
   329	}
   330	
   331	/**Function*************************************************************
   332	
   333	  Synopsis    [Prints direct SCL load diagnostics for the mapped network.]
   334	
   335	  Description []
   336	
   337	  SideEffects []
   338	
   339	  SeeAlso     []
   340	
   341	***********************************************************************/
   342	static void Abc_Stmap49CollectSclLoadStats( Abc_Ntk_t * pNtk, Abc_Stmap49LoadStats_t * pStats )
   343	{
   344	    SC_Lib * pLib = (SC_Lib *)Abc_FrameReadLibScl();
   345	    SC_Man * pTime = NULL;
   346	    Abc_Obj_t * pObj;
   347	    Mio_Gate_t * pGate;
   348	    SC_Cell * pCell;
   349	    float Load, MaxCap, Ratio, Criticality;
   350	    int i, CellId, Fanouts, Pins;
   351	    Abc_Stmap49LoadStatsClear( pStats );
   352	    if ( pLib == NULL || !Abc_SclHasDelayInfo(pLib) )
   353	        return;
   354	    pStats->fAvailable = 1;
   355	    if ( Abc_NtkHasMapping(pNtk) )
   356	    {
   357	        pTime = Abc_SclManStart( pLib, pNtk, 0, 1, 0, 0 );
   358	        pStats->TimingDelay = pTime->MaxDelay;
   359	    }
   360	    Abc_NtkForEachNode( pNtk, pObj, i )
   361	    {
   362	        pStats->nNodes++;
   363	        if ( pObj->pData == NULL )
   364	            continue;
   365	        pGate = (Mio_Gate_t *)pObj->pData;
   366	        CellId = Abc_SclCellFind( pLib, Mio_GateReadName(pGate) );
   367	        if ( CellId < 0 )
   368	            continue;
   369	        pCell = SC_LibCell( pLib, CellId );
   370	        if ( pCell == NULL || pCell->n_outputs == 0 )
   371	            continue;
   372	        MaxCap = SC_CellPin( pCell, pCell->n_inputs )->max_out_cap;
   373	        if ( MaxCap <= 0.0 )
   374	            continue;
   375	        Load = Abc_Stmap49FanoutLoad( pLib, pObj, &Fanouts, &Pins );
   376	        Ratio = Load / MaxCap;
   377	        pStats->RatioSum += Ratio;
   378	        if ( pStats->RatioMax < Ratio )
   379	            pStats->RatioMax = Ratio;
   380	        if ( Ratio > 1.0 )
   381	            pStats->nOver++;
   382	        pStats->nMatched++;
   383	        pStats->nPins += Pins;
   384	        Criticality = Abc_Stmap49ObjCriticality( pTime, pObj );
   385	        pStats->CriticalitySum += Criticality;
   386	        if ( Criticality > 0.0 )
   387	            pStats->nCriticalNodes++;
   388	        if ( pStats->CriticalityMax < Criticality )
   389	            pStats->CriticalityMax = Criticality;
   390	        Abc_Stmap49TopInsert( pStats->TopRatios, pStats->TopNodes, pStats->pTopGates, pStats->TopFanouts, pStats->TopLoads, pStats->TopCaps,
   391	            Ratio, Abc_ObjId(pObj), Mio_GateReadName(pGate), Fanouts, Load, MaxCap );
   392	        Abc_Stmap49CollectHotspotCone( pNtk, pObj, pStats, pTime, Ratio );
   393	    }
   394	    if ( pTime )
   395	        Abc_SclManFree( pTime );
   396	}
   397	
   398	static void Abc_Stmap49PrintSclLoadStats( const char * pLabel, Abc_Stmap49LoadStats_t * pStats )
   399	{
   400	    int i;
   401	    if ( !pStats->fAvailable )
   402	    {
   403	        printf( "stmap49 %s stats: unavailable = 1\n", pLabel );
   404	        return;
   405	    }
   406	    printf( "stmap49 %s stats: nodes = %d  matched = %d  fanout-pins = %d  over-max = %d  avg-load-ratio = %.3f  max-load-ratio = %.3f\n",
   407	        pLabel, pStats->nNodes, pStats->nMatched, pStats->nPins, pStats->nOver,
   408	        pStats->nMatched ? pStats->RatioSum / (float)pStats->nMatched : 0.0, pStats->RatioMax );
   409	    printf( "stmap49 %s criticality: timing-delay = %.3f  critical-nodes = %d  avg-criticality = %.3f  max-criticality = %.3f\n",
   410	        pLabel, pStats->TimingDelay, pStats->nCriticalNodes,
   411	        pStats->nMatched ? pStats->CriticalitySum / (float)pStats->nMatched : 0.0,
   412	        pStats->CriticalityMax );
   413	    for ( i = 0; i < 5 && pStats->TopRatios[i] > 0.0; i++ )
   414	        printf( "stmap49 %s top: rank = %d  node = %d  gate = %s  fanouts = %d  load = %.3f  max-cap = %.3f  load-ratio = %.3f\n",
   415	            pLabel, i + 1, pStats->TopNodes[i], pStats->pTopGates[i] ? pStats->pTopGates[i] : "?",
   416	            pStats->TopFanouts[i], pStats->TopLoads[i], pStats->TopCaps[i], pStats->TopRatios[i] );
   417	}
   418	
   419	static void Abc_Stmap49PrintHotspots( Abc_Stmap49LoadStats_t * pStats )
   420	{
   421	    int i;
   422	    if ( !pStats->fAvailable )
   423	        return;
   424	    printf( "stmap49 sink-pressure stats: roots = %d  consumer-fanin = %d  consumer-fanout = %d  raw-pressure-entries = %d  raw-pressure-updates = %d  sink-pressure-entries = %d  sink-pressure-updates = %d  pressure-missed = %d  pressure-capacity = %d  tracked-aig = %d  tracked-node = %d  tracked-raw-ratio = %.3f  tracked-sink-ratio = %.3f\n",
   425	        pStats->nHotspotRoots, pStats->nHotspotFanin, pStats->nHotspotFanout,
   426	        pStats->nPressureEntries, pStats->nPressureUpdates,
   427	        pStats->nSinkPressureEntries, pStats->nSinkPressureUpdates,
   428	        pStats->nPressureMissed,
   429	        pStats->nAigPressureRatios, ABC_STMAP49_TRACK_AIG_ID, pStats->TrackedNode,
   430	        pStats->TrackedRatio, pStats->TrackedSinkRatio );
   431	    for ( i = 0; i < ABC_STMAP49_TOP_PRESSURES && pStats->TopPressureRatios[i] > 0.0; i++ )
   432	        printf( "stmap49 sink-pressure: rank = %d  aig-id = %d  mapped-node = %d  sink-pressure-ratio = %.3f\n",
   433	            i + 1, pStats->TopPressureAigIds[i], pStats->TopPressureNodes[i], pStats->TopPressureRatios[i] );
   434	}
   435	
   436	static float Abc_Stmap49FeedbackSeverity( Abc_Stmap49LoadStats_t * pStats )
   437	{
   438	    float OverFrac, MaxPart, OverPart, Severity;
   439	    if ( !pStats->fAvailable || pStats->nMatched == 0 )
   440	        return 0.0;
   441	    OverFrac = (float)pStats->nOver / (float)pStats->nMatched;
   442	    MaxPart = pStats->RatioMax > 4.0 ? (pStats->RatioMax - 4.0) / 8.0 : 0.0;
   443	    OverPart = OverFrac > 0.002 ? (OverFrac - 0.002) / 0.006 : 0.0;
   444	    if ( MaxPart > 1.0 )
   445	        MaxPart = 1.0;
   446	    if ( OverPart > 1.0 )
   447	        OverPart = 1.0;
   448	    Severity = 0.65 * MaxPart + 0.35 * OverPart;
   449	    return Severity > 1.0 ? 1.0 : Severity;
   450	}
