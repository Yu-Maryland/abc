   390	        Abc_Stmap45TopInsert( pStats->TopRatios, pStats->TopNodes, pStats->pTopGates, pStats->TopFanouts, pStats->TopLoads, pStats->TopCaps,
   391	            Ratio, Abc_ObjId(pObj), Mio_GateReadName(pGate), Fanouts, Load, MaxCap );
   392	        Abc_Stmap45CollectHotspotCone( pNtk, pObj, pStats, pTime, Ratio );
   393	    }
