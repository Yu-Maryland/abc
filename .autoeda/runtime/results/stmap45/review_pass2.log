  1495	    Penalty = Map_MatchStmap34StrongPenaltyFactor( pNode, pCut, pMatch, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon, pLeafLoadAvg, pLoadDriveRatio, pFanLimit );
  1496	    LoadDriveRatio = pLoadDriveRatio ? *pLoadDriveRatio : 0.0;
  1497	    NodePressureRatio = Map_MatchStmap45NodePressureRatio( pNode, pNodeAigId );
  1498	    CutPressureRatio = Map_MatchStmap45CutPressureRatio( pCut );
  1499	    PressureRatio = NodePressureRatio > CutPressureRatio ? NodePressureRatio : CutPressureRatio;
  1500	    if ( pNodePressureRatio )
  1501	        *pNodePressureRatio = NodePressureRatio;
  1502	    if ( pCutPressureRatio )
  1503	        *pCutPressureRatio = CutPressureRatio;
  1504	    if ( Penalty > 0.0 && s_Stmap45SclFeedback > 0.0 && PressureRatio > 1.0 && LoadDriveRatio > 1.0 )
