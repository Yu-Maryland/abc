  1463	static int Map_MatchStmap45HasPressureAgreement( float NodePressureRatio, float CutPressureRatio )
  1464	{
  1465	    float PressureSpread;
  1466	    if ( s_Stmap45SclFeedback <= 0.0 || NodePressureRatio <= 1.75 || CutPressureRatio <= 1.75 )
  1467	        return 0;
  1468	    PressureSpread = NodePressureRatio > CutPressureRatio ? NodePressureRatio / CutPressureRatio : CutPressureRatio / NodePressureRatio;
  1469	    return PressureSpread <= 1.25;
  1470	}
  1471	
  1472	static float Map_MatchStmap45ModeratePenaltyFactor( Map_Node_t * pNode, Map_Cut_t * pCut, float ArrivalDelta, float ArrivalGainMargin, float Slack, float SlackMargin, float Epsilon, float * pNodePressureRatio, float * pCutPressureRatio, int * pNodeAigId )
  1473	{
  1474	    float Penalty, NodePressureRatio, CutPressureRatio, PressureAgreement, LocalFeedback;
  1475	    Penalty = Map_MatchStmap29ModeratePenaltyFactor( pNode, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon );
  1476	    NodePressureRatio = Map_MatchStmap45NodePressureRatio( pNode, pNodeAigId );
  1477	    CutPressureRatio = Map_MatchStmap45CutPressureRatio( pCut );
  1478	    if ( pNodePressureRatio )
  1479	        *pNodePressureRatio = NodePressureRatio;
  1480	    if ( pCutPressureRatio )
  1481	        *pCutPressureRatio = CutPressureRatio;
  1482	    if ( Penalty <= 0.0 || !Map_MatchStmap45HasPressureAgreement( NodePressureRatio, CutPressureRatio ) )
  1483	        return 0.0;
  1484	    PressureAgreement = NodePressureRatio < CutPressureRatio ? NodePressureRatio : CutPressureRatio;
  1485	    LocalFeedback = (PressureAgreement - 1.75) / 3.0;
  1486	    if ( LocalFeedback > 1.0 )
  1487	        LocalFeedback = 1.0;
  1488	    Penalty *= 0.40 + 0.60 * s_Stmap45SclFeedback * LocalFeedback;
  1489	    return Penalty > 1.0 ? 1.0 : Penalty;
  1490	}
  1491	
  1492	static float Map_MatchStmap45StrongPenaltyFactor( Map_Node_t * pNode, Map_Cut_t * pCut, Map_Match_t * pMatch, float ArrivalDelta, float ArrivalGainMargin, float Slack, float SlackMargin, float Epsilon, float * pLeafLoadAvg, float * pLoadDriveRatio, int * pFanLimit, float * pNodePressureRatio, float * pCutPressureRatio, int * pNodeAigId )
