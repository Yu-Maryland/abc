   342	static void Abc_Stmap45CollectSclLoadStats( Abc_Ntk_t * pNtk, Abc_Stmap45LoadStats_t * pStats )
   343	{
   344	    SC_Lib * pLib = (SC_Lib *)Abc_FrameReadLibScl();
   345	    SC_Man * pTime = NULL;
