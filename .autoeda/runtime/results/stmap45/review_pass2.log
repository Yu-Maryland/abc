  Description []

  SideEffects []

  SeeAlso     []

***********************************************************************/
static int Map_MatchCutHasStmapUpperModerateFanoutRisk( Map_Node_t * pNode, Map_Cut_t * pCut )
{
    return pNode->nRefs == 6 && pCut->nLeaves > 3;
}

