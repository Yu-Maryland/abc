+static float Map_MatchStmap45PressureLookup( int AigId )
+{
+    if ( AigId < 0 || AigId >= s_nStmap45SclPressureRatios || s_Stmap45SclFeedback <= 0.0 || s_pStmap45SclPressureRatios == NULL )
+        return 0.0;
+    return s_pStmap45SclPressureRatios[AigId];
