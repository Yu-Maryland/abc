        return 0.0;
    if ( pNode->nRefs < 5 || SlackMargin <= Epsilon || ArrivalGainMargin <= Epsilon )
        return 0.0;
    SlackRatio = Slack / SlackMargin;
    GainRatio = -ArrivalDelta / ArrivalGainMargin;
