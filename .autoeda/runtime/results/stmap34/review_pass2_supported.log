   700	    LeafLoadAvg = Map_MatchStmap32CutLeafLoadAvg( pCut );
   701	    FanLimit = pMatch && pMatch->pSuperBest ? (int)pMatch->pSuperBest->nFanLimit : 0;
   702	    LoadDriveRatio = FanLimit > 0 ? LeafLoadAvg / (float)FanLimit : LeafLoadAvg;
   703	    if ( pLeafLoadAvg )
   704	        *pLeafLoadAvg = LeafLoadAvg;
   705	    if ( pLoadDriveRatio )
   706	        *pLoadDriveRatio = LoadDriveRatio;
   707	    if ( pFanLimit )
   708	        *pFanLimit = FanLimit;
   709	    if ( LoadDriveRatio > 1.0 )
   710	        Penalty += FanLimit > 0 ? 0.18 * (LoadDriveRatio - 1.0) : 0.04 * (LeafLoadAvg - 1.0);
   711	    return Penalty > 0.75 ? 0.75 : Penalty;
