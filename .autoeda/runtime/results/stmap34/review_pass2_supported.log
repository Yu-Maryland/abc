   637	static float Map_MatchStmap32CutLeafLoadAvg( Map_Cut_t * pCut )
   638	{
   639	    Map_Node_t * pLeaf;
   640	    float Load = 0.0;
   641	    int i;
   642	    if ( pCut == NULL || pCut->nLeaves == 0 )
   643	        return 0.0;
   644	    for ( i = 0; i < (int)pCut->nLeaves; i++ )
   645	    {
   646	        pLeaf = Map_Regular( pCut->ppLeaves[i] );
   647	        if ( pLeaf != NULL && pLeaf->nRefs > 0 )
   648	            Load += (float)pLeaf->nRefs;
