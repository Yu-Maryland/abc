   752	/**Function*************************************************************
   753	
   754	  Synopsis    [Returns 1 if a fanout/load proxy should reject this cut.]
   755	
   756	  Description [Mode 1 is the classic map -f guard. Mode 2 is the stmap1
   757	  selective guard, which only rejects wider cuts when the node has higher
   758	  estimated fanout. Mode 3 is the stmap2 guard, which uses the same fanout
   759	  thresholds only during area recovery and only when the current phase has
   760	  slack over the mapper required time. Mode 4 is the stmap3 guard, which
   980	                return 0;
   981	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   982	        }
   983	        return 0;
   984	    }
   985	    return (pNode->nRefs > 3 && pCut->nLeaves > 2) || (pNode->nRefs > 1 && pCut->nLeaves > 3);
   986	}
