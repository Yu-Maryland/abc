   581	static float Map_MatchStmap30StrongPenaltyFactor( Map_Node_t * pNode, float ArrivalDelta, float ArrivalGainMargin, float Slack, float SlackMargin, float Epsilon )
   582	{
   583	    float Penalty, SlackRatio, GainRatio;
   584	    if ( !Map_MatchIsStmap30StrongPenaltyCandidate( pNode, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon ) )
   585	        return 0.0;
   586	    if ( SlackMargin <= Epsilon || ArrivalGainMargin <= Epsilon )
   587	        return 0.0;
   588	    SlackRatio = Slack / SlackMargin;
   589	    GainRatio = -ArrivalDelta / ArrivalGainMargin;
   590	    Penalty = 0.18 * (float)(pNode->nRefs - 4);
   591	    if ( SlackRatio < 1.25 )
   592	        Penalty += 0.16 * (1.25 - SlackRatio) / 0.25;
   593	    if ( GainRatio > 5.0 )
   594	        Penalty += 0.09 * (GainRatio - 5.0);
   595	    return Penalty > 0.75 ? 0.75 : Penalty;
   596	}
