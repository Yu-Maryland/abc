   664	static float Map_MatchStmap32StrongPenaltyFactor( Map_Node_t * pNode, Map_Cut_t * pCut, float ArrivalDelta, float ArrivalGainMargin, float Slack, float SlackMargin, float Epsilon )
   665	{
   666	    float Penalty, LeafLoadAvg;
   667	    if ( !Map_MatchIsStmap30StrongPenaltyCandidate( pNode, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon ) )
   668	        return 0.0;
   669	    Penalty = Map_MatchStmap31StrongPenaltyFactor( pNode, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon );
   670	    LeafLoadAvg = Map_MatchStmap32CutLeafLoadAvg( pCut );
   671	    if ( LeafLoadAvg > 1.0 )
   672	        Penalty += 0.04 * (LeafLoadAvg - 1.0);
   673	    return Penalty > 0.75 ? 0.75 : Penalty;
   674	}
   675	
   676	/**Function*************************************************************
   677	
   678	  Synopsis    [Returns the stmap33 drive-normalized strong-seed margin.]
   679	
   680	  Description []
   681	
   682	  SideEffects []
   683	
   684	  SeeAlso     []
   685	
   686	***********************************************************************/
   687	static float Map_MatchStmap33StrongPenaltyFactor( Map_Node_t * pNode, Map_Cut_t * pCut, Map_Match_t * pMatch, float ArrivalDelta, float ArrivalGainMargin, float Slack, float SlackMargin, float Epsilon, float * pLeafLoadAvg, float * pLoadDriveRatio, int * pFanLimit )
   688	{
   689	    float Penalty, LeafLoadAvg, LoadDriveRatio;
   690	    int FanLimit;
   691	    if ( pLeafLoadAvg )
   692	        *pLeafLoadAvg = 0.0;
   693	    if ( pLoadDriveRatio )
   694	        *pLoadDriveRatio = 0.0;
   695	    if ( pFanLimit )
   696	        *pFanLimit = 0;
   697	    if ( !Map_MatchIsStmap30StrongPenaltyCandidate( pNode, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon ) )
   698	        return 0.0;
   699	    Penalty = Map_MatchStmap31StrongPenaltyFactor( pNode, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon );
   700	    LeafLoadAvg = Map_MatchStmap32CutLeafLoadAvg( pCut );
   701	    FanLimit = pMatch && pMatch->pSuperBest ? (int)pMatch->pSuperBest->nFanLimit : 0;
   702	    LoadDriveRatio = FanLimit > 0 ? LeafLoadAvg / (float)FanLimit : LeafLoadAvg;
   703	    if ( pLeafLoadAvg )
   704	        *pLeafLoadAvg = LeafLoadAvg;
   705	    if ( pLoadDriveRatio )
   706	        *pLoadDriveRatio = LoadDriveRatio;
   707	    if ( pFanLimit )
   708	        *pFanLimit = FanLimit;
   709	    if ( LoadDriveRatio > 1.0 )
   710	        Penalty += FanLimit > 0 ? 0.18 * (LoadDriveRatio - 1.0) : 0.04 * (LeafLoadAvg - 1.0);
   711	    return Penalty > 0.75 ? 0.75 : Penalty;
   712	}
   713	
   714	/**Function*************************************************************
   715	
   716	  Synopsis    [Returns the stmap34 bounded drive-normalized strong margin.]
   717	
   718	  Description []
   719	
   720	  SideEffects []
   721	
   722	  SeeAlso     []
   723	
   724	***********************************************************************/
   725	static float Map_MatchStmap34StrongPenaltyFactor( Map_Node_t * pNode, Map_Cut_t * pCut, Map_Match_t * pMatch, float ArrivalDelta, float ArrivalGainMargin, float Slack, float SlackMargin, float Epsilon, float * pLeafLoadAvg, float * pLoadDriveRatio, int * pFanLimit )
   726	{
   727	    float Penalty, LeafLoadAvg, LoadDriveRatio;
   728	    int FanLimit;
   729	    if ( pLeafLoadAvg )
   730	        *pLeafLoadAvg = 0.0;
   731	    if ( pLoadDriveRatio )
   732	        *pLoadDriveRatio = 0.0;
   733	    if ( pFanLimit )
   734	        *pFanLimit = 0;
   735	    if ( !Map_MatchIsStmap30StrongPenaltyCandidate( pNode, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon ) )
   736	        return 0.0;
   737	    Penalty = Map_MatchStmap31StrongPenaltyFactor( pNode, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon );
   738	    LeafLoadAvg = Map_MatchStmap32CutLeafLoadAvg( pCut );
   739	    FanLimit = pMatch && pMatch->pSuperBest ? (int)pMatch->pSuperBest->nFanLimit : 0;
   740	    LoadDriveRatio = FanLimit > 0 ? LeafLoadAvg / (float)FanLimit : LeafLoadAvg;
   741	    if ( pLeafLoadAvg )
   742	        *pLeafLoadAvg = LeafLoadAvg;
   743	    if ( pLoadDriveRatio )
   744	        *pLoadDriveRatio = LoadDriveRatio;
   745	    if ( pFanLimit )
   746	        *pFanLimit = FanLimit;
   747	    if ( LoadDriveRatio > 1.0 )
   748	        Penalty += 0.02 * (LoadDriveRatio - 1.0) / LoadDriveRatio;
   749	    return Penalty > 0.75 ? 0.75 : Penalty;
   750	}
