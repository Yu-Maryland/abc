   752	/**Function*************************************************************
   753	
   754	  Synopsis    [Returns 1 if a fanout/load proxy should reject this cut.]
   755	
   756	  Description [Mode 1 is the classic map -f guard. Mode 2 is the stmap1
   757	  selective guard, which only rejects wider cuts when the node has higher
   758	  estimated fanout. Mode 3 is the stmap2 guard, which uses the same fanout
   759	  thresholds only during area recovery and only when the current phase has
   760	  slack over the mapper required time. Mode 4 is the stmap3 guard, which
   780	  middle-slack relief is allowed only for shallow and medium-depth nodes.
   781	  Mode 12 is the stmap11 tight-depth version of mode 11: the middle-slack
   782	  relief is allowed only for shallower nodes. Mode 13 is the stmap12
   783	  fanout-bucket split version of mode 12: the tight-depth middle-slack relief
   784	  is allowed only in the lower moderate fanout bucket. Mode 14 is stmap13,
   785	  which keeps mode 13 behavior while recording guard-hit counters. Mode 15 is
   786	  stmap14, which keeps the same bucket and counters but requires a stronger
   787	  middle-slack area-flow saving. Mode 16 is stmap15, which restores the
   788	  one-inverter relief threshold only after the current run has observed a high
   789	  lower-moderate/middle-slack exact-area profile. Mode 17 is stmap16, which
   790	  keeps mode 16 behavior and prints per-relief diagnostics. Mode 18 is stmap17,
   791	  which uses the one-inverter post-profile threshold only for candidates with
   792	  materially better mapper arrival. Mode 19 is stmap18, which keeps mode 18
   793	  decisions and adds near-miss diagnostics for candidates rejected by the
   794	  timing-quality/profile fallback. Mode 20 is stmap19, which allows the
   795	  one-inverter threshold before profile-open only for candidates with the same
   796	  material mapper-arrival improvement. Mode 21 is stmap20, which keeps the
   797	  mode 20 pre-profile seed but restricts it to shallow nodes. Mode 22 is
   798	  stmap21, which keeps the shallow seed and admits deeper pre-profile seeds
   799	  only when the arrival gain is unusually large. Mode 23 is stmap22, which
   800	  relaxes the deep pre-profile seed boundary to a moderate arrival gain. Mode
   801	  24 is stmap23, which keeps the strong deep seeds but allows moderate deep
   802	  seeds only when the existing mapper slack is near the critical side of the
   803	  middle-slack window. Mode 25 is stmap24, which tightens the moderate deep
   804	  slack gate to the lower edge of that critical window. Mode 26 is stmap25,
   805	  which keeps stmap24 and admits at most one moderate deep seed from the next
   806	  slack band as an ablation diagnostic. Mode 27 is stmap26, which skips the
   807	  first such moderate seed and admits only the second qualifying seed. Mode 28
   808	  is stmap27, which reopens the next slack band except for the high-reference,
   809	  low-slack, stronger-moderate signature isolated by stmap26. Mode 29 is
   810	  stmap28, which replaces that hard signature blocker with a high-reference
   811	  moderate-seed area penalty that scales with reference count, slack risk, and
   812	  arrival-gain risk. Mode 30 is stmap29, which keeps the same seed band but
   813	  makes the penalty a continuous load-risk gradient. Mode 31 is stmap30,
   814	  which keeps that moderate-seed gradient and adds a smaller continuous
   815	  penalty to high-reference strong deep seeds. Mode 32 is stmap31, which keeps
   816	  mode 31's moderate penalty but dampens the strong-seed gain slope. Mode 33
   817	  is stmap32, which adds a cut-leaf load proxy to the strong-seed penalty. Mode
   818	  34 is stmap33, which normalizes that load proxy by supergate fanout limit.
   819	  Mode 35 is stmap34, which uses a bounded sublinear load/drive curve.]
   820	
   821	  SideEffects []
   822	
   823	  SeeAlso     []
   824	
   825	***********************************************************************/
   826	static int Map_MatchSkipCutForFanout( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase )
   827	{
   828	    Map_Cut_t * pCutBest;
   829	    Map_Match_t * pMatchBest;
   830	    float Slack, SlackMargin, SlackLimit;
   831	
   832	    if ( !p->fSkipFanout )
   833	        return 0;
   834	    if ( p->fSkipFanout == 2 )
   835	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   836	    if ( p->fSkipFanout == 3 )
   837	    {
   838	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   839	            return 0;
   840	        pCutBest = pNode->pCutBest[fPhase];
   841	        if ( pCutBest == NULL )
   842	            return 0;
   843	        pMatchBest = pCutBest->M + fPhase;
   844	        if ( pMatchBest->pSuperBest == NULL )
   845	            return 0;
   846	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   847	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   848	        if ( Slack <= SlackMargin + p->fEpsilon )
   849	            return 0;
   850	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   851	    }
   852	    if ( p->fSkipFanout == 4 )
   853	    {
   854	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   855	            return 0;
   856	        pCutBest = pNode->pCutBest[fPhase];
   857	        if ( pCutBest == NULL )
   858	            return 0;
   859	        pMatchBest = pCutBest->M + fPhase;
   860	        if ( pMatchBest->pSuperBest == NULL || p->pSuperLib == NULL )
   861	            return 0;
   862	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   863	        SlackMargin = p->pSuperLib->tDelayInv.Worst;
   864	        SlackLimit = 2.0 * SlackMargin;
   865	        if ( Slack <= p->fEpsilon || Slack > SlackLimit + p->fEpsilon )
   866	            return 0;
   867	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   868	    }
   869	    if ( p->fSkipFanout == 5 )
   870	    {
   871	        if ( p->fMappingMode == 0 )
   872	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   873	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   874	            return 0;
   875	        pCutBest = pNode->pCutBest[fPhase];
   876	        if ( pCutBest == NULL )
   877	            return 0;
   878	        pMatchBest = pCutBest->M + fPhase;
   879	        if ( pMatchBest->pSuperBest == NULL )
   880	            return 0;
   881	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   882	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   883	        if ( Slack <= SlackMargin + p->fEpsilon )
   884	            return 0;
   885	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   886	    }
   887	    if ( p->fSkipFanout == 6 )
   888	    {
   889	        if ( p->fMappingMode == 0 )
   890	        {
   891	            if ( p->vMapObjs->nSize <= 20000 )
   892	                return 0;
   893	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   894	        }
   895	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   896	            return 0;
   897	        pCutBest = pNode->pCutBest[fPhase];
   898	        if ( pCutBest == NULL )
   899	            return 0;
   900	        pMatchBest = pCutBest->M + fPhase;
   901	        if ( pMatchBest->pSuperBest == NULL )
   902	            return 0;
   903	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   904	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   905	        if ( Slack <= SlackMargin + p->fEpsilon )
   906	            return 0;
   907	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   908	    }
   909	    if ( p->fSkipFanout == 7 )
   910	    {
   911	        if ( p->fMappingMode == 0 )
   912	        {
   913	            if ( p->vMapObjs->nSize <= 20000 )
   914	                return 0;
   915	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   916	        }
   917	        if ( p->fMappingMode >= 1 && p->fMappingMode <= 3 && p->vMapObjs->nSize <= 8000 )
   918	        {
   919	            pCutBest = pNode->pCutBest[fPhase];
   920	            if ( pCutBest == NULL )
   921	                return 0;
   922	            pMatchBest = pCutBest->M + fPhase;
   923	            if ( pMatchBest->pSuperBest == NULL )
   924	                return 0;
   925	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   926	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   927	            if ( Slack <= SlackMargin + p->fEpsilon )
   928	                return 0;
   929	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   930	        }
   931	        if ( p->fMappingMode == 1 )
   932	        {
   933	            pCutBest = pNode->pCutBest[fPhase];
   934	            if ( pCutBest == NULL )
   935	                return 0;
   936	            pMatchBest = pCutBest->M + fPhase;
   937	            if ( pMatchBest->pSuperBest == NULL )
   938	                return 0;
   939	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   940	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   941	            if ( Slack <= SlackMargin + p->fEpsilon )
   942	                return 0;
   943	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   944	        }
   945	        return 0;
   946	    }
   947	    if ( p->fSkipFanout >= 8 && p->fSkipFanout <= 35 )
   948	    {
   949	        if ( p->fMappingMode == 0 )
   950	        {
   951	            if ( p->vMapObjs->nSize <= 20000 )
   952	                return 0;
   953	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   954	        }
   955	        if ( p->fMappingMode >= 1 && p->fMappingMode <= 3 && p->vMapObjs->nSize <= 8000 )
   956	        {
   957	            pCutBest = pNode->pCutBest[fPhase];
   958	            if ( pCutBest == NULL )
   959	                return 0;
   960	            pMatchBest = pCutBest->M + fPhase;
   961	            if ( pMatchBest->pSuperBest == NULL )
   962	                return 0;
   963	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   964	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   965	            if ( Slack <= SlackMargin + p->fEpsilon )
   966	                return 0;
   967	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   968	        }
   969	        if ( p->fMappingMode == 1 )
   970	        {
   971	            pCutBest = pNode->pCutBest[fPhase];
   972	            if ( pCutBest == NULL )
   973	                return 0;
   974	            pMatchBest = pCutBest->M + fPhase;
   975	            if ( pMatchBest->pSuperBest == NULL )
   976	                return 0;
   977	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   978	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   979	            if ( Slack <= SlackMargin + p->fEpsilon )
   980	                return 0;
   981	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   982	        }
   983	        return 0;
   984	    }
   985	    return (pNode->nRefs > 3 && pCut->nLeaves > 2) || (pNode->nRefs > 1 && pCut->nLeaves > 3);
   986	}
