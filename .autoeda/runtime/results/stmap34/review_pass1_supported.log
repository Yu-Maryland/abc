   141	static void Map_MatchStmap13CountRisk( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut )
   142	{
   143	    if ( p->fSkipFanout < 14 || p->fSkipFanout > 35 )
   144	        return;
   145	    p->nStmap13ExactRisk++;
   146	    if ( Map_MatchCutHasStmapHighestFanoutRisk( pNode, pCut ) )
   147	        p->nStmap13HighestRisk++;
   148	    else if ( Map_MatchCutHasStmapLowerModerateFanoutRisk( pNode, pCut ) )
   149	        p->nStmap13LowerModRisk++;
   150	    else if ( Map_MatchCutHasStmapUpperModerateFanoutRisk( pNode, pCut ) )
   151	        p->nStmap13UpperModRisk++;
   152	}
