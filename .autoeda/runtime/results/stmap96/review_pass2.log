        s_Stmap75WatchAigIds[0], s_Stmap75WatchHitCounts[0],
        s_Stmap75WatchAigIds[1], s_Stmap75WatchHitCounts[1],
        s_Stmap75WatchAigIds[2], s_Stmap75WatchHitCounts[2],
        s_Stmap75WatchAigIds[3], s_Stmap75WatchHitCounts[3] );
}


