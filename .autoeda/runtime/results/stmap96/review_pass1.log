            s_nStmap93EmittedBlockedWindow++;
            pAction = "blocked-window";
        }
        else if ( !fMaterialDrive )
        {
            s_nStmap93EmittedBlockedDrive++;
            pAction = "blocked-drive";
        }
        else
        {
            s_nStmap93EmittedEligible++;
            if ( fRelaxedWindowUsed )
