    AreaMulti   = 0;
    DelayMulti  = 0;
    fAreaOnly   = 0;
    fRecovery   = 1;
    fSweep      = 0;
    fSwitching  = 0;
    fSkipFanout = 35; // bounded drive-normalized strong seed load proxy; -f disables it
    fUseProfile = 0;
    fUseBuffs   = 0;
