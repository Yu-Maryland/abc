   101	/**Function*************************************************************
   102	
   103	  Synopsis    [Prints direct SCL load diagnostics for the mapped network.]
   104	
   105	  Description []
   106	
   107	  SideEffects []
   108	
   109	  SeeAlso     []
   110	
   111	***********************************************************************/
   112	static void Abc_Stmap35PrintSclLoadStats( Abc_Ntk_t * pNtk )
   113	{
   114	    SC_Lib * pLib = (SC_Lib *)Abc_FrameReadLibScl();
   115	    Abc_Obj_t * pObj;
   116	    Mio_Gate_t * pGate;
   117	    SC_Cell * pCell;
   118	    float TopRatios[5] = {0}, TopLoads[5] = {0}, TopCaps[5] = {0};
   119	    const char * pTopGates[5] = {NULL};
   120	    int TopNodes[5] = {0}, TopFanouts[5] = {0};
   121	    float Load, MaxCap, Ratio, RatioSum = 0.0, RatioMax = 0.0;
   122	    int i, CellId, Fanouts, Pins, nNodes = 0, nMatched = 0, nPins = 0, nOver = 0;
   123	    if ( pLib == NULL || !Abc_SclHasDelayInfo(pLib) )
   124	    {
   125	        printf( "stmap35 scl-load stats: unavailable = 1\n" );
   126	        return;
   127	    }
   128	    Abc_NtkForEachNode( pNtk, pObj, i )
   129	    {
   130	        nNodes++;
   131	        if ( pObj->pData == NULL )
   132	            continue;
   133	        pGate = (Mio_Gate_t *)pObj->pData;
   134	        CellId = Abc_SclCellFind( pLib, Mio_GateReadName(pGate) );
   135	        if ( CellId < 0 )
   136	            continue;
   137	        pCell = SC_LibCell( pLib, CellId );
   138	        if ( pCell == NULL || pCell->n_outputs == 0 )
   139	            continue;
   140	        MaxCap = SC_CellPin( pCell, pCell->n_inputs )->max_out_cap;
   141	        if ( MaxCap <= 0.0 )
   142	            continue;
   143	        Load = Abc_Stmap35FanoutLoad( pLib, pObj, &Fanouts, &Pins );
   144	        Ratio = Load / MaxCap;
   145	        RatioSum += Ratio;
   146	        if ( RatioMax < Ratio )
   147	            RatioMax = Ratio;
   148	        if ( Ratio > 1.0 )
   149	            nOver++;
   150	        nMatched++;
   151	        nPins += Pins;
   152	        Abc_Stmap35TopInsert( TopRatios, TopNodes, pTopGates, TopFanouts, TopLoads, TopCaps,
   153	            Ratio, Abc_ObjId(pObj), Mio_GateReadName(pGate), Fanouts, Load, MaxCap );
   154	    }
   155	    printf( "stmap35 scl-load stats: nodes = %d  matched = %d  fanout-pins = %d  over-max = %d  avg-load-ratio = %.3f  max-load-ratio = %.3f\n",
   156	        nNodes, nMatched, nPins, nOver, nMatched ? RatioSum / (float)nMatched : 0.0, RatioMax );
   157	    for ( i = 0; i < 5 && TopRatios[i] > 0.0; i++ )
   158	        printf( "stmap35 scl-load top: rank = %d  node = %d  gate = %s  fanouts = %d  load = %.3f  max-cap = %.3f  load-ratio = %.3f\n",
   159	            i + 1, TopNodes[i], pTopGates[i] ? pTopGates[i] : "?", TopFanouts[i], TopLoads[i], TopCaps[i], TopRatios[i] );
   160	}
