    82	        (*pFanouts)++;
    83	        if ( !Abc_ObjIsNode(pFanout) || pFanout->pData == NULL )
    84	            continue;
    85	        iFanin = Abc_NodeFindFanin( pFanout, pObj );
    86	        if ( iFanin < 0 )
    87	            continue;
    88	        pGateFan = (Mio_Gate_t *)pFanout->pData;
    89	        CellId = Abc_SclCellFind( pLib, Mio_GateReadName(pGateFan) );
    90	        if ( CellId < 0 )
    91	            continue;
    92	        pCellFan = SC_LibCell( pLib, CellId );
    93	        if ( pCellFan == NULL || iFanin >= pCellFan->n_inputs )
    94	            continue;
    95	        Load += SC_CellPinCap( pCellFan, iFanin );
    96	        (*pPins)++;
    97	    }
    98	    return Load;
