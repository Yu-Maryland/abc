+static float Abc_Stmap35FanoutLoad( SC_Lib * pLib, Abc_Obj_t * pObj, int * pFanouts, int * pPins )
+{
+    Abc_Obj_t * pFanout;
+    Mio_Gate_t * pGateFan;
+    SC_Cell * pCellFan;
+    float Load = 0.0;
+    int i, iFanin, CellId;
+    *pFanouts = 0;
+    *pPins = 0;
+    Abc_ObjForEachFanout( pObj, pFanout, i )
+    {
