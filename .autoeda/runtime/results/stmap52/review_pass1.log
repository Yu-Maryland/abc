        AigId = Abc_Stmap52MappedObjAigId( pNtk, pFanin );
        if ( AigId >= 0 )
        {
            pStats->nHotspotFanin++;
            Abc_Stmap52PressureInsert( pStats, AigId, Abc_ObjId(pFanin), Ratio, SinkCriticality );
        }
