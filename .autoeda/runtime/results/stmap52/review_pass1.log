    SlackRatio = Slack / SlackMargin;
    GainRatio = -ArrivalDelta / ArrivalGainMargin;
    Penalty = 0.18 * (float)(pNode->nRefs - 4);
    if ( SlackRatio < 1.25 )
        Penalty += 0.16 * (1.25 - SlackRatio) / 0.25;
    if ( GainRatio > 5.0 )
        Penalty += 0.09 * (GainRatio - 5.0);
    return Penalty > 0.75 ? 0.75 : Penalty;
}

