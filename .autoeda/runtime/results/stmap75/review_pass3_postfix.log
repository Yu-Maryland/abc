    float * pAigPressureRatios;
    float * pAigSinkPressureRatios;
    float TopRatios[5];
    float TopLoads[5];
    float TopCaps[5];
    const char * pTopGates[5];
    int TopNodes[5];
    int TopFanouts[5];
    int TopPressureAigIds[ABC_STMAP65_TOP_PRESSURES];
    int TopPressureNodes[ABC_STMAP65_TOP_PRESSURES];
