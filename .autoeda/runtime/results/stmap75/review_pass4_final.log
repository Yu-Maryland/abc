  1798	
  1799	static float Map_Stmap73AcceptedWitnessScore( float NodePressureRatio, float CutPressureRatio, float Slack, float ArrivalDelta, float ArrivalGainMargin )
  1800	{
  1801	    float Pressure = NodePressureRatio > CutPressureRatio ? NodePressureRatio : CutPressureRatio;
  1802	    float Tightness = Slack > 0.0f ? 1.0f / (1.0f + Slack) : 1.0f;
  1803	    float SpeedGain = ArrivalDelta < 0.0f ? -ArrivalDelta / 20.0f : 0.0f;
  1804	    float MarginGain = ArrivalGainMargin > 0.0f ? ArrivalGainMargin / 20.0f : 0.0f;
  1805	    if ( SpeedGain > 1.0f )
  1806	        SpeedGain = 1.0f;
  1807	    if ( MarginGain > 1.0f )
  1808	        MarginGain = 1.0f;
  1809	    return Pressure + 0.25f * Tightness + 0.10f * SpeedGain + 0.05f * MarginGain;
  1810	}
  1811	
  1812	static float Map_Stmap73AcceptedWitnessScoreSlot( int i )
  1813	{
  1814	    return Map_Stmap73AcceptedWitnessScore(
  1815	        s_Stmap64WitnessNodePressureRatios[i],
  1816	        s_Stmap64WitnessCutPressureRatios[i],
  1817	        s_Stmap64WitnessSlacks[i],
  1818	        s_Stmap64WitnessArrivalDeltas[i],
  1819	        s_Stmap64WitnessArrivalGainMargins[i] );
  1820	}
  1821	
  1822	static void Map_Stmap73RecordAcceptedPressureWitness( Map_Node_t * pNode, Map_Cut_t * pCut, int AigId, int fPhase, const char * pClass, float NodePressureRatio, float CutPressureRatio, float Slack, float AreaSave, float ArrivalDelta, float ArrivalGainMargin, float PenaltyFactor, float AreaMargin, int fPressureAgreement, int fPressureNear, int fCutOnlyPressure, int fAreaCap )
  1823	{
  1824	    int i, Slot = -1, fDuplicate = 0, fStored = 0, fReplaced = 0;
  1825	    float Score, WorstScore;
  1826	    if ( !s_fStmap73AcceptedPressureWitnessDiag || pNode == NULL || AigId < 0 )
  1827	        return;
  1828	    if ( NodePressureRatio < 1.0f && CutPressureRatio < 1.0f )
  1829	        return;
  1830	    fPhase = fPhase ? 1 : 0;
  1831	    Score = Map_Stmap73AcceptedWitnessScore( NodePressureRatio, CutPressureRatio, Slack, ArrivalDelta, ArrivalGainMargin );
  1832	    s_nStmap73AcceptedPressureWitnessSources++;
  1833	    for ( i = 0; i < s_nStmap64CutOnlyWitnesses; i++ )
  1834	    {
  1835	        if ( s_Stmap64WitnessAigIds[i] == AigId && s_Stmap64WitnessPhases[i] == fPhase )
  1836	        {
  1837	            fDuplicate = 1;
  1838	            if ( Score > Map_Stmap73AcceptedWitnessScoreSlot( i ) + 0.0001f )
  1839	            {
  1840	                Slot = i;
  1841	                fReplaced = 1;
  1842	            }
  1843	            break;
  1844	        }
  1845	    }
  1846	    if ( Slot < 0 && !fDuplicate )
  1847	    {
  1848	        if ( s_nStmap64CutOnlyWitnesses < MAP_STMAP64_MAX_WITNESSES )
  1849	            Slot = s_nStmap64CutOnlyWitnesses++;
  1850	        else
  1851	        {
  1852	            Slot = 0;
  1853	            WorstScore = Map_Stmap73AcceptedWitnessScoreSlot( 0 );
  1854	            for ( i = 1; i < s_nStmap64CutOnlyWitnesses; i++ )
  1855	            {
  1856	                if ( Map_Stmap73AcceptedWitnessScoreSlot( i ) < WorstScore )
  1857	                {
  1858	                    Slot = i;
  1859	                    WorstScore = Map_Stmap73AcceptedWitnessScoreSlot( i );
  1860	                }
  1861	            }
  1862	            if ( Score <= WorstScore + 0.0001f )
  1863	                Slot = -1;
  1864	            else
  1865	                fReplaced = 1;
  1866	        }
  1867	    }
  1868	    if ( Slot >= 0 )
  1869	    {
  1870	        Map_Stmap64WriteWitnessSlot( Slot, pNode, AigId, fPhase, NodePressureRatio, CutPressureRatio, Slack, AreaSave, ArrivalDelta, ArrivalGainMargin );
  1871	        fStored = 1;
