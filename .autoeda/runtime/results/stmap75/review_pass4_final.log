  1692	    if ( s_nStmap64CutOnlyWitnesses >= MAP_STMAP64_MAX_WITNESSES )
  1693	        return;
  1694	    i = s_nStmap64CutOnlyWitnesses++;
  1695	    Map_Stmap64WriteWitnessSlot( i, pNode, AigId, fPhase, NodePressureRatio, CutPressureRatio, Slack, AreaSave, ArrivalDelta, ArrivalGainMargin );
