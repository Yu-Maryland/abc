    67	        WatchAigId >= 0, pNtk && Abc_NtkName(pNtk) ? Abc_NtkName(pNtk) : "?", WatchAigId );
    68	    Map_Stmap75SetFinalCriticalAigDiag( WatchAigId >= 0, WatchAigId );
    69	    RetValue = Abc_CommandStmap65( pAbc, argc, argv );
    70	    Map_Stmap75PrintFinalCriticalAigSummary();
    71	    Map_Stmap75SetFinalCriticalAigDiag( 0, -1 );
    72	    if ( RetValue == 0 )
    73	    {
    74	        pNtkRes = Abc_FrameReadNtk( pAbc );
    75	        Abc_Stmap74EnableFinalCriticalScope( pNtkRes, "stmap75" );
    76	    }
    77	    return RetValue;
    78	
    79	usage:
    80	    Abc_Print( -2, "usage: stmap75 [-DABFSG float] [-M num] [-arspfuovh]\n" );
    81	    Abc_Print( -2, "\t              performs stmap75 bounded-pressure mapping with mapper selected-match diagnostics for stmap74 final-critical AIG IDs\n" );
    82	    Abc_Print( -2, "\t-D float : sets the global required times [default = not used]\n" );
    83	    Abc_Print( -2, "\t-A float : \"area multiplier\" to bias gate selection [default = 0.00]\n" );
    84	    Abc_Print( -2, "\t-B float : \"delay multiplier\" to bias gate selection [default = 0.00]\n" );
    85	    Abc_Print( -2, "\t-F float : the logarithmic fanout delay parameter [default = 0.00]\n" );
    86	    Abc_Print( -2, "\t-S float : the slew parameter used to generate the library [default = 0.00]\n" );
    87	    Abc_Print( -2, "\t-G float : the SCL/genlib gain parameter used to generate the library [default = 250.00]\n" );
    88	    Abc_Print( -2, "\t-M num   : skip gate classes whose size is less than this [default = 0]\n" );
    89	    Abc_Print( -2, "\t-a       : toggles area-only mapping [default = no]\n" );
    90	    Abc_Print( -2, "\t-r       : toggles area recovery [default = yes]\n" );
    91	    Abc_Print( -2, "\t-s       : toggles sweep after mapping [default = no]\n" );
    92	    Abc_Print( -2, "\t-p       : optimizes power by minimizing switching [default = no]\n" );
    93	    Abc_Print( -2, "\t-f       : disables the bounded-pressure SCL feedback mapper mode [default = yes]\n" );
    94	    Abc_Print( -2, "\t-u       : use standard-cell profile [default = no]\n" );
    95	    Abc_Print( -2, "\t-o       : toggles using buffers to decouple combinational outputs [default = no]\n" );
    96	    Abc_Print( -2, "\t-v       : toggles verbose output [default = no]\n" );
    97	    Abc_Print( -2, "\t-h       : print the command usage\n" );
    98	    return 1;
    99	}
