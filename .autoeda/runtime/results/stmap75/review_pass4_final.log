  1685	    for ( i = 0; i < s_nStmap64CutOnlyWitnesses; i++ )
  1686	    {
  1687	        if ( s_Stmap64WitnessAigIds[i] != AigId || s_Stmap64WitnessPhases[i] != fPhase )
  1688	            continue;
  1689	        Map_Stmap64WriteWitnessSlot( i, pNode, AigId, fPhase, NodePressureRatio, CutPressureRatio, Slack, AreaSave, ArrivalDelta, ArrivalGainMargin );
