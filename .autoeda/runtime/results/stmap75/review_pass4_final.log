+static void Map_Stmap75ReadLeaf( Map_Cut_t * pCut, int iLeaf, int * pLeafNode, int * pLeafAigId )
+{
+    Map_Node_t * pLeaf;
+    if ( pLeafNode )
+        *pLeafNode = -1;
+    if ( pLeafAigId )
+        *pLeafAigId = -1;
+    if ( pCut == NULL || iLeaf < 0 || iLeaf >= (int)pCut->nLeaves )
+        return;
+    pLeaf = Map_Regular( pCut->ppLeaves[iLeaf] );
+    if ( pLeaf == NULL )
+        return;
+    if ( pLeafNode )
+        *pLeafNode = pLeaf->Num;
+    if ( pLeafAigId )
+        *pLeafAigId = Map_NodeReadAigId( pLeaf );
+}
