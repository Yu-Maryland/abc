  5370	            printf( "If such supergates exist in the library, report a bug.\n" );
  5371	            Extra_ProgressBarStop( pProgress );
  5372	            return 0;
  5373	        }
  5374	
  5375	        // if both phases are assigned, check if one of them can be dropped
  5376	        Map_NodeTryDroppingOnePhase( p, pNode );
  5377	        // set the arrival times of the node using the best cuts
  5378	        Map_NodeTransferArrivalTimes( p, pNode );
  5379	        // command-scoped stmap75 diagnostics; no mapper decisions depend on this.
  5380	        Map_Stmap75PrintSelectedMatches( p, pNode );
  5381	
  5382	        // update the progress bar
  5383	        Extra_ProgressBarUpdate( pProgress, i, "Matches ..." );
  5384	    }
  5385	    Extra_ProgressBarStop( pProgress );
  5386	    return 1;
  5387	}
