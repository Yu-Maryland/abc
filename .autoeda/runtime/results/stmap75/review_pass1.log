  5332	        if ( Map_NodeIsBuf(pNode) )
  5333	        {
  5334	            assert( pNode->p2 == NULL );
  5335	            pNode->tArrival[0] = Map_Regular(pNode->p1)->tArrival[ Map_IsComplement(pNode->p1)];
  5336	            pNode->tArrival[1] = Map_Regular(pNode->p1)->tArrival[!Map_IsComplement(pNode->p1)];
  5337	            continue;
  5338	        }
  5339	
  5340	        // skip primary inputs and secondary nodes if mapping with choices
  5341	        if ( !Map_NodeIsAnd( pNode ) || pNode->pRepr )
  5342	            continue;
  5343	
  5344	        // make sure that at least one non-trival cut is present
  5345	        if ( pNode->pCuts->pNext == NULL )
  5346	        {
  5347	            Extra_ProgressBarStop( pProgress );
  5348	            printf( "\nError: A node in the mapping graph does not have feasible cuts.\n" );
  5349	            return 0;
  5350	        }
  5351	
  5352	        // match negative phase
  5353	        if ( !Map_MatchNodePhase( p, pNode, 0 ) )
  5354	        {
  5355	            Extra_ProgressBarStop( pProgress );
  5356	            return 0;
  5357	        }
  5358	        // match positive phase
  5359	        if ( !Map_MatchNodePhase( p, pNode, 1 ) )
  5360	        {
  5361	            Extra_ProgressBarStop( pProgress );
  5362	            return 0;
  5363	        }
  5364	
  5365	        // make sure that at least one phase is mapped
  5366	        if ( pNode->pCutBest[0] == NULL && pNode->pCutBest[1] == NULL )
  5367	        {
  5368	            printf( "\nError: Could not match both phases of AIG node %d.\n", pNode->Num );
