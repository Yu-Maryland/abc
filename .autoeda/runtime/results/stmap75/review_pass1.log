    21	
    22	  Synopsis    [Runs the stmap75 mapper selected-match diagnostic.]
    23	
    24	  Description [stmap75 keeps the reviewed stmap65 mapping policy unchanged
    25	  and watches the mapper-selected cut/supergate records for the final-critical
    26	  AIG IDs identified by stmap74.]
    27	
    28	  SideEffects []
    29	
    30	  SeeAlso     []
    31	
    32	***********************************************************************/
    33	int Abc_CommandStmap75( Abc_Frame_t * pAbc, int argc, char ** argv )
    34	{
    35	    Abc_Ntk_t * pNtkRes;
    36	    int i, RetValue;
    37	    extern int Abc_CommandStmap65( Abc_Frame_t * pAbc, int argc, char ** argv );
    38	    extern void Map_Stmap75SetFinalCriticalAigDiag( int fEnable );
    39	    extern void Map_Stmap75PrintFinalCriticalAigSummary( void );
    40	    extern void Abc_Stmap74EnableFinalCriticalScope( Abc_Ntk_t * pNtk, const char * pLabel );
    41	
    42	    for ( i = 1; i < argc; i++ )
    43	    {
    44	        if ( !strcmp( argv[i], "-h" ) )
    45	            goto usage;
    46	    }
    47	
    48	    printf( "stmap75 diagnostic: inherited-policy = stmap65  mapper-selected-match-watch = 1  watch-aigs = 855,5219,11491,18002  source = stmap74-final-critical-top-aigs  mapping-policy-change = 0\n" );
    49	    Map_Stmap75SetFinalCriticalAigDiag( 1 );
    50	    RetValue = Abc_CommandStmap65( pAbc, argc, argv );
    51	    Map_Stmap75PrintFinalCriticalAigSummary();
    52	    Map_Stmap75SetFinalCriticalAigDiag( 0 );
    53	    if ( RetValue == 0 )
