  1935	static void Map_Stmap75PrintSelectedMatches( Map_Man_t * p, Map_Node_t * pNode )
  1936	{
  1937	    Map_Cut_t * pCut;
  1938	    Map_Match_t * pMatch;
  1939	    Mio_Gate_t * pGate;
  1940	    float NodePressureRatio, CutPressureRatio, LeafLoadAvg, LoadDriveRatio;
  1941	    float Arrival, Required, Slack, AreaFlow;
  1942	    int Phase, AigId, WatchIndex, FanLimit, Leaves, LeafNode[6], LeafAigId[6], i;
  1943	
  1944	    if ( !s_fStmap75FinalCriticalAigDiag || p == NULL || pNode == NULL )
  1945	        return;
  1946	    NodePressureRatio = Map_MatchStmap45NodePressureRatio( pNode, &AigId );
  1947	    WatchIndex = Map_Stmap75WatchIndex( AigId );
  1948	    if ( WatchIndex < 0 )
  1949	        return;
  1950	    for ( Phase = 0; Phase < 2; Phase++ )
  1951	    {
  1952	        pCut = pNode->pCutBest[Phase];
  1953	        if ( pCut == NULL )
  1954	            continue;
  1955	        pMatch = pCut->M + Phase;
  1956	        if ( pMatch->pSuperBest == NULL )
  1957	            continue;
  1958	        pGate = pMatch->pSuperBest->pRoot;
  1959	        CutPressureRatio = Map_MatchStmap45CutPressureRatio( pCut );
  1960	        LeafLoadAvg = Map_MatchStmap32CutLeafLoadAvg( pCut );
  1961	        FanLimit = (int)pMatch->pSuperBest->nFanLimit;
  1962	        LoadDriveRatio = FanLimit > 0 ? LeafLoadAvg / (float)FanLimit : LeafLoadAvg;
  1963	        Arrival = pMatch->tArrive.Worst;
  1964	        Required = pNode->tRequired[Phase].Worst;
  1965	        if ( Required > MAP_FLOAT_LARGE / 2 )
  1966	        {
  1967	            Required = -1.0;
  1968	            Slack = 0.0;
  1969	        }
  1970	        else
  1971	            Slack = Required - Arrival;
  1972	        AreaFlow = pMatch->AreaFlow;
  1973	        Leaves = (int)pCut->nLeaves;
  1974	        for ( i = 0; i < 6; i++ )
  1975	            Map_Stmap75ReadLeaf( pCut, i, LeafNode + i, LeafAigId + i );
  1976	        s_nStmap75SelectedMatchRows++;
  1977	        s_Stmap75WatchHitCounts[WatchIndex]++;
  1978	        printf( "stmap75 selected-match: index = %d  watch-index = %d  mapper-mode = %d  node = %d  aig-id = %d  level = %u  refs = %d  phase = %d  gate = %s  leaves = %d  cut-leaf-load-avg = %.3f  fanout-limit = %d  load-drive-ratio = %.3f  arrival = %.6f  required = %.6f  slack = %.6f  area-flow = %.6f  u-phase-best = %u  node-sink-pressure-ratio = %.3f  cut-sink-pressure-ratio = %.3f  scl-feedback = %.3f  leaf0-node = %d  leaf0-aig-id = %d  leaf1-node = %d  leaf1-aig-id = %d  leaf2-node = %d  leaf2-aig-id = %d  leaf3-node = %d  leaf3-aig-id = %d  leaf4-node = %d  leaf4-aig-id = %d  leaf5-node = %d  leaf5-aig-id = %d\n",
  1979	            s_nStmap75SelectedMatchRows, WatchIndex, p->fMappingMode, pNode->Num, AigId,
  1980	            pNode->Level, pNode->nRefs, Phase, pGate ? Mio_GateReadName(pGate) : "?",
  1981	            Leaves, LeafLoadAvg, FanLimit, LoadDriveRatio, Arrival, Required, Slack, AreaFlow,
  1982	            pMatch->uPhaseBest, NodePressureRatio, CutPressureRatio, s_Stmap45SclFeedback,
  1983	            LeafNode[0], LeafAigId[0], LeafNode[1], LeafAigId[1], LeafNode[2], LeafAigId[2],
  1984	            LeafNode[3], LeafAigId[3], LeafNode[4], LeafAigId[4], LeafNode[5], LeafAigId[5] );
  1985	    }
