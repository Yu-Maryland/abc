     NodeAigId = Map_NodeReadAigId( pNode );
     for ( i = 0; i < (int)pCut->nLeaves; i++ )
     {
         pLeaf = Map_Regular( pCut->ppLeaves[i] );
         if ( pLeaf == NULL )
