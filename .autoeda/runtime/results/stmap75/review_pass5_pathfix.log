+static int Map_Stmap75WatchIndex( int AigId )
+{
+    int i;
+    if ( !s_fStmap75FinalCriticalAigDiag )
+        return -1;
+    for ( i = 0; i < s_nStmap75ActiveWatchAigs; i++ )
