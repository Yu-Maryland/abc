    extern void Map_Stmap80PrintCandidateCutSummary( void );
    extern void Map_Stmap81SetParentPhaseBias( int fEnable, const char * pLabel, int ParentAigId, int ChildAigId );
    extern void Map_Stmap81PrintParentPhaseBiasSummary( void );

    for ( i = 1; i < argc; i++ )
    {
        if ( !strcmp( argv[i], "-h" ) )
            goto usage;
    }

    pNtk = Abc_FrameReadNtk( pAbc );
    Abc_Stmap81WatchAigsForNetwork( pNtk, &ChildAigId, &ParentAigId );
    WatchAigs[0] = ChildAigId;
    printf( "stmap81 diagnostic: inherited-policy = stmap65  mapper-selected-match-watch = %d  network = %s  child-aig = %d  parent-aig = %d  source = stmap80-parent-phase0-policy-probe  reconstruction-phase-trace = 1  demand-path-trace = 1  parent-cut-trace = 1  candidate-cut-trace = 1  parent-phase-bias = 1  final-phase-survival = 1  mapping-policy-change = watched-parent-child-phase0-window\n",
