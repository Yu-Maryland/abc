        Abc_Stmap74EnableFinalCriticalScope( pNtkRes, "stmap81" );
        Abc_Stmap76EnablePhaseSurvivalScope( pNtkRes, "stmap81", WatchAigs, ChildAigId >= 0 ? 1 : 0 );
    }
