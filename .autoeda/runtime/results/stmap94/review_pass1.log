        if ( Map_Stmap93EmittedDriveTargetPostSticky() )
            fAccepted = Map_Stmap93MaybeTargetEmittedDrive( p, pNode, pCut, pCutBest, fPhase, CutOrdinal, pMatch, &MatchBest, fAccepted );
