/**Function*************************************************************

  Synopsis    [Runs the stmap93 relaxed exact-area emitted-AIG drive/load target probe.]

  Description [stmap93 targets the final-critical emitted AIG/phase and allows
  a bounded exact-area premium when the stronger-drive candidate is otherwise
  blocked by zero-area best bookkeeping.]

  SideEffects []

  SeeAlso     []

***********************************************************************/
int Abc_CommandStmap93( Abc_Frame_t * pAbc, int argc, char ** argv )
{
    Abc_Ntk_t * pNtk, * pNtkRes;
    int i, RetValue, ChildAigId, ParentAigId, ChildPhase, ParentPhase, WatchAigs[2], nWatchAigs = 0;
    extern int Abc_CommandStmap65( Abc_Frame_t * pAbc, int argc, char ** argv );
    extern void Map_Stmap75SetFinalCriticalAigDiag( int fEnable, int WatchAigId );
    extern void Map_Stmap75SetFinalCriticalAigDiagArray( int fEnable, int * pWatchAigIds, int nWatchAigs );
    extern void Map_Stmap75SetFinalCriticalAigDiagLabel( const char * pLabel );
    extern void Map_Stmap75PrintFinalCriticalAigSummary( void );
    extern void Abc_Stmap74EnableFinalCriticalScope( Abc_Ntk_t * pNtk, const char * pLabel );
    extern void Abc_Stmap76EnablePhaseSurvivalScope( Abc_Ntk_t * pNtk, const char * pLabel, int * pWatchAigIds, int nWatchAigs );
    extern void Abc_Stmap77SetReconstructionDiag( int fEnable, const char * pLabel, int * pWatchAigIds, int nWatchAigs );
    extern void Abc_Stmap77PrintReconstructionSummary( void );
    extern void Abc_Stmap78SetDemandPathDiag( int fEnable, const char * pLabel, int WatchAigId, int DownstreamAigId );
    extern void Abc_Stmap78PrintDemandPathSummary( void );
    extern void Abc_Stmap79SetParentCutDiag( int fEnable, const char * pLabel, int ChildAigId, int ParentAigId );
    extern void Abc_Stmap79PrintParentCutSummary( void );
    extern void Map_Stmap80SetCandidateCutDiag( int fEnable, const char * pLabel, int ParentAigId, int ChildAigId );
    extern void Map_Stmap80PrintCandidateCutSummary( void );
    extern void Map_Stmap93SetEmittedDriveTarget( int fEnable, const char * pLabel, int AigId, int Phase );
    extern void Map_Stmap93PrintEmittedDriveTargetSummary( void );

    for ( i = 1; i < argc; i++ )
    {
        if ( !strcmp( argv[i], "-h" ) )
            goto usage;
    }

    pNtk = Abc_FrameReadNtk( pAbc );
    Abc_Stmap93WatchAigsForNetwork( pNtk, &ChildAigId, &ParentAigId, &ChildPhase, &ParentPhase );
    if ( ChildAigId >= 0 )
        WatchAigs[nWatchAigs++] = ChildAigId;
    if ( ParentAigId >= 0 )
        WatchAigs[nWatchAigs++] = ParentAigId;
    printf( "stmap93 diagnostic: inherited-policy = stmap65  mapper-selected-match-watch = %d  network = %s  final-critical-aig = %d  downstream-aig = %d  selected-watch-count = %d  dual-phase-survival-watch-count = %d  emitted-drive-target = %d  target-phase = %d  source = stmap93-relaxed-exact-area-emitted-drive-load-policy-probe  reconstruction-phase-trace = 1  demand-path-trace = 1  parent-cut-trace = 1  candidate-cut-trace = 1  final-phase-survival = 1  mapping-policy-change = watched-final-critical-relaxed-exact-area-emitted-drive-load-target\n",
        nWatchAigs > 0, pNtk && Abc_NtkName(pNtk) ? Abc_NtkName(pNtk) : "?",
        ChildAigId, ParentAigId, nWatchAigs, nWatchAigs,
        ChildAigId >= 0, ChildPhase );
    Map_Stmap75SetFinalCriticalAigDiagArray( nWatchAigs > 0, WatchAigs, nWatchAigs );
    Map_Stmap75SetFinalCriticalAigDiagLabel( "stmap93" );
    Abc_Stmap77SetReconstructionDiag( nWatchAigs > 0, "stmap93", WatchAigs, nWatchAigs );
    Abc_Stmap78SetDemandPathDiag( ChildAigId >= 0, "stmap93", ChildAigId, ParentAigId );
    Abc_Stmap79SetParentCutDiag( ChildAigId >= 0, "stmap93", ChildAigId, ParentAigId );
    Map_Stmap80SetCandidateCutDiag( ChildAigId >= 0, "stmap93", ParentAigId, ChildAigId );
    Map_Stmap93SetEmittedDriveTarget( ChildAigId >= 0, "stmap93", ChildAigId, ChildPhase );
    RetValue = Abc_CommandStmap65( pAbc, argc, argv );
    Abc_Stmap77PrintReconstructionSummary();
    Abc_Stmap78PrintDemandPathSummary();
    Abc_Stmap79PrintParentCutSummary();
    Map_Stmap80PrintCandidateCutSummary();
    Map_Stmap93PrintEmittedDriveTargetSummary();
    Map_Stmap93SetEmittedDriveTarget( 0, "stmap93", -1, 0 );
    Map_Stmap80SetCandidateCutDiag( 0, "stmap93", -1, -1 );
    Abc_Stmap79SetParentCutDiag( 0, "stmap93", -1, -1 );
    Abc_Stmap78SetDemandPathDiag( 0, "stmap93", -1, -1 );
    Abc_Stmap77SetReconstructionDiag( 0, "stmap93", NULL, 0 );
    Map_Stmap75PrintFinalCriticalAigSummary();
    Map_Stmap75SetFinalCriticalAigDiag( 0, -1 );
    if ( RetValue == 0 )
    {
        pNtkRes = Abc_FrameReadNtk( pAbc );
        Abc_Stmap74EnableFinalCriticalScope( pNtkRes, "stmap93" );
        Abc_Stmap76EnablePhaseSurvivalScope( pNtkRes, "stmap93", WatchAigs, nWatchAigs );
    }
    return RetValue;

usage:
    Abc_Print( -2, "usage: stmap93 [-DABFSG float] [-M num] [-arspfuovh]\n" );
    Abc_Print( -2, "\t              performs stmap93 bounded-pressure mapping with relaxed exact-area final-critical emitted-AIG drive/load targeting\n" );
