        if ( pWatchAigIds != NULL && pWatchAigIds[i] >= 0 )
            s_Stmap75WatchAigIds[s_nStmap75ActiveWatchAigs++] = pWatchAigIds[i];
    s_fStmap75FinalCriticalAigDiag = s_nStmap75ActiveWatchAigs > 0;
}

