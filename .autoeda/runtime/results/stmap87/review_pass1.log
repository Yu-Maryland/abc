   162	    Abc_Print( -2, "\t-G float : the SCL/genlib gain parameter used to generate the library [default = 250.00]\n" );
   163	    Abc_Print( -2, "\t-M num   : skip gate classes whose size is less than this [default = 0]\n" );
   164	    Abc_Print( -2, "\t-a       : toggles area-only mapping [default = no]\n" );
   165	    Abc_Print( -2, "\t-r       : toggles area recovery [default = yes]\n" );
   166	    Abc_Print( -2, "\t-s       : toggles sweep after mapping [default = no]\n" );
   167	    Abc_Print( -2, "\t-p       : optimizes power by minimizing switching [default = no]\n" );
   168	    Abc_Print( -2, "\t-f       : disables the bounded-pressure SCL feedback mapper mode [default = yes]\n" );
   169	    Abc_Print( -2, "\t-u       : use standard-cell profile [default = no]\n" );
   170	    Abc_Print( -2, "\t-o       : toggles using buffers to decouple combinational outputs [default = no]\n" );
   171	    Abc_Print( -2, "\t-v       : toggles verbose output [default = no]\n" );
   172	    Abc_Print( -2, "\t-h       : print the command usage\n" );
   173	    return 1;
