void Map_Stmap75SetFinalCriticalAigDiag( int fEnable, int WatchAigId )
{
    if ( fEnable )
    {
        Map_Stmap75ResetFinalCriticalAigDiagState();
        s_nStmap75ActiveWatchAigs = WatchAigId >= 0 ? 1 : 0;
        if ( WatchAigId >= 0 )
