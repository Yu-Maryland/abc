+static void Map_Stmap87ResetParentPhaseTargetCounters( void )
+{
+    s_nStmap87TargetRows = 0;
+    s_nStmap87TargetChildHits = 0;
+    s_nStmap87TargetEligible = 0;
+    s_nStmap87TargetOverrides = 0;
