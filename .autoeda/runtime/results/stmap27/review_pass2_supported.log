   424	/**Function*************************************************************
   425	
   426	  Synopsis    [Returns 1 if stmap27 should admit a signature-safe seed.]
   427	
   428	  Description []
   429	
   430	  SideEffects []

---
   500	  which uses the one-inverter post-profile threshold only for candidates with
   501	  materially better mapper arrival. Mode 19 is stmap18, which keeps mode 18
   502	  decisions and adds near-miss diagnostics for candidates rejected by the
   503	  timing-quality/profile fallback. Mode 20 is stmap19, which allows the
   504	  one-inverter threshold before profile-open only for candidates with the same
   505	  material mapper-arrival improvement. Mode 21 is stmap20, which keeps the
   506	  mode 20 pre-profile seed but restricts it to shallow nodes. Mode 22 is
   507	  stmap21, which keeps the shallow seed and admits deeper pre-profile seeds
   508	  only when the arrival gain is unusually large. Mode 23 is stmap22, which
   509	  relaxes the deep pre-profile seed boundary to a moderate arrival gain. Mode
   510	  24 is stmap23, which keeps the strong deep seeds but allows moderate deep
   511	  seeds only when the existing mapper slack is near the critical side of the
   512	  middle-slack window. Mode 25 is stmap24, which tightens the moderate deep
   513	  slack gate to the lower edge of that critical window. Mode 26 is stmap25,
   514	  which keeps stmap24 and admits at most one moderate deep seed from the next
   515	  slack band as an ablation diagnostic. Mode 27 is stmap26, which skips the
   516	  first such moderate seed and admits only the second qualifying seed. Mode 28
   517	  is stmap27, which reopens the next slack band except for the high-reference,
   518	  low-slack, stronger-moderate signature isolated by stmap26.]
   519	
   520	  SideEffects []
   521	
   522	  SeeAlso     []
   523	
   524	***********************************************************************/
   525	static int Map_MatchSkipCutForFanout( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase )
   526	{
   527	    Map_Cut_t * pCutBest;
   528	    Map_Match_t * pMatchBest;
   529	    float Slack, SlackMargin, SlackLimit;
   530	
   531	    if ( !p->fSkipFanout )
   532	        return 0;
   533	    if ( p->fSkipFanout == 2 )
   534	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   535	    if ( p->fSkipFanout == 3 )
   536	    {
   537	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   538	            return 0;
   539	        pCutBest = pNode->pCutBest[fPhase];
   540	        if ( pCutBest == NULL )
   541	            return 0;
   542	        pMatchBest = pCutBest->M + fPhase;
   543	        if ( pMatchBest->pSuperBest == NULL )
   544	            return 0;
   545	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   546	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   547	        if ( Slack <= SlackMargin + p->fEpsilon )
   548	            return 0;
   549	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   550	    }
   551	    if ( p->fSkipFanout == 4 )
   552	    {
   553	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   554	            return 0;
   555	        pCutBest = pNode->pCutBest[fPhase];
   556	        if ( pCutBest == NULL )
   557	            return 0;
   558	        pMatchBest = pCutBest->M + fPhase;
   559	        if ( pMatchBest->pSuperBest == NULL || p->pSuperLib == NULL )
   560	            return 0;
   561	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   562	        SlackMargin = p->pSuperLib->tDelayInv.Worst;
   563	        SlackLimit = 2.0 * SlackMargin;
   564	        if ( Slack <= p->fEpsilon || Slack > SlackLimit + p->fEpsilon )
   565	            return 0;
   566	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   567	    }
   568	    if ( p->fSkipFanout == 5 )
   569	    {
   570	        if ( p->fMappingMode == 0 )
   571	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   572	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   573	            return 0;
   574	        pCutBest = pNode->pCutBest[fPhase];
   575	        if ( pCutBest == NULL )
   576	            return 0;
   577	        pMatchBest = pCutBest->M + fPhase;
   578	        if ( pMatchBest->pSuperBest == NULL )
   579	            return 0;
   580	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   581	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   582	        if ( Slack <= SlackMargin + p->fEpsilon )
   583	            return 0;
   584	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   585	    }
   586	    if ( p->fSkipFanout == 6 )
   587	    {
   588	        if ( p->fMappingMode == 0 )
   589	        {
   590	            if ( p->vMapObjs->nSize <= 20000 )
   591	                return 0;
   592	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   593	        }
   594	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   595	            return 0;
   596	        pCutBest = pNode->pCutBest[fPhase];
   597	        if ( pCutBest == NULL )
   598	            return 0;
   599	        pMatchBest = pCutBest->M + fPhase;
   600	        if ( pMatchBest->pSuperBest == NULL )
   601	            return 0;
   602	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   603	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   604	        if ( Slack <= SlackMargin + p->fEpsilon )
   605	            return 0;
   606	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   607	    }
   608	    if ( p->fSkipFanout == 7 )
   609	    {
   610	        if ( p->fMappingMode == 0 )
   611	        {
   612	            if ( p->vMapObjs->nSize <= 20000 )
   613	                return 0;
   614	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   615	        }
   616	        if ( p->fMappingMode >= 1 && p->fMappingMode <= 3 && p->vMapObjs->nSize <= 8000 )
   617	        {
   618	            pCutBest = pNode->pCutBest[fPhase];
   619	            if ( pCutBest == NULL )
   620	                return 0;
   621	            pMatchBest = pCutBest->M + fPhase;
   622	            if ( pMatchBest->pSuperBest == NULL )
   623	                return 0;
   624	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   625	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   626	            if ( Slack <= SlackMargin + p->fEpsilon )
   627	                return 0;
   628	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   629	        }
   630	        if ( p->fMappingMode == 1 )
   631	        {
   632	            pCutBest = pNode->pCutBest[fPhase];
   633	            if ( pCutBest == NULL )
   634	                return 0;
   635	            pMatchBest = pCutBest->M + fPhase;
   636	            if ( pMatchBest->pSuperBest == NULL )
   637	                return 0;
   638	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   639	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   640	            if ( Slack <= SlackMargin + p->fEpsilon )
   641	                return 0;
   642	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   643	        }
   644	        return 0;
   645	    }
   646	    if ( p->fSkipFanout >= 8 && p->fSkipFanout <= 28 )
   647	    {
   648	        if ( p->fMappingMode == 0 )
   649	        {
   650	            if ( p->vMapObjs->nSize <= 20000 )
   651	                return 0;
   652	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   653	        }
   654	        if ( p->fMappingMode >= 1 && p->fMappingMode <= 3 && p->vMapObjs->nSize <= 8000 )
   655	        {
   656	            pCutBest = pNode->pCutBest[fPhase];
   657	            if ( pCutBest == NULL )
   658	                return 0;
   659	            pMatchBest = pCutBest->M + fPhase;
   660	            if ( pMatchBest->pSuperBest == NULL )
   661	                return 0;
   662	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   663	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   664	            if ( Slack <= SlackMargin + p->fEpsilon )
   665	                return 0;
   666	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   667	        }
   668	        if ( p->fMappingMode == 1 )
   669	        {
   670	            pCutBest = pNode->pCutBest[fPhase];
   671	            if ( pCutBest == NULL )
   672	                return 0;
   673	            pMatchBest = pCutBest->M + fPhase;
   674	            if ( pMatchBest->pSuperBest == NULL )
   675	                return 0;
   676	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   677	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   678	            if ( Slack <= SlackMargin + p->fEpsilon )
   679	                return 0;
   680	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   681	        }
   682	        return 0;
   683	    }
   684	    return (pNode->nRefs > 3 && pCut->nLeaves > 2) || (pNode->nRefs > 1 && pCut->nLeaves > 3);
   685	}
