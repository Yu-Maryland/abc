   687	/**Function*************************************************************
   688	
   689	  Synopsis    [Returns 1 if an stmap area-sensitive mode should reject a cut.]
   690	
   691	  Description [The area-sensitive guards are evaluated after matching the
   692	  candidate cut because their hypotheses need the candidate's actual mapper
   693	  area. In stmap6 exact-area recovery, a wide high-fanout cut is rejected only
   694	  when the existing match has slack and the candidate does not save at least
   695	  half an inverter area. In stmap7, the area-saving override additionally
   696	  requires more than two inverter delays of slack and excludes the highest
   697	  fanout-risk bucket. In stmap8, the override is further rejected when the
   698	  candidate match worsens mapper arrival by more than one quarter of an
   699	  inverter delay. In stmap9, middle-slack candidates can recover area only
   700	  when they are outside the highest fanout bucket, do not worsen mapper
   701	  arrival, and save at least one inverter area. In stmap10, that middle-slack
   702	  relief also requires the mapper node to be no deeper than level 96. In
   703	  stmap11, that depth window is tightened to level 64. In stmap12, the same
   704	  tight-depth relief is allowed only in the lower moderate fanout bucket. In
   705	  stmap13, the same decision path also records exact-area guard statistics. In
   706	  stmap14, the lower-moderate middle-slack relief must save two inverter areas
   707	  instead of one. In stmap15, one-inverter relief is restored only after the
   708	  mapper observes a high lower-moderate/middle-slack profile. In stmap16, the
   709	  same behavior also reports each admitted relief choice. In stmap17, the
   710	  adaptive one-inverter relief threshold also requires a material mapper-arrival
   711	  improvement; arrival-neutral choices keep the stricter two-inverter fallback.
   712	  In stmap18, the same decisions are preserved while near-miss rejected
   713	  middle-slack candidates are logged. In stmap19, pre-profile one-inverter
   714	  relief is seeded only by candidates with the same material arrival gain. In
   715	  stmap20, the pre-profile seed is further limited to shallow nodes. In
   716	  stmap21, deeper pre-profile seeds are allowed only with a much larger mapper
   717	  arrival gain. In stmap22, the same deep-seed path is relaxed to a moderate
   718	  mapper-arrival gain. In stmap23, moderate deep seeds also need near-critical
   719	  existing mapper slack. In stmap24, the moderate deep slack gate is tightened
   720	  to the lower edge of the critical slack window. In stmap25, the stmap24 rule
   721	  is kept, and one moderate deep seed from the next slack band is admitted for
   722	  ablation. In stmap26, the first such moderate seed is skipped and only the
   723	  second qualifying seed is admitted. In stmap27, moderate deep candidates in
   724	  the next slack band are admitted unless they match the high-reference,
   725	  low-slack, stronger-moderate signature isolated by stmap26.]
   726	
   727	  SideEffects []
   728	
   729	  SeeAlso     []
   730	
   731	***********************************************************************/
   732	static int Map_MatchSkipAreaSensitiveFanout( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase, Map_Match_t * pMatchBest, Map_Match_t * pMatch )
   733	{
   734	    float Slack, SlackMargin, SlackGate, ArrivalMargin, ArrivalDelta, ArrivalGainMargin, AreaMargin, AreaSave, OneInvArea;
   735	    const char * pReason;
   736	    int fMiddleReliefWindow, fStmap13, fProfileOpen, fArrivalQuality, fStrictFallback;
   737	    int fStmap25ModerateAblation, fStmap26ModerateAblationCandidate, fStmap26ModerateAblation;
   738	    int fStmap27ModerateSignatureSeed, fStmap27ModerateSignatureBlocked;
   739	
   740	    if ( p->fSkipFanout < 7 || p->fSkipFanout > 28 )
   741	        return 0;
   742	    if ( p->fMappingMode < 2 || p->fMappingMode > 3 )
   743	        return 0;
   744	    if ( p->vMapObjs->nSize <= 8000 )
   745	        return 0;
   746	    if ( !Map_MatchCutHasStmapFanoutRisk( pNode, pCut ) )
   747	        return 0;
   748	    fStmap13 = (p->fSkipFanout >= 14 && p->fSkipFanout <= 28);
   749	    Map_MatchStmap13CountRisk( p, pNode, pCut );
   750	    if ( pMatchBest == NULL || pMatchBest->pSuperBest == NULL || pMatch == NULL || pMatch->pSuperBest == NULL )
   751	        return 0;
   752	    Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   753	    SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   754	    ArrivalDelta = pMatch->tArrive.Worst - pMatchBest->tArrive.Worst;
   755	    ArrivalGainMargin = 0.25 * SlackMargin;
   756	    fArrivalQuality = ArrivalDelta <= -ArrivalGainMargin - p->fEpsilon;
   757	    if ( p->fSkipFanout >= 8 && p->fSkipFanout <= 28 )
   758	    {
   759	        SlackGate = 2.0 * SlackMargin;
   760	        fMiddleReliefWindow =
   761	             (p->fSkipFanout >= 10 && p->fSkipFanout <= 28) &&
   762	             Slack > SlackMargin + p->fEpsilon &&
   763	             Slack <= SlackGate + p->fEpsilon &&
   764	             !Map_MatchCutHasStmapHighestFanoutRisk( pNode, pCut ) &&
   765	             Map_MatchNodeHasStmapMiddleSlackRelief( p->fSkipFanout, pNode ) &&
   766	             (p->fSkipFanout < 13 || Map_MatchCutHasStmapLowerModerateFanoutRisk( pNode, pCut )) &&
   767	             pMatch->tArrive.Worst <= pMatchBest->tArrive.Worst + p->fEpsilon;
   768	        if ( fMiddleReliefWindow )
   769	        {
   770	            if ( fStmap13 )
   771	                p->nStmap13MiddleSlack++;
   772	            fProfileOpen = Map_MatchHasStmap15ReliefProfile( p );
   773	            fStmap25ModerateAblation =
   774	                p->fSkipFanout == 26 &&
   775	                !fProfileOpen &&
   776	                !Map_MatchNodeHasStmap20EarlySeedDepth( pNode ) &&
   777	                Map_MatchIsStmap25ModerateAblationSeed( p, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, p->fEpsilon );
   778	            fStmap26ModerateAblationCandidate =
   779	                p->fSkipFanout == 27 &&
   780	                !fProfileOpen &&
   781	                !Map_MatchNodeHasStmap20EarlySeedDepth( pNode ) &&
   782	                Map_MatchIsStmap26ModerateAblationCandidate( ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, p->fEpsilon );
   783	            fStmap26ModerateAblation =
   784	                fStmap26ModerateAblationCandidate &&
   785	                Map_MatchIsStmap26RankTwoModerateAblationSeed( p, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, p->fEpsilon );
   786	            fStmap27ModerateSignatureSeed =
   787	                p->fSkipFanout == 28 &&
   788	                !fProfileOpen &&
   789	                !Map_MatchNodeHasStmap20EarlySeedDepth( pNode ) &&
   790	                Map_MatchIsStmap27SignatureSafeModerateSeed( pNode, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, p->fEpsilon );
   791	            fStmap27ModerateSignatureBlocked =
   792	                p->fSkipFanout == 28 &&
   793	                !fProfileOpen &&
   794	                !Map_MatchNodeHasStmap20EarlySeedDepth( pNode ) &&
   795	                Map_MatchIsStmap27BlockedModerateSignature( pNode, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, p->fEpsilon );
   796	            fStrictFallback =
   797	                p->fSkipFanout == 15 ||
   798	                ((p->fSkipFanout == 16 || p->fSkipFanout == 17) && !fProfileOpen) ||
   799	                ((p->fSkipFanout == 18 || p->fSkipFanout == 19) && (!fProfileOpen || !fArrivalQuality)) ||
   800	                (p->fSkipFanout == 20 && !fArrivalQuality) ||
   801	                (p->fSkipFanout == 21 && (!fArrivalQuality || (!fProfileOpen && !Map_MatchNodeHasStmap20EarlySeedDepth( pNode )))) ||
   802	                (p->fSkipFanout == 22 && (!fArrivalQuality || (!fProfileOpen && !Map_MatchNodeHasStmap20EarlySeedDepth( pNode ) && !Map_MatchHasStmap21DeepSeedGain( ArrivalDelta, ArrivalGainMargin, p->fEpsilon )))) ||
   803	                (p->fSkipFanout == 23 && (!fArrivalQuality || (!fProfileOpen && !Map_MatchNodeHasStmap20EarlySeedDepth( pNode ) && !Map_MatchHasStmap22ModerateDeepSeedGain( ArrivalDelta, ArrivalGainMargin, p->fEpsilon )))) ||
   804	                (p->fSkipFanout == 24 && (!fArrivalQuality || (!fProfileOpen && !Map_MatchNodeHasStmap20EarlySeedDepth( pNode ) && !Map_MatchHasStmap23CriticalModerateDeepSeed( ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, p->fEpsilon )))) ||
   805	                (p->fSkipFanout == 25 && (!fArrivalQuality || (!fProfileOpen && !Map_MatchNodeHasStmap20EarlySeedDepth( pNode ) && !Map_MatchHasStmap24TightCriticalModerateDeepSeed( ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, p->fEpsilon )))) ||
   806	                (p->fSkipFanout == 26 && (!fArrivalQuality || (!fProfileOpen && !Map_MatchNodeHasStmap20EarlySeedDepth( pNode ) && !Map_MatchHasStmap25SingleModerateDeepSeed( p, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, p->fEpsilon )))) ||
   807	                (p->fSkipFanout == 27 && (!fArrivalQuality || (!fProfileOpen && !Map_MatchNodeHasStmap20EarlySeedDepth( pNode ) && !Map_MatchHasStmap26RankTwoModerateDeepSeed( p, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, p->fEpsilon )))) ||
   808	                (p->fSkipFanout == 28 && (!fArrivalQuality || (!fProfileOpen && !Map_MatchNodeHasStmap20EarlySeedDepth( pNode ) && !Map_MatchHasStmap27SignatureSafeModerateDeepSeed( pNode, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, p->fEpsilon ))));
   809	            AreaMargin = p->pSuperLib ? (fStrictFallback ? 2.0 : 1.0) * p->pSuperLib->AreaInv : 0.0;
   810	            AreaSave = pMatchBest->AreaFlow - pMatch->AreaFlow;
   811	            OneInvArea = p->pSuperLib ? p->pSuperLib->AreaInv : 0.0;
   812	            if ( AreaSave > AreaMargin + p->fEpsilon )
   813	            {
   814	                if ( fStmap13 )
   815	                    p->nStmap13MiddleRelief++;
   816	                if ( p->fSkipFanout == 17 )
   817	                    printf( "stmap16 relief diag: index = %d  profile-open = %d  node = %d  level = %u  refs = %d  leaves = %d  phase = %d  slack = %.6f  area-save = %.6f  arrival-delta = %.6f  area-margin = %.6f\n",
   818	                        p->nStmap13MiddleRelief, fProfileOpen, pNode->Num, pNode->Level, pNode->nRefs,
   819	                        pCut->nLeaves, fPhase, Slack, pMatchBest->AreaFlow - pMatch->AreaFlow,
