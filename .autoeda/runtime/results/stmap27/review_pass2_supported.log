    46	/**Function*************************************************************
    47	
    48	  Synopsis    [Cleans the match.]
    49	
    50	  Description []
    51	               
    52	  SideEffects []
    53	
    54	  SeeAlso     []
    55	
    56	***********************************************************************/
    57	void Map_MatchClean( Map_Match_t * pMatch )
    58	{
    59	    memset( pMatch, 0, sizeof(Map_Match_t) );
    60	    pMatch->AreaFlow          = MAP_FLOAT_LARGE; // unassigned
    61	    pMatch->tArrive.Rise   = MAP_FLOAT_LARGE; // unassigned
    62	    pMatch->tArrive.Fall   = MAP_FLOAT_LARGE; // unassigned
    63	    pMatch->tArrive.Worst  = MAP_FLOAT_LARGE; // unassigned
    64	}
    65	
    66	/**Function*************************************************************
    67	
    68	  Synopsis    [Returns 1 if the cut is a high-fanout wide-cut risk.]
    69	
    70	  Description []
    71	
    72	  SideEffects []
    73	
    74	  SeeAlso     []
    75	
    76	***********************************************************************/
    77	static int Map_MatchCutHasStmapFanoutRisk( Map_Node_t * pNode, Map_Cut_t * pCut )
    78	{
    79	    return (pNode->nRefs > 6 && pCut->nLeaves > 2) || (pNode->nRefs > 3 && pCut->nLeaves > 3);
    80	}
    81	
    82	/**Function*************************************************************
    83	
    84	  Synopsis    [Returns 1 if the cut is in the highest stmap fanout bucket.]
    85	
    86	  Description []
    87	
    88	  SideEffects []
    89	
    90	  SeeAlso     []
    91	
    92	***********************************************************************/
    93	static int Map_MatchCutHasStmapHighestFanoutRisk( Map_Node_t * pNode, Map_Cut_t * pCut )
    94	{
    95	    return pNode->nRefs > 6 && pCut->nLeaves > 2;
    96	}
    97	
