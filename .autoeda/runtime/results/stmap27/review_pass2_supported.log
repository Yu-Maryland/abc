  1038	    for ( pSuper = pMatch->pSupers, Counter = 0; pSuper; pSuper = pSuper->pNext, Counter++ )
  1039	    {
  1040	        p->nMatches++;
  1041	        // this is an attempt to reduce the runtime of matching and area 
  1042	        // at the cost of rare and very minor increase in delay
  1043	        // (the supergates are sorted by increasing area)
  1044	        if ( Counter == 30 )
  1045	           break;
  1046	
  1047	        // go through different phases of the given match and supergate
  1048	        pMatch->pSuperBest = pSuper;
  1049	        for ( i = 0; i < (int)pSuper->nPhases; i++ )
  1050	        {
  1051	            p->nPhases++;
  1052	            // find the overall phase of this match
  1053	            pMatch->uPhaseBest = pMatch->uPhase ^ pSuper->uPhases[i];
  1054	            if ( p->fMappingMode == 0 )
  1055	            {
  1056	                // get the arrival time
  1057	                Map_TimeCutComputeArrival( pNode, pCut, fPhase, fWorstLimit );
  1058	                // skip the cut if the arrival times exceed the required times
  1059	                if ( pMatch->tArrive.Worst > fWorstLimit + p->fEpsilon )
  1060	                    continue;
  1061	                // get the area (area flow)
  1062	                pMatch->AreaFlow = Map_CutGetAreaFlow( pCut, fPhase );
  1063	            }
  1064	            else
  1065	            {
  1066	                // get the area (area flow)
  1067	                if ( p->fMappingMode == 2 || p->fMappingMode == 3 )
  1068	                    pMatch->AreaFlow = Map_CutGetAreaDerefed( pCut, fPhase );
  1069	                else if ( p->fMappingMode == 4 )
  1070	                    pMatch->AreaFlow = Map_SwitchCutGetDerefed( pNode, pCut, fPhase );
  1071	                else 
  1072	                    pMatch->AreaFlow = Map_CutGetAreaFlow( pCut, fPhase );
  1073	                // skip if the cut is too large
  1074	                if ( pMatch->AreaFlow > MatchBest.AreaFlow + p->fEpsilon )
  1075	                    continue;
  1076	                // get the arrival time
  1077	                Map_TimeCutComputeArrival( pNode, pCut, fPhase, fWorstLimit );
  1078	                // skip the cut if the arrival times exceed the required times
  1079	                if ( pMatch->tArrive.Worst > fWorstLimit + p->fEpsilon )
  1080	                    continue;
  1081	            }
