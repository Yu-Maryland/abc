   184	}
   185	
   186	/**Function*************************************************************
   187	
   188	  Synopsis    [Returns 1 if the stmap mode allows middle-slack relief here.]
   189	
   190	  Description []
   191	
   192	  SideEffects []
   193	
   194	  SeeAlso     []
   195	
   196	***********************************************************************/
   197	static int Map_MatchNodeHasStmapMiddleSlackRelief( int Mode, Map_Node_t * pNode )
   198	{
   199	    if ( Mode == 10 )
   200	        return 1;
   201	    if ( Mode == 11 )
   202	        return Map_MatchNodeHasStmapReliefDepth( pNode );
   203	    if ( Mode == 12 )
   204	        return Map_MatchNodeHasStmapTightReliefDepth( pNode );
   205	    if ( Mode >= 13 && Mode <= 28 )
   206	        return Map_MatchNodeHasStmapTightReliefDepth( pNode );
   207	    return 0;
   208	}
