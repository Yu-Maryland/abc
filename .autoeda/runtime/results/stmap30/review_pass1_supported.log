    20	/**Function*************************************************************
    21	
    22	  Synopsis    [Runs the stmap30 mapper probe.]
    23	
    24	  Description [stmap30 keeps the stmap29 continuous moderate-seed penalty and
    25	  extends a smaller continuous load-risk penalty to high-reference strong
    26	  deep seeds in the same middle-slack band.]
    27	
    28	  SideEffects []
    29	
    30	  SeeAlso     []
    31	
    32	***********************************************************************/
    33	int Abc_CommandStmap30( Abc_Frame_t * pAbc, int argc, char ** argv )
    34	{
    35	    Abc_Ntk_t * pNtk, * pNtkRes;
    36	    char Buffer[100];
    37	    double DelayTarget;
    38	    double AreaMulti;
    39	    double DelayMulti;
    40	    float LogFan = 0;
    41	    float Slew = 0; // choose based on the library
    42	    float Gain = 250; // keep classic map gain to isolate the strong-seed penalty
    43	    int nGatesMin = 0;
    44	    int fAreaOnly;
    45	    int fRecovery;
    46	    int fSweep;
    47	    int fSwitching;
    48	    int fSkipFanout;
    49	    int fUseProfile;
    50	    int fUseBuffs;
    51	    int fVerbose;
    52	    int c;
    53	    extern Abc_Ntk_t * Abc_NtkMap( Abc_Ntk_t * pNtk, Mio_Library_t* userLib, double DelayTarget, double AreaMulti, double DelayMulti, float LogFan, float Slew, float Gain, int nGatesMin, int fRecovery, int fSwitching, int fSkipFanout, int fUseProfile, int fUseBuffs, int fVerbose );
    54	    extern int Abc_NtkFraigSweep( Abc_Ntk_t * pNtk, int fUseInv, int fExdc, int fVerbose, int fVeryVerbose );
    55	
    56	    pNtk = Abc_FrameReadNtk(pAbc);
    57	    DelayTarget = -1;
    58	    AreaMulti   = 0;
    59	    DelayMulti  = 0;
    60	    fAreaOnly   = 0;
    61	    fRecovery   = 1;
    62	    fSweep      = 0;
    63	    fSwitching  = 0;
    64	    fSkipFanout = 31; // strong deep high-reference load penalty; -f disables it
    65	    fUseProfile = 0;
    66	    fUseBuffs   = 0;
    67	    fVerbose    = 0;
    68	    Extra_UtilGetoptReset();
    69	    while ( ( c = Extra_UtilGetopt( argc, argv, "DABFSGMarspfuovh" ) ) != EOF )
    70	    {
    71	        switch ( c )
    72	        {
    73	        case 'D':
    74	            if ( globalUtilOptind >= argc )
    75	            {
    76	                Abc_Print( -1, "Command line switch \"-D\" should be followed by a floating point number.\n" );
    77	                goto usage;
    78	            }
    79	            DelayTarget = (float)atof(argv[globalUtilOptind]);
    80	            globalUtilOptind++;
    81	            if ( DelayTarget <= 0.0 )
    82	                goto usage;
    83	            break;
    84	        case 'A':
    85	            if ( globalUtilOptind >= argc )
    86	            {
    87	                Abc_Print( -1, "Command line switch \"-A\" should be followed by a floating point number.\n" );
    88	                goto usage;
    89	            }
    90	            AreaMulti = (float)atof(argv[globalUtilOptind]);
    91	            globalUtilOptind++;
    92	            break;
    93	        case 'B':
    94	            if ( globalUtilOptind >= argc )
    95	            {
    96	                Abc_Print( -1, "Command line switch \"-B\" should be followed by a floating point number.\n" );
    97	                goto usage;
    98	            }
    99	            DelayMulti = (float)atof(argv[globalUtilOptind]);
   100	            globalUtilOptind++;
   101	            break;
   102	        case 'F':
   103	            if ( globalUtilOptind >= argc )
   104	            {
   105	                Abc_Print( -1, "Command line switch \"-F\" should be followed by a floating point number.\n" );
   106	                goto usage;
   107	            }
   108	            LogFan = (float)atof(argv[globalUtilOptind]);
   109	            globalUtilOptind++;
   110	            if ( LogFan < 0.0 )
   111	                goto usage;
   112	            break;
   113	        case 'S':
   114	            if ( globalUtilOptind >= argc )
   115	            {
   116	                Abc_Print( -1, "Command line switch \"-S\" should be followed by a floating point number.\n" );
   117	                goto usage;
   118	            }
   119	            Slew = (float)atof(argv[globalUtilOptind]);
   120	            globalUtilOptind++;
   121	            if ( Slew <= 0.0 )
   122	                goto usage;
   123	            break;
   124	        case 'G':
   125	            if ( globalUtilOptind >= argc )
   126	            {
   127	                Abc_Print( -1, "Command line switch \"-G\" should be followed by a floating point number.\n" );
   128	                goto usage;
   129	            }
   130	            Gain = (float)atof(argv[globalUtilOptind]);
   131	            globalUtilOptind++;
   132	            if ( Gain <= 0.0 )
   133	                goto usage;
   134	            break;
   135	        case 'M':
   136	            if ( globalUtilOptind >= argc )
   137	            {
   138	                Abc_Print( -1, "Command line switch \"-M\" should be followed by a positive integer.\n" );
   139	                goto usage;
   140	            }
   141	            nGatesMin = atoi(argv[globalUtilOptind]);
   142	            globalUtilOptind++;
   143	            if ( nGatesMin < 0 )
   144	                goto usage;
   145	            break;
   146	        case 'a':
   147	            fAreaOnly ^= 1;
   148	            break;
   149	        case 'r':
   150	            fRecovery ^= 1;
   151	            break;
   152	        case 's':
   153	            fSweep ^= 1;
   154	            break;
   155	        case 'p':
   156	            fSwitching ^= 1;
   157	            break;
   158	        case 'f':
   159	            fSkipFanout = fSkipFanout ? 0 : 31;
   160	            break;
   161	        case 'u':
   162	            fUseProfile ^= 1;
   163	            break;
   164	        case 'o':
   165	            fUseBuffs ^= 1;
   166	            break;
   167	        case 'v':
   168	            fVerbose ^= 1;
   169	            break;
   170	        case 'h':
   171	            goto usage;
   172	        default:
   173	            goto usage;
   174	        }
   175	    }
   176	
   177	    if ( pNtk == NULL )
   178	    {
   179	        Abc_Print( -1, "Empty network.\n" );
   180	        return 1;
   181	    }
   182	
   183	    if ( fAreaOnly )
   184	        DelayTarget = ABC_INFINITY;
   185	
   186	    if ( !Abc_NtkIsStrash(pNtk) )
   187	    {
   188	        pNtk = Abc_NtkStrash( pNtk, 0, 0, 0 );
   189	        if ( pNtk == NULL )
   190	        {
   191	            Abc_Print( -1, "Strashing before stmap30 has failed.\n" );
   192	            return 1;
   193	        }
   194	        pNtk = Abc_NtkBalance( pNtkRes = pNtk, 0, 0, 1 );
   195	        Abc_NtkDelete( pNtkRes );
   196	        if ( pNtk == NULL )
   197	        {
   198	            Abc_Print( -1, "Balancing before stmap30 has failed.\n" );
   199	            return 1;
   200	        }
   201	        Abc_Print( 0, "The network was strashed and balanced before stmap30.\n" );
   202	        pNtkRes = Abc_NtkMap( pNtk, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, Gain, nGatesMin, fRecovery, fSwitching, fSkipFanout, fUseProfile, fUseBuffs, fVerbose );
   203	        if ( pNtkRes == NULL )
   204	        {
   205	            Abc_NtkDelete( pNtk );
   206	            Abc_Print( -1, "stmap30 has failed.\n" );
   207	            return 1;
   208	        }
   209	        Abc_NtkDelete( pNtk );
   210	    }
   211	    else
   212	    {
   213	        pNtkRes = Abc_NtkMap( pNtk, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, Gain, nGatesMin, fRecovery, fSwitching, fSkipFanout, fUseProfile, fUseBuffs, fVerbose );
   214	        if ( pNtkRes == NULL )
   215	        {
   216	            Abc_Print( -1, "stmap30 has failed.\n" );
   217	            return 1;
   218	        }
   219	    }
   220	
   221	    if ( fSweep )
   222	    {
   223	        Abc_NtkFraigSweep( pNtkRes, 0, 0, 0, 0 );
   224	        if ( Abc_NtkHasMapping(pNtkRes) )
   225	        {
   226	            pNtkRes = Abc_NtkDupDfs( pNtk = pNtkRes );
   227	            Abc_NtkDelete( pNtk );
   228	        }
   229	    }
   230	
   231	    Abc_FrameReplaceCurrentNetwork( pAbc, pNtkRes );
   232	    return 0;
   233	
   234	usage:
   235	    if ( DelayTarget == -1 )
   236	        sprintf(Buffer, "not used" );
   237	    else
   238	        sprintf(Buffer, "%.3f", DelayTarget );
   239	    Abc_Print( -2, "usage: stmap30 [-DABFSG float] [-M num] [-arspfuovh]\n" );
   240	    Abc_Print( -2, "\t              performs stmap30 standard-cell mapping with a strong deep seed load penalty\n" );
   241	    Abc_Print( -2, "\t-D float : sets the global required times [default = %s]\n", Buffer );
   242	    Abc_Print( -2, "\t-A float : \"area multiplier\" to bias gate selection [default = %.2f]\n", AreaMulti );
   243	    Abc_Print( -2, "\t-B float : \"delay multiplier\" to bias gate selection [default = %.2f]\n", DelayMulti );
   244	    Abc_Print( -2, "\t-F float : the logarithmic fanout delay parameter [default = %.2f]\n", LogFan );
   245	    Abc_Print( -2, "\t-S float : the slew parameter used to generate the library [default = %.2f]\n", Slew );
   246	    Abc_Print( -2, "\t-G float : the gain parameter used to generate the library [default = %.2f]\n", Gain );
   247	    Abc_Print( -2, "\t-M num   : skip gate classes whose size is less than this [default = %d]\n", nGatesMin );
   248	    Abc_Print( -2, "\t-a       : toggles area-only mapping [default = %s]\n", fAreaOnly? "yes": "no" );
   249	    Abc_Print( -2, "\t-r       : toggles area recovery [default = %s]\n", fRecovery? "yes": "no" );
   250	    Abc_Print( -2, "\t-s       : toggles sweep after mapping [default = %s]\n", fSweep? "yes": "no" );
   251	    Abc_Print( -2, "\t-p       : optimizes power by minimizing switching [default = %s]\n", fSwitching? "yes": "no" );
   252	    Abc_Print( -2, "\t-f       : disables the strong deep seed load penalty [default = %s]\n", fSkipFanout? "yes": "no" );
   253	    Abc_Print( -2, "\t-u       : use standard-cell profile [default = %s]\n", fUseProfile? "yes": "no" );
   254	    Abc_Print( -2, "\t-o       : toggles using buffers to decouple combinational outputs [default = %s]\n", fUseBuffs? "yes": "no" );
   255	    Abc_Print( -2, "\t-v       : toggles verbose output [default = %s]\n", fVerbose? "yes": "no" );
   256	    Abc_Print( -2, "\t-h       : print the command usage\n");
   257	    return 1;
   258	}
   259	
   260	ABC_NAMESPACE_IMPL_END

