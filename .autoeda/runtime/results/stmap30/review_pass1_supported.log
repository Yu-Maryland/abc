   175	ABC_PRT( "Time", Abc_Clock() - clk );
   176	}
   177	    }
   178	    p->timeArea += Abc_Clock() - clk;
   179	    //////////////////////////////////////////////////////////////////////
   180	
   181	    //////////////////////////////////////////////////////////////////////
   182	    // perform area recovery using exact area
   183	    clk = Abc_Clock();
   184	    if ( p->fSwitching )
   185	    {
   186	        // compute the required times
   187	        Map_TimeComputeRequiredGlobal( p );
   188	        // recover switching activity
   189	        p->fMappingMode = 4;
   190	        Map_MappingMatches( p );
   191	        // compute the references and collect the nodes used in the mapping
   192	        Map_MappingSetRefs( p );
   193	        p->AreaFinal = Map_MappingGetArea( p );
   194	if ( p->fVerbose )
   195	{
   196	printf( "Switching: %s = %8.2f  Flow = %11.1f  Area = %11.1f  %4.1f %%   ", 
   197	                    fShowSwitching? "Switch" : "Delay", 
   198	                    fShowSwitching? Map_MappingGetSwitching(p) : p->fRequiredGlo, 
   199	                    0.0, p->AreaFinal, 
   200	                    100.0*(p->AreaBase-p->AreaFinal)/p->AreaBase );
   201	ABC_PRT( "Time", Abc_Clock() - clk );
   202	}
   203	
   204	        // compute the required times
   205	        Map_TimeComputeRequiredGlobal( p );
   206	        // recover switching activity
   207	        p->fMappingMode = 4;
   208	        Map_MappingMatches( p );
   209	        // compute the references and collect the nodes used in the mapping
   210	        Map_MappingSetRefs( p );
   211	        p->AreaFinal = Map_MappingGetArea( p );
   212	if ( p->fVerbose )
   213	{
   214	printf( "Switching: %s = %8.2f  Flow = %11.1f  Area = %11.1f  %4.1f %%   ", 
   215	                    fShowSwitching? "Switch" : "Delay", 
   216	                    fShowSwitching? Map_MappingGetSwitching(p) : p->fRequiredGlo, 
   217	                    0.0, p->AreaFinal, 
   218	                    100.0*(p->AreaBase-p->AreaFinal)/p->AreaBase );
   219	ABC_PRT( "Time", Abc_Clock() - clk );
   220	}
   221	    }
   222	    p->timeArea += Abc_Clock() - clk;
   223	    //////////////////////////////////////////////////////////////////////
   224	
   225	    if ( p->fSkipFanout >= 14 && p->fSkipFanout <= 31 )
   226	        printf( "stmap%d guard stats: exact-risk = %d  highest = %d  lower-mod = %d  upper-mod = %d  middle-slack = %d  middle-relief = %d  reject-slack = %d  reject-highest = %d  reject-arrival = %d  reject-area = %d\n",
   227	            p->fSkipFanout - 1,
   228	            p->nStmap13ExactRisk, p->nStmap13HighestRisk, p->nStmap13LowerModRisk,
   229	            p->nStmap13UpperModRisk, p->nStmap13MiddleSlack, p->nStmap13MiddleRelief,
   230	            p->nStmap13RejectSlack, p->nStmap13RejectHighest, p->nStmap13RejectArrival,
   231	            p->nStmap13RejectArea );
   232	    if ( p->fSkipFanout >= 19 && p->fSkipFanout <= 31 )
   233	        printf( "stmap%d near-miss stats: near-miss = %d\n", p->fSkipFanout - 1, p->nStmap18NearMiss );
   234	    if ( p->fSkipFanout >= 20 && p->fSkipFanout <= 31 )
   235	        printf( "stmap%d early-seed stats: early-seed = %d\n", p->fSkipFanout - 1, p->nStmap19EarlySeed );
   236	    if ( p->fSkipFanout == 26 )
   237	        printf( "stmap25 ablation stats: moderate-ablation-seed = %d\n", p->nStmap25ModerateAblationSeed );
   238	    if ( p->fSkipFanout == 27 )
   239	        printf( "stmap26 ablation stats: moderate-ablation-seen = %d  moderate-ablation-seed = %d\n", p->nStmap26ModerateAblationSeen, p->nStmap26ModerateAblationSeed );
   240	    if ( p->fSkipFanout == 28 )
   241	        printf( "stmap27 signature stats: moderate-signature-seed = %d  moderate-signature-blocked = %d\n", p->nStmap27ModerateSignatureSeed, p->nStmap27ModerateSignatureBlocked );
   242	    if ( p->fSkipFanout == 29 )
   243	        printf( "stmap28 penalty stats: moderate-penalty-seed = %d  moderate-penalty-blocked = %d\n", p->nStmap28ModeratePenaltySeed, p->nStmap28ModeratePenaltyBlocked );
   244	    if ( p->fSkipFanout == 30 )
   245	        printf( "stmap29 penalty stats: moderate-penalty-seed = %d  moderate-penalty-blocked = %d\n", p->nStmap29ModeratePenaltySeed, p->nStmap29ModeratePenaltyBlocked );
   246	    if ( p->fSkipFanout == 31 )
