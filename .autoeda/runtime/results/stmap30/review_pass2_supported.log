   598	/**Function*************************************************************
   599	
   600	  Synopsis    [Returns 1 if a fanout/load proxy should reject this cut.]
   601	
   602	  Description [Mode 1 is the classic map -f guard. Mode 2 is the stmap1
   603	  selective guard, which only rejects wider cuts when the node has higher
   604	  estimated fanout. Mode 3 is the stmap2 guard, which uses the same fanout
   605	  thresholds only during area recovery and only when the current phase has
   606	  slack over the mapper required time. Mode 4 is the stmap3 guard, which
   607	  narrows the intervention to high-fanout nodes with only shallow positive
   608	  slack. Mode 5 is the stmap4 split-phase guard: stmap1-style guarding in
   609	  delay matching and stmap2-style slack-aware guarding in area recovery.
   610	  Mode 6 is the stmap5 shape-gated split-phase guard: the delay pass only
   611	  uses stmap1-style guarding in very large mapper graphs, while area recovery
   612	  keeps the stmap2 slack-aware guard. Mode 7 is the stmap6 area-sensitive
   613	  shape-gated guard: the delay pass keeps the stmap5 graph-size gate, small
   614	  mapper graphs keep the stmap2 slack-aware recovery guard, and exact-area
   615	  recovery on larger graphs checks the cut after matching so materially cheaper
   616	  cuts can override the fanout/load proxy. Mode 8 is the stmap7 criticality-
   617	  sensitive version of mode 7: exact-area recovery on larger graphs allows the
   618	  override only with deeper mapper slack and outside the highest fanout bucket.
   619	  Mode 9 is the stmap8 arrival-bounded version of mode 8: the area-saving
   620	  override also requires the candidate match to stay within one quarter of an
   621	  inverter delay of the existing mapper arrival. Mode 10 is the stmap9
   622	  middle-slack area-relief version of mode 9: it keeps the highest fanout
   623	  bucket protected, but in the one-to-two inverter slack bucket it allows a
   624	  wide cut only when it is arrival-neutral and saves at least one inverter
   625	  area. Mode 11 is the stmap10 depth-qualified version of mode 10: the
   626	  middle-slack relief is allowed only for shallow and medium-depth nodes.
   627	  Mode 12 is the stmap11 tight-depth version of mode 11: the middle-slack
   628	  relief is allowed only for shallower nodes. Mode 13 is the stmap12
   629	  fanout-bucket split version of mode 12: the tight-depth middle-slack relief
   630	  is allowed only in the lower moderate fanout bucket. Mode 14 is stmap13,
   631	  which keeps mode 13 behavior while recording guard-hit counters. Mode 15 is
   632	  stmap14, which keeps the same bucket and counters but requires a stronger
   633	  middle-slack area-flow saving. Mode 16 is stmap15, which restores the
   634	  one-inverter relief threshold only after the current run has observed a high
   635	  lower-moderate/middle-slack exact-area profile. Mode 17 is stmap16, which
   636	  keeps mode 16 behavior and prints per-relief diagnostics. Mode 18 is stmap17,
   637	  which uses the one-inverter post-profile threshold only for candidates with
   638	  materially better mapper arrival. Mode 19 is stmap18, which keeps mode 18
   639	  decisions and adds near-miss diagnostics for candidates rejected by the
   640	  timing-quality/profile fallback. Mode 20 is stmap19, which allows the
   641	  one-inverter threshold before profile-open only for candidates with the same
   642	  material mapper-arrival improvement. Mode 21 is stmap20, which keeps the
   643	  mode 20 pre-profile seed but restricts it to shallow nodes. Mode 22 is
   644	  stmap21, which keeps the shallow seed and admits deeper pre-profile seeds
   645	  only when the arrival gain is unusually large. Mode 23 is stmap22, which
   646	  relaxes the deep pre-profile seed boundary to a moderate arrival gain. Mode
   647	  24 is stmap23, which keeps the strong deep seeds but allows moderate deep
   648	  seeds only when the existing mapper slack is near the critical side of the
   649	  middle-slack window. Mode 25 is stmap24, which tightens the moderate deep
   650	  slack gate to the lower edge of that critical window. Mode 26 is stmap25,
   651	  which keeps stmap24 and admits at most one moderate deep seed from the next
   652	  slack band as an ablation diagnostic. Mode 27 is stmap26, which skips the
   653	  first such moderate seed and admits only the second qualifying seed. Mode 28
   654	  is stmap27, which reopens the next slack band except for the high-reference,
   655	  low-slack, stronger-moderate signature isolated by stmap26. Mode 29 is
   656	  stmap28, which replaces that hard signature blocker with a high-reference
   657	  moderate-seed area penalty that scales with reference count, slack risk, and
   658	  arrival-gain risk. Mode 30 is stmap29, which keeps the same seed band but
   659	  makes the penalty a continuous load-risk gradient. Mode 31 is stmap30,
   660	  which keeps that moderate-seed gradient and adds a smaller continuous
   661	  penalty to high-reference strong deep seeds.]
   662	
   663	  SideEffects []
   664	
   665	  SeeAlso     []
   666	
   667	***********************************************************************/
   668	static int Map_MatchSkipCutForFanout( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase )
   669	{
   670	    Map_Cut_t * pCutBest;
   671	    Map_Match_t * pMatchBest;
   672	    float Slack, SlackMargin, SlackLimit;
   673	
   674	    if ( !p->fSkipFanout )
   675	        return 0;
   676	    if ( p->fSkipFanout == 2 )
   677	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   678	    if ( p->fSkipFanout == 3 )
   679	    {
   680	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   681	            return 0;
   682	        pCutBest = pNode->pCutBest[fPhase];
   683	        if ( pCutBest == NULL )
   684	            return 0;
   685	        pMatchBest = pCutBest->M + fPhase;
   686	        if ( pMatchBest->pSuperBest == NULL )
   687	            return 0;
   688	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   689	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   690	        if ( Slack <= SlackMargin + p->fEpsilon )
   691	            return 0;
   692	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   693	    }
   694	    if ( p->fSkipFanout == 4 )
   695	    {
   696	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   697	            return 0;
   698	        pCutBest = pNode->pCutBest[fPhase];
   699	        if ( pCutBest == NULL )
   700	            return 0;
   701	        pMatchBest = pCutBest->M + fPhase;
   702	        if ( pMatchBest->pSuperBest == NULL || p->pSuperLib == NULL )
   703	            return 0;
   704	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   705	        SlackMargin = p->pSuperLib->tDelayInv.Worst;
   706	        SlackLimit = 2.0 * SlackMargin;
   707	        if ( Slack <= p->fEpsilon || Slack > SlackLimit + p->fEpsilon )
   708	            return 0;
   709	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   710	    }
   711	    if ( p->fSkipFanout == 5 )
   712	    {
   713	        if ( p->fMappingMode == 0 )
   714	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   715	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   716	            return 0;
   717	        pCutBest = pNode->pCutBest[fPhase];
   718	        if ( pCutBest == NULL )
   719	            return 0;
   720	        pMatchBest = pCutBest->M + fPhase;
   721	        if ( pMatchBest->pSuperBest == NULL )
   722	            return 0;
   723	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   724	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   725	        if ( Slack <= SlackMargin + p->fEpsilon )
   726	            return 0;
   727	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   728	    }
   729	    if ( p->fSkipFanout == 6 )
   730	    {
   731	        if ( p->fMappingMode == 0 )
   732	        {
   733	            if ( p->vMapObjs->nSize <= 20000 )
   734	                return 0;
   735	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   736	        }
   737	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   738	            return 0;
   739	        pCutBest = pNode->pCutBest[fPhase];
   740	        if ( pCutBest == NULL )
   741	            return 0;
   742	        pMatchBest = pCutBest->M + fPhase;
   743	        if ( pMatchBest->pSuperBest == NULL )
   744	            return 0;
   745	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   746	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   747	        if ( Slack <= SlackMargin + p->fEpsilon )
   748	            return 0;
   749	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   750	    }
   751	    if ( p->fSkipFanout == 7 )
   752	    {
   753	        if ( p->fMappingMode == 0 )
   754	        {
   755	            if ( p->vMapObjs->nSize <= 20000 )
   756	                return 0;
   757	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   758	        }
   759	        if ( p->fMappingMode >= 1 && p->fMappingMode <= 3 && p->vMapObjs->nSize <= 8000 )
   760	        {
   761	            pCutBest = pNode->pCutBest[fPhase];
   762	            if ( pCutBest == NULL )
   763	                return 0;
   764	            pMatchBest = pCutBest->M + fPhase;
   765	            if ( pMatchBest->pSuperBest == NULL )
   766	                return 0;
   767	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   768	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   769	            if ( Slack <= SlackMargin + p->fEpsilon )
   770	                return 0;
   771	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   772	        }
   773	        if ( p->fMappingMode == 1 )
   774	        {
   775	            pCutBest = pNode->pCutBest[fPhase];
   776	            if ( pCutBest == NULL )
   777	                return 0;
   778	            pMatchBest = pCutBest->M + fPhase;
   779	            if ( pMatchBest->pSuperBest == NULL )
   780	                return 0;
   781	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   782	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   783	            if ( Slack <= SlackMargin + p->fEpsilon )
   784	                return 0;
   785	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   786	        }
   787	        return 0;
   788	    }
   789	    if ( p->fSkipFanout >= 8 && p->fSkipFanout <= 31 )
   790	    {
   791	        if ( p->fMappingMode == 0 )
   792	        {
   793	            if ( p->vMapObjs->nSize <= 20000 )
   794	                return 0;
   795	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   796	        }
   797	        if ( p->fMappingMode >= 1 && p->fMappingMode <= 3 && p->vMapObjs->nSize <= 8000 )
   798	        {
   799	            pCutBest = pNode->pCutBest[fPhase];
   800	            if ( pCutBest == NULL )
   801	                return 0;
   802	            pMatchBest = pCutBest->M + fPhase;
   803	            if ( pMatchBest->pSuperBest == NULL )
   804	                return 0;
   805	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   806	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   807	            if ( Slack <= SlackMargin + p->fEpsilon )
   808	                return 0;
   809	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   810	        }
   811	        if ( p->fMappingMode == 1 )
   812	        {
   813	            pCutBest = pNode->pCutBest[fPhase];
   814	            if ( pCutBest == NULL )
   815	                return 0;
   816	            pMatchBest = pCutBest->M + fPhase;
   817	            if ( pMatchBest->pSuperBest == NULL )
   818	                return 0;
   819	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   820	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   821	            if ( Slack <= SlackMargin + p->fEpsilon )
   822	                return 0;
   823	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   824	        }
   825	        return 0;
   826	    }
   827	    return (pNode->nRefs > 3 && pCut->nLeaves > 2) || (pNode->nRefs > 1 && pCut->nLeaves > 3);
   828	}
   829	
   830	/**Function*************************************************************
   831	
   832	  Synopsis    [Returns 1 if an stmap area-sensitive mode should reject a cut.]
   833	
   834	  Description [The area-sensitive guards are evaluated after matching the
   835	  candidate cut because their hypotheses need the candidate's actual mapper
   836	  area. In stmap6 exact-area recovery, a wide high-fanout cut is rejected only
   837	  when the existing match has slack and the candidate does not save at least
   838	  half an inverter area. In stmap7, the area-saving override additionally
   839	  requires more than two inverter delays of slack and excludes the highest
   840	  fanout-risk bucket. In stmap8, the override is further rejected when the
   841	  candidate match worsens mapper arrival by more than one quarter of an
   842	  inverter delay. In stmap9, middle-slack candidates can recover area only
   843	  when they are outside the highest fanout bucket, do not worsen mapper
   844	  arrival, and save at least one inverter area. In stmap10, that middle-slack
   845	  relief also requires the mapper node to be no deeper than level 96. In
   846	  stmap11, that depth window is tightened to level 64. In stmap12, the same
   847	  tight-depth relief is allowed only in the lower moderate fanout bucket. In
   848	  stmap13, the same decision path also records exact-area guard statistics. In
   849	  stmap14, the lower-moderate middle-slack relief must save two inverter areas
   850	  instead of one. In stmap15, one-inverter relief is restored only after the
   851	  mapper observes a high lower-moderate/middle-slack profile. In stmap16, the
   852	  same behavior also reports each admitted relief choice. In stmap17, the
   853	  adaptive one-inverter relief threshold also requires a material mapper-arrival
   854	  improvement; arrival-neutral choices keep the stricter two-inverter fallback.
   855	  In stmap18, the same decisions are preserved while near-miss rejected
   856	  middle-slack candidates are logged. In stmap19, pre-profile one-inverter
   857	  relief is seeded only by candidates with the same material arrival gain. In
   858	  stmap20, the pre-profile seed is further limited to shallow nodes. In
   859	  stmap21, deeper pre-profile seeds are allowed only with a much larger mapper
   860	  arrival gain. In stmap22, the same deep-seed path is relaxed to a moderate
   861	  mapper-arrival gain. In stmap23, moderate deep seeds also need near-critical
   862	  existing mapper slack. In stmap24, the moderate deep slack gate is tightened
   863	  to the lower edge of the critical slack window. In stmap25, the stmap24 rule
   864	  is kept, and one moderate deep seed from the next slack band is admitted for
   865	  ablation. In stmap26, the first such moderate seed is skipped and only the
   866	  second qualifying seed is admitted. In stmap27, moderate deep candidates in
   867	  the next slack band are admitted unless they match the high-reference,
   868	  low-slack, stronger-moderate signature isolated by stmap26. In stmap28, that
   869	  hard blocker is replaced by a soft area-margin penalty on high-reference
   870	  moderate seeds whose slack and arrival-gain ratios resemble load-risky
   871	  choices. In stmap29, the high-reference penalty is made continuous over the
   872	  same seed band. In stmap30, the same load-risk surface is extended to
   873	  high-reference strong deep seeds with a smaller continuous penalty.]
   874	
   875	  SideEffects []
   876	
   877	  SeeAlso     []
   878	
   879	***********************************************************************/
   880	static int Map_MatchSkipAreaSensitiveFanout( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase, Map_Match_t * pMatchBest, Map_Match_t * pMatch )
   881	{
   882	    float Slack, SlackMargin, SlackGate, ArrivalMargin, ArrivalDelta, ArrivalGainMargin, AreaMargin, AreaSave, OneInvArea;
   883	    float Stmap28PenaltyFactor, Stmap29PenaltyFactor, Stmap30ModeratePenaltyFactor, Stmap30StrongPenaltyFactor, Stmap30PenaltyFactor;
   884	    const char * pReason;
   885	    int fMiddleReliefWindow, fStmap13, fProfileOpen, fArrivalQuality, fStrictFallback;
   886	    int fStmap25ModerateAblation, fStmap26ModerateAblationCandidate, fStmap26ModerateAblation;
   887	    int fStmap27ModerateSignatureSeed, fStmap27ModerateSignatureBlocked;
   888	    int fStmap28ModeratePenaltyCandidate, fStmap29ModeratePenaltyCandidate;
   889	    int fStmap30ModeratePenaltyCandidate, fStmap30StrongPenaltyCandidate;
   890	
   891	    if ( p->fSkipFanout < 7 || p->fSkipFanout > 31 )
   892	        return 0;
   893	    if ( p->fMappingMode < 2 || p->fMappingMode > 3 )
   894	        return 0;
   895	    if ( p->vMapObjs->nSize <= 8000 )
   896	        return 0;
   897	    if ( !Map_MatchCutHasStmapFanoutRisk( pNode, pCut ) )
   898	        return 0;
   899	    fStmap13 = (p->fSkipFanout >= 14 && p->fSkipFanout <= 31);
   900	    Map_MatchStmap13CountRisk( p, pNode, pCut );
   901	    if ( pMatchBest == NULL || pMatchBest->pSuperBest == NULL || pMatch == NULL || pMatch->pSuperBest == NULL )
   902	        return 0;
   903	    Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   904	    SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   905	    ArrivalDelta = pMatch->tArrive.Worst - pMatchBest->tArrive.Worst;
   906	    ArrivalGainMargin = 0.25 * SlackMargin;
   907	    fArrivalQuality = ArrivalDelta <= -ArrivalGainMargin - p->fEpsilon;
   908	    if ( p->fSkipFanout >= 8 && p->fSkipFanout <= 31 )
   909	    {
   910	        SlackGate = 2.0 * SlackMargin;
   911	        fMiddleReliefWindow =
   912	             (p->fSkipFanout >= 10 && p->fSkipFanout <= 31) &&
   913	             Slack > SlackMargin + p->fEpsilon &&
   914	             Slack <= SlackGate + p->fEpsilon &&
   915	             !Map_MatchCutHasStmapHighestFanoutRisk( pNode, pCut ) &&
   916	             Map_MatchNodeHasStmapMiddleSlackRelief( p->fSkipFanout, pNode ) &&
   917	             (p->fSkipFanout < 13 || Map_MatchCutHasStmapLowerModerateFanoutRisk( pNode, pCut )) &&
   918	             pMatch->tArrive.Worst <= pMatchBest->tArrive.Worst + p->fEpsilon;
   919	        if ( fMiddleReliefWindow )
   920	        {
   921	            if ( fStmap13 )
   922	                p->nStmap13MiddleSlack++;
   923	            fProfileOpen = Map_MatchHasStmap15ReliefProfile( p );
   924	            fStmap25ModerateAblation =
   925	                p->fSkipFanout == 26 &&
   926	                !fProfileOpen &&
   927	                !Map_MatchNodeHasStmap20EarlySeedDepth( pNode ) &&
   928	                Map_MatchIsStmap25ModerateAblationSeed( p, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, p->fEpsilon );
   929	            fStmap26ModerateAblationCandidate =
   930	                p->fSkipFanout == 27 &&
