   494	    if ( !Map_MatchIsStmap28ModeratePenaltyCandidate( ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon ) )
   495	        return 0.0;
   496	    if ( pNode->nRefs < 5 )
   497	        return 0.0;
   498	    Penalty += 0.15 * (float)(pNode->nRefs - 4);
   499	    if ( Slack <= 1.15 * SlackMargin + Epsilon )
   500	        Penalty += 0.15;
   501	    if ( ArrivalDelta <= -2.25 * ArrivalGainMargin - Epsilon )
   502	        Penalty += 0.15;
   503	    return Penalty > 1.0 ? 1.0 : Penalty;
   504	}
