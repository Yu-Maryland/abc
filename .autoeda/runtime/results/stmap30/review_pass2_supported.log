   562	static int Map_MatchIsStmap30StrongPenaltyCandidate( Map_Node_t * pNode, float ArrivalDelta, float ArrivalGainMargin, float Slack, float SlackMargin, float Epsilon )
   563	{
   564	    if ( pNode->nRefs < 5 )
   565	        return 0;
   566	    return Map_MatchHasStmap21DeepSeedGain( ArrivalDelta, ArrivalGainMargin, Epsilon ) &&
   567	        Slack <= 1.25 * SlackMargin + Epsilon;
   568	}
