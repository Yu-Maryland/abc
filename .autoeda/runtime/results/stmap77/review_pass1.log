def _join_sorted_values(rows, key):
    values = {row.get(key, "") for row in rows if row.get(key, "") != ""}
    return "+".join(sorted(values, key=lambda v: int(v) if v.lstrip("-").isdigit() else v))


def write_reconstruct_summary(stats_by_name, multi_stats_by_name):
    rows_out = []
    for bench in BENCHMARKS:
        stat_rows = [row for row in stats_by_name.get("reconstruct_stats", []) if row["benchmark"] == bench]
        stat = stat_rows[0] if stat_rows else {}
        requests = [row for row in multi_stats_by_name.get("reconstruct_request", []) if row["benchmark"] == bench]
        emits = [row for row in multi_stats_by_name.get("reconstruct_emit", []) if row["benchmark"] == bench]
        inverters = [row for row in multi_stats_by_name.get("reconstruct_inverter", []) if row["benchmark"] == bench]
        caches = [row for row in multi_stats_by_name.get("reconstruct_cache", []) if row["benchmark"] == bench]
        survival = [row for row in multi_stats_by_name.get("phase_survival", []) if row["benchmark"] == bench]
        survival_row = survival[0] if survival else {}
        phase0_emit = next((row for row in emits if row.get("phase") == "0"), {})
        phase1_emit = next((row for row in emits if row.get("phase") == "1"), {})
        phase0_nodes = int(survival_row.get("phase0_nodes", "0") or 0)
        phase1_nodes = int(survival_row.get("phase1_nodes", "0") or 0)
        rows_out.append({
            "benchmark": bench,
            "aig_id": stat.get("watched_aigs", "0") != "0" and (requests[0].get("aig_id", "") if requests else survival_row.get("aig_id", "")) or "",
            "rows": stat.get("rows", ""),
            "requests": stat.get("requests", ""),
            "direct_emits": stat.get("direct_emits", ""),
            "inverters": stat.get("inverters", ""),
            "cache_hits": stat.get("cache_hits", ""),
            "requested_phases": _join_sorted_values(requests, "requested_phase"),
            "direct_phases": _join_sorted_values(emits, "phase"),
            "inverter_requested_phases": _join_sorted_values(inverters, "requested_phase"),
            "cache_phases": _join_sorted_values(caches, "phase"),
            "phase0_direct_gate": phase0_emit.get("gate", ""),
            "phase1_direct_gate": phase1_emit.get("gate", ""),
            "phase0_final_nodes": survival_row.get("phase0_nodes", ""),
            "phase1_final_nodes": survival_row.get("phase1_nodes", ""),
            "both_direct_phases": int(bool(phase0_emit) and bool(phase1_emit)),
            "both_final_phases": int(phase0_nodes > 0 and phase1_nodes > 0),
        })
    write_csv(
        RESULTS / "reconstruct_summary.csv",
        rows_out,
        [
            "benchmark", "aig_id", "rows", "requests", "direct_emits",
            "inverters", "cache_hits", "requested_phases", "direct_phases",
            "inverter_requested_phases", "cache_phases", "phase0_direct_gate",
            "phase1_direct_gate", "phase0_final_nodes", "phase1_final_nodes",
            "both_direct_phases", "both_final_phases",
        ],
    )


