#define ABC_STMAP65_BOUND_RATIO_CAP 2.10f
#define ABC_STMAP65_SEVERE_THRESHOLD 0.85f
#define ABC_STMAP65_PRESSURE_ENTRY_THRESHOLD 8000

typedef struct Abc_Stmap65LoadStats_t_
{
    int fAvailable;
    int nNodes;
    int nMatched;
    int nPins;
    int nOver;
    int nHotspotRoots;
    int nHotspotFanin;
    int nHotspotFanout;
