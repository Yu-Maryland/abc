        flow_results = [f.result() for f in concurrent.futures.as_completed(futures)]

    by_key = {(r["benchmark"], r["kind"]): r for r in flow_results}
    metrics_rows = []
    comparison_rows = []
    stats_by_name = {name: [] for name in STAT_PATTERNS}

