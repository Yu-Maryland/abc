   621	Abc_Obj_t * Abc_NodeFromMapPhase_rec( Abc_Ntk_t * pNtkNew, Map_Node_t * pNodeMap, int fPhase )
   622	{
   623	    Abc_Obj_t * pNodePIs[10];
   624	    Abc_Obj_t * pNodeNew;
   625	    Map_Node_t ** ppLeaves;
   626	    Map_Cut_t * pCutBest;
   627	    Map_Super_t * pSuperBest;
   628	    unsigned uPhaseBest;
   629	    int i, fInvPin, nLeaves;
   630	
   631	    // make sure the node can be implemented in this phase
   632	    assert( Map_NodeReadCutBest(pNodeMap, fPhase) != NULL || Map_NodeIsConst(pNodeMap) );
   633	    // check if the phase is already implemented
   634	    pNodeNew = (Abc_Obj_t *)Map_NodeReadData( pNodeMap, fPhase );
   635	    if ( pNodeNew )
   636	    {
   637	        Abc_Stmap77RecordReconstructionCache( pNodeMap, fPhase, pNodeNew, "phase" );
   638	        return pNodeNew;
   639	    }
   640	
   641	    // get the information about the best cut 
   642	    pCutBest   = Map_NodeReadCutBest( pNodeMap, fPhase );
   643	    pSuperBest = Map_CutReadSuperBest( pCutBest, fPhase );
   644	    uPhaseBest = Map_CutReadPhaseBest( pCutBest, fPhase );
   645	    nLeaves    = Map_CutReadLeavesNum( pCutBest );
   646	    ppLeaves   = Map_CutReadLeaves( pCutBest );
   647	    //Vec_Ptr_t * vAnds = Map_CutInternalNodes( pNodeMap, pCutBest );
   648	
   649	    // collect the PI nodes
   650	    for ( i = 0; i < nLeaves; i++ )
   651	    {
   652	        fInvPin = ((uPhaseBest & (1 << i)) > 0);
   653	        pNodePIs[i] = Abc_NodeFromMap_rec( pNtkNew, ppLeaves[i], !fInvPin );
   654	        assert( pNodePIs[i] != NULL );
   655	    }
   656	
   657	    // implement the supergate
   658	    pNodeNew = Abc_NodeFromMapSuper_rec( pNtkNew, pNodeMap, pSuperBest, pNodePIs, nLeaves );
   659	    Vec_IntWriteEntry( pNtkNew->vOrigNodeIds, pNodeNew->Id, Abc_Var2Lit( Map_NodeReadAigId(pNodeMap), fPhase ) );
   660	    Map_NodeSetData( pNodeMap, fPhase, (char *)pNodeNew );
   661	    Abc_Stmap77RecordReconstructionEmit( pNodeMap, fPhase, pNodeNew, pCutBest, pSuperBest, uPhaseBest );
   662	    return pNodeNew;
   663	}
   664	Abc_Obj_t * Abc_NodeFromMap_rec( Abc_Ntk_t * pNtkNew, Map_Node_t * pNodeMap, int fPhase )
   665	{
   666	    Abc_Obj_t * pNodeNew, * pNodeInv;
   667	
   668	    // check the case of constant node
   669	    if ( Map_NodeIsConst(pNodeMap) )
   670	    {
   671	        pNodeNew = fPhase? Abc_NtkCreateNodeConst1(pNtkNew) : Abc_NtkCreateNodeConst0(pNtkNew);
   672	        if ( pNodeNew->pData == NULL )
   673	            printf( "Error creating mapped network: Library does not have a constant %d gate.\n", fPhase );
   674	        return pNodeNew;
   675	    }
   676	
   677	    Abc_Stmap77RecordReconstructionRequest( pNodeMap, fPhase );
   678	
   679	    // check if the phase is already implemented
   680	    pNodeNew = (Abc_Obj_t *)Map_NodeReadData( pNodeMap, fPhase );
   681	    if ( pNodeNew )
   682	    {
   683	        Abc_Stmap77RecordReconstructionCache( pNodeMap, fPhase, pNodeNew, "request" );
   684	        return pNodeNew;
   685	    }
   686	
   687	    // implement the node if the best cut is assigned
   688	    if ( Map_NodeReadCutBest(pNodeMap, fPhase) != NULL )
   689	        return Abc_NodeFromMapPhase_rec( pNtkNew, pNodeMap, fPhase );
   690	
   691	    // if the cut is not assigned, implement the node
   692	    assert( Map_NodeReadCutBest(pNodeMap, !fPhase) != NULL || Map_NodeIsConst(pNodeMap) );
   693	    pNodeNew = Abc_NodeFromMapPhase_rec( pNtkNew, pNodeMap, !fPhase );
   694	
   695	    // add the inverter
   696	    pNodeInv = Abc_NtkCreateNode( pNtkNew );
   697	    Vec_IntWriteEntry( pNtkNew->vOrigNodeIds, pNodeInv->Id, Abc_Var2Lit( Map_NodeReadAigId(pNodeMap), fPhase ) );
   698	    Abc_ObjAddFanin( pNodeInv, pNodeNew );
   699	    pNodeInv->pData = Mio_LibraryReadInv((Mio_Library_t *)Abc_FrameReadLibGen());
   700	
   701	    // set the inverter
   702	    Map_NodeSetData( pNodeMap, fPhase, (char *)pNodeInv );
   703	    Abc_Stmap77RecordReconstructionInverter( pNodeMap, fPhase, pNodeNew, pNodeInv );
   704	    return pNodeInv;
   705	}
   706	Abc_Ntk_t * Abc_NtkFromMap( Map_Man_t * pMan, Abc_Ntk_t * pNtk, int fUseBuffs )
   707	{
   708	    Abc_Ntk_t * pNtkNew;
   709	    Map_Node_t * pNodeMap;
   710	    Abc_Obj_t * pNode, * pNodeNew;
   711	    int i, nDupGates;
   712	    assert( Map_ManReadBufNum(pMan) == pNtk->nBarBufs );
   713	    // create the new network
   714	    pNtkNew = Abc_NtkStartFrom( pNtk, ABC_NTK_LOGIC, ABC_FUNC_MAP );
   715	    pNtkNew->vOrigNodeIds = Vec_IntStartFull( 2 * Abc_NtkObjNumMax(pNtk) );
   716	    // make the mapper point to the new network
   717	    Map_ManCleanData( pMan );
   718	    Abc_NtkForEachCi( pNtk, pNode, i )
   719	    {
   720	        if ( i >= Abc_NtkCiNum(pNtk) - pNtk->nBarBufs )
   721	            break;
   722	        Map_NodeSetData( Map_ManReadInputs(pMan)[i], 1, (char *)pNode->pCopy );
   723	    }
   724	    Abc_NtkForEachCi( pNtk, pNode, i )
   725	    {
   726	        if ( i < Abc_NtkCiNum(pNtk) - pNtk->nBarBufs )
   727	            continue;
   728	        Map_NodeSetData( Map_ManReadBufs(pMan)[i - (Abc_NtkCiNum(pNtk) - pNtk->nBarBufs)], 1, (char *)pNode->pCopy );
   729	    }
   730	    // assign the mapping of the required phase to the POs
   731	    Abc_NtkForEachCo( pNtk, pNode, i )
   732	    {
   733	        if ( i < Abc_NtkCoNum(pNtk) - pNtk->nBarBufs )
   734	            continue;
   735	        pNodeMap = Map_ManReadBufDriver( pMan, i - (Abc_NtkCoNum(pNtk) - pNtk->nBarBufs) );
   736	        Abc_Stmap77RecordReconstructionDemand( "barbuf", i, pNodeMap, !Map_IsComplement(pNodeMap) );
   737	        pNodeNew = Abc_NodeFromMap_rec( pNtkNew, Map_Regular(pNodeMap), !Map_IsComplement(pNodeMap) );
   738	        assert( !Abc_ObjIsComplement(pNodeNew) );
   739	        Abc_ObjAddFanin( pNode->pCopy, pNodeNew );
   740	    }
   741	    Abc_NtkForEachCo( pNtk, pNode, i )
   742	    {
   743	        if ( i >= Abc_NtkCoNum(pNtk) - pNtk->nBarBufs )
   744	            break;
   745	        pNodeMap = Map_ManReadOutputs(pMan)[i];
   746	        Abc_Stmap77RecordReconstructionDemand( "co", i, pNodeMap, !Map_IsComplement(pNodeMap) );
   747	        pNodeNew = Abc_NodeFromMap_rec( pNtkNew, Map_Regular(pNodeMap), !Map_IsComplement(pNodeMap) );
   748	        assert( !Abc_ObjIsComplement(pNodeNew) );
   749	        Abc_ObjAddFanin( pNode->pCopy, pNodeNew );
   750	    }
   751	    // decouple the PO driver nodes to reduce the number of levels
   752	    nDupGates = Abc_NtkLogicMakeSimpleCos( pNtkNew, !fUseBuffs );
   753	//    if ( nDupGates && Map_ManReadVerbose(pMan) )
   754	//        printf( "Duplicated %d gates to decouple the CO drivers.\n", nDupGates );
   755	    return pNtkNew;
   756	}
