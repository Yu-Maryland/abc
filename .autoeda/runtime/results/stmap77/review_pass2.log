typedef struct Abc_Stmap65LoadStats_t_
{
    int fAvailable;
    int nNodes;
    int nMatched;
    int nPins;
    int nOver;
    int nHotspotRoots;
    int nHotspotFanin;
    int nHotspotFanout;
    int nPressureEntries;
    int nPressureUpdates;
    int nPressureMissed;
    int nSinkPressureEntries;
    int nSinkPressureUpdates;
    int nAigPressureRatios;
    int nCriticalNodes;
    int TrackedNode;
    float RatioSum;
    float RatioMax;
    float TrackedRatio;
