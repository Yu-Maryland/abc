   244	    printf( "%s reconstruct-inverter: index = %d  watch-index = %d  node = %d  aig-id = %d  requested-phase = %d  source-phase = %d  source-node = %d  source-gate = %s  inverter-node = %d  inverter-gate = %s\n",
   245	        s_pStmap77ReconstructionLabel, s_nStmap77ReconstructionRows, WatchIndex,
   246	        Map_NodeReadNum(Map_Regular(pNodeMap)), AigId, fPhase, !fPhase,
   247	        pNodeSource ? Abc_ObjId(pNodeSource) : -1, pSourceGate ? Mio_GateReadName(pSourceGate) : "?",
   248	        pNodeInv ? Abc_ObjId(pNodeInv) : -1, pInvGate ? Mio_GateReadName(pInvGate) : "?" );
