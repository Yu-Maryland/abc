   231	static void Abc_Stmap77RecordReconstructionInverter( Map_Node_t * pNodeMap, int fPhase, Abc_Obj_t * pNodeSource, Abc_Obj_t * pNodeInv )
   232	{
   233	    Mio_Gate_t * pSourceGate, * pInvGate;
   234	    int AigId, WatchIndex;
