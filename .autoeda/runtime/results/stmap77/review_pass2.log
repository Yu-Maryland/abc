static void Map_Stmap75ResetFinalCriticalAigDiagState( void )
{
    int i;
    s_nStmap75ActiveWatchAigs = 0;
    s_nStmap75SelectedMatchRows = 0;
    for ( i = 0; i < MAP_STMAP75_WATCH_AIGS; i++ )
