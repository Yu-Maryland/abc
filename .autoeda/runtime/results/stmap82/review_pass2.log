   345	    if ( pCut == NULL || pMatch == NULL || pMatch->pSuperBest == NULL )
   346	        return 0;
   347	    uPhaseBest = pMatch->uPhaseBest;
   348	    for ( i = 0; i < pCut->nLeaves && i < 6; i++ )
   349	    {
