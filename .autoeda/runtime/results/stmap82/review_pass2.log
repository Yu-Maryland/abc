   589	void Map_Stmap82PrintStickyParentPhaseSummary( void )
   590	{
  5560	    // recompute the exact area of the current best match
  5561	    // because the exact area of the fanins may have changed
  5562	    // as a result of remapping fanins in the topological order
  5563	    if ( p->fMappingMode == 2 || p->fMappingMode == 3 )
  5564	    {
  5565	        pMatch = pCutBest->M + fPhase;
  5566	        if ( pNode->nRefAct[fPhase] > 0 || 
  5567	            (pNode->pCutBest[!fPhase] == NULL && pNode->nRefAct[!fPhase] > 0) )
  5568	            pMatch->AreaFlow = Area1 = Map_CutDeref( pCutBest, fPhase, p->fUseProfile );
  5569	        else
  5570	            pMatch->AreaFlow = Area1 = Map_CutGetAreaDerefed( pCutBest, fPhase );
  5571	    }
  5572	    else if ( p->fMappingMode == 4 )
  5573	    {
  5574	        pMatch = pCutBest->M + fPhase;
  5575	        if ( pNode->nRefAct[fPhase] > 0 || 
  5576	            (pNode->pCutBest[!fPhase] == NULL && pNode->nRefAct[!fPhase] > 0) )
  5577	            pMatch->AreaFlow = Area1 = Map_SwitchCutDeref( pNode, pCutBest, fPhase );
  5578	        else
  5579	            pMatch->AreaFlow = Area1 = Map_SwitchCutGetDerefed( pNode, pCutBest, fPhase );
  5580	    }
  5581	
  5582	    // save the old mapping
  5583	    if ( pCutBest )
  5584	        MatchBest = pCutBest->M[fPhase];
  5585	    else
  5586	        Map_MatchClean( &MatchBest );
  5587	    Map_MatchClean( &Stmap82StickyMatch );
  5588	    Map_Stmap82RememberStickyParentPhase( p, pNode, pCutBest, fPhase, -1, &MatchBest, pCutBest != NULL, &fStmap82Sticky, &Stmap82StickyMatch, &pStmap82StickyCut, &Stmap82StickyCutOrdinal );
  5589	 
  5590	    // select the new best cut
  5591	    fWorstLimit = pNode->tRequired[fPhase].Worst;
  5592	    for ( pCut = pNode->pCuts->pNext, CutOrdinal = 0; pCut; pCut = pCut->pNext, CutOrdinal++ )
  5593	    {
  5594	        // limit gate sizes based on fanout count
  5595	        fSkipFanout = Map_MatchSkipCutForFanout( p, pNode, pCut, fPhase );
  5596	        if ( fSkipFanout )
  5597	        {
  5598	            Map_Stmap80RecordCandidateCut( p, pNode, pCut, fPhase, CutOrdinal, pCut->M + fPhase, &MatchBest, MAP_STMAP80_REASON_SKIP_FANOUT, 0, 0 );
  5599	            continue;
  5600	        }
  5601	        pMatch = pCut->M + fPhase;
  5602	        if ( pMatch->pSupers == NULL )
  5603	        {
  5604	            Map_Stmap80RecordCandidateCut( p, pNode, pCut, fPhase, CutOrdinal, pMatch, &MatchBest, MAP_STMAP80_REASON_NO_SUPERS, 0, 0 );
  5605	            continue;
  5606	        }
  5607	
  5608	        // find the matches for the cut
  5609	        Map_MatchNodeCut( p, pNode, pCut, fPhase, fWorstLimit );
  5610	        if ( pMatch->pSuperBest == NULL || pMatch->tArrive.Worst > fWorstLimit + p->fEpsilon )
  5611	        {
  5612	            Map_Stmap80RecordCandidateCut( p, pNode, pCut, fPhase, CutOrdinal, pMatch, &MatchBest, pMatch->pSuperBest == NULL ? MAP_STMAP80_REASON_NO_SUPER_BEST : MAP_STMAP80_REASON_REQUIRED, 0, 0 );
  5613	            continue;
  5614	        }
  5615	        fAreaSkip = Map_MatchSkipAreaSensitiveFanout( p, pNode, pCut, fPhase, &MatchBest, pMatch );
  5616	        if ( fAreaSkip )
  5617	        {
  5618	            Map_Stmap80RecordCandidateCut( p, pNode, pCut, fPhase, CutOrdinal, pMatch, &MatchBest, MAP_STMAP80_REASON_AREA_SENSITIVE, 0, 0 );
  5619	            continue;
  5620	        }
  5621	
  5622	        // if the cut can be matched compare the matchings
  5623	        fAccepted = Map_MatchCompare( p, &MatchBest, pMatch, p->fMappingMode );
  5624	        fAccepted = Map_Stmap81MaybeBiasParentPhase( p, pNode, pCut, fPhase, CutOrdinal, pMatch, &MatchBest, fAccepted );
  5625	        fAccepted = Map_Stmap82MaybeBlockStickyReplacement( p, pNode, pCut, fPhase, CutOrdinal, pMatch, fAccepted, fStmap82Sticky, &Stmap82StickyMatch, pStmap82StickyCut, Stmap82StickyCutOrdinal );
  5626	        Map_Stmap80RecordCandidateCut( p, pNode, pCut, fPhase, CutOrdinal, pMatch, &MatchBest, fAccepted ? MAP_STMAP80_REASON_ACCEPTED_BEST : MAP_STMAP80_REASON_NONSELECTED, fAccepted, 1 );
  5627	        if ( fAccepted )
  5628	        {
