static int Abc_Stmap81WatchAigsForNetwork( Abc_Ntk_t * pNtk, int * pChildAig, int * pParentAig )
{
    char * pName = pNtk ? Abc_NtkName(pNtk) : NULL;
    char * pBase, * pSlash, * pBackslash;
    *pChildAig = -1;
    *pParentAig = -1;
    if ( pName == NULL )
        return 0;
    pSlash = strrchr( pName, '/' );
    pBackslash = strrchr( pName, '\\' );
    if ( pSlash && (!pBackslash || pSlash > pBackslash) )
        pBase = pSlash + 1;
    else if ( pBackslash )
        pBase = pBackslash + 1;
    else
        pBase = pName;
    if ( !strcmp( pBase, "i10" ) )
    {
        *pChildAig = 855;
        *pParentAig = 861;
        return 1;
    }
    if ( !strcmp( pBase, "ode" ) )
    {
        *pChildAig = 5219;
        *pParentAig = 5229;
        return 1;
    }
    if ( !strcmp( pBase, "or1200_flat" ) || !strcmp( pBase, "or1200" ) )
    {
        *pChildAig = 11491;
        *pParentAig = 13829;
        return 1;
    }
    if ( !strcmp( pBase, "syn2" ) )
    {
        *pChildAig = 18002;
        *pParentAig = 18467;
        return 1;
    }
    return 0;
}

/**Function*************************************************************

  Synopsis    [Runs the stmap81 watched-parent phase-retention probe.]

  Description [stmap81 reuses stmap80 diagnostics and enables a narrow
  final-pass mapper policy probe: for the configured downstream parent, exact
  or phase-aware area recovery may keep a child-phase-0 candidate when it is
  within a small timing and area-premium window of the current best cut.]

  SideEffects []

  SeeAlso     []

***********************************************************************/
int Abc_CommandStmap81( Abc_Frame_t * pAbc, int argc, char ** argv )
{
    Abc_Ntk_t * pNtk, * pNtkRes;
    int i, RetValue, ChildAigId, ParentAigId, WatchAigs[1];
    extern int Abc_CommandStmap65( Abc_Frame_t * pAbc, int argc, char ** argv );
    extern void Map_Stmap75SetFinalCriticalAigDiag( int fEnable, int WatchAigId );
    extern void Map_Stmap75SetFinalCriticalAigDiagLabel( const char * pLabel );
    extern void Map_Stmap75PrintFinalCriticalAigSummary( void );
    extern void Abc_Stmap74EnableFinalCriticalScope( Abc_Ntk_t * pNtk, const char * pLabel );
    extern void Abc_Stmap76EnablePhaseSurvivalScope( Abc_Ntk_t * pNtk, const char * pLabel, int * pWatchAigIds, int nWatchAigs );
    extern void Abc_Stmap77SetReconstructionDiag( int fEnable, const char * pLabel, int * pWatchAigIds, int nWatchAigs );
    extern void Abc_Stmap77PrintReconstructionSummary( void );
    extern void Abc_Stmap78SetDemandPathDiag( int fEnable, const char * pLabel, int WatchAigId, int DownstreamAigId );
    extern void Abc_Stmap78PrintDemandPathSummary( void );
    extern void Abc_Stmap79SetParentCutDiag( int fEnable, const char * pLabel, int ChildAigId, int ParentAigId );
    extern void Abc_Stmap79PrintParentCutSummary( void );
    extern void Map_Stmap80SetCandidateCutDiag( int fEnable, const char * pLabel, int ParentAigId, int ChildAigId );
    extern void Map_Stmap80PrintCandidateCutSummary( void );
    extern void Map_Stmap81SetParentPhaseBias( int fEnable, const char * pLabel, int ParentAigId, int ChildAigId );
    extern void Map_Stmap81PrintParentPhaseBiasSummary( void );

    for ( i = 1; i < argc; i++ )
    {
        if ( !strcmp( argv[i], "-h" ) )
            goto usage;
    }

    pNtk = Abc_FrameReadNtk( pAbc );
    Abc_Stmap81WatchAigsForNetwork( pNtk, &ChildAigId, &ParentAigId );
    WatchAigs[0] = ChildAigId;
    printf( "stmap81 diagnostic: inherited-policy = stmap65  mapper-selected-match-watch = %d  network = %s  child-aig = %d  parent-aig = %d  source = stmap80-parent-phase0-policy-probe  reconstruction-phase-trace = 1  demand-path-trace = 1  parent-cut-trace = 1  candidate-cut-trace = 1  parent-phase-bias = 1  final-phase-survival = 1  mapping-policy-change = watched-parent-child-phase0-window\n",
        ChildAigId >= 0, pNtk && Abc_NtkName(pNtk) ? Abc_NtkName(pNtk) : "?",
        ChildAigId, ParentAigId );
    Map_Stmap75SetFinalCriticalAigDiag( ChildAigId >= 0, ChildAigId );
    Map_Stmap75SetFinalCriticalAigDiagLabel( "stmap81" );
    Abc_Stmap77SetReconstructionDiag( ChildAigId >= 0, "stmap81", WatchAigs, ChildAigId >= 0 ? 1 : 0 );
    Abc_Stmap78SetDemandPathDiag( ChildAigId >= 0, "stmap81", ChildAigId, ParentAigId );
    Abc_Stmap79SetParentCutDiag( ChildAigId >= 0, "stmap81", ChildAigId, ParentAigId );
    Map_Stmap80SetCandidateCutDiag( ChildAigId >= 0, "stmap81", ParentAigId, ChildAigId );
    Map_Stmap81SetParentPhaseBias( ChildAigId >= 0, "stmap81", ParentAigId, ChildAigId );
    RetValue = Abc_CommandStmap65( pAbc, argc, argv );
    Abc_Stmap77PrintReconstructionSummary();
    Abc_Stmap78PrintDemandPathSummary();
    Abc_Stmap79PrintParentCutSummary();
    Map_Stmap80PrintCandidateCutSummary();
    Map_Stmap81PrintParentPhaseBiasSummary();
    Map_Stmap81SetParentPhaseBias( 0, "stmap81", -1, -1 );
    Map_Stmap80SetCandidateCutDiag( 0, "stmap81", -1, -1 );
    Abc_Stmap79SetParentCutDiag( 0, "stmap81", -1, -1 );
    Abc_Stmap78SetDemandPathDiag( 0, "stmap81", -1, -1 );
    Abc_Stmap77SetReconstructionDiag( 0, "stmap81", NULL, 0 );
    Map_Stmap75PrintFinalCriticalAigSummary();
    Map_Stmap75SetFinalCriticalAigDiag( 0, -1 );
    if ( RetValue == 0 )
    {
        pNtkRes = Abc_FrameReadNtk( pAbc );
        Abc_Stmap74EnableFinalCriticalScope( pNtkRes, "stmap81" );
        Abc_Stmap76EnablePhaseSurvivalScope( pNtkRes, "stmap81", WatchAigs, ChildAigId >= 0 ? 1 : 0 );
    }
    return RetValue;

usage:
