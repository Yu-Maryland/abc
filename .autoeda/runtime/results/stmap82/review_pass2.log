   448	        s_pStmap81ParentPhaseBiasLabel, s_Stmap81ParentAigId, s_Stmap81ChildAigId,
   449	        s_nStmap81ParentPhaseRows, s_nStmap81ParentPhaseChild0,
   450	        s_nStmap81ParentPhaseEligible, s_nStmap81ParentPhaseOverrides,
   451	        s_nStmap81ParentPhaseAlready, s_nStmap81ParentPhaseBlockedMode,
   452	        s_nStmap81ParentPhaseBlockedBest, s_nStmap81ParentPhaseBlockedWindow,
   453	        s_nStmap81ParentPhaseBlockedChild, 0.75f, 0.75f, 2.00f );
   454	}
