   514	static int Map_Stmap82StickyParentPhaseApplies( Map_Man_t * p, Map_Node_t * pNode, int fPhase )
   515	{
   516	    Map_Node_t * pNodeRegular;
   517	    if ( !s_fStmap82StickyParentPhase || !s_fStmap82StickyParentPhaseActive || p == NULL || pNode == NULL )
   518	        return 0;
   519	    if ( p->fMappingMode != 2 && p->fMappingMode != 3 )
   520	        return 0;
   521	    pNodeRegular = Map_Regular( pNode );
   522	    if ( Map_NodeIsConst( pNodeRegular ) )
   523	        return 0;
   524	    (void)fPhase;
   525	    return Map_NodeReadAigId( pNodeRegular ) == s_Stmap82ParentAigId;
   526	}
   527	
   528	static void Map_Stmap82RememberStickyParentPhase( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase, int CutOrdinal, Map_Match_t * pMatch, int fAccepted, int * pfSticky, Map_Match_t * pStickyMatch, Map_Cut_t ** ppStickyCut, int * pStickyCutOrdinal )
   529	{
   530	    int ChildLeaf, ChildPhase;
   531	    if ( !fAccepted || !Map_Stmap82StickyParentPhaseApplies( p, pNode, fPhase ) )
   532	        return;
   533	    if ( !Map_Stmap81ReadChildPhase( pCut, pMatch, s_Stmap82ChildAigId, &ChildLeaf, &ChildPhase ) || ChildPhase != 0 )
   534	        return;
   535	    *pfSticky = 1;
   536	    *pStickyMatch = *pMatch;
   537	    *ppStickyCut = pCut;
   538	    *pStickyCutOrdinal = CutOrdinal;
   539	    s_nStmap82StickySet++;
   540	    printf( "%s sticky-parent-phase: index = %d  parent-aig = %d  child-aig = %d  mapper-mode = %d  phase = %d  action = set-sticky  cut-ordinal = %d  child-leaf-index = %d  child-requested-phase = %d  gate = %s  arrival = %.3f  area-flow = %.3f  sticky-cut-ordinal = %d  sticky-arrival = %.3f  sticky-area-flow = %.3f  timing-hold-window = %.3f\n",
   541	        s_pStmap82StickyParentPhaseLabel, ++s_nStmap82StickyRows,
   542	        s_Stmap82ParentAigId, s_Stmap82ChildAigId, p->fMappingMode, fPhase,
   543	        CutOrdinal, ChildLeaf, ChildPhase,
   544	        pMatch->pSuperBest ? Mio_GateReadName(pMatch->pSuperBest->pRoot) : "?",
   545	        pMatch->tArrive.Worst, pMatch->AreaFlow,
   546	        *pStickyCutOrdinal, pStickyMatch->tArrive.Worst, pStickyMatch->AreaFlow, 3.00f );
   547	}
   548	
   549	static int Map_Stmap82MaybeBlockStickyReplacement( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase, int CutOrdinal, Map_Match_t * pMatch, int fAccepted, int fSticky, Map_Match_t * pStickyMatch, Map_Cut_t * pStickyCut, int StickyCutOrdinal )
   550	{
   551	    int ChildLeaf, ChildPhase;
   552	    float TimingGain;
   553	    const char * pAction;
   554	    if ( !fAccepted || !fSticky || !Map_Stmap82StickyParentPhaseApplies( p, pNode, fPhase ) )
   555	        return fAccepted;
   556	    Map_Stmap81ReadChildPhase( pCut, pMatch, s_Stmap82ChildAigId, &ChildLeaf, &ChildPhase );
   557	    TimingGain = pStickyMatch->tArrive.Worst - pMatch->tArrive.Worst;
   558	    if ( ChildPhase == 0 )
   559	    {
   560	        s_nStmap82StickyAllowedChild0++;
   561	        pAction = "allow-child-phase0";
   562	    }
   563	    else if ( TimingGain > 3.00f + p->fEpsilon )
   564	    {
   565	        s_nStmap82StickyAllowedTiming++;
   566	        pAction = "allow-timing";
   567	    }
   568	    else
   569	    {
   570	        s_nStmap82StickyBlocked++;
   571	        pAction = "block-child-missing";
   572	        fAccepted = 0;
   573	    }
   574	    if ( pAction[0] == 'a' )
   575	        s_nStmap82StickyIgnored++;
   576	    printf( "%s sticky-parent-phase: index = %d  parent-aig = %d  child-aig = %d  mapper-mode = %d  phase = %d  action = %s  cut-ordinal = %d  child-leaf-index = %d  child-requested-phase = %d  gate = %s  arrival = %.3f  area-flow = %.3f  sticky-cut-ordinal = %d  sticky-gate = %s  sticky-arrival = %.3f  sticky-area-flow = %.3f  timing-gain = %.3f  timing-hold-window = %.3f\n",
   577	        s_pStmap82StickyParentPhaseLabel, ++s_nStmap82StickyRows,
   578	        s_Stmap82ParentAigId, s_Stmap82ChildAigId, p->fMappingMode, fPhase,
   579	        pAction, CutOrdinal, ChildLeaf, ChildPhase,
   580	        pMatch->pSuperBest ? Mio_GateReadName(pMatch->pSuperBest->pRoot) : "?",
   581	        pMatch->tArrive.Worst, pMatch->AreaFlow,
   582	        StickyCutOrdinal,
   583	        pStickyMatch->pSuperBest ? Mio_GateReadName(pStickyMatch->pSuperBest->pRoot) : "?",
   584	        pStickyMatch->tArrive.Worst, pStickyMatch->AreaFlow, TimingGain, 3.00f );
   585	    (void)pStickyCut;
   586	    return fAccepted;
   587	}
