  5428	
  5429	/**Function*************************************************************
  5430	
  5431	  Synopsis    [Find the best matching of the cut.]
  5432	
  5433	  Description [The parameters: the node (pNode), the cut (pCut), the phase to be matched 
  5434	  (fPhase), and the upper bound on the arrival times of the cut (fWorstLimit). This 
  5435	  procedure goes through the matching supergates up to the phase assignment, and selects the
  5436	  best supergate, which will be used to map the cut. As a result of calling this procedure
  5437	  the matching information is written into pMatch.]
  5438	               
  5439	  SideEffects []
  5440	
  5441	  SeeAlso     []
  5442	
  5443	***********************************************************************/
  5444	int Map_MatchNodeCut( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase, float fWorstLimit )
  5445	{
  5446	    Map_Match_t MatchBest, * pMatch = pCut->M + fPhase;
  5447	    Map_Super_t * pSuper;
  5448	    int i, Counter;
  5449	
  5450	    // save the current match of the cut
  5451	    MatchBest = *pMatch;
  5452	    // go through the supergates
  5453	    for ( pSuper = pMatch->pSupers, Counter = 0; pSuper; pSuper = pSuper->pNext, Counter++ )
  5454	    {
  5455	        p->nMatches++;
  5456	        // this is an attempt to reduce the runtime of matching and area 
  5457	        // at the cost of rare and very minor increase in delay
  5458	        // (the supergates are sorted by increasing area)
  5459	        if ( Counter == 30 )
  5460	           break;
  5461	
  5462	        // go through different phases of the given match and supergate
  5463	        pMatch->pSuperBest = pSuper;
  5464	        for ( i = 0; i < (int)pSuper->nPhases; i++ )
  5465	        {
  5466	            p->nPhases++;
  5467	            // find the overall phase of this match
  5468	            pMatch->uPhaseBest = pMatch->uPhase ^ pSuper->uPhases[i];
  5469	            if ( p->fMappingMode == 0 )
  5470	            {
  5471	                // get the arrival time
  5472	                Map_TimeCutComputeArrival( pNode, pCut, fPhase, fWorstLimit );
  5473	                // skip the cut if the arrival times exceed the required times
  5474	                if ( pMatch->tArrive.Worst > fWorstLimit + p->fEpsilon )
  5475	                    continue;
  5476	                // get the area (area flow)
  5477	                pMatch->AreaFlow = Map_CutGetAreaFlow( pCut, fPhase );
  5478	            }
  5479	            else
  5480	            {
  5481	                // get the area (area flow)
  5482	                if ( p->fMappingMode == 2 || p->fMappingMode == 3 )
  5483	                    pMatch->AreaFlow = Map_CutGetAreaDerefed( pCut, fPhase );
  5484	                else if ( p->fMappingMode == 4 )
  5485	                    pMatch->AreaFlow = Map_SwitchCutGetDerefed( pNode, pCut, fPhase );
  5486	                else 
  5487	                    pMatch->AreaFlow = Map_CutGetAreaFlow( pCut, fPhase );
  5488	                // skip if the cut is too large
  5489	                if ( pMatch->AreaFlow > MatchBest.AreaFlow + p->fEpsilon )
  5490	                    continue;
  5491	                // get the arrival time
  5492	                Map_TimeCutComputeArrival( pNode, pCut, fPhase, fWorstLimit );
  5493	                // skip the cut if the arrival times exceed the required times
  5494	                if ( pMatch->tArrive.Worst > fWorstLimit + p->fEpsilon )
  5495	                    continue;
  5496	            }
  5497	
  5498	            // if the cut is non-trivial, compare it
  5499	            if ( Map_MatchCompare( p, &MatchBest, pMatch, p->fMappingMode ) )
  5500	            {
  5501	                MatchBest = *pMatch;
  5502	                // if we are mapping for delay, the worst-case limit should be reduced
  5503	                if ( p->fMappingMode == 0 )
  5504	                    fWorstLimit = MatchBest.tArrive.Worst;
  5505	            }
  5506	        }
  5507	    }
  5508	    // set the best match
  5509	    *pMatch = MatchBest;
  5510	
  5511	    // recompute the arrival time and area (area flow) of this cut
  5512	    if ( pMatch->pSuperBest )
  5513	    {
  5514	        Map_TimeCutComputeArrival( pNode, pCut, fPhase, MAP_FLOAT_LARGE );
  5515	        if ( p->fMappingMode == 2 || p->fMappingMode == 3 )
  5516	            pMatch->AreaFlow = Map_CutGetAreaDerefed( pCut, fPhase );
  5517	        else if ( p->fMappingMode == 4 )
  5518	            pMatch->AreaFlow = Map_SwitchCutGetDerefed( pNode, pCut, fPhase );
  5519	        else 
  5520	            pMatch->AreaFlow = Map_CutGetAreaFlow( pCut, fPhase );
  5521	    }
  5522	    return 1;
  5523	}
  5524	
  5525	/**Function*************************************************************
  5526	
  5527	  Synopsis    [Find the matching of one polarity of the node.]
  5528	
  5529	  Description []
  5530	               
  5531	  SideEffects []
  5532	
  5533	  SeeAlso     []
  5534	
  5535	***********************************************************************/
  5536	int Map_MatchNodePhase( Map_Man_t * p, Map_Node_t * pNode, int fPhase )
  5537	{
  5538	    Map_Match_t MatchBest, Stmap82StickyMatch, * pMatch;
  5539	    Map_Cut_t * pCut, * pCutBest, * pStmap82StickyCut = NULL;
  5540	    float Area1 = 0.0; // Suppress "might be used uninitialized
  5541	    float Area2, fWorstLimit;
  5542	    int CutOrdinal, fSkipFanout, fAreaSkip, fAccepted, fStmap82Sticky = 0, Stmap82StickyCutOrdinal = -1;
  5543	
  5544	    // skip the cuts that have been unassigned during area recovery
  5545	    pCutBest = pNode->pCutBest[fPhase];
  5546	    if ( p->fMappingMode != 0 && pCutBest == NULL )
  5547	        return 1;
  5548	
  5549	    // recompute the arrival times of the current best match 
