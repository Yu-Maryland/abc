  5360	//    if ( pM1->pSuperBest == pM2->pSuperBest )
  5361	//        return 0;
  5362	    if ( !fDoingArea )
  5363	    {
  5364	        // compare the arrival times
  5365	        if ( pM1->tArrive.Worst < pM2->tArrive.Worst - pMan->fEpsilon )
  5366	            return 0;
  5367	        if ( pM1->tArrive.Worst > pM2->tArrive.Worst + pMan->fEpsilon )
  5368	            return 1;
  5369	        // compare the areas or area flows
  5370	        if ( pM1->AreaFlow < pM2->AreaFlow - pMan->fEpsilon )
  5371	            return 0;
  5372	        if ( pM1->AreaFlow > pM2->AreaFlow + pMan->fEpsilon )
  5373	            return 1;
  5374	        // compare the fanout limits
  5375	        if ( pM1->pSuperBest->nFanLimit > pM2->pSuperBest->nFanLimit )
  5376	            return 0;
  5377	        if ( pM1->pSuperBest->nFanLimit < pM2->pSuperBest->nFanLimit )
  5378	            return 1;
  5379	        // compare the number of leaves
  5380	        if ( pM1->pSuperBest->nFanins < pM2->pSuperBest->nFanins )
  5381	            return 0;
  5382	        if ( pM1->pSuperBest->nFanins > pM2->pSuperBest->nFanins )
  5383	            return 1;
  5384	        // otherwise prefer the old cut
  5385	        return 0;
  5386	    }
  5387	    else
  5388	    {
  5389	        // compare the areas or area flows
  5390	        if ( pM1->AreaFlow < pM2->AreaFlow - pMan->fEpsilon )
  5391	            return 0;
  5392	        if ( pM1->AreaFlow > pM2->AreaFlow + pMan->fEpsilon )
  5393	            return 1;
  5394	
  5395	        // make decision based on cell profile
  5396	        if ( pMan->fUseProfile && pM1->pSuperBest && pM1->pSuperBest )
  5397	        {
  5398	            int M1req = Mio_GateReadProfile(pM1->pSuperBest->pRoot);
  5399	            int M2req = Mio_GateReadProfile(pM2->pSuperBest->pRoot);
  5400	            int M1act = Mio_GateReadProfile2(pM1->pSuperBest->pRoot);
  5401	            int M2act = Mio_GateReadProfile2(pM2->pSuperBest->pRoot);
  5402	            //printf( "%d %d  ", M1req, M2req );
  5403	            if ( M1act < M1req && M2act > M2req )
  5404	                return 0;
  5405	            if ( M2act < M2req && M1act > M1req )
  5406	                return 1;
  5407	        }
  5408	
  5409	        // compare the arrival times
  5410	        if ( pM1->tArrive.Worst < pM2->tArrive.Worst - pMan->fEpsilon )
  5411	            return 0;
  5412	        if ( pM1->tArrive.Worst > pM2->tArrive.Worst + pMan->fEpsilon )
  5413	            return 1;
  5414	        // compare the fanout limits
  5415	        if ( pM1->pSuperBest->nFanLimit > pM2->pSuperBest->nFanLimit )
  5416	            return 0;
  5417	        if ( pM1->pSuperBest->nFanLimit < pM2->pSuperBest->nFanLimit )
  5418	            return 1;
  5419	        // compare the number of leaves
  5420	        if ( pM1->pSuperBest->nFanins < pM2->pSuperBest->nFanins )
  5421	            return 0;
  5422	        if ( pM1->pSuperBest->nFanins > pM2->pSuperBest->nFanins )
  5423	            return 1;
  5424	        // otherwise prefer the old cut
  5425	        return 0;
  5426	    }
