   394	        if ( p->fMappingMode != 2 && p->fMappingMode != 3 )
   395	        {
   396	            s_nStmap81ParentPhaseBlockedMode++;
   397	            pAction = "blocked-mode";
   398	        }
   399	        else if ( pBestBefore == NULL || pBestBefore->pSuperBest == NULL )
   400	        {
   401	            s_nStmap81ParentPhaseBlockedBest++;
   402	            pAction = "blocked-no-best";
   403	        }
   404	        else if ( ArrivalDelta > ArrivalWindow + p->fEpsilon || AreaPremium > AreaPremiumWindow + p->fEpsilon || AreaRatio > 2.00f + p->fEpsilon )
   405	        {
   406	            s_nStmap81ParentPhaseBlockedWindow++;
   407	            pAction = "blocked-window";
   408	        }
   409	        else
   410	        {
   411	            s_nStmap81ParentPhaseEligible++;
   412	            fEligible = 1;
   413	            if ( fAccepted )
   414	            {
   415	                s_nStmap81ParentPhaseAlready++;
   416	                pAction = "already-selected";
   417	            }
   418	            else
   419	            {
   420	                s_nStmap81ParentPhaseOverrides++;
   421	                fOverride = 1;
   422	                pAction = "override";
   423	                fAccepted = 1;
   424	            }
   425	        }
   426	    }
   427	
   428	    if ( ChildPhase == 0 || fOverride )
   429	    {
   430	        pGate = pMatch && pMatch->pSuperBest ? pMatch->pSuperBest->pRoot : NULL;
   431	        pGateBefore = pBestBefore && pBestBefore->pSuperBest ? pBestBefore->pSuperBest->pRoot : NULL;
   432	        printf( "%s parent-phase-bias: index = %d  parent-aig = %d  child-aig = %d  mapper-mode = %d  phase = %d  cut-ordinal = %d  action = %s  eligible = %d  override = %d  accepted-before = %d  child-leaf-index = %d  child-requested-phase = %d  gate = %s  best-gate = %s  arrival = %.3f  best-arrival = %.3f  arrival-delta = %.3f  area-flow = %.3f  best-area-flow = %.3f  area-premium = %.3f  area-ratio = %.3f  arrival-window = %.3f  area-premium-window = %.3f\n",
   433	            s_pStmap81ParentPhaseBiasLabel, s_nStmap81ParentPhaseRows,
   434	            s_Stmap81ParentAigId, s_Stmap81ChildAigId, p->fMappingMode, fPhase,
   435	            CutOrdinal, pAction, fEligible, fOverride, fAccepted && !fOverride,
   436	            ChildLeaf, ChildPhase, pGate ? Mio_GateReadName(pGate) : "?",
   437	            pGateBefore ? Mio_GateReadName(pGateBefore) : "?",
   438	            pMatch->tArrive.Worst, pBestBefore ? pBestBefore->tArrive.Worst : MAP_FLOAT_LARGE,
   439	            ArrivalDelta, pMatch->AreaFlow, pBestBefore ? pBestBefore->AreaFlow : MAP_FLOAT_LARGE,
   440	            AreaPremium, AreaRatio, ArrivalWindow, AreaPremiumWindow );
   441	    }
   442	    return fAccepted;
   443	}
