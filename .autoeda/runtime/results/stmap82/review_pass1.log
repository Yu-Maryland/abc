   514	static int Map_Stmap82StickyParentPhaseApplies( Map_Man_t * p, Map_Node_t * pNode, int fPhase )
   515	{
   516	    Map_Node_t * pNodeRegular;
   517	    if ( !s_fStmap82StickyParentPhase || !s_fStmap82StickyParentPhaseActive || p == NULL || pNode == NULL )
   518	        return 0;
   519	    if ( p->fMappingMode != 2 && p->fMappingMode != 3 )
   520	        return 0;
   521	    pNodeRegular = Map_Regular( pNode );
   522	    if ( Map_NodeIsConst( pNodeRegular ) )
   523	        return 0;
   524	    (void)fPhase;
   525	    return Map_NodeReadAigId( pNodeRegular ) == s_Stmap82ParentAigId;
   526	}
