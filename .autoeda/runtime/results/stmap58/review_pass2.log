   459	    if ( MaxPart > 1.0 )
   460	        MaxPart = 1.0;
   461	    if ( OverPart > 1.0 )
   462	        OverPart = 1.0;
   463	    Severity = 0.65 * MaxPart + 0.35 * OverPart;
   464	    return Severity > 1.0 ? 1.0 : Severity;
   465	}
   466	
   467	static float * Abc_Stmap58BuildBoundedPressures( Abc_Stmap58LoadStats_t * pStats, int fSevereTransfer, Abc_Stmap58BoundedStats_t * pBounded )
   468	{
   469	    float * pRatios;
   470	    float RawRatio, SinkRatio, BoundedRatio, Candidate;
   471	    int i;
   472	    memset( pBounded, 0, sizeof(Abc_Stmap58BoundedStats_t) );
   473	    pBounded->fSevereTransfer = fSevereTransfer;
   474	    if ( pStats->nAigPressureRatios <= 0 )
   475	        return NULL;
   476	    pRatios = ABC_ALLOC( float, pStats->nAigPressureRatios );
   477	    if ( pRatios == NULL )
   478	        return NULL;
   479	    for ( i = 0; i < pStats->nAigPressureRatios; i++ )
   480	    {
   481	        RawRatio = pStats->pAigPressureRatios ? pStats->pAigPressureRatios[i] : 0.0f;
   482	        SinkRatio = pStats->pAigSinkPressureRatios ? pStats->pAigSinkPressureRatios[i] : 0.0f;
   483	        BoundedRatio = SinkRatio;
   484	        if ( fSevereTransfer && BoundedRatio > ABC_STMAP58_BOUND_RATIO_CAP )
   485	        {
   486	            BoundedRatio = ABC_STMAP58_BOUND_RATIO_CAP;
   487	            pBounded->nCapped++;
   488	        }
   489	        if ( fSevereTransfer && RawRatio > 1.0f )
   490	        {
   491	            Candidate = 1.0f + ABC_STMAP58_BOUND_RAW_WEIGHT * (RawRatio - 1.0f);
   492	            if ( Candidate > ABC_STMAP58_BOUND_RATIO_CAP )
   493	                Candidate = ABC_STMAP58_BOUND_RATIO_CAP;
   494	            if ( Candidate > BoundedRatio )
   495	            {
   496	                BoundedRatio = Candidate;
   497	                if ( Candidate >= ABC_STMAP58_BOUND_RATIO_CAP )
   498	                    pBounded->nCapped++;
   499	                if ( SinkRatio > 0.0f )
   500	                    pBounded->nLifted++;
   501	                else
   502	                    pBounded->nRawOnly++;
   503	            }
   504	            else if ( SinkRatio > 0.0f )
   505	                pBounded->nSinkFallback++;
   506	        }
   507	        else if ( SinkRatio > 0.0f )
   508	            pBounded->nSinkFallback++;
   509	        pRatios[i] = BoundedRatio;
   510	        if ( BoundedRatio > 0.0f )
   511	            pBounded->nEntries++;
   512	        if ( i == ABC_STMAP58_TRACK_AIG_ID )
   513	            pBounded->TrackedBoundedRatio = BoundedRatio;
   514	    }
   515	    return pRatios;
   516	}
