    ),
    "bounded_pressure_stats": re.compile(
        r"stmap58 bounded-pressure stats: severe-transfer = (?P<severe_transfer>\d+)  raw-weight = (?P<raw_weight>[0-9]+(?:\.[0-9]+)?)  ratio-cap = (?P<ratio_cap>[0-9]+(?:\.[0-9]+)?)  bounded-pressure-entries = (?P<bounded_pressure_entries>\d+)  lifted = (?P<lifted>\d+)  capped = (?P<capped>\d+)  raw-only = (?P<raw_only>\d+)  sink-fallback = (?P<sink_fallback>\d+)  tracked-aig = (?P<tracked_aig>\d+)  tracked-raw-ratio = (?P<tracked_raw_ratio>[0-9]+(?:\.[0-9]+)?)  tracked-sink-ratio = (?P<tracked_sink_ratio>[0-9]+(?:\.[0-9]+)?)  tracked-bounded-ratio = (?P<tracked_bounded_ratio>[0-9]+(?:\.[0-9]+)?)"
    ),
