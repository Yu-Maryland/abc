   434	static void Abc_Stmap58PrintHotspots( Abc_Stmap58LoadStats_t * pStats )
   435	{
   436	    int i;
   437	    if ( !pStats->fAvailable )
   438	        return;
   439	    printf( "stmap58 sink-pressure stats: roots = %d  consumer-fanin = %d  consumer-fanout = %d  raw-pressure-entries = %d  raw-pressure-updates = %d  sink-pressure-entries = %d  sink-pressure-updates = %d  pressure-missed = %d  pressure-capacity = %d  tracked-aig = %d  tracked-node = %d  tracked-raw-ratio = %.3f  tracked-sink-ratio = %.3f\n",
   440	        pStats->nHotspotRoots, pStats->nHotspotFanin, pStats->nHotspotFanout,
   441	        pStats->nPressureEntries, pStats->nPressureUpdates,
   442	        pStats->nSinkPressureEntries, pStats->nSinkPressureUpdates,
   443	        pStats->nPressureMissed,
   444	        pStats->nAigPressureRatios, ABC_STMAP58_TRACK_AIG_ID, pStats->TrackedNode,
   445	        pStats->TrackedRatio, pStats->TrackedSinkRatio );
   446	    for ( i = 0; i < ABC_STMAP58_TOP_PRESSURES && pStats->TopPressureRatios[i] > 0.0; i++ )
   447	        printf( "stmap58 sink-pressure: rank = %d  aig-id = %d  mapped-node = %d  sink-pressure-ratio = %.3f\n",
   448	            i + 1, pStats->TopPressureAigIds[i], pStats->TopPressureNodes[i], pStats->TopPressureRatios[i] );
   449	}
   450	
   451	static float Abc_Stmap58FeedbackSeverity( Abc_Stmap58LoadStats_t * pStats )
   452	{
   453	    float OverFrac, MaxPart, OverPart, Severity;
   454	    if ( !pStats->fAvailable || pStats->nMatched == 0 )
   455	        return 0.0;
   456	    OverFrac = (float)pStats->nOver / (float)pStats->nMatched;
   457	    MaxPart = pStats->RatioMax > 4.0 ? (pStats->RatioMax - 4.0) / 8.0 : 0.0;
   458	    OverPart = OverFrac > 0.002 ? (OverFrac - 0.002) / 0.006 : 0.0;
   459	    if ( MaxPart > 1.0 )
   460	        MaxPart = 1.0;
   461	    if ( OverPart > 1.0 )
   462	        OverPart = 1.0;
   463	    Severity = 0.65 * MaxPart + 0.35 * OverPart;
   464	    return Severity > 1.0 ? 1.0 : Severity;
   465	}
   466	
   467	static float * Abc_Stmap58BuildBoundedPressures( Abc_Stmap58LoadStats_t * pStats, int fSevereTransfer, Abc_Stmap58BoundedStats_t * pBounded )
   468	{
   469	    float * pRatios;
   470	    float RawRatio, SinkRatio, BoundedRatio, Candidate;
   471	    int i;
   472	    memset( pBounded, 0, sizeof(Abc_Stmap58BoundedStats_t) );
   473	    pBounded->fSevereTransfer = fSevereTransfer;
   474	    if ( pStats->nAigPressureRatios <= 0 )
   475	        return NULL;
   476	    pRatios = ABC_ALLOC( float, pStats->nAigPressureRatios );
   477	    if ( pRatios == NULL )
   478	        return NULL;
   479	    for ( i = 0; i < pStats->nAigPressureRatios; i++ )
   480	    {
   481	        RawRatio = pStats->pAigPressureRatios ? pStats->pAigPressureRatios[i] : 0.0f;
   482	        SinkRatio = pStats->pAigSinkPressureRatios ? pStats->pAigSinkPressureRatios[i] : 0.0f;
   483	        BoundedRatio = SinkRatio;
   484	        if ( fSevereTransfer && RawRatio > 1.0f )
   485	        {
   486	            Candidate = 1.0f + ABC_STMAP58_BOUND_RAW_WEIGHT * (RawRatio - 1.0f);
   487	            if ( Candidate > ABC_STMAP58_BOUND_RATIO_CAP )
   488	            {
   489	                Candidate = ABC_STMAP58_BOUND_RATIO_CAP;
   490	                pBounded->nCapped++;
   491	            }
   492	            if ( Candidate > BoundedRatio )
   493	            {
   494	                BoundedRatio = Candidate;
   495	                if ( SinkRatio > 0.0f )
   496	                    pBounded->nLifted++;
   497	                else
   498	                    pBounded->nRawOnly++;
   499	            }
   500	            else if ( SinkRatio > 0.0f )
   501	                pBounded->nSinkFallback++;
   502	        }
   503	        else if ( SinkRatio > 0.0f )
   504	            pBounded->nSinkFallback++;
   505	        pRatios[i] = BoundedRatio;
   506	        if ( BoundedRatio > 0.0f )
   507	            pBounded->nEntries++;
   508	        if ( i == ABC_STMAP58_TRACK_AIG_ID )
   509	            pBounded->TrackedBoundedRatio = BoundedRatio;
   510	    }
   511	    return pRatios;
   512	}
   513	
   514	static void Abc_Stmap58PrintBoundedPressures( Abc_Stmap58LoadStats_t * pStats, Abc_Stmap58BoundedStats_t * pBounded )
   515	{
   516	    printf( "stmap58 bounded-pressure stats: severe-transfer = %d  raw-weight = %.2f  ratio-cap = %.3f  bounded-pressure-entries = %d  lifted = %d  capped = %d  raw-only = %d  sink-fallback = %d  tracked-aig = %d  tracked-raw-ratio = %.3f  tracked-sink-ratio = %.3f  tracked-bounded-ratio = %.3f\n",
   517	        pBounded->fSevereTransfer, ABC_STMAP58_BOUND_RAW_WEIGHT, ABC_STMAP58_BOUND_RATIO_CAP,
   518	        pBounded->nEntries, pBounded->nLifted, pBounded->nCapped,
   519	        pBounded->nRawOnly, pBounded->nSinkFallback, ABC_STMAP58_TRACK_AIG_ID,
   520	        pStats->TrackedRatio, pStats->TrackedSinkRatio, pBounded->TrackedBoundedRatio );
   521	}
