    DelayMulti  = 0;
    fAreaOnly   = 0;
    fRecovery   = 1;
    fSweep      = 0;
    fSwitching  = 0;
    fSkipFanout = 57; // stmap57 raw-pressure transfer over reviewed mode 57; -f disables it
    fUseProfile = 0;
    fUseBuffs   = 0;
