   523	/**Function*************************************************************
   524	
   525	  Synopsis    [Runs the stmap58 mapper probe.]
   526	
   527	  Description [stmap58 measures direct SCL load/max-cap pressure after an
   528	  initial base-gain map, keeps the stmap49 high-pressure SCL/genlib gain, and
   529	  remaps through the reviewed stmap56 mapper mode while feeding bounded
   530	  transferred pressure into that mode. Severe-feedback runs lift sink-weighted
   531	  pressure toward raw pressure using a 0.72 weight and cap the resulting ratio
   532	  at 2.10; non-severe runs keep the prior sink-weighted pressure handoff.]
   533	
   534	  SideEffects []
   535	
   536	  SeeAlso     []
   537	
   538	***********************************************************************/
   539	int Abc_CommandStmap58( Abc_Frame_t * pAbc, int argc, char ** argv )
   540	{
   541	    Abc_Ntk_t * pNtk, * pNtkMap, * pNtkRes, * pNtkFirst;
   542	    Abc_Stmap58LoadStats_t LoadStats;
   543	    Abc_Stmap58BoundedStats_t BoundedStats;
   544	    float * pBoundedPressureRatios = NULL;
   545	    char Buffer[100];
   546	    double DelayTarget;
   547	    double AreaMulti;
   548	    double DelayMulti;
   549	    float LogFan = 0;
   550	    float Slew = 0; // choose based on the library
   551	    float Gain = 250; // base SCL/genlib gain for low and moderate pressure
   552	    float LowGain, SelectedGain;
   553	    int nGatesMin = 0;
   554	    int fAreaOnly;
   555	    int fRecovery;
   556	    int fSweep;
   557	    int fSwitching;
   558	    int fSkipFanout;
   559	    int fUseProfile;
   560	    int fUseBuffs;
   561	    int fVerbose;
   562	    int c, fTempMap = 0;
   563	    int fUseReducedGain, fSevereTransfer;
   564	    float OverFrac, Feedback;
   565	    extern Abc_Ntk_t * Abc_NtkMap( Abc_Ntk_t * pNtk, Mio_Library_t* userLib, double DelayTarget, double AreaMulti, double DelayMulti, float LogFan, float Slew, float Gain, int nGatesMin, int fRecovery, int fSwitching, int fSkipFanout, int fUseProfile, int fUseBuffs, int fVerbose );
   566	    extern int Abc_NtkFraigSweep( Abc_Ntk_t * pNtk, int fUseInv, int fExdc, int fVerbose, int fVeryVerbose );
   567	    extern void Map_Stmap45SetSclLoadFeedbackWithEntries( float MaxLoadRatio, float OverFrac, float Severity, float * pAigPressureRatios, int nAigPressureRatios, int nPressureEntries );
   568	
   569	    pNtk = Abc_FrameReadNtk(pAbc);
   570	    DelayTarget = -1;
   571	    AreaMulti   = 0;
   572	    DelayMulti  = 0;
   573	    fAreaOnly   = 0;
   574	    fRecovery   = 1;
   575	    fSweep      = 0;
   576	    fSwitching  = 0;
   577	    fSkipFanout = 57; // stmap58 bounded pressure transfer over reviewed mode 57; -f disables it
   578	    fUseProfile = 0;
   579	    fUseBuffs   = 0;
   580	    fVerbose    = 0;
   581	    Extra_UtilGetoptReset();
   582	    while ( ( c = Extra_UtilGetopt( argc, argv, "DABFSGMarspfuovh" ) ) != EOF )
   583	    {
   584	        switch ( c )
   585	        {
   586	        case 'D':
   587	            if ( globalUtilOptind >= argc )
   588	            {
   589	                Abc_Print( -1, "Command line switch \"-D\" should be followed by a floating point number.\n" );
   590	                goto usage;
   591	            }
   592	            DelayTarget = (float)atof(argv[globalUtilOptind]);
   593	            globalUtilOptind++;
   594	            if ( DelayTarget <= 0.0 )
   595	                goto usage;
   596	            break;
   597	        case 'A':
   598	            if ( globalUtilOptind >= argc )
   599	            {
   600	                Abc_Print( -1, "Command line switch \"-A\" should be followed by a floating point number.\n" );
   601	                goto usage;
   602	            }
   603	            AreaMulti = (float)atof(argv[globalUtilOptind]);
   604	            globalUtilOptind++;
   605	            break;
   606	        case 'B':
   607	            if ( globalUtilOptind >= argc )
   608	            {
   609	                Abc_Print( -1, "Command line switch \"-B\" should be followed by a floating point number.\n" );
   610	                goto usage;
   611	            }
   612	            DelayMulti = (float)atof(argv[globalUtilOptind]);
   613	            globalUtilOptind++;
   614	            break;
   615	        case 'F':
   616	            if ( globalUtilOptind >= argc )
   617	            {
   618	                Abc_Print( -1, "Command line switch \"-F\" should be followed by a floating point number.\n" );
   619	                goto usage;
   620	            }
   621	            LogFan = (float)atof(argv[globalUtilOptind]);
   622	            globalUtilOptind++;
   623	            if ( LogFan < 0.0 )
   624	                goto usage;
   625	            break;
   626	        case 'S':
   627	            if ( globalUtilOptind >= argc )
   628	            {
   629	                Abc_Print( -1, "Command line switch \"-S\" should be followed by a floating point number.\n" );
   630	                goto usage;
   631	            }
   632	            Slew = (float)atof(argv[globalUtilOptind]);
   633	            globalUtilOptind++;
   634	            if ( Slew <= 0.0 )
   635	                goto usage;
   636	            break;
   637	        case 'G':
   638	            if ( globalUtilOptind >= argc )
   639	            {
   640	                Abc_Print( -1, "Command line switch \"-G\" should be followed by a floating point number.\n" );
   641	                goto usage;
   642	            }
   643	            Gain = (float)atof(argv[globalUtilOptind]);
   644	            globalUtilOptind++;
   645	            if ( Gain <= 0.0 )
   646	                goto usage;
   647	            break;
   648	        case 'M':
   649	            if ( globalUtilOptind >= argc )
   650	            {
   651	                Abc_Print( -1, "Command line switch \"-M\" should be followed by a positive integer.\n" );
   652	                goto usage;
   653	            }
