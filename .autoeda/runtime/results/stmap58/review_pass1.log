   305	/**Function*************************************************************
   306	
   307	  Synopsis    [Returns direct SCL input-pin load driven by a mapped node.]
   308	
   309	  Description []
   310	
   311	  SideEffects []
   312	
   313	  SeeAlso     []
   314	
   315	***********************************************************************/
   316	static float Abc_Stmap58FanoutLoad( SC_Lib * pLib, Abc_Obj_t * pObj, int * pFanouts, int * pPins )
   317	{
   318	    Abc_Obj_t * pFanout;
   319	    Mio_Gate_t * pGateFan;
   320	    SC_Cell * pCellFan;
   321	    float Load = 0.0;
   322	    int i, iFanin, CellId;
   323	    *pFanouts = 0;
   324	    *pPins = 0;
   325	    Abc_ObjForEachFanout( pObj, pFanout, i )
   326	    {
   327	        (*pFanouts)++;
   328	        if ( !Abc_ObjIsNode(pFanout) || pFanout->pData == NULL )
   329	            continue;
   330	        iFanin = Abc_NodeFindFanin( pFanout, pObj );
   331	        if ( iFanin < 0 )
   332	            continue;
   333	        pGateFan = (Mio_Gate_t *)pFanout->pData;
   334	        CellId = Abc_SclCellFind( pLib, Mio_GateReadName(pGateFan) );
   335	        if ( CellId < 0 )
   336	            continue;
   337	        pCellFan = SC_LibCell( pLib, CellId );
   338	        if ( pCellFan == NULL || iFanin >= pCellFan->n_inputs )
   339	            continue;
   340	        Load += SC_CellPinCap( pCellFan, iFanin );
   341	        (*pPins)++;
   342	    }
   343	    return Load;
   344	}
   345	
   346	/**Function*************************************************************
   347	
   348	  Synopsis    [Prints direct SCL load diagnostics for the mapped network.]
   349	
   350	  Description []
   351	
   352	  SideEffects []
   353	
   354	  SeeAlso     []
   355	
   356	***********************************************************************/
   357	static void Abc_Stmap58CollectSclLoadStats( Abc_Ntk_t * pNtk, Abc_Stmap58LoadStats_t * pStats )
   358	{
   359	    SC_Lib * pLib = (SC_Lib *)Abc_FrameReadLibScl();
   360	    SC_Man * pTime = NULL;
   361	    Abc_Obj_t * pObj;
   362	    Mio_Gate_t * pGate;
   363	    SC_Cell * pCell;
   364	    float Load, MaxCap, Ratio, Criticality;
   365	    int i, CellId, Fanouts, Pins;
   366	    Abc_Stmap58LoadStatsClear( pStats );
   367	    if ( pLib == NULL || !Abc_SclHasDelayInfo(pLib) )
   368	        return;
   369	    pStats->fAvailable = 1;
   370	    if ( Abc_NtkHasMapping(pNtk) )
   371	    {
   372	        pTime = Abc_SclManStart( pLib, pNtk, 0, 1, 0, 0 );
   373	        pStats->TimingDelay = pTime->MaxDelay;
   374	    }
   375	    Abc_NtkForEachNode( pNtk, pObj, i )
   376	    {
   377	        pStats->nNodes++;
   378	        if ( pObj->pData == NULL )
   379	            continue;
   380	        pGate = (Mio_Gate_t *)pObj->pData;
   381	        CellId = Abc_SclCellFind( pLib, Mio_GateReadName(pGate) );
   382	        if ( CellId < 0 )
   383	            continue;
   384	        pCell = SC_LibCell( pLib, CellId );
   385	        if ( pCell == NULL || pCell->n_outputs == 0 )
   386	            continue;
   387	        MaxCap = SC_CellPin( pCell, pCell->n_inputs )->max_out_cap;
   388	        if ( MaxCap <= 0.0 )
   389	            continue;
   390	        Load = Abc_Stmap58FanoutLoad( pLib, pObj, &Fanouts, &Pins );
   391	        Ratio = Load / MaxCap;
   392	        pStats->RatioSum += Ratio;
   393	        if ( pStats->RatioMax < Ratio )
   394	            pStats->RatioMax = Ratio;
   395	        if ( Ratio > 1.0 )
   396	            pStats->nOver++;
   397	        pStats->nMatched++;
   398	        pStats->nPins += Pins;
   399	        Criticality = Abc_Stmap58ObjCriticality( pTime, pObj );
   400	        pStats->CriticalitySum += Criticality;
   401	        if ( Criticality > 0.0 )
   402	            pStats->nCriticalNodes++;
   403	        if ( pStats->CriticalityMax < Criticality )
   404	            pStats->CriticalityMax = Criticality;
   405	        Abc_Stmap58TopInsert( pStats->TopRatios, pStats->TopNodes, pStats->pTopGates, pStats->TopFanouts, pStats->TopLoads, pStats->TopCaps,
   406	            Ratio, Abc_ObjId(pObj), Mio_GateReadName(pGate), Fanouts, Load, MaxCap );
   407	        Abc_Stmap58CollectHotspotCone( pNtk, pObj, pStats, pTime, Ratio );
   408	    }
   409	    if ( pTime )
   410	        Abc_SclManFree( pTime );
   411	}
   412	
   413	static void Abc_Stmap58PrintSclLoadStats( const char * pLabel, Abc_Stmap58LoadStats_t * pStats )
   414	{
   415	    int i;
   416	    if ( !pStats->fAvailable )
   417	    {
   418	        printf( "stmap58 %s stats: unavailable = 1\n", pLabel );
   419	        return;
   420	    }
   421	    printf( "stmap58 %s stats: nodes = %d  matched = %d  fanout-pins = %d  over-max = %d  avg-load-ratio = %.3f  max-load-ratio = %.3f\n",
   422	        pLabel, pStats->nNodes, pStats->nMatched, pStats->nPins, pStats->nOver,
   423	        pStats->nMatched ? pStats->RatioSum / (float)pStats->nMatched : 0.0, pStats->RatioMax );
   424	    printf( "stmap58 %s criticality: timing-delay = %.3f  critical-nodes = %d  avg-criticality = %.3f  max-criticality = %.3f\n",
   425	        pLabel, pStats->TimingDelay, pStats->nCriticalNodes,
   426	        pStats->nMatched ? pStats->CriticalitySum / (float)pStats->nMatched : 0.0,
   427	        pStats->CriticalityMax );
   428	    for ( i = 0; i < 5 && pStats->TopRatios[i] > 0.0; i++ )
   429	        printf( "stmap58 %s top: rank = %d  node = %d  gate = %s  fanouts = %d  load = %.3f  max-cap = %.3f  load-ratio = %.3f\n",
   430	            pLabel, i + 1, pStats->TopNodes[i], pStats->pTopGates[i] ? pStats->pTopGates[i] : "?",
   431	            pStats->TopFanouts[i], pStats->TopLoads[i], pStats->TopCaps[i], pStats->TopRatios[i] );
   432	}
