   198	        return 0.0;
   199	    Slack = Abc_SclObjGetSlack( pTime, pObj, pTime->MaxDelay );
   200	    if ( Slack < 0.0 )
   201	        Slack = 0.0;
   202	    Window = 0.18 * pTime->MaxDelay;
   203	    if ( Window < 10.0 )
   204	        Window = 10.0;
   205	    Criticality = 1.0 - Slack / Window;
   206	    if ( Criticality < 0.0 )
   207	        return 0.0;
   208	    return Criticality > 1.0 ? 1.0 : Criticality;
   209	}
   210	
   211	static void Abc_Stmap58PressureInsert( Abc_Stmap58LoadStats_t * pStats, int AigId, int NodeId, float Ratio, float SinkCriticality )
   212	{
   213	    float OldRatio, OldSinkRatio, SinkWeight, SinkRatio;
   214	    if ( AigId < 0 || Ratio <= 1.0 )
   215	        return;
   216	    if ( SinkCriticality < 0.0 )
   217	        SinkCriticality = 0.0;
   218	    if ( SinkCriticality > 1.0 )
   219	        SinkCriticality = 1.0;
   220	    SinkWeight = 0.35 + 0.65 * SinkCriticality;
   221	    SinkRatio = 1.0 + (Ratio - 1.0) * SinkWeight;
   222	    if ( AigId == ABC_STMAP58_TRACK_AIG_ID && Ratio > pStats->TrackedRatio )
   223	    {
   224	        pStats->TrackedRatio = Ratio;
   225	        pStats->TrackedNode = NodeId;
   226	    }
   227	    if ( AigId == ABC_STMAP58_TRACK_AIG_ID && SinkRatio > pStats->TrackedSinkRatio )
   228	        pStats->TrackedSinkRatio = SinkRatio;
   229	    if ( !Abc_Stmap58EnsurePressureCapacity( pStats, AigId ) )
   230	    {
   231	        pStats->nPressureMissed++;
   232	        return;
   233	    }
   234	    OldRatio = pStats->pAigPressureRatios[AigId];
   235	    OldSinkRatio = pStats->pAigSinkPressureRatios[AigId];
   236	    if ( OldRatio == 0.0 )
   237	        pStats->nPressureEntries++;
   238	    else if ( Ratio > OldRatio )
   239	        pStats->nPressureUpdates++;
   240	    if ( Ratio > OldRatio )
   241	        pStats->pAigPressureRatios[AigId] = Ratio;
   242	    if ( SinkRatio <= 1.0 || SinkRatio <= OldSinkRatio )
   243	        return;
   244	    if ( OldSinkRatio == 0.0 )
   245	        pStats->nSinkPressureEntries++;
   246	    else
   247	        pStats->nSinkPressureUpdates++;
   248	    pStats->pAigSinkPressureRatios[AigId] = SinkRatio;
   249	    Abc_Stmap58PressureTopInsert( pStats, AigId, NodeId, SinkRatio );
   250	}
   251	
   252	static void Abc_Stmap58InsertConsumerFanins( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap58LoadStats_t * pStats, float Ratio, float SinkCriticality, int Depth )
   253	{
   254	    Abc_Obj_t * pFanin;
   255	    int i, AigId;
   256	    if ( pObj == NULL || Ratio <= 1.0 || Depth <= 0 )
   257	        return;
   258	    Abc_ObjForEachFanin( pObj, pFanin, i )
   259	    {
   260	        AigId = Abc_Stmap58MappedObjAigId( pNtk, pFanin );
   261	        if ( AigId >= 0 )
   262	        {
   263	            pStats->nHotspotFanin++;
   264	            Abc_Stmap58PressureInsert( pStats, AigId, Abc_ObjId(pFanin), Ratio, SinkCriticality );
   265	        }
   266	        Abc_Stmap58InsertConsumerFanins( pNtk, pFanin, pStats, 0.78 * Ratio, SinkCriticality, Depth - 1 );
   267	    }
   268	}
   269	
   270	static void Abc_Stmap58CollectHotspotCone( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap58LoadStats_t * pStats, SC_Man * pTime, float Ratio )
   271	{
   272	    Abc_Obj_t * pFanout, * pFanout2;
   273	    float FanoutCriticality;
   274	    int i, k, AigId;
   275	    if ( Ratio <= 1.0 )
   276	        return;
   277	    AigId = Abc_Stmap58MappedObjAigId( pNtk, pObj );
   278	    if ( AigId >= 0 )
   279	    {
   280	        pStats->nHotspotRoots++;
   281	        Abc_Stmap58PressureInsert( pStats, AigId, Abc_ObjId(pObj), 0.90 * Ratio, Abc_Stmap58ObjCriticality( pTime, pObj ) );
   282	    }
   283	    Abc_ObjForEachFanout( pObj, pFanout, i )
   284	    {
   285	        FanoutCriticality = Abc_Stmap58ObjCriticality( pTime, pFanout );
   286	        AigId = Abc_Stmap58MappedObjAigId( pNtk, pFanout );
   287	        if ( AigId >= 0 )
   288	        {
   289	            pStats->nHotspotFanout++;
   290	            Abc_Stmap58PressureInsert( pStats, AigId, Abc_ObjId(pFanout), Ratio, FanoutCriticality );
   291	        }
   292	        Abc_Stmap58InsertConsumerFanins( pNtk, pFanout, pStats, 0.86 * Ratio, FanoutCriticality, 3 );
   293	        Abc_ObjForEachFanout( pFanout, pFanout2, k )
   294	        {
   295	            FanoutCriticality = Abc_Stmap58ObjCriticality( pTime, pFanout2 );
   296	            AigId = Abc_Stmap58MappedObjAigId( pNtk, pFanout2 );
   297	            if ( AigId < 0 )
   298	                continue;
   299	            pStats->nHotspotFanout++;
   300	            Abc_Stmap58PressureInsert( pStats, AigId, Abc_ObjId(pFanout2), 0.66 * Ratio, FanoutCriticality );
   301	        }
   302	    }
   303	}
