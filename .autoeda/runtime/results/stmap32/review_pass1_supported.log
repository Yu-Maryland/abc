   676	/**Function*************************************************************
   677	
   678	  Synopsis    [Returns 1 if a fanout/load proxy should reject this cut.]
   679	
   680	  Description [Mode 1 is the classic map -f guard. Mode 2 is the stmap1
   681	  selective guard, which only rejects wider cuts when the node has higher
   682	  estimated fanout. Mode 3 is the stmap2 guard, which uses the same fanout
   683	  thresholds only during area recovery and only when the current phase has
   684	  slack over the mapper required time. Mode 4 is the stmap3 guard, which
   685	  narrows the intervention to high-fanout nodes with only shallow positive
   686	  slack. Mode 5 is the stmap4 split-phase guard: stmap1-style guarding in
   687	  delay matching and stmap2-style slack-aware guarding in area recovery.
   688	  Mode 6 is the stmap5 shape-gated split-phase guard: the delay pass only
   689	  uses stmap1-style guarding in very large mapper graphs, while area recovery
   690	  keeps the stmap2 slack-aware guard. Mode 7 is the stmap6 area-sensitive
   691	  shape-gated guard: the delay pass keeps the stmap5 graph-size gate, small
   692	  mapper graphs keep the stmap2 slack-aware recovery guard, and exact-area
   693	  recovery on larger graphs checks the cut after matching so materially cheaper
   694	  cuts can override the fanout/load proxy. Mode 8 is the stmap7 criticality-
   695	  sensitive version of mode 7: exact-area recovery on larger graphs allows the
   696	  override only with deeper mapper slack and outside the highest fanout bucket.
   697	  Mode 9 is the stmap8 arrival-bounded version of mode 8: the area-saving
   698	  override also requires the candidate match to stay within one quarter of an
   699	  inverter delay of the existing mapper arrival. Mode 10 is the stmap9
   700	  middle-slack area-relief version of mode 9: it keeps the highest fanout
   701	  bucket protected, but in the one-to-two inverter slack bucket it allows a
   702	  wide cut only when it is arrival-neutral and saves at least one inverter
   703	  area. Mode 11 is the stmap10 depth-qualified version of mode 10: the
   704	  middle-slack relief is allowed only for shallow and medium-depth nodes.
   705	  Mode 12 is the stmap11 tight-depth version of mode 11: the middle-slack
   706	  relief is allowed only for shallower nodes. Mode 13 is the stmap12
   707	  fanout-bucket split version of mode 12: the tight-depth middle-slack relief
   708	  is allowed only in the lower moderate fanout bucket. Mode 14 is stmap13,
   709	  which keeps mode 13 behavior while recording guard-hit counters. Mode 15 is
   710	  stmap14, which keeps the same bucket and counters but requires a stronger
   711	  middle-slack area-flow saving. Mode 16 is stmap15, which restores the
   712	  one-inverter relief threshold only after the current run has observed a high
   713	  lower-moderate/middle-slack exact-area profile. Mode 17 is stmap16, which
   714	  keeps mode 16 behavior and prints per-relief diagnostics. Mode 18 is stmap17,
   715	  which uses the one-inverter post-profile threshold only for candidates with
   716	  materially better mapper arrival. Mode 19 is stmap18, which keeps mode 18
   717	  decisions and adds near-miss diagnostics for candidates rejected by the
   718	  timing-quality/profile fallback. Mode 20 is stmap19, which allows the
   719	  one-inverter threshold before profile-open only for candidates with the same
   720	  material mapper-arrival improvement. Mode 21 is stmap20, which keeps the
   721	  mode 20 pre-profile seed but restricts it to shallow nodes. Mode 22 is
   722	  stmap21, which keeps the shallow seed and admits deeper pre-profile seeds
   723	  only when the arrival gain is unusually large. Mode 23 is stmap22, which
   724	  relaxes the deep pre-profile seed boundary to a moderate arrival gain. Mode
   725	  24 is stmap23, which keeps the strong deep seeds but allows moderate deep
   726	  seeds only when the existing mapper slack is near the critical side of the
   727	  middle-slack window. Mode 25 is stmap24, which tightens the moderate deep
   728	  slack gate to the lower edge of that critical window. Mode 26 is stmap25,
   729	  which keeps stmap24 and admits at most one moderate deep seed from the next
   730	  slack band as an ablation diagnostic. Mode 27 is stmap26, which skips the
   731	  first such moderate seed and admits only the second qualifying seed. Mode 28
   732	  is stmap27, which reopens the next slack band except for the high-reference,
   733	  low-slack, stronger-moderate signature isolated by stmap26. Mode 29 is
   734	  stmap28, which replaces that hard signature blocker with a high-reference
   735	  moderate-seed area penalty that scales with reference count, slack risk, and
   736	  arrival-gain risk. Mode 30 is stmap29, which keeps the same seed band but
   737	  makes the penalty a continuous load-risk gradient. Mode 31 is stmap30,
   738	  which keeps that moderate-seed gradient and adds a smaller continuous
   739	  penalty to high-reference strong deep seeds. Mode 32 is stmap31, which keeps
   740	  mode 31's moderate penalty but dampens the strong-seed gain slope. Mode 33
   741	  is stmap32, which adds a cut-leaf load proxy to the strong-seed penalty.]
   742	
   743	  SideEffects []
   744	
   745	  SeeAlso     []
   746	
   747	***********************************************************************/
   748	static int Map_MatchSkipCutForFanout( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase )
   749	{
   750	    Map_Cut_t * pCutBest;
   751	    Map_Match_t * pMatchBest;
   752	    float Slack, SlackMargin, SlackLimit;
   753	
   754	    if ( !p->fSkipFanout )
   755	        return 0;
   756	    if ( p->fSkipFanout == 2 )
   757	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   758	    if ( p->fSkipFanout == 3 )
   759	    {
   760	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   761	            return 0;
   762	        pCutBest = pNode->pCutBest[fPhase];
   763	        if ( pCutBest == NULL )
   764	            return 0;
   765	        pMatchBest = pCutBest->M + fPhase;
   766	        if ( pMatchBest->pSuperBest == NULL )
   767	            return 0;
   768	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   769	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   770	        if ( Slack <= SlackMargin + p->fEpsilon )
   771	            return 0;
   772	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   773	    }
   774	    if ( p->fSkipFanout == 4 )
   775	    {
   776	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   777	            return 0;
   778	        pCutBest = pNode->pCutBest[fPhase];
   779	        if ( pCutBest == NULL )
   780	            return 0;
   781	        pMatchBest = pCutBest->M + fPhase;
   782	        if ( pMatchBest->pSuperBest == NULL || p->pSuperLib == NULL )
   783	            return 0;
   784	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   785	        SlackMargin = p->pSuperLib->tDelayInv.Worst;
   786	        SlackLimit = 2.0 * SlackMargin;
   787	        if ( Slack <= p->fEpsilon || Slack > SlackLimit + p->fEpsilon )
   788	            return 0;
   789	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   790	    }
   791	    if ( p->fSkipFanout == 5 )
   792	    {
   793	        if ( p->fMappingMode == 0 )
   794	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   795	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   796	            return 0;
   797	        pCutBest = pNode->pCutBest[fPhase];
   798	        if ( pCutBest == NULL )
   799	            return 0;
   800	        pMatchBest = pCutBest->M + fPhase;
   801	        if ( pMatchBest->pSuperBest == NULL )
   802	            return 0;
   803	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   804	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   805	        if ( Slack <= SlackMargin + p->fEpsilon )
   806	            return 0;
   807	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   808	    }
   809	    if ( p->fSkipFanout == 6 )
   810	    {
   811	        if ( p->fMappingMode == 0 )
   812	        {
   813	            if ( p->vMapObjs->nSize <= 20000 )
   814	                return 0;
   815	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   816	        }
   817	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   818	            return 0;
   819	        pCutBest = pNode->pCutBest[fPhase];
   820	        if ( pCutBest == NULL )
   821	            return 0;
   822	        pMatchBest = pCutBest->M + fPhase;
   823	        if ( pMatchBest->pSuperBest == NULL )
   824	            return 0;
   825	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   826	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   827	        if ( Slack <= SlackMargin + p->fEpsilon )
   828	            return 0;
   829	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   830	    }
   831	    if ( p->fSkipFanout == 7 )
   832	    {
   833	        if ( p->fMappingMode == 0 )
   834	        {
   835	            if ( p->vMapObjs->nSize <= 20000 )
   836	                return 0;
   837	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   838	        }
   839	        if ( p->fMappingMode >= 1 && p->fMappingMode <= 3 && p->vMapObjs->nSize <= 8000 )
   840	        {
   841	            pCutBest = pNode->pCutBest[fPhase];
   842	            if ( pCutBest == NULL )
   843	                return 0;
   844	            pMatchBest = pCutBest->M + fPhase;
   845	            if ( pMatchBest->pSuperBest == NULL )
   846	                return 0;
   847	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   848	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   849	            if ( Slack <= SlackMargin + p->fEpsilon )
   850	                return 0;
   851	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   852	        }
   853	        if ( p->fMappingMode == 1 )
   854	        {
   855	            pCutBest = pNode->pCutBest[fPhase];
   856	            if ( pCutBest == NULL )
   857	                return 0;
   858	            pMatchBest = pCutBest->M + fPhase;
   859	            if ( pMatchBest->pSuperBest == NULL )
   860	                return 0;
   861	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   862	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   863	            if ( Slack <= SlackMargin + p->fEpsilon )
   864	                return 0;
   865	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   866	        }
   867	        return 0;
   868	    }
   869	    if ( p->fSkipFanout >= 8 && p->fSkipFanout <= 33 )
   870	    {
   871	        if ( p->fMappingMode == 0 )
   872	        {
   873	            if ( p->vMapObjs->nSize <= 20000 )
   874	                return 0;
   875	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   876	        }
   877	        if ( p->fMappingMode >= 1 && p->fMappingMode <= 3 && p->vMapObjs->nSize <= 8000 )
   878	        {
   879	            pCutBest = pNode->pCutBest[fPhase];
   880	            if ( pCutBest == NULL )
   881	                return 0;
   882	            pMatchBest = pCutBest->M + fPhase;
   883	            if ( pMatchBest->pSuperBest == NULL )
   884	                return 0;
   885	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   886	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   887	            if ( Slack <= SlackMargin + p->fEpsilon )
   888	                return 0;
   889	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   890	        }
   891	        if ( p->fMappingMode == 1 )
   892	        {
   893	            pCutBest = pNode->pCutBest[fPhase];
   894	            if ( pCutBest == NULL )
   895	                return 0;
   896	            pMatchBest = pCutBest->M + fPhase;
   897	            if ( pMatchBest->pSuperBest == NULL )
   898	                return 0;
   899	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   900	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   901	            if ( Slack <= SlackMargin + p->fEpsilon )
   902	                return 0;
   903	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   904	        }
   905	        return 0;
   906	    }
   907	    return (pNode->nRefs > 3 && pCut->nLeaves > 2) || (pNode->nRefs > 1 && pCut->nLeaves > 3);
