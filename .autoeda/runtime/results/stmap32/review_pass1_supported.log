   523	/**Function*************************************************************
   524	
   525	  Synopsis    [Returns the stmap29 continuous extra area margin.]
   526	
   527	  Description []
   528	
   529	  SideEffects []
   530	
   531	  SeeAlso     []
   532	
   533	***********************************************************************/
   534	static float Map_MatchStmap29ModeratePenaltyFactor( Map_Node_t * pNode, float ArrivalDelta, float ArrivalGainMargin, float Slack, float SlackMargin, float Epsilon )
   535	{
   536	    float Penalty, SlackRatio, GainRatio;
   537	    if ( !Map_MatchIsStmap28ModeratePenaltyCandidate( ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon ) )
   538	        return 0.0;
   539	    if ( pNode->nRefs < 5 || SlackMargin <= Epsilon || ArrivalGainMargin <= Epsilon )
   540	        return 0.0;
   541	    SlackRatio = Slack / SlackMargin;
   542	    GainRatio = -ArrivalDelta / ArrivalGainMargin;
   543	    Penalty = 0.22 * (float)(pNode->nRefs - 4);
   544	    if ( SlackRatio < 1.25 )
   545	        Penalty += 0.20 * (1.25 - SlackRatio) / 0.25;
   546	    if ( GainRatio > 2.0 )
   547	        Penalty += 0.10 * (GainRatio - 2.0);
   548	    return Penalty > 1.0 ? 1.0 : Penalty;
   549	}
