   653	/**Function*************************************************************
   654	
   655	  Synopsis    [Returns the stmap32 cut-leaf strong-seed extra area margin.]
   656	
   657	  Description []
   658	
   659	  SideEffects []
   660	
   661	  SeeAlso     []
   662	
   663	***********************************************************************/
   664	static float Map_MatchStmap32StrongPenaltyFactor( Map_Node_t * pNode, Map_Cut_t * pCut, float ArrivalDelta, float ArrivalGainMargin, float Slack, float SlackMargin, float Epsilon )
   665	{
   666	    float Penalty, LeafLoadAvg;
   667	    if ( !Map_MatchIsStmap30StrongPenaltyCandidate( pNode, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon ) )
   668	        return 0.0;
   669	    Penalty = Map_MatchStmap31StrongPenaltyFactor( pNode, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon );
   670	    LeafLoadAvg = Map_MatchStmap32CutLeafLoadAvg( pCut );
   671	    if ( LeafLoadAvg > 1.0 )
   672	        Penalty += 0.04 * (LeafLoadAvg - 1.0);
   673	    return Penalty > 0.75 ? 0.75 : Penalty;
   674	}
