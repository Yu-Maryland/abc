   609	static float Map_MatchStmap31StrongPenaltyFactor( Map_Node_t * pNode, float ArrivalDelta, float ArrivalGainMargin, float Slack, float SlackMargin, float Epsilon )
   610	{
   611	    float Penalty, SlackRatio, GainRatio;
   612	    if ( !Map_MatchIsStmap30StrongPenaltyCandidate( pNode, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon ) )
   613	        return 0.0;
   614	    if ( SlackMargin <= Epsilon || ArrivalGainMargin <= Epsilon )
   615	        return 0.0;
   616	    SlackRatio = Slack / SlackMargin;
   617	    GainRatio = -ArrivalDelta / ArrivalGainMargin;
   618	    Penalty = 0.18 * (float)(pNode->nRefs - 4);
   619	    if ( SlackRatio < 1.25 )
   620	        Penalty += 0.16 * (1.25 - SlackRatio) / 0.25;
   621	    if ( GainRatio > 5.0 )
   622	        Penalty += 0.05 * (GainRatio - 5.0);
   623	    return Penalty > 0.75 ? 0.75 : Penalty;
   624	}
