    61	    pMatch->tArrive.Rise   = MAP_FLOAT_LARGE; // unassigned
    62	    pMatch->tArrive.Fall   = MAP_FLOAT_LARGE; // unassigned
    63	    pMatch->tArrive.Worst  = MAP_FLOAT_LARGE; // unassigned
    64	}
