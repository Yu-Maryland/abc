   135	static void Abc_Stmap36CollectSclLoadStats( Abc_Ntk_t * pNtk, Abc_Stmap36LoadStats_t * pStats )
   136	{
   137	    SC_Lib * pLib = (SC_Lib *)Abc_FrameReadLibScl();
   138	    Abc_Obj_t * pObj;
   139	    Mio_Gate_t * pGate;
   140	    SC_Cell * pCell;
   141	    float Load, MaxCap, Ratio;
   142	    int i, CellId, Fanouts, Pins;
   143	    Abc_Stmap36LoadStatsClear( pStats );
   144	    if ( pLib == NULL || !Abc_SclHasDelayInfo(pLib) )
   145	        return;
   146	    pStats->fAvailable = 1;
   147	    Abc_NtkForEachNode( pNtk, pObj, i )
   148	    {
   149	        pStats->nNodes++;
   150	        if ( pObj->pData == NULL )
   151	            continue;
   152	        pGate = (Mio_Gate_t *)pObj->pData;
   153	        CellId = Abc_SclCellFind( pLib, Mio_GateReadName(pGate) );
   154	        if ( CellId < 0 )
   155	            continue;
   156	        pCell = SC_LibCell( pLib, CellId );
   157	        if ( pCell == NULL || pCell->n_outputs == 0 )
   158	            continue;
   159	        MaxCap = SC_CellPin( pCell, pCell->n_inputs )->max_out_cap;
   160	        if ( MaxCap <= 0.0 )
   161	            continue;
   162	        Load = Abc_Stmap36FanoutLoad( pLib, pObj, &Fanouts, &Pins );
   163	        Ratio = Load / MaxCap;
   164	        pStats->RatioSum += Ratio;
   165	        if ( pStats->RatioMax < Ratio )
   166	            pStats->RatioMax = Ratio;
   167	        if ( Ratio > 1.0 )
   168	            pStats->nOver++;
   169	        pStats->nMatched++;
   170	        pStats->nPins += Pins;
   171	        Abc_Stmap36TopInsert( pStats->TopRatios, pStats->TopNodes, pStats->pTopGates, pStats->TopFanouts, pStats->TopLoads, pStats->TopCaps,
   172	            Ratio, Abc_ObjId(pObj), Mio_GateReadName(pGate), Fanouts, Load, MaxCap );
   173	    }
   174	}
