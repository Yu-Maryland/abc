    55	static void Abc_Stmap36TopInsert( float * pRatios, int * pNodes, const char ** ppGates, int * pFanouts, float * pLoads, float * pCaps, float Ratio, int Node, const char * pGate, int Fanouts, float Load, float Cap )
    56	{
    57	    int i, k;
    58	    if ( Ratio <= pRatios[4] )
    59	        return;
    60	    for ( i = 0; i < 5; i++ )
    61	    {
    62	        if ( Ratio <= pRatios[i] )
    63	            continue;
    64	        for ( k = 4; k > i; k-- )
    65	        {
    66	            pRatios[k] = pRatios[k-1];
    67	            pNodes[k] = pNodes[k-1];
    68	            ppGates[k] = ppGates[k-1];
    69	            pFanouts[k] = pFanouts[k-1];
    70	            pLoads[k] = pLoads[k-1];
    71	            pCaps[k] = pCaps[k-1];
    72	        }
    73	        pRatios[i] = Ratio;
    74	        pNodes[i] = Node;
    75	        ppGates[i] = pGate;
    76	        pFanouts[i] = Fanouts;
    77	        pLoads[i] = Load;
    78	        pCaps[i] = Cap;
    79	        return;
    80	    }
    81	}
