   193	static float Abc_Stmap36FeedbackSeverity( Abc_Stmap36LoadStats_t * pStats )
   194	{
   195	    float OverFrac, MaxPart, OverPart, Severity;
   196	    if ( !pStats->fAvailable || pStats->nMatched == 0 )
   197	        return 0.0;
   198	    OverFrac = (float)pStats->nOver / (float)pStats->nMatched;
   199	    MaxPart = pStats->RatioMax > 4.0 ? (pStats->RatioMax - 4.0) / 8.0 : 0.0;
   200	    OverPart = OverFrac > 0.002 ? (OverFrac - 0.002) / 0.006 : 0.0;
   201	    if ( MaxPart > 1.0 )
   202	        MaxPart = 1.0;
   203	    if ( OverPart > 1.0 )
   204	        OverPart = 1.0;
   205	    Severity = 0.65 * MaxPart + 0.35 * OverPart;
   206	    return Severity > 1.0 ? 1.0 : Severity;
   207	}
