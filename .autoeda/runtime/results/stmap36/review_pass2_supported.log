    94	static float Abc_Stmap36FanoutLoad( SC_Lib * pLib, Abc_Obj_t * pObj, int * pFanouts, int * pPins )
    95	{
    96	    Abc_Obj_t * pFanout;
    97	    Mio_Gate_t * pGateFan;
    98	    SC_Cell * pCellFan;
    99	    float Load = 0.0;
   100	    int i, iFanin, CellId;
   101	    *pFanouts = 0;
   102	    *pPins = 0;
   103	    Abc_ObjForEachFanout( pObj, pFanout, i )
   104	    {
   105	        (*pFanouts)++;
   106	        if ( !Abc_ObjIsNode(pFanout) || pFanout->pData == NULL )
   107	            continue;
   108	        iFanin = Abc_NodeFindFanin( pFanout, pObj );
   109	        if ( iFanin < 0 )
   110	            continue;
   111	        pGateFan = (Mio_Gate_t *)pFanout->pData;
   112	        CellId = Abc_SclCellFind( pLib, Mio_GateReadName(pGateFan) );
   113	        if ( CellId < 0 )
   114	            continue;
   115	        pCellFan = SC_LibCell( pLib, CellId );
   116	        if ( pCellFan == NULL || iFanin >= pCellFan->n_inputs )
   117	            continue;
   118	        Load += SC_CellPinCap( pCellFan, iFanin );
   119	        (*pPins)++;
   120	    }
   121	    return Load;
   122	}
