   846	static int Map_Stmap88MaybeTargetChildPhase( Map_Man_t * p, Map_Node_t * pNode, int fPhase, int CutOrdinal, Map_Match_t * pMatch, Map_Match_t * pBestBefore, int fAccepted )
   847	{
   848	    Map_Node_t * pNodeRegular;
   849	    Mio_Gate_t * pGate, * pGateBefore;
   850	    int AigId, fEligible, fOverride;
   851	    float ArrivalGain, AreaPremium, AreaRatio, MinArrivalGain, AreaPremiumWindow, AreaRatioWindow;
   852	    const char * pAction;
   853	    if ( !s_fStmap88ChildPhaseTarget || !s_fStmap88ChildPhaseTargetActive || p == NULL || pNode == NULL || pMatch == NULL )
   854	        return fAccepted;
   855	    pNodeRegular = Map_Regular( pNode );
   856	    if ( Map_NodeIsConst( pNodeRegular ) )
   857	        return fAccepted;
   858	    AigId = Map_NodeReadAigId( pNodeRegular );
   859	    if ( AigId != s_Stmap88ChildAigId )
   860	        return fAccepted;
   861	
   862	    s_nStmap88ChildTargetRows++;
   863	    if ( fPhase == s_Stmap88TargetPhase )
   864	        s_nStmap88ChildTargetPhaseHits++;
   865	
   866	    MinArrivalGain = 0.02f;
   867	    AreaPremiumWindow = 1.20f;
   868	    AreaRatioWindow = 2.00f;
   869	    ArrivalGain = pBestBefore ? pBestBefore->tArrive.Worst - pMatch->tArrive.Worst : -MAP_FLOAT_LARGE;
   870	    AreaPremium = pBestBefore ? pMatch->AreaFlow - pBestBefore->AreaFlow : MAP_FLOAT_LARGE;
   871	    AreaRatio = (pBestBefore && pBestBefore->AreaFlow > p->fEpsilon) ? pMatch->AreaFlow / pBestBefore->AreaFlow : MAP_FLOAT_LARGE;
   872	    fEligible = 0;
   873	    fOverride = 0;
   874	    pAction = "blocked-phase";
   875	
   876	    if ( fPhase != s_Stmap88TargetPhase )
   877	    {
   878	        s_nStmap88ChildTargetBlockedPhase++;
   879	        pAction = "blocked-phase";
   880	    }
   881	    else if ( p->fMappingMode != 2 && p->fMappingMode != 3 )
   882	    {
   883	        s_nStmap88ChildTargetBlockedMode++;
   884	        pAction = "blocked-mode";
   885	    }
   886	    else if ( pBestBefore == NULL || pBestBefore->pSuperBest == NULL )
   887	    {
   888	        s_nStmap88ChildTargetBlockedBest++;
   889	        pAction = "blocked-no-best";
   890	    }
   891	    else if ( ArrivalGain < MinArrivalGain - p->fEpsilon )
   892	    {
   893	        s_nStmap88ChildTargetBlockedSpeed++;
   894	        pAction = "blocked-speed";
   895	    }
   896	    else if ( AreaPremium > AreaPremiumWindow + p->fEpsilon || AreaRatio > AreaRatioWindow + p->fEpsilon )
   897	    {
   898	        s_nStmap88ChildTargetBlockedWindow++;
   899	        pAction = "blocked-window";
   900	    }
   901	    else
   902	    {
   903	        s_nStmap88ChildTargetEligible++;
   904	        fEligible = 1;
   905	        if ( fAccepted )
   906	        {
   907	            s_nStmap88ChildTargetAlready++;
   908	            pAction = "already-selected";
   909	        }
   910	        else
   911	        {
   912	            s_nStmap88ChildTargetOverrides++;
   913	            fOverride = 1;
   914	            pAction = "override";
   915	            fAccepted = 1;
   916	        }
   917	    }
   918	
   919	    if ( fPhase == s_Stmap88TargetPhase || fOverride )
   920	    {
   921	        pGate = pMatch && pMatch->pSuperBest ? pMatch->pSuperBest->pRoot : NULL;
   922	        pGateBefore = pBestBefore && pBestBefore->pSuperBest ? pBestBefore->pSuperBest->pRoot : NULL;
   923	        printf( "%s child-phase-target: index = %d  child-aig = %d  target-phase = %d  mapper-mode = %d  phase = %d  cut-ordinal = %d  action = %s  eligible = %d  override = %d  accepted-before = %d  gate = %s  best-gate = %s  arrival = %.3f  best-arrival = %.3f  arrival-gain = %.3f  area-flow = %.3f  best-area-flow = %.3f  area-premium = %.3f  area-ratio = %.3f  min-arrival-gain = %.3f  area-premium-window = %.3f  area-ratio-window = %.3f\n",
   924	            s_pStmap88ChildPhaseTargetLabel, s_nStmap88ChildTargetRows,
   925	            s_Stmap88ChildAigId, s_Stmap88TargetPhase, p->fMappingMode, fPhase,
   926	            CutOrdinal, pAction, fEligible, fOverride, fAccepted && !fOverride,
   927	            pGate ? Mio_GateReadName(pGate) : "?",
   928	            pGateBefore ? Mio_GateReadName(pGateBefore) : "?",
   929	            pMatch->tArrive.Worst, pBestBefore ? pBestBefore->tArrive.Worst : MAP_FLOAT_LARGE,
   930	            ArrivalGain, pMatch->AreaFlow, pBestBefore ? pBestBefore->AreaFlow : MAP_FLOAT_LARGE,
   931	            AreaPremium, AreaRatio, MinArrivalGain, AreaPremiumWindow, AreaRatioWindow );
   932	    }
   933	    return fAccepted;
   934	}
