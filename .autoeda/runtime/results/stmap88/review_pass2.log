    Abc_Stmap79SetParentCutDiag( 0, "stmap86", -1, -1 );
    Abc_Stmap78SetDemandPathDiag( 0, "stmap86", -1, -1 );
    Abc_Stmap77SetReconstructionDiag( 0, "stmap86", NULL, 0 );
    Map_Stmap75PrintFinalCriticalAigSummary();
    Map_Stmap75SetFinalCriticalAigDiag( 0, -1 );
    if ( RetValue == 0 )
    {
        pNtkRes = Abc_FrameReadNtk( pAbc );
        Abc_Stmap74EnableFinalCriticalScope( pNtkRes, "stmap86" );
        Abc_Stmap76EnablePhaseSurvivalScope( pNtkRes, "stmap86", WatchAigs, nWatchAigs );
    }
    return RetValue;

usage:
    Abc_Print( -2, "usage: stmap86 [-DABFSG float] [-M num] [-arspfuovh]\n" );
