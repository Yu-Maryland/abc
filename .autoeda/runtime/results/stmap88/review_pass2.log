   151	    Map_Stmap75PrintFinalCriticalAigSummary();
   152	    Map_Stmap75SetFinalCriticalAigDiag( 0, -1 );
   153	    if ( RetValue == 0 )
   154	    {
   155	        pNtkRes = Abc_FrameReadNtk( pAbc );
   156	        Abc_Stmap74EnableFinalCriticalScope( pNtkRes, "stmap88" );
   157	        Abc_Stmap76EnablePhaseSurvivalScope( pNtkRes, "stmap88", WatchAigs, nWatchAigs );
   158	    }
   159	    return RetValue;
   160	
   161	usage:
   162	    Abc_Print( -2, "usage: stmap88 [-DABFSG float] [-M num] [-arspfuovh]\n" );
   163	    Abc_Print( -2, "\t              performs stmap88 bounded-pressure mapping with parent phase targeting plus child phase-1 speed targeting\n" );
   164	    Abc_Print( -2, "\t-D float : sets the global required times [default = not used]\n" );
   165	    Abc_Print( -2, "\t-A float : \"area multiplier\" to bias gate selection [default = 0.00]\n" );
   166	    Abc_Print( -2, "\t-B float : \"delay multiplier\" to bias gate selection [default = 0.00]\n" );
   167	    Abc_Print( -2, "\t-F float : the logarithmic fanout delay parameter [default = 0.00]\n" );
   168	    Abc_Print( -2, "\t-S float : the slew parameter used to generate the library [default = 0.00]\n" );
   169	    Abc_Print( -2, "\t-G float : the SCL/genlib gain parameter used to generate the library [default = 250.00]\n" );
   170	    Abc_Print( -2, "\t-M num   : skip gate classes whose size is less than this [default = 0]\n" );
   171	    Abc_Print( -2, "\t-a       : toggles area-only mapping [default = no]\n" );
   172	    Abc_Print( -2, "\t-r       : toggles area recovery [default = yes]\n" );
   173	    Abc_Print( -2, "\t-s       : toggles sweep after mapping [default = no]\n" );
   174	    Abc_Print( -2, "\t-p       : optimizes power by minimizing switching [default = no]\n" );
   175	    Abc_Print( -2, "\t-f       : disables the bounded-pressure SCL feedback mapper mode [default = yes]\n" );
   176	    Abc_Print( -2, "\t-u       : use standard-cell profile [default = no]\n" );
   177	    Abc_Print( -2, "\t-o       : toggles using buffers to decouple combinational outputs [default = no]\n" );
   178	    Abc_Print( -2, "\t-v       : toggles verbose output [default = no]\n" );
   179	    Abc_Print( -2, "\t-h       : print the command usage\n" );
   180	    return 1;
   181	}
