  5795	/**Function*************************************************************
  5796	
  5797	  Synopsis    [Find the best matching of the cut.]
  5798	
  5799	  Description [The parameters: the node (pNode), the cut (pCut), the phase to be matched 
  5800	  (fPhase), and the upper bound on the arrival times of the cut (fWorstLimit). This 
  5801	  procedure goes through the matching supergates up to the phase assignment, and selects the
  5802	  best supergate, which will be used to map the cut. As a result of calling this procedure
  5803	  the matching information is written into pMatch.]
  5804	               
  5805	  SideEffects []
  5806	
  5807	  SeeAlso     []
  5808	
  5809	***********************************************************************/
  5810	int Map_MatchNodeCut( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase, float fWorstLimit )
  5811	{
  5812	    Map_Match_t MatchBest, * pMatch = pCut->M + fPhase;
  5813	    Map_Super_t * pSuper;
  5814	    int i, Counter;
  5815	
  5816	    // save the current match of the cut
  5817	    MatchBest = *pMatch;
  5818	    // go through the supergates
  5819	    for ( pSuper = pMatch->pSupers, Counter = 0; pSuper; pSuper = pSuper->pNext, Counter++ )
  5820	    {
  5821	        p->nMatches++;
  5822	        // this is an attempt to reduce the runtime of matching and area 
  5823	        // at the cost of rare and very minor increase in delay
  5824	        // (the supergates are sorted by increasing area)
  5825	        if ( Counter == 30 )
  5826	           break;
  5827	
  5828	        // go through different phases of the given match and supergate
  5829	        pMatch->pSuperBest = pSuper;
  5830	        for ( i = 0; i < (int)pSuper->nPhases; i++ )
  5831	        {
  5832	            p->nPhases++;
  5833	            // find the overall phase of this match
  5834	            pMatch->uPhaseBest = pMatch->uPhase ^ pSuper->uPhases[i];
  5835	            if ( p->fMappingMode == 0 )
  5836	            {
  5837	                // get the arrival time
  5838	                Map_TimeCutComputeArrival( pNode, pCut, fPhase, fWorstLimit );
  5839	                // skip the cut if the arrival times exceed the required times
  5840	                if ( pMatch->tArrive.Worst > fWorstLimit + p->fEpsilon )
  5841	                    continue;
  5842	                // get the area (area flow)
  5843	                pMatch->AreaFlow = Map_CutGetAreaFlow( pCut, fPhase );
  5844	            }
  5845	            else
  5846	            {
  5847	                // get the area (area flow)
  5848	                if ( p->fMappingMode == 2 || p->fMappingMode == 3 )
  5849	                    pMatch->AreaFlow = Map_CutGetAreaDerefed( pCut, fPhase );
  5850	                else if ( p->fMappingMode == 4 )
  5851	                    pMatch->AreaFlow = Map_SwitchCutGetDerefed( pNode, pCut, fPhase );
  5852	                else 
  5853	                    pMatch->AreaFlow = Map_CutGetAreaFlow( pCut, fPhase );
  5854	                // skip if the cut is too large
  5855	                if ( pMatch->AreaFlow > MatchBest.AreaFlow + p->fEpsilon )
  5856	                    continue;
  5857	                // get the arrival time
  5858	                Map_TimeCutComputeArrival( pNode, pCut, fPhase, fWorstLimit );
  5859	                // skip the cut if the arrival times exceed the required times
  5860	                if ( pMatch->tArrive.Worst > fWorstLimit + p->fEpsilon )
  5861	                    continue;
  5862	            }
  5863	
  5864	            // if the cut is non-trivial, compare it
  5865	            if ( Map_MatchCompare( p, &MatchBest, pMatch, p->fMappingMode ) )
  5866	            {
  5867	                MatchBest = *pMatch;
  5868	                // if we are mapping for delay, the worst-case limit should be reduced
  5869	                if ( p->fMappingMode == 0 )
  5870	                    fWorstLimit = MatchBest.tArrive.Worst;
  5871	            }
  5872	        }
  5873	    }
  5874	    // set the best match
  5875	    *pMatch = MatchBest;
  5876	
  5877	    // recompute the arrival time and area (area flow) of this cut
  5878	    if ( pMatch->pSuperBest )
  5879	    {
  5880	        Map_TimeCutComputeArrival( pNode, pCut, fPhase, MAP_FLOAT_LARGE );
  5881	        if ( p->fMappingMode == 2 || p->fMappingMode == 3 )
  5882	            pMatch->AreaFlow = Map_CutGetAreaDerefed( pCut, fPhase );
  5883	        else if ( p->fMappingMode == 4 )
  5884	            pMatch->AreaFlow = Map_SwitchCutGetDerefed( pNode, pCut, fPhase );
  5885	        else 
  5886	            pMatch->AreaFlow = Map_CutGetAreaFlow( pCut, fPhase );
  5887	    }
  5888	    return 1;
  5889	}
