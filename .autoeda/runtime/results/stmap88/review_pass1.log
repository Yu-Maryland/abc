  6000	            // if we are mapping for delay, the worst-case limit should be tightened
  6001	            if ( p->fMappingMode == 0 )
  6002	                fWorstLimit = MatchBest.tArrive.Worst;
  6003	        }
  6004	    }
  6005	
  6006	    if ( pCutBest == NULL )
