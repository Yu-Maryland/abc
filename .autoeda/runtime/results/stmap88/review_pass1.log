   556	static int Map_Stmap82MaybeBlockStickyReplacement( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase, int CutOrdinal, Map_Match_t * pMatch, int fAccepted, int fSticky, Map_Match_t * pStickyMatch, Map_Cut_t * pStickyCut, int StickyCutOrdinal )
