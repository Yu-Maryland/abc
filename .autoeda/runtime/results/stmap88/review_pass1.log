  6014	    if ( p->fMappingMode >= 2 && 
  6015	         (pNode->nRefAct[fPhase] > 0 || 
  6016	         (pNode->pCutBest[!fPhase] == NULL && pNode->nRefAct[!fPhase] > 0)) )
  6017	    {
  6018	        if ( p->fMappingMode == 2 || p->fMappingMode == 3 )
  6019	            Area2 = Map_CutRef( pNode->pCutBest[fPhase], fPhase, p->fUseProfile );
  6020	        else if ( p->fMappingMode == 4 )
  6021	            Area2 = Map_SwitchCutRef( pNode, pNode->pCutBest[fPhase], fPhase );
  6022	        else 
  6023	            assert( 0 );
