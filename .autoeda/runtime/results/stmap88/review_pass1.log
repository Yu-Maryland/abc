  5902	int Map_MatchNodePhase( Map_Man_t * p, Map_Node_t * pNode, int fPhase )
  5903	{
  5904	    Map_Match_t MatchBest, Stmap82StickyMatch, * pMatch;
  5905	    Map_Cut_t * pCut, * pCutBest, * pStmap82StickyCut = NULL;
  5906	    float Area1 = 0.0; // Suppress "might be used uninitialized
  5907	    float Area2, fWorstLimit;
  5908	    int CutOrdinal, fSkipFanout, fAreaSkip, fAccepted, fStmap82Sticky = 0, Stmap82StickyCutOrdinal = -1;
  5909	
  5910	    // skip the cuts that have been unassigned during area recovery
  5911	    pCutBest = pNode->pCutBest[fPhase];
  5912	    if ( p->fMappingMode != 0 && pCutBest == NULL )
  5913	        return 1;
  5914	
  5915	    // recompute the arrival times of the current best match 
  5916	    // because the arrival times of the fanins may have changed 
  5917	    // as a result of remapping fanins in the topological order
  5918	    if ( p->fMappingMode != 0 )
  5919	    {
  5920	        Map_TimeCutComputeArrival( pNode, pCutBest, fPhase, MAP_FLOAT_LARGE );
  5921	        // make sure that the required times are met
  5922	//        assert( pCutBest->M[fPhase].tArrive.Rise < pNode->tRequired[fPhase].Rise + p->fEpsilon );
  5923	//        assert( pCutBest->M[fPhase].tArrive.Fall < pNode->tRequired[fPhase].Fall + p->fEpsilon );
  5924	    }
  5925	
  5926	    // recompute the exact area of the current best match
  5927	    // because the exact area of the fanins may have changed
  5928	    // as a result of remapping fanins in the topological order
  5929	    if ( p->fMappingMode == 2 || p->fMappingMode == 3 )
  5930	    {
  5931	        pMatch = pCutBest->M + fPhase;
  5932	        if ( pNode->nRefAct[fPhase] > 0 || 
  5933	            (pNode->pCutBest[!fPhase] == NULL && pNode->nRefAct[!fPhase] > 0) )
  5934	            pMatch->AreaFlow = Area1 = Map_CutDeref( pCutBest, fPhase, p->fUseProfile );
  5935	        else
  5936	            pMatch->AreaFlow = Area1 = Map_CutGetAreaDerefed( pCutBest, fPhase );
  5937	    }
  5938	    else if ( p->fMappingMode == 4 )
  5939	    {
  5940	        pMatch = pCutBest->M + fPhase;
  5941	        if ( pNode->nRefAct[fPhase] > 0 || 
  5942	            (pNode->pCutBest[!fPhase] == NULL && pNode->nRefAct[!fPhase] > 0) )
  5943	            pMatch->AreaFlow = Area1 = Map_SwitchCutDeref( pNode, pCutBest, fPhase );
  5944	        else
  5945	            pMatch->AreaFlow = Area1 = Map_SwitchCutGetDerefed( pNode, pCutBest, fPhase );
