   521	static int Map_Stmap82StickyParentPhaseApplies( Map_Man_t * p, Map_Node_t * pNode, int fPhase )
   522	{
   523	    Map_Node_t * pNodeRegular;
   524	    if ( !s_fStmap82StickyParentPhase || !s_fStmap82StickyParentPhaseActive || p == NULL || pNode == NULL )
   525	        return 0;
   526	    if ( p->fMappingMode != 2 && p->fMappingMode != 3 )
   527	        return 0;
   528	    pNodeRegular = Map_Regular( pNode );
   529	    if ( Map_NodeIsConst( pNodeRegular ) )
