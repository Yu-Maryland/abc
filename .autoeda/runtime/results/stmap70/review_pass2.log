    {
        if ( !strcmp( argv[i], "-h" ) )
            goto usage;
    }

    printf( "stmap67 diagnostic: inherited-policy = stmap65  near-strong-node-load-drop = 1  final-stime-witness = 1  node-pressure-window = [1.15,1.25)  strong-node-threshold = 1.25\n" );
