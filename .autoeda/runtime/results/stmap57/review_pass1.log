static void Abc_Stmap57CollectHotspotCone( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap57LoadStats_t * pStats, SC_Man * pTime, float Ratio )
{
    Abc_Obj_t * pFanout, * pFanout2;
    float FanoutCriticality;
    int i, k, AigId;
    if ( Ratio <= 1.0 )
        return;
    AigId = Abc_Stmap57MappedObjAigId( pNtk, pObj );
    if ( AigId >= 0 )
    {
        pStats->nHotspotRoots++;
        Abc_Stmap57PressureInsert( pStats, AigId, Abc_ObjId(pObj), 0.90 * Ratio, Abc_Stmap57ObjCriticality( pTime, pObj ) );
    }
    Abc_ObjForEachFanout( pObj, pFanout, i )
    {
        FanoutCriticality = Abc_Stmap57ObjCriticality( pTime, pFanout );
        AigId = Abc_Stmap57MappedObjAigId( pNtk, pFanout );
        if ( AigId >= 0 )
        {
            pStats->nHotspotFanout++;
            Abc_Stmap57PressureInsert( pStats, AigId, Abc_ObjId(pFanout), Ratio, FanoutCriticality );
        }
        Abc_Stmap57InsertConsumerFanins( pNtk, pFanout, pStats, 0.86 * Ratio, FanoutCriticality, 3 );
