        if ( pNtkFirst == NULL )
        {
            if ( fTempMap )
                Abc_NtkDelete( pNtkMap );
            Abc_Print( -1, "stmap57 has failed.\n" );
            return 1;
        }
        Abc_Stmap57CollectSclLoadStats( pNtkFirst, &LoadStats );
        Abc_Stmap57PrintSclLoadStats( "feedback-load", &LoadStats );
        Abc_Stmap57PrintHotspots( &LoadStats );
        OverFrac = LoadStats.nMatched ? (float)LoadStats.nOver / (float)LoadStats.nMatched : 0.0;
        Feedback = Abc_Stmap57FeedbackSeverity( &LoadStats );
        LowGain = 0.90 * Gain;
        SelectedGain = Gain;
        fUseReducedGain = Feedback >= 0.85 && LoadStats.nPressureEntries >= 8000;
        if ( fUseReducedGain && LowGain > 0.0 )
            SelectedGain = LowGain;
        printf( "stmap57 feedback: remap = 1  active = %d  max-load-ratio = %.3f  over-max-frac = %.6f  severity = %.3f  raw-pressure-entries = %d  sink-pressure-entries = %d  pressure-capacity = %d\n",
            Feedback > 0.0 && LoadStats.nPressureEntries > 0, LoadStats.RatioMax, OverFrac,
            Feedback, LoadStats.nPressureEntries, LoadStats.nSinkPressureEntries,
            LoadStats.nAigPressureRatios );
        printf( "stmap57 blended-gain: base-gain = %.2f  blend-gain = %.2f  selected-gain = %.2f  severity-threshold = 0.850  raw-pressure-threshold = 8000  selected-blend-gain = %d\n",
            Gain, LowGain, SelectedGain, fUseReducedGain );
        printf( "stmap57 mapper-mode: raw-pressure-transfer-mode = 57  blended-gain = %.2f  pressure-feed = raw-load  inherited-cut-only-area-save-cap = 1.35x-inverter\n", SelectedGain );
        Abc_NtkDelete( pNtkFirst );
        Map_Stmap45SetSclLoadFeedbackWithEntries( LoadStats.RatioMax, OverFrac, Feedback, LoadStats.pAigPressureRatios, LoadStats.nAigPressureRatios, LoadStats.nPressureEntries );
        pNtkRes = Abc_NtkMap( pNtkMap, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, SelectedGain, nGatesMin, fRecovery, fSwitching, 57, fUseProfile, fUseBuffs, fVerbose );
        Map_Stmap45SetSclLoadFeedbackWithEntries( 0.0, 0.0, 0.0, NULL, 0, 0 );
        Abc_Stmap57LoadStatsFree( &LoadStats );
        if ( pNtkRes == NULL )
        {
            if ( fTempMap )
                Abc_NtkDelete( pNtkMap );
            Abc_Print( -1, "stmap57 feedback remap has failed.\n" );
            return 1;
        }
    }
    else
    {
        pNtkRes = Abc_NtkMap( pNtkMap, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, Gain, nGatesMin, fRecovery, fSwitching, 0, fUseProfile, fUseBuffs, fVerbose );
        if ( pNtkRes == NULL )
        {
            if ( fTempMap )
                Abc_NtkDelete( pNtkMap );
            Abc_Print( -1, "stmap57 has failed.\n" );
            return 1;
        }
    }
    if ( fTempMap )
        Abc_NtkDelete( pNtkMap );

    if ( fSweep )
    {
        Abc_NtkFraigSweep( pNtkRes, 0, 0, 0, 0 );
        if ( Abc_NtkHasMapping(pNtkRes) )
        {
            pNtkRes = Abc_NtkDupDfs( pNtk = pNtkRes );
            Abc_NtkDelete( pNtk );
        }
    }

    Abc_Stmap57CollectSclLoadStats( pNtkRes, &LoadStats );
    Abc_Stmap57PrintSclLoadStats( "scl-load", &LoadStats );
    Abc_Stmap57LoadStatsFree( &LoadStats );
    Abc_FrameReplaceCurrentNetwork( pAbc, pNtkRes );
    return 0;

usage:
    if ( DelayTarget == -1 )
