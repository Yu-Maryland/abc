   419	static void Abc_Stmap57PrintHotspots( Abc_Stmap57LoadStats_t * pStats )
   420	{
   421	    int i;
   422	    if ( !pStats->fAvailable )
   423	        return;
   424	    printf( "stmap57 sink-pressure stats: roots = %d  consumer-fanin = %d  consumer-fanout = %d  raw-pressure-entries = %d  raw-pressure-updates = %d  sink-pressure-entries = %d  sink-pressure-updates = %d  pressure-missed = %d  pressure-capacity = %d  tracked-aig = %d  tracked-node = %d  tracked-raw-ratio = %.3f  tracked-sink-ratio = %.3f\n",
   425	        pStats->nHotspotRoots, pStats->nHotspotFanin, pStats->nHotspotFanout,
   426	        pStats->nPressureEntries, pStats->nPressureUpdates,
   427	        pStats->nSinkPressureEntries, pStats->nSinkPressureUpdates,
   428	        pStats->nPressureMissed,
   429	        pStats->nAigPressureRatios, ABC_STMAP57_TRACK_AIG_ID, pStats->TrackedNode,
   430	        pStats->TrackedRatio, pStats->TrackedSinkRatio );
   431	    for ( i = 0; i < ABC_STMAP57_TOP_PRESSURES && pStats->TopPressureRatios[i] > 0.0; i++ )
   432	        printf( "stmap57 sink-pressure: rank = %d  aig-id = %d  mapped-node = %d  sink-pressure-ratio = %.3f\n",
   433	            i + 1, pStats->TopPressureAigIds[i], pStats->TopPressureNodes[i], pStats->TopPressureRatios[i] );
