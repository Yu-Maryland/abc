/**Function*************************************************************

  Synopsis    [Runs the stmap8 mapper probe.]

  Description [stmap8 tests an arrival-bounded refinement of the stmap7
  criticality-sensitive high-fanout wide-cut guard. It keeps the same
  graph-size, slack, and fanout-bucket gates, but exact-area recovery on
  mid-sized and large graphs may allow an area-saving wide high-fanout cut
  only when the candidate match does not worsen mapper arrival by more than
  one quarter of an inverter delay.]

  SideEffects []

  SeeAlso     []

***********************************************************************/
int Abc_CommandStmap8( Abc_Frame_t * pAbc, int argc, char ** argv )
{
    Abc_Ntk_t * pNtk, * pNtkRes;
    char Buffer[100];
    double DelayTarget;
    double AreaMulti;
    double DelayMulti;
    float LogFan = 0;
    float Slew = 0; // choose based on the library
    float Gain = 250; // keep classic map gain to isolate the recovery guard hypothesis
    int nGatesMin = 0;
    int fAreaOnly;
    int fRecovery;
    int fSweep;
    int fSwitching;
    int fSkipFanout;
    int fUseProfile;
    int fUseBuffs;
    int fVerbose;
    int c;
    extern Abc_Ntk_t * Abc_NtkMap( Abc_Ntk_t * pNtk, Mio_Library_t* userLib, double DelayTarget, double AreaMulti, double DelayMulti, float LogFan, float Slew, float Gain, int nGatesMin, int fRecovery, int fSwitching, int fSkipFanout, int fUseProfile, int fUseBuffs, int fVerbose );
