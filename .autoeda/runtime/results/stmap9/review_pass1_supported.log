   315	static int Map_MatchSkipAreaSensitiveFanout( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase, Map_Match_t * pMatchBest, Map_Match_t * pMatch )
   316	{
   317	    float Slack, SlackMargin, SlackGate, ArrivalMargin, AreaMargin;
   318	
   319	    if ( p->fSkipFanout != 7 && p->fSkipFanout != 8 && p->fSkipFanout != 9 && p->fSkipFanout != 10 )
   320	        return 0;
   321	    if ( p->fMappingMode < 2 || p->fMappingMode > 3 )
   322	        return 0;
   323	    if ( p->vMapObjs->nSize <= 8000 )
   324	        return 0;
   325	    if ( !Map_MatchCutHasStmapFanoutRisk( pNode, pCut ) )
   326	        return 0;
   327	    if ( pMatchBest == NULL || pMatchBest->pSuperBest == NULL || pMatch == NULL || pMatch->pSuperBest == NULL )
   328	        return 0;
   329	    Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   330	    SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   331	    if ( p->fSkipFanout == 8 || p->fSkipFanout == 9 || p->fSkipFanout == 10 )
   332	    {
   333	        SlackGate = 2.0 * SlackMargin;
   334	        if ( p->fSkipFanout == 10 &&
   335	             Slack > SlackMargin + p->fEpsilon &&
   336	             Slack <= SlackGate + p->fEpsilon &&
   337	             !Map_MatchCutHasStmapHighestFanoutRisk( pNode, pCut ) &&
   338	             pMatch->tArrive.Worst <= pMatchBest->tArrive.Worst + p->fEpsilon )
   339	        {
   340	            AreaMargin = p->pSuperLib ? p->pSuperLib->AreaInv : 0.0;
   341	            if ( pMatch->AreaFlow < pMatchBest->AreaFlow - AreaMargin - p->fEpsilon )
   342	                return 0;
   343	        }
   344	        if ( Slack <= SlackGate + p->fEpsilon )
   345	            return 1;
   346	        if ( Map_MatchCutHasStmapHighestFanoutRisk( pNode, pCut ) )
   347	            return 1;
   348	    }
   349	    if ( Slack <= SlackMargin + p->fEpsilon )
   350	        return 0;
   351	    if ( p->fSkipFanout == 9 || p->fSkipFanout == 10 )
   352	    {
   353	        ArrivalMargin = 0.25 * SlackMargin;
   354	        if ( pMatch->tArrive.Worst > pMatchBest->tArrive.Worst + ArrivalMargin + p->fEpsilon )
   355	            return 1;
   356	    }
   357	    AreaMargin = p->pSuperLib ? 0.5 * p->pSuperLib->AreaInv : 0.0;
   358	    if ( pMatch->AreaFlow < pMatchBest->AreaFlow - AreaMargin - p->fEpsilon )
   359	        return 0;
   360	    return 1;
