   203	        Abc_Print( 0, "The network was strashed and balanced before stmap10.\n" );
   204	        pNtkRes = Abc_NtkMap( pNtk, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, Gain, nGatesMin, fRecovery, fSwitching, fSkipFanout, fUseProfile, fUseBuffs, fVerbose );
   205	        if ( pNtkRes == NULL )
   206	        {
   207	            Abc_NtkDelete( pNtk );
   208	            Abc_Print( -1, "stmap10 has failed.\n" );
   209	            return 1;
