    20	/**Function*************************************************************
    21	
    22	  Synopsis    [Runs the stmap10 mapper probe.]
    23	
    24	  Description [stmap10 tests a depth-qualified refinement of the stmap9
    25	  middle-slack area-relief high-fanout wide-cut guard. It keeps the same
    26	  arrival-neutral and area-saving middle-slack override, but allows it only
    27	  in shallow and medium-depth mapper nodes, leaving deep reconvergent nodes
    28	  on the stricter stmap8-style arrival-bounded guard.]
    29	
    30	  SideEffects []
    31	
    32	  SeeAlso     []
    33	
    34	***********************************************************************/
    35	int Abc_CommandStmap10( Abc_Frame_t * pAbc, int argc, char ** argv )
    36	{
    37	    Abc_Ntk_t * pNtk, * pNtkRes;
    38	    char Buffer[100];
    39	    double DelayTarget;
    40	    double AreaMulti;
    41	    double DelayMulti;
    42	    float LogFan = 0;
    43	    float Slew = 0; // choose based on the library
    44	    float Gain = 250; // keep classic map gain to isolate the recovery guard hypothesis
    45	    int nGatesMin = 0;
    46	    int fAreaOnly;
    47	    int fRecovery;
    48	    int fSweep;
    49	    int fSwitching;
    50	    int fSkipFanout;
    51	    int fUseProfile;
    52	    int fUseBuffs;
    53	    int fVerbose;
    54	    int c;
    55	    extern Abc_Ntk_t * Abc_NtkMap( Abc_Ntk_t * pNtk, Mio_Library_t* userLib, double DelayTarget, double AreaMulti, double DelayMulti, float LogFan, float Slew, float Gain, int nGatesMin, int fRecovery, int fSwitching, int fSkipFanout, int fUseProfile, int fUseBuffs, int fVerbose );
    56	    extern int Abc_NtkFraigSweep( Abc_Ntk_t * pNtk, int fUseInv, int fExdc, int fVerbose, int fVeryVerbose );
    57	
    58	    pNtk = Abc_FrameReadNtk(pAbc);
    59	    DelayTarget = -1;
    60	    AreaMulti   = 0;
    61	    DelayMulti  = 0;
    62	    fAreaOnly   = 0;
    63	    fRecovery   = 1;
    64	    fSweep      = 0;
    65	    fSwitching  = 0;
    66	    fSkipFanout = 11; // depth-qualified middle-slack area-relief guard; -f disables it
    67	    fUseProfile = 0;
    68	    fUseBuffs   = 0;
    69	    fVerbose    = 0;
    70	    Extra_UtilGetoptReset();
    71	    while ( ( c = Extra_UtilGetopt( argc, argv, "DABFSGMarspfuovh" ) ) != EOF )
    72	    {
    73	        switch ( c )
    74	        {
    75	        case 'D':
    76	            if ( globalUtilOptind >= argc )
    77	            {
    78	                Abc_Print( -1, "Command line switch \"-D\" should be followed by a floating point number.\n" );
    79	                goto usage;
    80	            }
    81	            DelayTarget = (float)atof(argv[globalUtilOptind]);
    82	            globalUtilOptind++;
    83	            if ( DelayTarget <= 0.0 )
    84	                goto usage;
    85	            break;
    86	        case 'A':
    87	            if ( globalUtilOptind >= argc )
    88	            {
    89	                Abc_Print( -1, "Command line switch \"-A\" should be followed by a floating point number.\n" );
    90	                goto usage;
    91	            }
    92	            AreaMulti = (float)atof(argv[globalUtilOptind]);
    93	            globalUtilOptind++;
    94	            break;
    95	        case 'B':
    96	            if ( globalUtilOptind >= argc )
    97	            {
    98	                Abc_Print( -1, "Command line switch \"-B\" should be followed by a floating point number.\n" );
    99	                goto usage;
   100	            }
   101	            DelayMulti = (float)atof(argv[globalUtilOptind]);
   102	            globalUtilOptind++;
   103	            break;
   104	        case 'F':
   105	            if ( globalUtilOptind >= argc )
   106	            {
   107	                Abc_Print( -1, "Command line switch \"-F\" should be followed by a floating point number.\n" );
   108	                goto usage;
   109	            }
   110	            LogFan = (float)atof(argv[globalUtilOptind]);
   111	            globalUtilOptind++;
   112	            if ( LogFan < 0.0 )
   113	                goto usage;
   114	            break;
   115	        case 'S':
   116	            if ( globalUtilOptind >= argc )
   117	            {
   118	                Abc_Print( -1, "Command line switch \"-S\" should be followed by a floating point number.\n" );
   119	                goto usage;
   120	            }
   121	            Slew = (float)atof(argv[globalUtilOptind]);
   122	            globalUtilOptind++;
   123	            if ( Slew <= 0.0 )
   124	                goto usage;
   125	            break;
   126	        case 'G':
   127	            if ( globalUtilOptind >= argc )
   128	            {
   129	                Abc_Print( -1, "Command line switch \"-G\" should be followed by a floating point number.\n" );
   130	                goto usage;
   131	            }
   132	            Gain = (float)atof(argv[globalUtilOptind]);
   133	            globalUtilOptind++;
   134	            if ( Gain <= 0.0 )
   135	                goto usage;
   136	            break;
   137	        case 'M':
   138	            if ( globalUtilOptind >= argc )
   139	            {
   140	                Abc_Print( -1, "Command line switch \"-M\" should be followed by a positive integer.\n" );
   141	                goto usage;
   142	            }
   143	            nGatesMin = atoi(argv[globalUtilOptind]);
   144	            globalUtilOptind++;
   145	            if ( nGatesMin < 0 )
   146	                goto usage;
   147	            break;
   148	        case 'a':
