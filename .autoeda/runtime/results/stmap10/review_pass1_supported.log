   211	        Abc_NtkDelete( pNtk );
   212	    }
   213	    else
   214	    {
   215	        pNtkRes = Abc_NtkMap( pNtk, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, Gain, nGatesMin, fRecovery, fSwitching, fSkipFanout, fUseProfile, fUseBuffs, fVerbose );
   216	        if ( pNtkRes == NULL )
   217	        {
   218	            Abc_Print( -1, "stmap10 has failed.\n" );
   219	            return 1;
   220	        }
   221	    }
   222	
   223	    if ( fSweep )
   224	    {
   225	        Abc_NtkFraigSweep( pNtkRes, 0, 0, 0, 0 );
   226	        if ( Abc_NtkHasMapping(pNtkRes) )
   227	        {
   228	            pNtkRes = Abc_NtkDupDfs( pNtk = pNtkRes );
   229	            Abc_NtkDelete( pNtk );
   230	        }
   231	    }
   232	
   233	    Abc_FrameReplaceCurrentNetwork( pAbc, pNtkRes );
   234	    return 0;
