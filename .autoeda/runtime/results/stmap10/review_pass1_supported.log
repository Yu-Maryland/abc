   153	            break;
   154	        case 's':
   155	            fSweep ^= 1;
   156	            break;
   157	        case 'p':
   158	            fSwitching ^= 1;
   159	            break;
   160	        case 'f':
   161	            fSkipFanout = fSkipFanout ? 0 : 11;
   162	            break;
   163	        case 'u':
   164	            fUseProfile ^= 1;
   165	            break;
   166	        case 'o':
