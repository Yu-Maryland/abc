   236	usage:
   237	    if ( DelayTarget == -1 )
   238	        sprintf(Buffer, "not used" );
   239	    else
   240	        sprintf(Buffer, "%.3f", DelayTarget );
   241	    Abc_Print( -2, "usage: stmap10 [-DABFSG float] [-M num] [-arspfuovh]\n" );
