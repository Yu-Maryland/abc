   311	/**Function*************************************************************
   312	
   313	  Synopsis    [Returns 1 if an stmap area-sensitive mode should reject a cut.]
   314	
   315	  Description [The area-sensitive guards are evaluated after matching the
   316	  candidate cut because their hypotheses need the candidate's actual mapper
   317	  area. In stmap6 exact-area recovery, a wide high-fanout cut is rejected only
   318	  when the existing match has slack and the candidate does not save at least
   319	  half an inverter area. In stmap7, the area-saving override additionally
   320	  requires more than two inverter delays of slack and excludes the highest
   321	  fanout-risk bucket. In stmap8, the override is further rejected when the
   322	  candidate match worsens mapper arrival by more than one quarter of an
   323	  inverter delay. In stmap9, middle-slack candidates can recover area only
   324	  when they are outside the highest fanout bucket, do not worsen mapper
   325	  arrival, and save at least one inverter area. In stmap10, that middle-slack
   326	  relief also requires the mapper node to be no deeper than level 96.]
   327	
   328	  SideEffects []
   329	
   330	  SeeAlso     []
   331	
   332	***********************************************************************/
   333	static int Map_MatchSkipAreaSensitiveFanout( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase, Map_Match_t * pMatchBest, Map_Match_t * pMatch )
   334	{
   335	    float Slack, SlackMargin, SlackGate, ArrivalMargin, AreaMargin;
   336	
   337	    if ( p->fSkipFanout != 7 && p->fSkipFanout != 8 && p->fSkipFanout != 9 && p->fSkipFanout != 10 && p->fSkipFanout != 11 )
   338	        return 0;
   339	    if ( p->fMappingMode < 2 || p->fMappingMode > 3 )
   340	        return 0;
   341	    if ( p->vMapObjs->nSize <= 8000 )
   342	        return 0;
   343	    if ( !Map_MatchCutHasStmapFanoutRisk( pNode, pCut ) )
   344	        return 0;
   345	    if ( pMatchBest == NULL || pMatchBest->pSuperBest == NULL || pMatch == NULL || pMatch->pSuperBest == NULL )
   346	        return 0;
   347	    Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   348	    SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   349	    if ( p->fSkipFanout == 8 || p->fSkipFanout == 9 || p->fSkipFanout == 10 || p->fSkipFanout == 11 )
   350	    {
   351	        SlackGate = 2.0 * SlackMargin;
   352	        if ( (p->fSkipFanout == 10 || p->fSkipFanout == 11) &&
   353	             Slack > SlackMargin + p->fEpsilon &&
   354	             Slack <= SlackGate + p->fEpsilon &&
   355	             !Map_MatchCutHasStmapHighestFanoutRisk( pNode, pCut ) &&
   356	             (p->fSkipFanout == 10 || Map_MatchNodeHasStmapReliefDepth( pNode )) &&
   357	             pMatch->tArrive.Worst <= pMatchBest->tArrive.Worst + p->fEpsilon )
   358	        {
   359	            AreaMargin = p->pSuperLib ? p->pSuperLib->AreaInv : 0.0;
   360	            if ( pMatch->AreaFlow < pMatchBest->AreaFlow - AreaMargin - p->fEpsilon )
   361	                return 0;
   362	        }
   363	        if ( Slack <= SlackGate + p->fEpsilon )
   364	            return 1;
   365	        if ( Map_MatchCutHasStmapHighestFanoutRisk( pNode, pCut ) )
   366	            return 1;
   367	    }
   368	    if ( Slack <= SlackMargin + p->fEpsilon )
   369	        return 0;
   370	    if ( p->fSkipFanout == 9 || p->fSkipFanout == 10 || p->fSkipFanout == 11 )
   371	    {
   372	        ArrivalMargin = 0.25 * SlackMargin;
   373	        if ( pMatch->tArrive.Worst > pMatchBest->tArrive.Worst + ArrivalMargin + p->fEpsilon )
   374	            return 1;
   375	    }
   376	    AreaMargin = p->pSuperLib ? 0.5 * p->pSuperLib->AreaInv : 0.0;
   377	    if ( pMatch->AreaFlow < pMatchBest->AreaFlow - AreaMargin - p->fEpsilon )
   378	        return 0;
   379	    return 1;
   380	}
