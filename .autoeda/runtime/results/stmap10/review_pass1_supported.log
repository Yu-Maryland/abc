   122	  slack over the mapper required time. Mode 4 is the stmap3 guard, which
   123	  narrows the intervention to high-fanout nodes with only shallow positive
   124	  slack. Mode 5 is the stmap4 split-phase guard: stmap1-style guarding in
   125	  delay matching and stmap2-style slack-aware guarding in area recovery.
   126	  Mode 6 is the stmap5 shape-gated split-phase guard: the delay pass only
   127	  uses stmap1-style guarding in very large mapper graphs, while area recovery
   128	  keeps the stmap2 slack-aware guard. Mode 7 is the stmap6 area-sensitive
   129	  shape-gated guard: the delay pass keeps the stmap5 graph-size gate, small
   130	  mapper graphs keep the stmap2 slack-aware recovery guard, and exact-area
   131	  recovery on larger graphs checks the cut after matching so materially cheaper
   132	  cuts can override the fanout/load proxy. Mode 8 is the stmap7 criticality-
   133	  sensitive version of mode 7: exact-area recovery on larger graphs allows the
   134	  override only with deeper mapper slack and outside the highest fanout bucket.
   135	  Mode 9 is the stmap8 arrival-bounded version of mode 8: the area-saving
   136	  override also requires the candidate match to stay within one quarter of an
   137	  inverter delay of the existing mapper arrival. Mode 10 is the stmap9
   138	  middle-slack area-relief version of mode 9: it keeps the highest fanout
   139	  bucket protected, but in the one-to-two inverter slack bucket it allows a
   140	  wide cut only when it is arrival-neutral and saves at least one inverter
   141	  area. Mode 11 is the stmap10 depth-qualified version of mode 10: the
   142	  middle-slack relief is allowed only for shallow and medium-depth nodes.]
   143	
   144	  SideEffects []
   145	
   146	  SeeAlso     []
   147	
   148	***********************************************************************/
   149	static int Map_MatchSkipCutForFanout( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase )
   150	{
   151	    Map_Cut_t * pCutBest;
   152	    Map_Match_t * pMatchBest;
   153	    float Slack, SlackMargin, SlackLimit;
   154	
   155	    if ( !p->fSkipFanout )
   156	        return 0;
   157	    if ( p->fSkipFanout == 2 )
   158	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   159	    if ( p->fSkipFanout == 3 )
   160	    {
   161	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   162	            return 0;
   163	        pCutBest = pNode->pCutBest[fPhase];
   164	        if ( pCutBest == NULL )
   165	            return 0;
   166	        pMatchBest = pCutBest->M + fPhase;
   167	        if ( pMatchBest->pSuperBest == NULL )
   168	            return 0;
   169	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   170	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   171	        if ( Slack <= SlackMargin + p->fEpsilon )
   172	            return 0;
   173	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   174	    }
   175	    if ( p->fSkipFanout == 4 )
   176	    {
   177	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   178	            return 0;
   179	        pCutBest = pNode->pCutBest[fPhase];
   180	        if ( pCutBest == NULL )
   181	            return 0;
   182	        pMatchBest = pCutBest->M + fPhase;
   183	        if ( pMatchBest->pSuperBest == NULL || p->pSuperLib == NULL )
   184	            return 0;
   185	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   186	        SlackMargin = p->pSuperLib->tDelayInv.Worst;
   187	        SlackLimit = 2.0 * SlackMargin;
   188	        if ( Slack <= p->fEpsilon || Slack > SlackLimit + p->fEpsilon )
   189	            return 0;
   190	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   191	    }
   192	    if ( p->fSkipFanout == 5 )
   193	    {
   194	        if ( p->fMappingMode == 0 )
   195	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   196	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   197	            return 0;
   198	        pCutBest = pNode->pCutBest[fPhase];
   199	        if ( pCutBest == NULL )
   200	            return 0;
   201	        pMatchBest = pCutBest->M + fPhase;
   202	        if ( pMatchBest->pSuperBest == NULL )
   203	            return 0;
   204	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   205	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   206	        if ( Slack <= SlackMargin + p->fEpsilon )
   207	            return 0;
   208	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   209	    }
   210	    if ( p->fSkipFanout == 6 )
   211	    {
   212	        if ( p->fMappingMode == 0 )
   213	        {
   214	            if ( p->vMapObjs->nSize <= 20000 )
   215	                return 0;
   216	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   217	        }
   218	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   219	            return 0;
   220	        pCutBest = pNode->pCutBest[fPhase];
   221	        if ( pCutBest == NULL )
   222	            return 0;
   223	        pMatchBest = pCutBest->M + fPhase;
   224	        if ( pMatchBest->pSuperBest == NULL )
   225	            return 0;
   226	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   227	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   228	        if ( Slack <= SlackMargin + p->fEpsilon )
   229	            return 0;
   230	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   231	    }
   232	    if ( p->fSkipFanout == 7 )
   233	    {
   234	        if ( p->fMappingMode == 0 )
   235	        {
   236	            if ( p->vMapObjs->nSize <= 20000 )
   237	                return 0;
   238	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   239	        }
   240	        if ( p->fMappingMode >= 1 && p->fMappingMode <= 3 && p->vMapObjs->nSize <= 8000 )
   241	        {
   242	            pCutBest = pNode->pCutBest[fPhase];
   243	            if ( pCutBest == NULL )
   244	                return 0;
   245	            pMatchBest = pCutBest->M + fPhase;
   246	            if ( pMatchBest->pSuperBest == NULL )
   247	                return 0;
   248	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   249	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   250	            if ( Slack <= SlackMargin + p->fEpsilon )
   251	                return 0;
   252	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   253	        }
   254	        if ( p->fMappingMode == 1 )
   255	        {
   256	            pCutBest = pNode->pCutBest[fPhase];
   257	            if ( pCutBest == NULL )
   258	                return 0;
   259	            pMatchBest = pCutBest->M + fPhase;
   260	            if ( pMatchBest->pSuperBest == NULL )
   261	                return 0;
   262	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   263	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   264	            if ( Slack <= SlackMargin + p->fEpsilon )
   265	                return 0;
   266	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   267	        }
   268	        return 0;
   269	    }
   270	    if ( p->fSkipFanout == 8 || p->fSkipFanout == 9 || p->fSkipFanout == 10 || p->fSkipFanout == 11 )
   271	    {
   272	        if ( p->fMappingMode == 0 )
   273	        {
   274	            if ( p->vMapObjs->nSize <= 20000 )
   275	                return 0;
   276	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   277	        }
   278	        if ( p->fMappingMode >= 1 && p->fMappingMode <= 3 && p->vMapObjs->nSize <= 8000 )
   279	        {
   280	            pCutBest = pNode->pCutBest[fPhase];
   281	            if ( pCutBest == NULL )
   282	                return 0;
   283	            pMatchBest = pCutBest->M + fPhase;
   284	            if ( pMatchBest->pSuperBest == NULL )
   285	                return 0;
   286	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   287	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   288	            if ( Slack <= SlackMargin + p->fEpsilon )
   289	                return 0;
   290	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   291	        }
   292	        if ( p->fMappingMode == 1 )
   293	        {
   294	            pCutBest = pNode->pCutBest[fPhase];
   295	            if ( pCutBest == NULL )
   296	                return 0;
   297	            pMatchBest = pCutBest->M + fPhase;
   298	            if ( pMatchBest->pSuperBest == NULL )
   299	                return 0;
   300	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   301	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   302	            if ( Slack <= SlackMargin + p->fEpsilon )
   303	                return 0;
   304	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   305	        }
   306	        return 0;
   307	    }
   308	    return (pNode->nRefs > 3 && pCut->nLeaves > 2) || (pNode->nRefs > 1 && pCut->nLeaves > 3);
   309	}
