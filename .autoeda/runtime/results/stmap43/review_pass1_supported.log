+    s_Stmap43SclOverFrac = OverFrac;
+    s_Stmap43SclFeedback = Severity;
+    s_pStmap43SclPressureRatios = pAigPressureRatios;
+    s_nStmap43SclPressureRatios = nAigPressureRatios;
