  1409	    if ( p->fSkipFanout == 2 )
  1410	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
  1411	    if ( p->fSkipFanout == 3 )
  1412	    {
  1413	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
  1414	            return 0;
  1415	        pCutBest = pNode->pCutBest[fPhase];
  1416	        if ( pCutBest == NULL )
