            return 0;
        pMatchBest = pCutBest->M + fPhase;
        if ( pMatchBest->pSuperBest == NULL || p->pSuperLib == NULL )
            return 0;
        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
        SlackMargin = p->pSuperLib->tDelayInv.Worst;
        SlackLimit = 2.0 * SlackMargin;
