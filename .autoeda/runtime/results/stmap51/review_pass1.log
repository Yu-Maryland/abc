}

static void Abc_Stmap51InsertConsumerFanins( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap51LoadStats_t * pStats, float Ratio, float SinkCriticality, int Depth )
{
    Abc_Obj_t * pFanin;
    int i, AigId;
    if ( pObj == NULL || Ratio <= 1.0 || Depth <= 0 )
        return;
    Abc_ObjForEachFanin( pObj, pFanin, i )
    {
        AigId = Abc_Stmap51MappedObjAigId( pNtk, pFanin );
        if ( AigId >= 0 )
        {
            pStats->nHotspotFanin++;
            Abc_Stmap51PressureInsert( pStats, AigId, Abc_ObjId(pFanin), Ratio, SinkCriticality );
        }
        Abc_Stmap51InsertConsumerFanins( pNtk, pFanin, pStats, 0.78 * Ratio, SinkCriticality, Depth - 1 );
    }
}

static void Abc_Stmap51CollectHotspotCone( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap51LoadStats_t * pStats, SC_Man * pTime, float Ratio )
{
    Abc_Obj_t * pFanout, * pFanout2;
