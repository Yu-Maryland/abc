            p->nStmap13RejectSlack, p->nStmap13RejectHighest, p->nStmap13RejectArrival,
            p->nStmap13RejectArea );

    // print the arrival times of the latest outputs
    if ( p->fVerbose )
        Map_MappingPrintOutputArrivals( p );
    return 1;
}
