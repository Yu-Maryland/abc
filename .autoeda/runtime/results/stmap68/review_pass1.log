    {
        LocalFeedback = (PressureRatio - 1.0) / 4.0;
        if ( LocalFeedback > 1.0 )
            LocalFeedback = 1.0;
        Penalty += 0.16 * s_Stmap44SclFeedback * LocalFeedback * (LoadDriveRatio - 1.0) / LoadDriveRatio;
