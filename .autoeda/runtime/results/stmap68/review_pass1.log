    if ( Criticality < 0.0 )
        return 0.0;
    return Criticality > 1.0 ? 1.0 : Criticality;
}

static void Abc_Stmap64PressureInsert( Abc_Stmap64LoadStats_t * pStats, int AigId, int NodeId, float Ratio, float SinkCriticality )
