LIBS += -lm
ifneq ($(OS), $(filter $(OS), FreeBSD OpenBSD NetBSD))
  LIBS += -ldl
endif

ifneq ($(OS), $(filter $(OS), FreeBSD OpenBSD NetBSD Darwin))
   LIBS += -lrt
endif

ifdef ABC_USE_LIBSTDCXX
   LIBS += -lstdc++
   $(call abc_info,$(MSG_PREFIX)Using explicit -lstdc++)
endif

