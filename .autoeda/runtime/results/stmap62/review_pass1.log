        Abc_Stmap62InsertConsumerFanins( pNtk, pFanin, pStats, 0.78 * Ratio, SinkCriticality, Depth - 1 );
    }
}

static void Abc_Stmap62CollectHotspotCone( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap62LoadStats_t * pStats, SC_Man * pTime, float Ratio )
