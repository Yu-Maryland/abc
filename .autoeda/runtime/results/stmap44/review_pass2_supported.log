        {
            pStats->nHotspotFanin++;
            Abc_Stmap44PressureInsert( pStats, AigId, Abc_ObjId(pFanin), Ratio, SinkCriticality );
        }
        Abc_Stmap44InsertConsumerFanins( pNtk, pFanin, pStats, 0.78 * Ratio, SinkCriticality, Depth - 1 );
    }
}

