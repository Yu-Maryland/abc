static int Map_MatchSkipCutForFanout( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase )
{
    Map_Cut_t * pCutBest;
    Map_Match_t * pMatchBest;
    float Slack, SlackMargin, SlackLimit;

    if ( !p->fSkipFanout )
