        fStickyReplacementAllowDrive = CandidateFanLimit >= s_Stmap93EmittedStickyFanLimit ||
            CandidateLoadDriveRatio + LoadDriveRatioMinGain < s_Stmap93EmittedStickyLoadDriveRatio;
