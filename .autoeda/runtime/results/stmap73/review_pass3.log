int Abc_CommandStmap65( Abc_Frame_t * pAbc, int argc, char ** argv )
{
    Abc_Ntk_t * pNtk, * pNtkMap, * pNtkRes, * pNtkFirst;
    Abc_Stmap65LoadStats_t LoadStats;
    Abc_Stmap65BoundedStats_t BoundedStats;
