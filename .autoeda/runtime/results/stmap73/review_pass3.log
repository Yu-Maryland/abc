library: 7nm_lvt_ff.lib
benchmarks:
- benchmarks/i10.aig
- benchmarks/ode.abc.blif
- benchmarks/or1200.abc.blif
- benchmarks/syn2.abc.blif
build:
  command: make ABC_USE_NO_READLINE=1
  artifact: ./abc
  clean_command: make clean
baseline_flow:
  library_command: read_lib
  design_command: read
  template: './abc -c "read_lib {library}; read {design}; resyn; resyn2; dch -v; map; topo; buffer; upsize -v; dnsize -v; stime"'
candidate_flow:
  command_pattern: stmap{iteration}
  library_command: read_lib
  design_command: read
  template: './abc -c "read_lib {library}; read {design}; resyn; resyn2; dch -v; {command}; topo; buffer; upsize -v; dnsize -v; stime"'
  smoke_design: benchmarks/i10.aig
  required_help_template: './abc -c "{command} -h"'
timeouts:
  per_design_seconds: 600
  review_pass_seconds: 600
  smoke_seconds: 600
  build_seconds: 900
metrics:
- name: stime_delay_ps
  role: primary
  direction: minimize
  source: stdout
  extraction: regex_last_match
  regex: 'WireLoad\s*=\s*"[^"]*".*Area\s*=\s*([0-9]+(?:\.[0-9]+)?).*Delay\s*=\s*([0-9]+(?:\.[0-9]+)?)\s*ps'
  group: 2
  unit: ps
- name: stime_area
  role: secondary
  direction: minimize
  source: stdout
  extraction: regex_last_match
  regex: 'WireLoad\s*=\s*"[^"]*".*Area\s*=\s*([0-9]+(?:\.[0-9]+)?).*Delay\s*=\s*([0-9]+(?:\.[0-9]+)?)\s*ps'
  group: 1
objective:
  aggregation: per_benchmark_required
  compare_to: baseline_command
  ranking:
    primary: stime_delay_ps
    secondary: stime_area
  tie_breakers:
  - more_benchmarks_improved_delay
  - lower_geomean_area
correctness:
- type: build
  mode: builtin
  command: make ABC_USE_NO_READLINE=1
  timeout_seconds: 900
  pass_condition: exit_zero
  fail_condition: non_zero_or_timeout
- type: numbered_implementation_exists
  mode: review
  timeout_seconds: 600
  pass_condition: new stmapN command and implementation files exist
  fail_condition: missing numbered command, missing implementation, or skipped version number
- type: command_help
  mode: usage_text
  command_template: './abc -c "{command} -h"'
  timeout_seconds: 600
  pass_condition: usage text is printed for the new stmapN command; ABC help-path exit code 0 or 1 is acceptable
  fail_condition: command missing, crashes before printing usage, or has no usage text
- type: smoke_flow
  mode: command_exit_zero
  design: benchmarks/i10.aig
  command_template: './abc -c "read_lib 7nm_lvt_ff.lib; read benchmarks/i10.aig; resyn; resyn2; dch -v; {command}; topo; buffer; upsize -v; dnsize -v; stime"'
  timeout_seconds: 600
  pass_condition: exit_zero_and_parseable_stime_metrics
  fail_condition: non_zero_timeout_or_unparseable_metrics
- type: combinational_equivalence
  mode: abc_cec
  timeout_seconds: 600
  artifact_dir_template: .autoeda/runtime/results/{command}
  expected_flow: for each required benchmark, write an original strashed temporary from `read_lib {library}; read {design}; strash`; write a candidate post-flow strashed temporary from the configured candidate flow plus `strash`; then run `./abc -c "cec <original_temp> <candidate_temp>"`
  pass_condition: ABC cec reports equivalent for every required benchmark, or an explicitly logged alternate equivalence method is used only when direct cec is invalid for that benchmark format
  fail_condition: cec failure, inconclusive result, crash, timeout, missing artifact, or unlogged equivalence exception
- type: benchmark_metrics
  mode: parser
  timeout_seconds: 600
  pass_condition: all four required benchmarks produce final stime_delay_ps and stime_area
  fail_condition: any required benchmark missing, crashed, timed out, or unparseable
- type: version_log_updated
