  2338	static float Map_MatchStmap46ModeratePenaltyFactor( Map_Node_t * pNode, Map_Cut_t * pCut, float ArrivalDelta, float ArrivalGainMargin, float Slack, float SlackMargin, float Epsilon, float * pNodePressureRatio, float * pCutPressureRatio, int * pNodeAigId )
  2339	{
  2340	    float Penalty, NodePressureRatio, CutPressureRatio, PressureAgreement, LocalFeedback;
  2341	    Penalty = Map_MatchStmap29ModeratePenaltyFactor( pNode, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon );
  2342	    NodePressureRatio = Map_MatchStmap46NodePressureRatio( pNode, pNodeAigId );
  2343	    CutPressureRatio = Map_MatchStmap46CutPressureRatio( pCut );
  2344	    if ( pNodePressureRatio )
  2345	        *pNodePressureRatio = NodePressureRatio;
  2346	    if ( pCutPressureRatio )
  2347	        *pCutPressureRatio = CutPressureRatio;
  2348	    if ( Penalty <= 0.0 || !Map_MatchStmap46HasPressureAgreement( NodePressureRatio, CutPressureRatio ) )
  2349	        return 0.0;
  2350	    PressureAgreement = NodePressureRatio < CutPressureRatio ? NodePressureRatio : CutPressureRatio;
  2351	    LocalFeedback = (PressureAgreement - 1.75) / 3.0;
  2352	    if ( LocalFeedback > 1.0 )
  2353	        LocalFeedback = 1.0;
  2354	    Penalty *= 0.40 + 0.60 * s_Stmap46SclFeedback * LocalFeedback;
  2355	    return Penalty > 1.0 ? 1.0 : Penalty;
  2356	}
  2357	
  2358	static float Map_MatchStmap46StrongPenaltyFactor( Map_Node_t * pNode, Map_Cut_t * pCut, Map_Match_t * pMatch, float ArrivalDelta, float ArrivalGainMargin, float Slack, float SlackMargin, float Epsilon, float * pLeafLoadAvg, float * pLoadDriveRatio, int * pFanLimit, float * pNodePressureRatio, float * pCutPressureRatio, int * pNodeAigId )
  2359	{
  2360	    float Penalty, LoadDriveRatio, NodePressureRatio, CutPressureRatio, PressureRatio, LocalFeedback;
  2361	    Penalty = Map_MatchStmap34StrongPenaltyFactor( pNode, pCut, pMatch, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon, pLeafLoadAvg, pLoadDriveRatio, pFanLimit );
  2362	    LoadDriveRatio = pLoadDriveRatio ? *pLoadDriveRatio : 0.0;
  2363	    NodePressureRatio = Map_MatchStmap46NodePressureRatio( pNode, pNodeAigId );
  2364	    CutPressureRatio = Map_MatchStmap46CutPressureRatio( pCut );
  2365	    PressureRatio = NodePressureRatio > CutPressureRatio ? NodePressureRatio : CutPressureRatio;
  2366	    if ( pNodePressureRatio )
  2367	        *pNodePressureRatio = NodePressureRatio;
  2368	    if ( pCutPressureRatio )
  2369	        *pCutPressureRatio = CutPressureRatio;
  2370	    if ( Penalty > 0.0 && s_Stmap46SclFeedback > 0.0 && PressureRatio > 1.0 && LoadDriveRatio > 1.0 )
  2371	    {
  2372	        LocalFeedback = (PressureRatio - 1.0) / 4.0;
  2373	        if ( LocalFeedback > 1.0 )
  2374	            LocalFeedback = 1.0;
  2375	        Penalty += 0.16 * s_Stmap46SclFeedback * LocalFeedback * (LoadDriveRatio - 1.0) / LoadDriveRatio;
  2376	    }
  2377	    return Penalty > 0.75 ? 0.75 : Penalty;
  2378	}
