            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
            if ( Slack <= SlackMargin + p->fEpsilon )
