   143	            globalUtilOptind++;
   144	            if ( nGatesMin < 0 )
   145	                goto usage;
   146	            break;
   147	        case 'a':
   148	            fAreaOnly ^= 1;
   149	            break;
   150	        case 'r':
   151	            fRecovery ^= 1;
   152	            break;
   153	        case 's':
   154	            fSweep ^= 1;
   155	            break;
   156	        case 'p':
   157	            fSwitching ^= 1;
   158	            break;
   159	        case 'f':
