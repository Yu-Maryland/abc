   203	        pNtkRes = Abc_NtkMap( pNtk, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, Gain, nGatesMin, fRecovery, fSwitching, fSkipFanout, fUseProfile, fUseBuffs, fVerbose );
   204	        if ( pNtkRes == NULL )
   205	        {
   206	            Abc_NtkDelete( pNtk );
   207	            Abc_Print( -1, "stmap29 has failed.\n" );
   208	            return 1;
   209	        }
   210	        Abc_NtkDelete( pNtk );
   211	    }
   212	    else
   213	    {
   214	        pNtkRes = Abc_NtkMap( pNtk, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, Gain, nGatesMin, fRecovery, fSwitching, fSkipFanout, fUseProfile, fUseBuffs, fVerbose );
   215	        if ( pNtkRes == NULL )
   216	        {
   217	            Abc_Print( -1, "stmap29 has failed.\n" );
   218	            return 1;
   219	        }
   220	    }
   221	
   222	    if ( fSweep )
   223	    {
   224	        Abc_NtkFraigSweep( pNtkRes, 0, 0, 0, 0 );
   225	        if ( Abc_NtkHasMapping(pNtkRes) )
   226	        {
   227	            pNtkRes = Abc_NtkDupDfs( pNtk = pNtkRes );
   228	            Abc_NtkDelete( pNtk );
   229	        }
   230	    }
   231	
   232	    Abc_FrameReplaceCurrentNetwork( pAbc, pNtkRes );
   233	    return 0;
   234	
   235	usage:
   236	    if ( DelayTarget == -1 )
   237	        sprintf(Buffer, "not used" );
   238	    else
   239	        sprintf(Buffer, "%.3f", DelayTarget );
   240	    Abc_Print( -2, "usage: stmap29 [-DABFSG float] [-M num] [-arspfuovh]\n" );
   241	    Abc_Print( -2, "\t              performs stmap29 standard-cell mapping with a continuous moderate seed load penalty\n" );
   242	    Abc_Print( -2, "\t-D float : sets the global required times [default = %s]\n", Buffer );
   243	    Abc_Print( -2, "\t-A float : \"area multiplier\" to bias gate selection [default = %.2f]\n", AreaMulti );
   244	    Abc_Print( -2, "\t-B float : \"delay multiplier\" to bias gate selection [default = %.2f]\n", DelayMulti );
   245	    Abc_Print( -2, "\t-F float : the logarithmic fanout delay parameter [default = %.2f]\n", LogFan );
