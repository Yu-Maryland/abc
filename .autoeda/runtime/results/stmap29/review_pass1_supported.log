   161	            break;
   162	        case 'u':
   163	            fUseProfile ^= 1;
   164	            break;
   165	        case 'o':
   166	            fUseBuffs ^= 1;
   167	            break;
   168	        case 'v':
   169	            fVerbose ^= 1;
   170	            break;
   171	        case 'h':
