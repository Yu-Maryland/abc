    20	/**Function*************************************************************
    21	
    22	  Synopsis    [Runs the stmap29 mapper probe.]
    23	
    24	  Description [stmap29 keeps the stmap28 moderate-seed eligibility band but
    25	  replaces its stepwise high-reference area penalty with a continuous
    26	  load-risk gradient based on reference count, slack ratio, and arrival-gain
    27	  ratio.]
    28	
    29	  SideEffects []
    30	
    31	  SeeAlso     []
    32	
    33	***********************************************************************/
    34	int Abc_CommandStmap29( Abc_Frame_t * pAbc, int argc, char ** argv )
    35	{
    36	    Abc_Ntk_t * pNtk, * pNtkRes;
    37	    char Buffer[100];
    38	    double DelayTarget;
    39	    double AreaMulti;
    40	    double DelayMulti;
    41	    float LogFan = 0;
    42	    float Slew = 0; // choose based on the library
    43	    float Gain = 250; // keep classic map gain to isolate the continuous penalty
    44	    int nGatesMin = 0;
    45	    int fAreaOnly;
    46	    int fRecovery;
    47	    int fSweep;
    48	    int fSwitching;
    49	    int fSkipFanout;
    50	    int fUseProfile;
    51	    int fUseBuffs;
    52	    int fVerbose;
    53	    int c;
    54	    extern Abc_Ntk_t * Abc_NtkMap( Abc_Ntk_t * pNtk, Mio_Library_t* userLib, double DelayTarget, double AreaMulti, double DelayMulti, float LogFan, float Slew, float Gain, int nGatesMin, int fRecovery, int fSwitching, int fSkipFanout, int fUseProfile, int fUseBuffs, int fVerbose );
    55	    extern int Abc_NtkFraigSweep( Abc_Ntk_t * pNtk, int fUseInv, int fExdc, int fVerbose, int fVeryVerbose );
    56	
    57	    pNtk = Abc_FrameReadNtk(pAbc);
    58	    DelayTarget = -1;
    59	    AreaMulti   = 0;
    60	    DelayMulti  = 0;
    61	    fAreaOnly   = 0;
    62	    fRecovery   = 1;
    63	    fSweep      = 0;
    64	    fSwitching  = 0;
    65	    fSkipFanout = 30; // continuous high-reference moderate seed penalty; -f disables it
    66	    fUseProfile = 0;
    67	    fUseBuffs   = 0;
    68	    fVerbose    = 0;
    69	    Extra_UtilGetoptReset();
    70	    while ( ( c = Extra_UtilGetopt( argc, argv, "DABFSGMarspfuovh" ) ) != EOF )
    71	    {
    72	        switch ( c )
    73	        {
    74	        case 'D':
    75	            if ( globalUtilOptind >= argc )
    76	            {
    77	                Abc_Print( -1, "Command line switch \"-D\" should be followed by a floating point number.\n" );
    78	                goto usage;
    79	            }
    80	            DelayTarget = (float)atof(argv[globalUtilOptind]);
    81	            globalUtilOptind++;
    82	            if ( DelayTarget <= 0.0 )
    83	                goto usage;
    84	            break;
    85	        case 'A':
    86	            if ( globalUtilOptind >= argc )
    87	            {
    88	                Abc_Print( -1, "Command line switch \"-A\" should be followed by a floating point number.\n" );
    89	                goto usage;
    90	            }
    91	            AreaMulti = (float)atof(argv[globalUtilOptind]);
    92	            globalUtilOptind++;
    93	            break;
    94	        case 'B':
    95	            if ( globalUtilOptind >= argc )
    96	            {
    97	                Abc_Print( -1, "Command line switch \"-B\" should be followed by a floating point number.\n" );
    98	                goto usage;
    99	            }
   100	            DelayMulti = (float)atof(argv[globalUtilOptind]);
   101	            globalUtilOptind++;
   102	            break;
   103	        case 'F':
   104	            if ( globalUtilOptind >= argc )
   105	            {
   106	                Abc_Print( -1, "Command line switch \"-F\" should be followed by a floating point number.\n" );
   107	                goto usage;
   108	            }
   109	            LogFan = (float)atof(argv[globalUtilOptind]);
   110	            globalUtilOptind++;
   111	            if ( LogFan < 0.0 )
   112	                goto usage;
   113	            break;
   114	        case 'S':
   115	            if ( globalUtilOptind >= argc )
   116	            {
   117	                Abc_Print( -1, "Command line switch \"-S\" should be followed by a floating point number.\n" );
   118	                goto usage;
   119	            }
   120	            Slew = (float)atof(argv[globalUtilOptind]);
   121	            globalUtilOptind++;
   122	            if ( Slew <= 0.0 )
   123	                goto usage;
   124	            break;
   125	        case 'G':
   126	            if ( globalUtilOptind >= argc )
