   412	/**Function*************************************************************
   413	
   414	  Synopsis    [Returns 1 if an stmap area-sensitive mode should reject a cut.]
   415	
   416	  Description [The area-sensitive guards are evaluated after matching the
   417	  candidate cut because their hypotheses need the candidate's actual mapper
   418	  area. In stmap6 exact-area recovery, a wide high-fanout cut is rejected only
   419	  when the existing match has slack and the candidate does not save at least
   420	  half an inverter area. In stmap7, the area-saving override additionally
   421	  requires more than two inverter delays of slack and excludes the highest
   422	  fanout-risk bucket. In stmap8, the override is further rejected when the
   423	  candidate match worsens mapper arrival by more than one quarter of an
   424	  inverter delay. In stmap9, middle-slack candidates can recover area only
   425	  when they are outside the highest fanout bucket, do not worsen mapper
   426	  arrival, and save at least one inverter area. In stmap10, that middle-slack
   427	  relief also requires the mapper node to be no deeper than level 96. In
   428	  stmap11, that depth window is tightened to level 64. In stmap12, the same
   429	  tight-depth relief is allowed only in the lower moderate fanout bucket. In
   430	  stmap13, the same decision path also records exact-area guard statistics.]
   431	
   432	  SideEffects []
   433	
   434	  SeeAlso     []
   435	
   436	***********************************************************************/
   437	static int Map_MatchSkipAreaSensitiveFanout( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase, Map_Match_t * pMatchBest, Map_Match_t * pMatch )
   438	{
   439	    float Slack, SlackMargin, SlackGate, ArrivalMargin, AreaMargin;
   440	    int fMiddleReliefWindow, fStmap13;
   441	
   442	    if ( p->fSkipFanout != 7 && p->fSkipFanout != 8 && p->fSkipFanout != 9 && p->fSkipFanout != 10 && p->fSkipFanout != 11 && p->fSkipFanout != 12 && p->fSkipFanout != 13 && p->fSkipFanout != 14 )
   443	        return 0;
   444	    if ( p->fMappingMode < 2 || p->fMappingMode > 3 )
   445	        return 0;
   446	    if ( p->vMapObjs->nSize <= 8000 )
   447	        return 0;
   448	    if ( !Map_MatchCutHasStmapFanoutRisk( pNode, pCut ) )
   449	        return 0;
   450	    fStmap13 = (p->fSkipFanout == 14);
   451	    Map_MatchStmap13CountRisk( p, pNode, pCut );
   452	    if ( pMatchBest == NULL || pMatchBest->pSuperBest == NULL || pMatch == NULL || pMatch->pSuperBest == NULL )
   453	        return 0;
   454	    Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   455	    SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   456	    if ( p->fSkipFanout == 8 || p->fSkipFanout == 9 || p->fSkipFanout == 10 || p->fSkipFanout == 11 || p->fSkipFanout == 12 || p->fSkipFanout == 13 || p->fSkipFanout == 14 )
   457	    {
   458	        SlackGate = 2.0 * SlackMargin;
   459	        fMiddleReliefWindow =
   460	             (p->fSkipFanout == 10 || p->fSkipFanout == 11 || p->fSkipFanout == 12 || p->fSkipFanout == 13 || p->fSkipFanout == 14) &&
   461	             Slack > SlackMargin + p->fEpsilon &&
   462	             Slack <= SlackGate + p->fEpsilon &&
   463	             !Map_MatchCutHasStmapHighestFanoutRisk( pNode, pCut ) &&
   464	             Map_MatchNodeHasStmapMiddleSlackRelief( p->fSkipFanout, pNode ) &&
   465	             (p->fSkipFanout != 13 || Map_MatchCutHasStmapLowerModerateFanoutRisk( pNode, pCut )) &&
   466	             (p->fSkipFanout != 14 || Map_MatchCutHasStmapLowerModerateFanoutRisk( pNode, pCut )) &&
   467	             pMatch->tArrive.Worst <= pMatchBest->tArrive.Worst + p->fEpsilon;
   468	        if ( fMiddleReliefWindow )
   469	        {
   470	            if ( fStmap13 )
   471	                p->nStmap13MiddleSlack++;
   472	            AreaMargin = p->pSuperLib ? p->pSuperLib->AreaInv : 0.0;
   473	            if ( pMatch->AreaFlow < pMatchBest->AreaFlow - AreaMargin - p->fEpsilon )
   474	            {
   475	                if ( fStmap13 )
   476	                    p->nStmap13MiddleRelief++;
   477	                return 0;
   478	            }
   479	            if ( fStmap13 )
   480	                p->nStmap13RejectArea++;
   481	            return 1;
   482	        }
   483	        if ( Slack <= SlackGate + p->fEpsilon )
   484	        {
   485	            if ( fStmap13 )
   486	                p->nStmap13RejectSlack++;
   487	            return 1;
   488	        }
   489	        if ( Map_MatchCutHasStmapHighestFanoutRisk( pNode, pCut ) )
   490	        {
   491	            if ( fStmap13 )
   492	                p->nStmap13RejectHighest++;
   493	            return 1;
   494	        }
   495	    }
   496	    if ( Slack <= SlackMargin + p->fEpsilon )
   497	        return 0;
   498	    if ( p->fSkipFanout == 9 || p->fSkipFanout == 10 || p->fSkipFanout == 11 || p->fSkipFanout == 12 || p->fSkipFanout == 13 || p->fSkipFanout == 14 )
   499	    {
   500	        ArrivalMargin = 0.25 * SlackMargin;
   501	        if ( pMatch->tArrive.Worst > pMatchBest->tArrive.Worst + ArrivalMargin + p->fEpsilon )
   502	        {
   503	            if ( fStmap13 )
   504	                p->nStmap13RejectArrival++;
   505	            return 1;
   506	        }
   507	    }
   508	    AreaMargin = p->pSuperLib ? 0.5 * p->pSuperLib->AreaInv : 0.0;
   509	    if ( pMatch->AreaFlow < pMatchBest->AreaFlow - AreaMargin - p->fEpsilon )
   510	        return 0;
   511	    if ( fStmap13 )
   512	        p->nStmap13RejectArea++;
   513	    return 1;
   514	}
