   252	    Map_Cut_t * pCutBest;
   253	    Map_Match_t * pMatchBest;
   254	    float Slack, SlackMargin, SlackLimit;
   255	
   256	    if ( !p->fSkipFanout )
   257	        return 0;
   258	    if ( p->fSkipFanout == 2 )
   259	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   260	    if ( p->fSkipFanout == 3 )
   261	    {
   262	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   263	            return 0;
   264	        pCutBest = pNode->pCutBest[fPhase];
   265	        if ( pCutBest == NULL )
   266	            return 0;
   267	        pMatchBest = pCutBest->M + fPhase;
   268	        if ( pMatchBest->pSuperBest == NULL )
   269	            return 0;
   270	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   271	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   272	        if ( Slack <= SlackMargin + p->fEpsilon )
   273	            return 0;
   274	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   275	    }
   276	    if ( p->fSkipFanout == 4 )
   277	    {
   278	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   279	            return 0;
   280	        pCutBest = pNode->pCutBest[fPhase];
   281	        if ( pCutBest == NULL )
   282	            return 0;
   283	        pMatchBest = pCutBest->M + fPhase;
   284	        if ( pMatchBest->pSuperBest == NULL || p->pSuperLib == NULL )
   285	            return 0;
   286	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   287	        SlackMargin = p->pSuperLib->tDelayInv.Worst;
   288	        SlackLimit = 2.0 * SlackMargin;
   289	        if ( Slack <= p->fEpsilon || Slack > SlackLimit + p->fEpsilon )
   290	            return 0;
   291	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   292	    }
   293	    if ( p->fSkipFanout == 5 )
   294	    {
   295	        if ( p->fMappingMode == 0 )
   296	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   297	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   298	            return 0;
   299	        pCutBest = pNode->pCutBest[fPhase];
   300	        if ( pCutBest == NULL )
   301	            return 0;
   302	        pMatchBest = pCutBest->M + fPhase;
   303	        if ( pMatchBest->pSuperBest == NULL )
   304	            return 0;
   305	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   306	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   307	        if ( Slack <= SlackMargin + p->fEpsilon )
   308	            return 0;
   309	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   310	    }
   311	    if ( p->fSkipFanout == 6 )
   312	    {
   313	        if ( p->fMappingMode == 0 )
   314	        {
   315	            if ( p->vMapObjs->nSize <= 20000 )
   316	                return 0;
   317	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   318	        }
   319	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   320	            return 0;
   321	        pCutBest = pNode->pCutBest[fPhase];
   322	        if ( pCutBest == NULL )
   323	            return 0;
   324	        pMatchBest = pCutBest->M + fPhase;
   325	        if ( pMatchBest->pSuperBest == NULL )
   326	            return 0;
   327	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   328	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   329	        if ( Slack <= SlackMargin + p->fEpsilon )
   330	            return 0;
   331	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   332	    }
   333	    if ( p->fSkipFanout == 7 )
   334	    {
   335	        if ( p->fMappingMode == 0 )
   336	        {
   337	            if ( p->vMapObjs->nSize <= 20000 )
   338	                return 0;
   339	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   340	        }
   341	        if ( p->fMappingMode >= 1 && p->fMappingMode <= 3 && p->vMapObjs->nSize <= 8000 )
   342	        {
   343	            pCutBest = pNode->pCutBest[fPhase];
   344	            if ( pCutBest == NULL )
   345	                return 0;
   346	            pMatchBest = pCutBest->M + fPhase;
   347	            if ( pMatchBest->pSuperBest == NULL )
   348	                return 0;
   349	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   350	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   351	            if ( Slack <= SlackMargin + p->fEpsilon )
   352	                return 0;
   353	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   354	        }
   355	        if ( p->fMappingMode == 1 )
   356	        {
   357	            pCutBest = pNode->pCutBest[fPhase];
   358	            if ( pCutBest == NULL )
   359	                return 0;
   360	            pMatchBest = pCutBest->M + fPhase;
   361	            if ( pMatchBest->pSuperBest == NULL )
   362	                return 0;
   363	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   364	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   365	            if ( Slack <= SlackMargin + p->fEpsilon )
   366	                return 0;
   367	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   368	        }
   369	        return 0;
   370	    }
   371	    if ( p->fSkipFanout == 8 || p->fSkipFanout == 9 || p->fSkipFanout == 10 || p->fSkipFanout == 11 || p->fSkipFanout == 12 || p->fSkipFanout == 13 || p->fSkipFanout == 14 )
   372	    {
   373	        if ( p->fMappingMode == 0 )
   374	        {
   375	            if ( p->vMapObjs->nSize <= 20000 )
   376	                return 0;
   377	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   378	        }
   379	        if ( p->fMappingMode >= 1 && p->fMappingMode <= 3 && p->vMapObjs->nSize <= 8000 )
   380	        {
   381	            pCutBest = pNode->pCutBest[fPhase];
   382	            if ( pCutBest == NULL )
   383	                return 0;
   384	            pMatchBest = pCutBest->M + fPhase;
   385	            if ( pMatchBest->pSuperBest == NULL )
   386	                return 0;
   387	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   388	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   389	            if ( Slack <= SlackMargin + p->fEpsilon )
   390	                return 0;
   391	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   392	        }
   393	        if ( p->fMappingMode == 1 )
   394	        {
   395	            pCutBest = pNode->pCutBest[fPhase];
   396	            if ( pCutBest == NULL )
   397	                return 0;
   398	            pMatchBest = pCutBest->M + fPhase;
   399	            if ( pMatchBest->pSuperBest == NULL )
   400	                return 0;
   401	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   402	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   403	            if ( Slack <= SlackMargin + p->fEpsilon )
   404	                return 0;
   405	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   406	        }
   407	        return 0;
   408	    }
   409	    return (pNode->nRefs > 3 && pCut->nLeaves > 2) || (pNode->nRefs > 1 && pCut->nLeaves > 3);
   410	}
