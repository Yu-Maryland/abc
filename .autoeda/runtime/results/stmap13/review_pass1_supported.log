    20	/**Function*************************************************************
    21	
    22	  Synopsis    [Runs the stmap13 mapper probe.]
    23	
    24	  Description [stmap13 keeps the stmap12 fanout-bucket split middle-slack
    25	  guard behavior, but records per-bucket exact-area guard counters so later
    26	  versions can tune the lower-moderate bucket using observed mapper evidence.]
    27	
    28	  SideEffects []
    29	
    30	  SeeAlso     []
    31	
    32	***********************************************************************/
    33	int Abc_CommandStmap13( Abc_Frame_t * pAbc, int argc, char ** argv )
    34	{
    35	    Abc_Ntk_t * pNtk, * pNtkRes;
    36	    char Buffer[100];
    37	    double DelayTarget;
    38	    double AreaMulti;
    39	    double DelayMulti;
    40	    float LogFan = 0;
    41	    float Slew = 0; // choose based on the library
    42	    float Gain = 250; // keep classic map gain to isolate the recovery guard hypothesis
    43	    int nGatesMin = 0;
    44	    int fAreaOnly;
    45	    int fRecovery;
    46	    int fSweep;
    47	    int fSwitching;
    48	    int fSkipFanout;
    49	    int fUseProfile;
    50	    int fUseBuffs;
    51	    int fVerbose;
    52	    int c;
    53	    extern Abc_Ntk_t * Abc_NtkMap( Abc_Ntk_t * pNtk, Mio_Library_t* userLib, double DelayTarget, double AreaMulti, double DelayMulti, float LogFan, float Slew, float Gain, int nGatesMin, int fRecovery, int fSwitching, int fSkipFanout, int fUseProfile, int fUseBuffs, int fVerbose );
    54	    extern int Abc_NtkFraigSweep( Abc_Ntk_t * pNtk, int fUseInv, int fExdc, int fVerbose, int fVeryVerbose );
    55	
    56	    pNtk = Abc_FrameReadNtk(pAbc);
    57	    DelayTarget = -1;
    58	    AreaMulti   = 0;
    59	    DelayMulti  = 0;
    60	    fAreaOnly   = 0;
    61	    fRecovery   = 1;
    62	    fSweep      = 0;
    63	    fSwitching  = 0;
    64	    fSkipFanout = 14; // stmap12 behavior with guard-hit counters; -f disables it
    65	    fUseProfile = 0;
    66	    fUseBuffs   = 0;
    67	    fVerbose    = 0;
    68	    Extra_UtilGetoptReset();
    69	    while ( ( c = Extra_UtilGetopt( argc, argv, "DABFSGMarspfuovh" ) ) != EOF )
    70	    {
    71	        switch ( c )
    72	        {
    73	        case 'D':
    74	            if ( globalUtilOptind >= argc )
    75	            {
    76	                Abc_Print( -1, "Command line switch \"-D\" should be followed by a floating point number.\n" );
    77	                goto usage;
    78	            }
    79	            DelayTarget = (float)atof(argv[globalUtilOptind]);
    80	            globalUtilOptind++;
    81	            if ( DelayTarget <= 0.0 )
    82	                goto usage;
    83	            break;
    84	        case 'A':
    85	            if ( globalUtilOptind >= argc )
    86	            {
    87	                Abc_Print( -1, "Command line switch \"-A\" should be followed by a floating point number.\n" );
    88	                goto usage;
    89	            }
    90	            AreaMulti = (float)atof(argv[globalUtilOptind]);
    91	            globalUtilOptind++;
    92	            break;
    93	        case 'B':
    94	            if ( globalUtilOptind >= argc )
    95	            {
    96	                Abc_Print( -1, "Command line switch \"-B\" should be followed by a floating point number.\n" );
    97	                goto usage;
    98	            }
    99	            DelayMulti = (float)atof(argv[globalUtilOptind]);
   100	            globalUtilOptind++;
   101	            break;
   102	        case 'F':
   103	            if ( globalUtilOptind >= argc )
   104	            {
   105	                Abc_Print( -1, "Command line switch \"-F\" should be followed by a floating point number.\n" );
   106	                goto usage;
   107	            }
   108	            LogFan = (float)atof(argv[globalUtilOptind]);
   109	            globalUtilOptind++;
   110	            if ( LogFan < 0.0 )
   111	                goto usage;
   112	            break;
   113	        case 'S':
   114	            if ( globalUtilOptind >= argc )
   115	            {
   116	                Abc_Print( -1, "Command line switch \"-S\" should be followed by a floating point number.\n" );
   117	                goto usage;
   118	            }
   119	            Slew = (float)atof(argv[globalUtilOptind]);
   120	            globalUtilOptind++;
   121	            if ( Slew <= 0.0 )
   122	                goto usage;
   123	            break;
   124	        case 'G':
   125	            if ( globalUtilOptind >= argc )
   126	            {
   127	                Abc_Print( -1, "Command line switch \"-G\" should be followed by a floating point number.\n" );
   128	                goto usage;
   129	            }
   130	            Gain = (float)atof(argv[globalUtilOptind]);
   131	            globalUtilOptind++;
   132	            if ( Gain <= 0.0 )
   133	                goto usage;
   134	            break;
   135	        case 'M':
   136	            if ( globalUtilOptind >= argc )
   137	            {
   138	                Abc_Print( -1, "Command line switch \"-M\" should be followed by a positive integer.\n" );
   139	                goto usage;
   140	            }
   141	            nGatesMin = atoi(argv[globalUtilOptind]);
   142	            globalUtilOptind++;
   143	            if ( nGatesMin < 0 )
   144	                goto usage;
   145	            break;
   146	        case 'a':
   147	            fAreaOnly ^= 1;
   148	            break;
   149	        case 'r':
