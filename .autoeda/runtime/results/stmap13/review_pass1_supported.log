/**Function*************************************************************

  Synopsis    [Runs the stmap12 mapper probe.]

  Description [stmap12 tests a fanout-bucket split of the stmap11
  middle-slack area-relief high-fanout wide-cut guard. It keeps the same
  tight mapper-depth window, but allows the middle-slack relief only in the
  lower moderate fanout bucket, leaving upper-moderate and highest fanout
  nodes on the stricter stmap8-style arrival-bounded guard.]

  SideEffects []

  SeeAlso     []

***********************************************************************/
int Abc_CommandStmap12( Abc_Frame_t * pAbc, int argc, char ** argv )
{
    Abc_Ntk_t * pNtk, * pNtkRes;
    char Buffer[100];
    double DelayTarget;
    double AreaMulti;
    double DelayMulti;
    float LogFan = 0;
    float Slew = 0; // choose based on the library
    float Gain = 250; // keep classic map gain to isolate the recovery guard hypothesis
    int nGatesMin = 0;
    int fAreaOnly;
    int fRecovery;
    int fSweep;
    int fSwitching;
    int fSkipFanout;
    int fUseProfile;
    int fUseBuffs;
