   223	    //////////////////////////////////////////////////////////////////////
   224	
   225	    if ( p->fSkipFanout == 14 )
   226	        printf( "stmap13 guard stats: exact-risk = %d  highest = %d  lower-mod = %d  upper-mod = %d  middle-slack = %d  middle-relief = %d  reject-slack = %d  reject-highest = %d  reject-arrival = %d  reject-area = %d\n",
   227	            p->nStmap13ExactRisk, p->nStmap13HighestRisk, p->nStmap13LowerModRisk,
   228	            p->nStmap13UpperModRisk, p->nStmap13MiddleSlack, p->nStmap13MiddleRelief,
   229	            p->nStmap13RejectSlack, p->nStmap13RejectHighest, p->nStmap13RejectArrival,
   230	            p->nStmap13RejectArea );
   231	
   232	    // print the arrival times of the latest outputs
   233	    if ( p->fVerbose )
   234	        Map_MappingPrintOutputArrivals( p );
   235	    return 1;
