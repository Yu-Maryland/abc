  1006	    Abc_Ntk_t * pNtkNew;
  1007	    Map_Node_t * pNodeMap;
  1008	    Abc_Obj_t * pNode, * pNodeNew;
  1009	    int i, nDupGates;
  1010	    assert( Map_ManReadBufNum(pMan) == pNtk->nBarBufs );
  1011	    // create the new network
  1012	    pNtkNew = Abc_NtkStartFrom( pNtk, ABC_NTK_LOGIC, ABC_FUNC_MAP );
  1013	    pNtkNew->vOrigNodeIds = Vec_IntStartFull( 2 * Abc_NtkObjNumMax(pNtk) );
  1014	    // make the mapper point to the new network
  1015	    Map_ManCleanData( pMan );
  1016	    Abc_NtkForEachCi( pNtk, pNode, i )
  1017	    {
  1018	        if ( i >= Abc_NtkCiNum(pNtk) - pNtk->nBarBufs )
  1019	            break;
  1020	        Map_NodeSetData( Map_ManReadInputs(pMan)[i], 1, (char *)pNode->pCopy );
