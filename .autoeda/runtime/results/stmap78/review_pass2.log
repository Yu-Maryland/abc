   750	/**Function*************************************************************
   751	
   752	  Synopsis    [Load the network into manager.]
   753	
   754	  Description []
   755	               
   756	  SideEffects []
   757	
   758	  SeeAlso     []
   759	
   760	***********************************************************************/
   761	Map_Man_t * Abc_NtkToMap( Abc_Ntk_t * pNtk, double DelayTarget, int fRecovery, float * pSwitching, int fVerbose )
   762	{
   763	    Map_Man_t * pMan;
   764	    Map_Node_t * pNodeMap;
   765	    Vec_Ptr_t * vNodes;
   766	    Abc_Obj_t * pNode, * pFanin, * pPrev;
   767	    int i;
   768	
   769	    assert( Abc_NtkIsStrash(pNtk) );
   770	
   771	    // start the mapping manager and set its parameters
   772	    pMan = Map_ManCreate( Abc_NtkPiNum(pNtk) + Abc_NtkLatchNum(pNtk) - pNtk->nBarBufs, Abc_NtkPoNum(pNtk) + Abc_NtkLatchNum(pNtk) - pNtk->nBarBufs, fVerbose );
   773	    if ( pMan == NULL )
   774	        return NULL;
   775	    Map_ManSetAreaRecovery( pMan, fRecovery );
   776	    Map_ManSetOutputNames( pMan, Abc_NtkCollectCioNames(pNtk, 1) );
   777	    Map_ManSetDelayTarget( pMan, (float)DelayTarget );
   778	    Map_ManCreateAigIds( pMan, Abc_NtkObjNumMax(pNtk) );
   779	
   780	    // set arrival and requireds
   781	    if ( Scl_ConIsRunning() && Scl_ConHasInArrs() )
   782	        Map_ManSetInputArrivals( pMan, Abc_NtkMapCopyCiArrivalCon(pNtk) );
   783	    else
   784	        Map_ManSetInputArrivals( pMan, Abc_NtkMapCopyCiArrival(pNtk, Abc_NtkGetCiArrivalTimes(pNtk)) );
   785	    if ( Scl_ConIsRunning() && Scl_ConHasOutReqs() )
   786	        Map_ManSetOutputRequireds( pMan, Abc_NtkMapCopyCoRequiredCon(pNtk) );
   787	    else
   788	        Map_ManSetOutputRequireds( pMan, Abc_NtkMapCopyCoRequired(pNtk, Abc_NtkGetCoRequiredTimes(pNtk)) );
   789	
   790	    // create PIs and remember them in the old nodes
   791	    Abc_NtkCleanCopy( pNtk );
   792	    Abc_AigConst1(pNtk)->pCopy = (Abc_Obj_t *)Map_ManReadConst1(pMan);
   793	    Abc_NtkForEachCi( pNtk, pNode, i )
   794	    {
   795	        if ( i == Abc_NtkCiNum(pNtk) - pNtk->nBarBufs )
   796	            break;
   797	        pNodeMap = Map_ManReadInputs(pMan)[i];
   798	        pNode->pCopy = (Abc_Obj_t *)pNodeMap;
   799	        if ( pSwitching )
   800	            Map_NodeSetSwitching( pNodeMap, pSwitching[pNode->Id] );
   801	        Map_NodeSetAigId( pNodeMap, pNode->Id );
   802	    }
   803	
   804	    // load the AIG into the mapper
   805	    vNodes = Abc_AigDfsMap( pNtk );
   806	    Vec_PtrForEachEntry( Abc_Obj_t *, vNodes, pNode, i )
   807	    {
   808	        if ( Abc_ObjIsLatch(pNode) )
   809	        {
   810	            pFanin = Abc_ObjFanin0(pNode);
   811	            pNodeMap = Map_NodeBuf( pMan, Map_NotCond( Abc_ObjFanin0(pFanin)->pCopy, (int)Abc_ObjFaninC0(pFanin) ) );
   812	            Abc_ObjFanout0(pNode)->pCopy = (Abc_Obj_t *)pNodeMap;
   813	            continue;
   814	        }
   815	        assert( Abc_ObjIsNode(pNode) );
   816	        // add the node to the mapper
   817	        pNodeMap = Map_NodeAnd( pMan, 
   818	            Map_NotCond( Abc_ObjFanin0(pNode)->pCopy, (int)Abc_ObjFaninC0(pNode) ),
   819	            Map_NotCond( Abc_ObjFanin1(pNode)->pCopy, (int)Abc_ObjFaninC1(pNode) ) );
   820	        assert( pNode->pCopy == NULL );
   821	        // remember the node
   822	        pNode->pCopy = (Abc_Obj_t *)pNodeMap;
   823	        if ( pSwitching )
   824	            Map_NodeSetSwitching( pNodeMap, pSwitching[pNode->Id] );
   825	        // set up the choice node
   826	        if ( Abc_AigNodeIsChoice( pNode ) )
   827	            for ( pPrev = pNode, pFanin = (Abc_Obj_t *)pNode->pData; pFanin; pPrev = pFanin, pFanin = (Abc_Obj_t *)pFanin->pData )
   828	            {
   829	                Map_NodeSetNextE( (Map_Node_t *)pPrev->pCopy, (Map_Node_t *)pFanin->pCopy );
   830	                Map_NodeSetRepr( (Map_Node_t *)pFanin->pCopy, (Map_Node_t *)pNode->pCopy );
   831	            }
   832	        Map_NodeSetAigId( pNodeMap, pNode->Id );
   833	    }
   834	    assert( Map_ManReadBufNum(pMan) == pNtk->nBarBufs );
   835	    Vec_PtrFree( vNodes );
   836	
   837	    // set the primary outputs in the required phase
   838	    Abc_NtkForEachCo( pNtk, pNode, i )
   839	    {
   840	        if ( i == Abc_NtkCoNum(pNtk) - pNtk->nBarBufs )
   841	            break;
   842	        Map_ManReadOutputs(pMan)[i] = Map_NotCond( (Map_Node_t *)Abc_ObjFanin0(pNode)->pCopy, (int)Abc_ObjFaninC0(pNode) );
   843	    }
   844	    return pMan;
   845	}
