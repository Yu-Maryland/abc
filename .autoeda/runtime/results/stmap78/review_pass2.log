   238	        return;
   239	    pSourceGate = pNodeSource ? (Mio_Gate_t *)pNodeSource->pData : NULL;
   240	    pInvGate = pNodeInv ? (Mio_Gate_t *)pNodeInv->pData : NULL;
   241	    s_nStmap77ReconstructionRows++;
   242	    s_nStmap77ReconstructionInverters++;
