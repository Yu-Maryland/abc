   902	Abc_Obj_t * Abc_NodeFromMapPhase_rec( Abc_Ntk_t * pNtkNew, Map_Node_t * pNodeMap, int fPhase )
   903	{
   904	    Abc_Obj_t * pNodePIs[10];
   905	    Abc_Obj_t * pNodeNew;
   906	    Map_Node_t ** ppLeaves;
   907	    Map_Cut_t * pCutBest;
   908	    Map_Super_t * pSuperBest;
   909	    unsigned uPhaseBest;
   910	    int i, fInvPin, nLeaves;
   911	
   912	    // make sure the node can be implemented in this phase
   913	    assert( Map_NodeReadCutBest(pNodeMap, fPhase) != NULL || Map_NodeIsConst(pNodeMap) );
   914	    // check if the phase is already implemented
   915	    pNodeNew = (Abc_Obj_t *)Map_NodeReadData( pNodeMap, fPhase );
   916	    if ( pNodeNew )
   917	    {
   918	        Abc_Stmap77RecordReconstructionCache( pNodeMap, fPhase, pNodeNew, "phase" );
   919	        return pNodeNew;
   920	    }
   921	
   922	    // get the information about the best cut 
   923	    pCutBest   = Map_NodeReadCutBest( pNodeMap, fPhase );
   924	    pSuperBest = Map_CutReadSuperBest( pCutBest, fPhase );
   925	    uPhaseBest = Map_CutReadPhaseBest( pCutBest, fPhase );
   926	    nLeaves    = Map_CutReadLeavesNum( pCutBest );
   927	    ppLeaves   = Map_CutReadLeaves( pCutBest );
   928	    //Vec_Ptr_t * vAnds = Map_CutInternalNodes( pNodeMap, pCutBest );
   929	
   930	    // collect the PI nodes
   931	    for ( i = 0; i < nLeaves; i++ )
   932	    {
   933	        fInvPin = ((uPhaseBest & (1 << i)) > 0);
   934	        Abc_Stmap78RecordLeafDemand( pNodeMap, fPhase, ppLeaves[i], !fInvPin, i, pCutBest, pSuperBest, uPhaseBest );
   935	        pNodePIs[i] = Abc_NodeFromMap_rec( pNtkNew, ppLeaves[i], !fInvPin );
   936	        assert( pNodePIs[i] != NULL );
   937	    }
   938	
   939	    // implement the supergate
   940	    pNodeNew = Abc_NodeFromMapSuper_rec( pNtkNew, pNodeMap, pSuperBest, pNodePIs, nLeaves );
   941	    Vec_IntWriteEntry( pNtkNew->vOrigNodeIds, pNodeNew->Id, Abc_Var2Lit( Map_NodeReadAigId(pNodeMap), fPhase ) );
   942	    Map_NodeSetData( pNodeMap, fPhase, (char *)pNodeNew );
   943	    Abc_Stmap77RecordReconstructionEmit( pNodeMap, fPhase, pNodeNew, pCutBest, pSuperBest, uPhaseBest );
   944	    return pNodeNew;
   945	}
   946	Abc_Obj_t * Abc_NodeFromMap_rec( Abc_Ntk_t * pNtkNew, Map_Node_t * pNodeMap, int fPhase )
   947	{
   948	    Abc_Obj_t * pNodeNew, * pNodeInv;
   949	    int fPushed = 0, fOldPathPhase = -1;
   950	
   951	    // check the case of constant node
   952	    if ( Map_NodeIsConst(pNodeMap) )
   953	    {
   954	        pNodeNew = fPhase? Abc_NtkCreateNodeConst1(pNtkNew) : Abc_NtkCreateNodeConst0(pNtkNew);
   955	        if ( pNodeNew->pData == NULL )
   956	            printf( "Error creating mapped network: Library does not have a constant %d gate.\n", fPhase );
   957	        return pNodeNew;
   958	    }
   959	
   960	    Abc_Stmap78DemandPathPush( pNodeMap, fPhase );
   961	    fPushed = s_fStmap78DemandPathDiag && s_fStmap78DemandPathActive;
   962	    Abc_Stmap77RecordReconstructionRequest( pNodeMap, fPhase );
   963	
   964	    // check if the phase is already implemented
   965	    pNodeNew = (Abc_Obj_t *)Map_NodeReadData( pNodeMap, fPhase );
   966	    if ( pNodeNew )
   967	    {
   968	        Abc_Stmap77RecordReconstructionCache( pNodeMap, fPhase, pNodeNew, "request" );
   969	        if ( fPushed )
   970	            Abc_Stmap78DemandPathPop();
   971	        return pNodeNew;
   972	    }
   973	
   974	    // implement the node if the best cut is assigned
   975	    if ( Map_NodeReadCutBest(pNodeMap, fPhase) != NULL )
   976	    {
   977	        pNodeNew = Abc_NodeFromMapPhase_rec( pNtkNew, pNodeMap, fPhase );
   978	        if ( fPushed )
   979	            Abc_Stmap78DemandPathPop();
   980	        return pNodeNew;
   981	    }
   982	
   983	    // if the cut is not assigned, implement the node
   984	    assert( Map_NodeReadCutBest(pNodeMap, !fPhase) != NULL || Map_NodeIsConst(pNodeMap) );
   985	    if ( fPushed )
   986	        fOldPathPhase = Abc_Stmap78DemandPathSetTopPhase( !fPhase );
   987	    pNodeNew = Abc_NodeFromMapPhase_rec( pNtkNew, pNodeMap, !fPhase );
   988	    if ( fPushed && fOldPathPhase >= 0 )
   989	        Abc_Stmap78DemandPathSetTopPhase( fOldPathPhase );
   990	
   991	    // add the inverter
   992	    pNodeInv = Abc_NtkCreateNode( pNtkNew );
   993	    Vec_IntWriteEntry( pNtkNew->vOrigNodeIds, pNodeInv->Id, Abc_Var2Lit( Map_NodeReadAigId(pNodeMap), fPhase ) );
   994	    Abc_ObjAddFanin( pNodeInv, pNodeNew );
   995	    pNodeInv->pData = Mio_LibraryReadInv((Mio_Library_t *)Abc_FrameReadLibGen());
   996	
   997	    // set the inverter
   998	    Map_NodeSetData( pNodeMap, fPhase, (char *)pNodeInv );
   999	    Abc_Stmap77RecordReconstructionInverter( pNodeMap, fPhase, pNodeNew, pNodeInv );
  1000	    if ( fPushed )
  1001	        Abc_Stmap78DemandPathPop();
  1002	    return pNodeInv;
  1003	}
  1004	Abc_Ntk_t * Abc_NtkFromMap( Map_Man_t * pMan, Abc_Ntk_t * pNtk, int fUseBuffs )
  1005	{
  1006	    Abc_Ntk_t * pNtkNew;
