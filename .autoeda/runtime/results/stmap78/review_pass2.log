  1033	        pNodeMap = Map_ManReadBufDriver( pMan, i - (Abc_NtkCoNum(pNtk) - pNtk->nBarBufs) );
  1034	        Abc_Stmap77RecordReconstructionDemand( "barbuf", i, pNodeMap, !Map_IsComplement(pNodeMap) );
  1035	        Abc_Stmap78DemandPathSetRoot( "barbuf", i );
  1036	        pNodeNew = Abc_NodeFromMap_rec( pNtkNew, Map_Regular(pNodeMap), !Map_IsComplement(pNodeMap) );
  1037	        assert( !Abc_ObjIsComplement(pNodeNew) );
  1038	        Abc_ObjAddFanin( pNode->pCopy, pNodeNew );
  1039	    }
  1040	    Abc_NtkForEachCo( pNtk, pNode, i )
  1041	    {
  1042	        if ( i >= Abc_NtkCoNum(pNtk) - pNtk->nBarBufs )
  1043	            break;
  1044	        pNodeMap = Map_ManReadOutputs(pMan)[i];
  1045	        Abc_Stmap77RecordReconstructionDemand( "co", i, pNodeMap, !Map_IsComplement(pNodeMap) );
  1046	        Abc_Stmap78DemandPathSetRoot( "co", i );
  1047	        pNodeNew = Abc_NodeFromMap_rec( pNtkNew, Map_Regular(pNodeMap), !Map_IsComplement(pNodeMap) );
  1048	        assert( !Abc_ObjIsComplement(pNodeNew) );
  1049	        Abc_ObjAddFanin( pNode->pCopy, pNodeNew );
  1050	    }
  1051	    // decouple the PO driver nodes to reduce the number of levels
  1052	    nDupGates = Abc_NtkLogicMakeSimpleCos( pNtkNew, !fUseBuffs );
