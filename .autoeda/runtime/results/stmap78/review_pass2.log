   469	static void Abc_Stmap78DemandPathPop( void )
   470	{
   471	    if ( !s_fStmap78DemandPathDiag || !s_fStmap78DemandPathActive )
   472	        return;
   473	    if ( s_nStmap78Stack > 0 )
   474	        s_nStmap78Stack--;
