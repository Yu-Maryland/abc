   246	        s_pStmap77ReconstructionLabel, s_nStmap77ReconstructionRows, WatchIndex,
   247	        Map_NodeReadNum(Map_Regular(pNodeMap)), AigId, fPhase, !fPhase,
   248	        pNodeSource ? Abc_ObjId(pNodeSource) : -1, pSourceGate ? Mio_GateReadName(pSourceGate) : "?",
