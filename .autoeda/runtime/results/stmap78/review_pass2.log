   477	static int Abc_Stmap78DemandPathSetTopPhase( int fPhase )
   478	{
   479	    int iTop, fOldPhase;
   480	    if ( !s_fStmap78DemandPathDiag || !s_fStmap78DemandPathActive )
   481	        return -1;
   482	    if ( s_nStmap78Stack <= 0 || s_nStmap78Stack > ABC_STMAP78_MAX_PATH )
