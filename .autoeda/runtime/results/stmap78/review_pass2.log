   341	static const char * Abc_Stmap78PhaseAction( Map_Node_t * pNodeMap, int fPhase )
   342	{
   343	    Map_Node_t * pNodeRegular;
   344	    if ( pNodeMap == NULL )
   345	        return "unavailable";
   346	    pNodeRegular = Map_Regular( pNodeMap );
   347	    if ( Map_NodeReadData( pNodeRegular, fPhase ) != NULL )
   348	        return "cached";
   349	    if ( Map_NodeReadCutBest( pNodeRegular, fPhase ) != NULL )
   350	        return "direct-cut";
   351	    if ( Map_NodeReadCutBest( pNodeRegular, !fPhase ) != NULL )
   352	        return "inverter-from-opposite";
   353	    return "unavailable";
   354	}
   355	
   356	static const char * Abc_Stmap78PhaseGateName( Map_Node_t * pNodeMap, int fPhase )
   357	{
   358	    Map_Cut_t * pCutBest;
   359	    Map_Super_t * pSuperBest;
   360	    Mio_Gate_t * pGate;
   361	    if ( pNodeMap == NULL )
   362	        return "?";
   363	    pCutBest = Map_NodeReadCutBest( Map_Regular(pNodeMap), fPhase );
   364	    if ( pCutBest == NULL )
   365	        return "?";
   366	    pSuperBest = Map_CutReadSuperBest( pCutBest, fPhase );
   367	    pGate = pSuperBest ? Map_SuperReadRoot( pSuperBest ) : NULL;
   368	    return pGate ? Mio_GateReadName( pGate ) : "?";
   369	}
   370	
   371	static void Abc_Stmap78AppendValue( char * pBuffer, int nBuffer, int * pPos, int Value )
   372	{
   373	    int nWritten;
   374	    if ( *pPos >= nBuffer )
   375	        return;
   376	    nWritten = snprintf( pBuffer + *pPos, nBuffer - *pPos, *pPos ? ">%d" : "%d", Value );
   377	    if ( nWritten < 0 )
   378	        return;
   379	    *pPos += nWritten;
   380	    if ( *pPos >= nBuffer )
   620	    if ( AreaMulti != 0.0 )
   621	        Mio_LibraryMultiArea( (Mio_Library_t *)Abc_FrameReadLibGen(), -AreaMulti );
   622	    if ( DelayMulti != 0.0 )
   623	        Mio_LibraryMultiDelay( (Mio_Library_t *)Abc_FrameReadLibGen(), -DelayMulti );
   624	
   625	    // print a warning about choice nodes
   626	    if ( fVerbose && Abc_NtkGetChoiceNum( pNtk ) )
   627	        printf( "Performing mapping with choices.\n" );
   628	
   629	    // compute switching activity
   630	    fShowSwitching |= fSwitching;
   631	    if ( fShowSwitching )
   632	    {
   633	        extern Vec_Int_t * Sim_NtkComputeSwitching( Abc_Ntk_t * pNtk, int nPatterns );
   634	        vSwitching = Sim_NtkComputeSwitching( pNtk, 4096 );
   635	        pSwitching = (float *)vSwitching->pArray;
   636	    }
   637	
   638	    // perform the mapping
   639	    pMan = Abc_NtkToMap( pNtk, DelayTarget, fRecovery, pSwitching, fVerbose );
   640	    if ( pSwitching ) Vec_IntFree( vSwitching );
   641	    if ( pMan == NULL )
   642	        return NULL;
   643	clk = Abc_Clock();
   644	    Map_ManSetSwitching( pMan, fSwitching );
   645	    Map_ManSetSkipFanout( pMan, fSkipFanout );
   646	    if ( fUseProfile )
   647	        Map_ManSetUseProfile( pMan );
   648	    if ( LogFan != 0 )
   649	        Map_ManCreateNodeDelays( pMan, LogFan );
   650	    if ( !Map_Mapping( pMan ) )
   651	    {
   652	        Map_ManFree( pMan );
   653	        return NULL;
   654	    }
   655	//    Map_ManPrintStatsToFile( pNtk->pSpec, Map_ManReadAreaFinal(pMan), Map_ManReadRequiredGlo(pMan), Abc_Clock()-clk );
   656	
   657	    // reconstruct the network after mapping (use buffers when user requested or in the area mode)
   658	    pNtkNew = Abc_NtkFromMap( pMan, pNtk, fUseBuffs || (DelayTarget == (double)ABC_INFINITY) );
   659	    if ( Mio_LibraryHasProfile(pLib) )
   660	        Mio_LibraryTransferProfile2( (Mio_Library_t *)Abc_FrameReadLibGen(), pLib );
   661	    Map_ManFree( pMan );
   662	    if ( pNtkNew == NULL )
   663	        return NULL;
   664	
   665	    if ( pNtk->pExdc )
   666	        pNtkNew->pExdc = Abc_NtkDup( pNtk->pExdc );
   667	if ( fVerbose )
   668	{
   669	ABC_PRT( "Total runtime", Abc_Clock() - clkTotal );
   670	}
   671	
   672	    // make sure that everything is okay
   673	    if ( !Abc_NtkCheck( pNtkNew ) )
   674	    {
   675	        printf( "Abc_NtkMap: The network check has failed.\n" );
   676	        Abc_NtkDelete( pNtkNew );
   677	        return NULL;
   678	    }
   679	    return pNtkNew;
   680	}
