   371	static void Abc_Stmap78AppendValue( char * pBuffer, int nBuffer, int * pPos, int Value )
   372	{
   373	    int nWritten;
   374	    if ( *pPos >= nBuffer )
   375	        return;
   376	    nWritten = snprintf( pBuffer + *pPos, nBuffer - *pPos, *pPos ? ">%d" : "%d", Value );
   377	    if ( nWritten < 0 )
   378	        return;
   379	    *pPos += nWritten;
   380	    if ( *pPos >= nBuffer )
   381	        *pPos = nBuffer - 1;
   382	}
