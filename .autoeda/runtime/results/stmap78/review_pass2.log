   448	static void Abc_Stmap78DemandPathPush( Map_Node_t * pNodeMap, int fPhase )
   449	{
   450	    Map_Node_t * pNodeRegular;
   451	    int AigId;
   452	    if ( !s_fStmap78DemandPathDiag || !s_fStmap78DemandPathActive || pNodeMap == NULL )
   453	        return;
   454	    pNodeRegular = Map_Regular( pNodeMap );
   455	    if ( Map_NodeIsConst( pNodeRegular ) )
   456	        return;
   457	    AigId = Map_NodeReadAigId( pNodeRegular );
   458	    if ( s_nStmap78Stack < ABC_STMAP78_MAX_PATH )
   459	    {
   460	        s_Stmap78PathNodes[s_nStmap78Stack] = Map_NodeReadNum( pNodeRegular );
   461	        s_Stmap78PathAigs[s_nStmap78Stack] = AigId;
   462	        s_Stmap78PathPhases[s_nStmap78Stack] = fPhase;
   463	    }
   464	    s_nStmap78Stack++;
   465	    if ( AigId == s_Stmap78WatchAigId )
   466	        Abc_Stmap78RecordTargetRequest( pNodeRegular, fPhase );
   467	}
