   417	    int ParentAig = Limit >= 2 ? s_Stmap78PathAigs[Limit - 2] : -1;
   418	    int ParentNode = Limit >= 2 ? s_Stmap78PathNodes[Limit - 2] : -1;
   419	    int ParentPhase = Limit >= 2 ? s_Stmap78PathPhases[Limit - 2] : -1;
   420	    int fViaDownstream = Abc_Stmap78PathContainsAig( s_Stmap78DownstreamAigId );
   421	    const char * pPhase0Action = Abc_Stmap78PhaseAction( pNodeRegular, 0 );
