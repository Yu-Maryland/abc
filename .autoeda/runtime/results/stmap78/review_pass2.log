  1015	    Map_ManCleanData( pMan );
  1016	    Abc_NtkForEachCi( pNtk, pNode, i )
  1017	    {
  1018	        if ( i >= Abc_NtkCiNum(pNtk) - pNtk->nBarBufs )
  1019	            break;
  1020	        Map_NodeSetData( Map_ManReadInputs(pMan)[i], 1, (char *)pNode->pCopy );
