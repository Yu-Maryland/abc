   682	/**Function*************************************************************
   683	
   684	  Synopsis    [Load the network into manager.]
   685	
   686	  Description []
   687	               
   688	  SideEffects []
   689	
   690	  SeeAlso     []
   691	
   692	***********************************************************************/
   693	Map_Time_t * Abc_NtkMapCopyCiArrival( Abc_Ntk_t * pNtk, Abc_Time_t * ppTimes )
   694	{
   695	    Map_Time_t * p;
   696	    int i;
   697	    p = ABC_CALLOC( Map_Time_t, Abc_NtkCiNum(pNtk) );
   698	    for ( i = 0; i < Abc_NtkCiNum(pNtk); i++ )
   699	    {
   700	        p[i].Fall = ppTimes[i].Fall;
   701	        p[i].Rise = ppTimes[i].Rise;
   702	        p[i].Worst = Abc_MaxFloat( p[i].Fall, p[i].Rise );
   703	    }
   704	    ABC_FREE( ppTimes );
   705	    return p;
   706	}
   707	Map_Time_t * Abc_NtkMapCopyCoRequired( Abc_Ntk_t * pNtk, Abc_Time_t * ppTimes )
   708	{
   709	    Map_Time_t * p;
   710	    int i;
   711	    p = ABC_CALLOC( Map_Time_t, Abc_NtkCoNum(pNtk) );
   712	    for ( i = 0; i < Abc_NtkCoNum(pNtk); i++ )
   713	    {
   714	        p[i].Fall = ppTimes[i].Fall;
   715	        p[i].Rise = ppTimes[i].Rise;
   716	        p[i].Worst = Abc_MaxFloat( p[i].Fall, p[i].Rise );
   717	    }
   718	    ABC_FREE( ppTimes );
   719	    return p;
   720	}
