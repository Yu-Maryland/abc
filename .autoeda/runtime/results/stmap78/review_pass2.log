   135	    if ( !s_fStmap77ReconstructionDiag || !s_fStmap77ReconstructionActive || pNodeMap == NULL )
   136	        return -1;
   137	    pNodeRegular = Map_Regular( pNodeMap );
   138	    if ( Map_NodeIsConst( pNodeRegular ) )
   139	        return -1;
   140	    AigId = Map_NodeReadAigId( pNodeRegular );
   141	    if ( pAigId )
   142	        *pAigId = AigId;
   143	    for ( i = 0; i < s_nStmap77ReconstructionWatchAigs; i++ )
   144	        if ( s_Stmap77ReconstructionWatchAigIds[i] == AigId )
   145	            return i;
   146	    return -1;
   147	}
