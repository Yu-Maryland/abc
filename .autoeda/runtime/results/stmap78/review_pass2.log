    63	/**Function*************************************************************
    64	
    65	  Synopsis    [Runs the stmap78 final-demand path diagnostic.]
    66	
    67	  Description [stmap78 keeps the reviewed stmap65 mapping policy unchanged,
    68	  reuses stmap77 reconstruction and phase-survival tracing, and adds a
    69	  final-remap demand-path trace from CO roots to the watched AIG. For ode,
    70	  this identifies whether downstream AIG 5229 is the parent that requests
    71	  phase 1 of watched AIG 5219.]
    72	
    73	  SideEffects []
    74	
    75	  SeeAlso     []
    76	
    77	***********************************************************************/
    78	int Abc_CommandStmap78( Abc_Frame_t * pAbc, int argc, char ** argv )
    79	{
    80	    Abc_Ntk_t * pNtk, * pNtkRes;
    81	    int i, RetValue, WatchAigId, DownstreamAigId, WatchAigs[1];
    82	    extern int Abc_CommandStmap65( Abc_Frame_t * pAbc, int argc, char ** argv );
    83	    extern void Map_Stmap75SetFinalCriticalAigDiag( int fEnable, int WatchAigId );
    84	    extern void Map_Stmap75SetFinalCriticalAigDiagLabel( const char * pLabel );
    85	    extern void Map_Stmap75PrintFinalCriticalAigSummary( void );
    86	    extern void Abc_Stmap74EnableFinalCriticalScope( Abc_Ntk_t * pNtk, const char * pLabel );
    87	    extern void Abc_Stmap76EnablePhaseSurvivalScope( Abc_Ntk_t * pNtk, const char * pLabel, int * pWatchAigIds, int nWatchAigs );
    88	    extern void Abc_Stmap77SetReconstructionDiag( int fEnable, const char * pLabel, int * pWatchAigIds, int nWatchAigs );
    89	    extern void Abc_Stmap77PrintReconstructionSummary( void );
    90	    extern void Abc_Stmap78SetDemandPathDiag( int fEnable, const char * pLabel, int WatchAigId, int DownstreamAigId );
    91	    extern void Abc_Stmap78PrintDemandPathSummary( void );
    92	
    93	    for ( i = 1; i < argc; i++ )
    94	    {
    95	        if ( !strcmp( argv[i], "-h" ) )
    96	            goto usage;
    97	    }
    98	
    99	    pNtk = Abc_FrameReadNtk( pAbc );
   100	    Abc_Stmap78WatchAigsForNetwork( pNtk, &WatchAigId, &DownstreamAigId );
   101	    WatchAigs[0] = WatchAigId;
   102	    printf( "stmap78 diagnostic: inherited-policy = stmap65  mapper-selected-match-watch = %d  network = %s  watch-aig = %d  downstream-aig = %d  source = stmap77-final-demand-hypothesis  reconstruction-phase-trace = 1  demand-path-trace = 1  final-phase-survival = 1  mapping-policy-change = 0\n",
   103	        WatchAigId >= 0, pNtk && Abc_NtkName(pNtk) ? Abc_NtkName(pNtk) : "?",
   104	        WatchAigId, DownstreamAigId );
   105	    Map_Stmap75SetFinalCriticalAigDiag( WatchAigId >= 0, WatchAigId );
   106	    Map_Stmap75SetFinalCriticalAigDiagLabel( "stmap78" );
   107	    Abc_Stmap77SetReconstructionDiag( WatchAigId >= 0, "stmap78", WatchAigs, WatchAigId >= 0 ? 1 : 0 );
   108	    Abc_Stmap78SetDemandPathDiag( WatchAigId >= 0, "stmap78", WatchAigId, DownstreamAigId );
   109	    RetValue = Abc_CommandStmap65( pAbc, argc, argv );
   110	    Abc_Stmap77PrintReconstructionSummary();
   111	    Abc_Stmap78PrintDemandPathSummary();
   112	    Abc_Stmap78SetDemandPathDiag( 0, "stmap78", -1, -1 );
   113	    Abc_Stmap77SetReconstructionDiag( 0, "stmap78", NULL, 0 );
   114	    Map_Stmap75PrintFinalCriticalAigSummary();
   115	    Map_Stmap75SetFinalCriticalAigDiag( 0, -1 );
   116	    if ( RetValue == 0 )
   117	    {
   118	        pNtkRes = Abc_FrameReadNtk( pAbc );
   119	        Abc_Stmap74EnableFinalCriticalScope( pNtkRes, "stmap78" );
   120	        Abc_Stmap76EnablePhaseSurvivalScope( pNtkRes, "stmap78", WatchAigs, WatchAigId >= 0 ? 1 : 0 );
   121	    }
   122	    return RetValue;
   123	
   124	usage:
   125	    Abc_Print( -2, "usage: stmap78 [-DABFSG float] [-M num] [-arspfuovh]\n" );
   126	    Abc_Print( -2, "\t              performs stmap78 bounded-pressure mapping with final demand-path diagnostics\n" );
   127	    Abc_Print( -2, "\t-D float : sets the global required times [default = not used]\n" );
   128	    Abc_Print( -2, "\t-A float : \"area multiplier\" to bias gate selection [default = 0.00]\n" );
   129	    Abc_Print( -2, "\t-B float : \"delay multiplier\" to bias gate selection [default = 0.00]\n" );
   130	    Abc_Print( -2, "\t-F float : the logarithmic fanout delay parameter [default = 0.00]\n" );
   131	    Abc_Print( -2, "\t-S float : the slew parameter used to generate the library [default = 0.00]\n" );
   132	    Abc_Print( -2, "\t-G float : the SCL/genlib gain parameter used to generate the library [default = 250.00]\n" );
   133	    Abc_Print( -2, "\t-M num   : skip gate classes whose size is less than this [default = 0]\n" );
   134	    Abc_Print( -2, "\t-a       : toggles area-only mapping [default = no]\n" );
   135	    Abc_Print( -2, "\t-r       : toggles area recovery [default = yes]\n" );
   136	    Abc_Print( -2, "\t-s       : toggles sweep after mapping [default = no]\n" );
   137	    Abc_Print( -2, "\t-p       : optimizes power by minimizing switching [default = no]\n" );
   138	    Abc_Print( -2, "\t-f       : disables the bounded-pressure SCL feedback mapper mode [default = yes]\n" );
   139	    Abc_Print( -2, "\t-u       : use standard-cell profile [default = no]\n" );
   140	    Abc_Print( -2, "\t-o       : toggles using buffers to decouple combinational outputs [default = no]\n" );
   141	    Abc_Print( -2, "\t-v       : toggles verbose output [default = no]\n" );
   142	    Abc_Print( -2, "\t-h       : print the command usage\n" );
   143	    return 1;
   144	}
