   430	    if ( !strcmp( pPhase0Action, "direct-cut" ) || !strcmp( pPhase0Action, "cached" ) )
   431	        s_nStmap78Phase0Direct++;
   432	    else if ( !strcmp( pPhase0Action, "inverter-from-opposite" ) )
   433	        s_nStmap78Phase0Invert++;
   434	    printf( "%s demand-path: index = %d  co-kind = %s  co-index = %d  watch-aig = %d  downstream-aig = %d  requested-phase = %d  stack-depth = %d  via-downstream = %d  parent-node = %d  parent-aig-id = %d  parent-phase = %d  parent-is-downstream = %d  phase0-action = %s  phase1-action = %s  phase0-has-cut = %d  phase1-has-cut = %d  phase0-cached = %d  phase1-cached = %d  phase0-gate = %s  phase1-gate = %s  path-aigs = %s  path-nodes = %s  path-phases = %s\n",
   435	        s_pStmap78DemandPathLabel, s_nStmap78DemandRows, s_pStmap78RootKind,
   436	        s_iStmap78RootCo, s_Stmap78WatchAigId, s_Stmap78DownstreamAigId,
   437	        fPhase, s_nStmap78Stack, fViaDownstream, ParentNode, ParentAig,
