   153	    if ( WatchIndex < 0 )
   154	        return;
   155	    s_nStmap77ReconstructionRows++;
   156	    s_nStmap77ReconstructionDemands++;
   157	    printf( "%s reconstruct-demand: index = %d  watch-index = %d  co-kind = %s  co-index = %d  node = %d  aig-id = %d  requested-phase = %d  complemented-driver = %d\n",
   158	        s_pStmap77ReconstructionLabel, s_nStmap77ReconstructionRows, WatchIndex, pKind ? pKind : "?",
   159	        CoIndex, Map_NodeReadNum(Map_Regular(pNodeMap)), AigId, fPhase, Map_IsComplement(pNodeMap) );
   160	}
