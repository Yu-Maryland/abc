   197	
   198	static void Abc_Stmap77RecordReconstructionEmit( Map_Node_t * pNodeMap, int fPhase, Abc_Obj_t * pNodeNew, Map_Cut_t * pCutBest, Map_Super_t * pSuperBest, unsigned uPhaseBest )
   199	{
   200	    Map_Node_t ** ppLeaves;
   201	    Mio_Gate_t * pGate;
   202	    int AigId, WatchIndex, nLeaves, i, LeafAigId[6], LeafPhase[6];
   203	    WatchIndex = Abc_Stmap77ReconstructionWatchIndex( pNodeMap, &AigId );
   204	    if ( WatchIndex < 0 )
   205	        return;
   206	    nLeaves = pCutBest ? Map_CutReadLeavesNum( pCutBest ) : 0;
   207	    ppLeaves = pCutBest ? Map_CutReadLeaves( pCutBest ) : NULL;
   208	    for ( i = 0; i < 6; i++ )
   209	    {
   210	        LeafAigId[i] = -1;
   211	        LeafPhase[i] = -1;
   212	        if ( ppLeaves != NULL && i < nLeaves )
   213	        {
   214	            LeafAigId[i] = Map_NodeReadAigId( Map_Regular(ppLeaves[i]) );
   215	            LeafPhase[i] = ((uPhaseBest & (1 << i)) > 0) ? 0 : 1;
   216	        }
   217	    }
   218	    pGate = pNodeNew ? (Mio_Gate_t *)pNodeNew->pData : NULL;
   219	    s_nStmap77ReconstructionRows++;
   220	    s_nStmap77ReconstructionDirectEmits++;
   221	    if ( fPhase >= 0 && fPhase < 2 )
   222	        s_Stmap77ReconstructionDirectPhase[fPhase]++;
   223	    printf( "%s reconstruct-emit: index = %d  watch-index = %d  node = %d  aig-id = %d  phase = %d  new-node = %d  gate = %s  leaves = %d  u-phase-best = %u  fanout-limit = %d  leaf0-aig-id = %d  leaf0-phase = %d  leaf1-aig-id = %d  leaf1-phase = %d  leaf2-aig-id = %d  leaf2-phase = %d  leaf3-aig-id = %d  leaf3-phase = %d  leaf4-aig-id = %d  leaf4-phase = %d  leaf5-aig-id = %d  leaf5-phase = %d\n",
   224	        s_pStmap77ReconstructionLabel, s_nStmap77ReconstructionRows, WatchIndex,
   225	        Map_NodeReadNum(Map_Regular(pNodeMap)), AigId, fPhase,
   226	        pNodeNew ? Abc_ObjId(pNodeNew) : -1, pGate ? Mio_GateReadName(pGate) : "?",
   227	        nLeaves, uPhaseBest, pSuperBest ? Map_SuperReadFanoutLimit(pSuperBest) : -1,
   228	        LeafAigId[0], LeafPhase[0], LeafAigId[1], LeafPhase[1], LeafAigId[2], LeafPhase[2],
   229	        LeafAigId[3], LeafPhase[3], LeafAigId[4], LeafPhase[4], LeafAigId[5], LeafPhase[5] );
   230	}
