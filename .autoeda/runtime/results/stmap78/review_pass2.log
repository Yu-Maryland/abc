   162	static void Abc_Stmap77RecordReconstructionRequest( Map_Node_t * pNodeMap, int fPhase )
   163	{
   164	    int AigId, WatchIndex;
   165	    WatchIndex = Abc_Stmap77ReconstructionWatchIndex( pNodeMap, &AigId );
   166	    if ( WatchIndex < 0 )
   167	        return;
   168	    s_nStmap77ReconstructionRows++;
   169	    s_nStmap77ReconstructionRequests++;
   170	    if ( fPhase >= 0 && fPhase < 2 )
   171	        s_Stmap77ReconstructionRequestPhase[fPhase]++;
   172	    printf( "%s reconstruct-request: index = %d  watch-index = %d  node = %d  aig-id = %d  requested-phase = %d  has-cut-requested = %d  has-cut-opposite = %d  cached-requested = %d  cached-opposite = %d  level = %d\n",
   173	        s_pStmap77ReconstructionLabel, s_nStmap77ReconstructionRows, WatchIndex,
   174	        Map_NodeReadNum(Map_Regular(pNodeMap)), AigId, fPhase,
   175	        Map_NodeReadCutBest(Map_Regular(pNodeMap), fPhase) != NULL,
   176	        Map_NodeReadCutBest(Map_Regular(pNodeMap), !fPhase) != NULL,
   177	        Map_NodeReadData(Map_Regular(pNodeMap), fPhase) != NULL,
   178	        Map_NodeReadData(Map_Regular(pNodeMap), !fPhase) != NULL,
   179	        Map_NodeReadLevel(Map_Regular(pNodeMap)) );
   180	}
