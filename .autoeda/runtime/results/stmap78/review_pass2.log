   393	static void Abc_Stmap78FormatPath( char * pAigs, char * pNodes, char * pPhases, int nBuffer )
   394	{
   395	    int i, Limit = s_nStmap78Stack < ABC_STMAP78_MAX_PATH ? s_nStmap78Stack : ABC_STMAP78_MAX_PATH;
   396	    int nAigPos = 0, nNodePos = 0, nPhasePos = 0;
   397	    pAigs[0] = pNodes[0] = pPhases[0] = 0;
   398	    for ( i = 0; i < Limit; i++ )
   399	    {
   400	        Abc_Stmap78AppendValue( pAigs, nBuffer, &nAigPos, s_Stmap78PathAigs[i] );
   401	        Abc_Stmap78AppendValue( pNodes, nBuffer, &nNodePos, s_Stmap78PathNodes[i] );
   402	        Abc_Stmap78AppendValue( pPhases, nBuffer, &nPhasePos, s_Stmap78PathPhases[i] );
   403	    }
   404	    if ( pAigs[0] == 0 )
   405	    {
   406	        pAigs[0] = '-'; pAigs[1] = 0;
   407	        pNodes[0] = '-'; pNodes[1] = 0;
   408	        pPhases[0] = '-'; pPhases[1] = 0;
   409	    }
   410	}
