        return 0.0;
    Load = (float)Abc_SclObjLoadMax( pTime, pObj );
    if ( pLoad )
        *pLoad = Load;
    if ( pMaxCap )
        *pMaxCap = MaxCap;
    return Load / MaxCap;
}

