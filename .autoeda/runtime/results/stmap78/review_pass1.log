+        Abc_Stmap78AppendValue( pNodes, nBuffer, &nNodePos, s_Stmap78PathNodes[i] );
+        Abc_Stmap78AppendValue( pPhases, nBuffer, &nPhasePos, s_Stmap78PathPhases[i] );
+    }
+    if ( pAigs[0] == 0 )
+    {
+        pAigs[0] = '-'; pAigs[1] = 0;
+        pNodes[0] = '-'; pNodes[1] = 0;
+        pPhases[0] = '-'; pPhases[1] = 0;
+    }
+}
