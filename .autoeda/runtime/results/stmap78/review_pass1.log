+    s_nStmap78Stack = 0;
+}
+
+static void Abc_Stmap78ClearDemandPathDiag( void )
+{
+    s_fStmap78DemandPathDiag = 0;
+    s_fStmap78DemandPathActive = 0;
+    s_pStmap78DemandPathLabel = "stmap78";
+    s_Stmap78WatchAigId = -1;
