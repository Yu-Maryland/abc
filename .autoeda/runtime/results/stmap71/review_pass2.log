  loaded or timing-critical after buffering and sizing before reopening any
  mapper admission rule.]

  SideEffects []

  SeeAlso     []

***********************************************************************/
int Abc_CommandStmap69( Abc_Frame_t * pAbc, int argc, char ** argv )
{
    Abc_Ntk_t * pNtkRes;
    int i, RetValue;
    extern int Abc_CommandStmap65( Abc_Frame_t * pAbc, int argc, char ** argv );
    extern void Map_Stmap69SetPressureNearWitnessDiag( int fEnable );
    extern void Abc_Stmap64EnableFinalWitnessScope( Abc_Ntk_t * pNtk, const char * pLabel );

    for ( i = 1; i < argc; i++ )
    {
        if ( !strcmp( argv[i], "-h" ) )
            goto usage;
    }

    printf( "stmap69 diagnostic: inherited-policy = stmap65  pressure-near-witness = 1  pressure-near-source = stmap56-mode57  mapping-policy-change = 0\n" );
    Map_Stmap69SetPressureNearWitnessDiag( 1 );
    RetValue = Abc_CommandStmap65( pAbc, argc, argv );
    Map_Stmap69SetPressureNearWitnessDiag( 0 );
    if ( RetValue == 0 )
    {
        pNtkRes = Abc_FrameReadNtk( pAbc );
        Abc_Stmap64EnableFinalWitnessScope( pNtkRes, "stmap69" );
    }
    return RetValue;

usage:
    Abc_Print( -2, "usage: stmap69 [-DABFSG float] [-M num] [-arspfuovh]\n" );
    Abc_Print( -2, "\t              performs stmap69 bounded-pressure mapping with pressure-near downstream witness diagnostics\n" );
