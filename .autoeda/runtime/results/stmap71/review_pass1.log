  1598	static void Map_Stmap64RecordCutOnlyWitnessRaw( Map_Node_t * pNode, int AigId, int fPhase, float NodePressureRatio, float CutPressureRatio, float Slack, float AreaSave, float ArrivalDelta, float ArrivalGainMargin )
  1599	{
  1600	    int i;
