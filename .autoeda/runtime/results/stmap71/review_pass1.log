    24	  Description [stmap71 keeps the reviewed stmap65 mapping policy unchanged
    25	  and records mode-57 moderate-penalty block candidates as downstream final
    26	  witnesses.  The diagnostic asks whether the remaining moderate blocker class
    27	  has final criticality at least 0.50 after topo, buffer, upsize, dnsize, and
    28	  stime before reopening any mapper admission rule.]
    29	
    30	  SideEffects []
    31	
    32	  SeeAlso     []
    33	
    34	***********************************************************************/
    35	int Abc_CommandStmap71( Abc_Frame_t * pAbc, int argc, char ** argv )
    36	{
    37	    Abc_Ntk_t * pNtkRes;
    38	    int i, RetValue;
    39	    extern int Abc_CommandStmap65( Abc_Frame_t * pAbc, int argc, char ** argv );
    40	    extern void Map_Stmap71SetModeratePenaltyWitnessDiag( int fEnable );
    41	    extern void Abc_Stmap64EnableFinalWitnessScope( Abc_Ntk_t * pNtk, const char * pLabel );
    42	
    43	    for ( i = 1; i < argc; i++ )
    44	    {
    45	        if ( !strcmp( argv[i], "-h" ) )
    46	            goto usage;
    47	    }
    48	
    49	    printf( "stmap71 diagnostic: inherited-policy = stmap65  moderate-penalty-witness = 1  source = stmap56-mode57  final-criticality-gate = 0.50  mapping-policy-change = 0\n" );
    50	    Map_Stmap71SetModeratePenaltyWitnessDiag( 1 );
    51	    RetValue = Abc_CommandStmap65( pAbc, argc, argv );
    52	    Map_Stmap71SetModeratePenaltyWitnessDiag( 0 );
    53	    if ( RetValue == 0 )
    54	    {
    55	        pNtkRes = Abc_FrameReadNtk( pAbc );
    56	        Abc_Stmap64EnableFinalWitnessScope( pNtkRes, "stmap71" );
    57	    }
    58	    return RetValue;
    59	
    60	usage:
    61	    Abc_Print( -2, "usage: stmap71 [-DABFSG float] [-M num] [-arspfuovh]\n" );
    62	    Abc_Print( -2, "\t              performs stmap71 bounded-pressure mapping with moderate-penalty downstream witness diagnostics\n" );
    63	    Abc_Print( -2, "\t-D float : sets the global required times [default = not used]\n" );
    64	    Abc_Print( -2, "\t-A float : \"area multiplier\" to bias gate selection [default = 0.00]\n" );
    65	    Abc_Print( -2, "\t-B float : \"delay multiplier\" to bias gate selection [default = 0.00]\n" );
    66	    Abc_Print( -2, "\t-F float : the logarithmic fanout delay parameter [default = 0.00]\n" );
    67	    Abc_Print( -2, "\t-S float : the slew parameter used to generate the library [default = 0.00]\n" );
    68	    Abc_Print( -2, "\t-G float : the SCL/genlib gain parameter used to generate the library [default = 250.00]\n" );
    69	    Abc_Print( -2, "\t-M num   : skip gate classes whose size is less than this [default = 0]\n" );
    70	    Abc_Print( -2, "\t-a       : toggles area-only mapping [default = no]\n" );
    71	    Abc_Print( -2, "\t-r       : toggles area recovery [default = yes]\n" );
    72	    Abc_Print( -2, "\t-s       : toggles sweep after mapping [default = no]\n" );
    73	    Abc_Print( -2, "\t-p       : optimizes power by minimizing switching [default = no]\n" );
    74	    Abc_Print( -2, "\t-f       : disables the bounded-pressure SCL feedback mapper mode [default = yes]\n" );
    75	    Abc_Print( -2, "\t-u       : use standard-cell profile [default = no]\n" );
    76	    Abc_Print( -2, "\t-o       : toggles using buffers to decouple combinational outputs [default = no]\n" );
    77	    Abc_Print( -2, "\t-v       : toggles verbose output [default = no]\n" );
    78	    Abc_Print( -2, "\t-h       : print the command usage\n" );
    79	    return 1;
    80	}
