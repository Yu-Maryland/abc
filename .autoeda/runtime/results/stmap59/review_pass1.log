   567	    float OverFrac, Feedback;
   568	    extern Abc_Ntk_t * Abc_NtkMap( Abc_Ntk_t * pNtk, Mio_Library_t* userLib, double DelayTarget, double AreaMulti, double DelayMulti, float LogFan, float Slew, float Gain, int nGatesMin, int fRecovery, int fSwitching, int fSkipFanout, int fUseProfile, int fUseBuffs, int fVerbose );
   569	    extern int Abc_NtkFraigSweep( Abc_Ntk_t * pNtk, int fUseInv, int fExdc, int fVerbose, int fVeryVerbose );
   570	    extern void Map_Stmap45SetSclLoadFeedbackWithEntries( float MaxLoadRatio, float OverFrac, float Severity, float * pAigPressureRatios, int nAigPressureRatios, int nPressureEntries );
   571	
   572	    pNtk = Abc_FrameReadNtk(pAbc);
   573	    DelayTarget = -1;
   574	    AreaMulti   = 0;
   575	    DelayMulti  = 0;
   576	    fAreaOnly   = 0;
   577	    fRecovery   = 1;
   578	    fSweep      = 0;
