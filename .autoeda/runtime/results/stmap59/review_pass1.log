   636	            globalUtilOptind++;
   637	            if ( Slew <= 0.0 )
   638	                goto usage;
   639	            break;
   640	        case 'G':
   641	            if ( globalUtilOptind >= argc )
   642	            {
   643	                Abc_Print( -1, "Command line switch \"-G\" should be followed by a floating point number.\n" );
   644	                goto usage;
   645	            }
   646	            Gain = (float)atof(argv[globalUtilOptind]);
