   701	
   702	    Map_Stmap45SetSclLoadFeedbackWithEntries( 0.0, 0.0, 0.0, NULL, 0, 0 );
   703	    pNtkMap = pNtk;
   704	    if ( !Abc_NtkIsStrash(pNtk) )
   705	    {
   706	        pNtkMap = Abc_NtkStrash( pNtk, 0, 0, 0 );
   707	        if ( pNtkMap == NULL )
   708	        {
   709	            Abc_Print( -1, "Strashing before stmap59 has failed.\n" );
   710	            return 1;
   711	        }
   712	        pNtkMap = Abc_NtkBalance( pNtkRes = pNtkMap, 0, 0, 1 );
   713	        Abc_NtkDelete( pNtkRes );
   714	        if ( pNtkMap == NULL )
   715	        {
   716	            Abc_Print( -1, "Balancing before stmap59 has failed.\n" );
   717	            return 1;
   718	        }
   719	        fTempMap = 1;
   720	        Abc_Print( 0, "The network was strashed and balanced before stmap59.\n" );
   721	    }
   722	
   723	    if ( fSkipFanout )
   724	    {
   725	        pNtkFirst = Abc_NtkMap( pNtkMap, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, Gain, nGatesMin, fRecovery, fSwitching, 36, fUseProfile, fUseBuffs, fVerbose );
   726	        if ( pNtkFirst == NULL )
   727	        {
   728	            if ( fTempMap )
   729	                Abc_NtkDelete( pNtkMap );
   730	            Abc_Print( -1, "stmap59 has failed.\n" );
   731	            return 1;
   732	        }
   733	        Abc_Stmap59CollectSclLoadStats( pNtkFirst, &LoadStats );
   734	        Abc_Stmap59PrintSclLoadStats( "feedback-load", &LoadStats );
   735	        Abc_Stmap59PrintHotspots( &LoadStats );
   736	        OverFrac = LoadStats.nMatched ? (float)LoadStats.nOver / (float)LoadStats.nMatched : 0.0;
   737	        Feedback = Abc_Stmap59FeedbackSeverity( &LoadStats );
   738	        LowGain = 0.90 * Gain;
   739	        SelectedGain = Gain;
   740	        fUseReducedGain = Feedback >= ABC_STMAP59_SEVERE_THRESHOLD && LoadStats.nPressureEntries >= ABC_STMAP59_PRESSURE_ENTRY_THRESHOLD;
   741	        fSevereTransfer = fUseReducedGain;
   742	        if ( fUseReducedGain && LowGain > 0.0 )
   743	            SelectedGain = LowGain;
   744	        pBoundedPressureRatios = Abc_Stmap59BuildBoundedPressures( &LoadStats, fSevereTransfer, &BoundedStats );
   745	        if ( pBoundedPressureRatios == NULL && LoadStats.nAigPressureRatios > 0 )
   746	        {
   747	            Abc_NtkDelete( pNtkFirst );
   748	            Abc_Stmap59LoadStatsFree( &LoadStats );
   749	            if ( fTempMap )
   750	                Abc_NtkDelete( pNtkMap );
   751	            Abc_Print( -1, "stmap59 bounded-pressure allocation has failed.\n" );
   752	            return 1;
   753	        }
   754	        printf( "stmap59 feedback: remap = 1  active = %d  max-load-ratio = %.3f  over-max-frac = %.6f  severity = %.3f  raw-pressure-entries = %d  sink-pressure-entries = %d  pressure-capacity = %d\n",
   755	            Feedback > 0.0 && LoadStats.nPressureEntries > 0, LoadStats.RatioMax, OverFrac,
   756	            Feedback, LoadStats.nPressureEntries, LoadStats.nSinkPressureEntries,
   757	            LoadStats.nAigPressureRatios );
   758	        printf( "stmap59 blended-gain: base-gain = %.2f  blend-gain = %.2f  selected-gain = %.2f  severity-threshold = 0.850  raw-pressure-threshold = 8000  selected-blend-gain = %d\n",
   759	            Gain, LowGain, SelectedGain, fUseReducedGain );
   760	        Abc_Stmap59PrintBoundedPressures( &LoadStats, &BoundedStats );
   761	        printf( "stmap59 mapper-mode: bounded-pressure-transfer-mode = 57  blended-gain = %.2f  pressure-feed = %s  raw-weight = %.2f  bounded-ratio-cap = %.3f  inherited-cut-only-area-save-cap = 1.35x-inverter\n",
   762	            SelectedGain, fSevereTransfer ? "bounded-raw" : "sink-fallback",
   763	            ABC_STMAP59_BOUND_RAW_WEIGHT, ABC_STMAP59_BOUND_RATIO_CAP );
   764	        Abc_NtkDelete( pNtkFirst );
   765	        Map_Stmap45SetSclLoadFeedbackWithEntries( LoadStats.RatioMax, OverFrac, Feedback, pBoundedPressureRatios, LoadStats.nAigPressureRatios, BoundedStats.nEntries );
   766	        pNtkRes = Abc_NtkMap( pNtkMap, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, SelectedGain, nGatesMin, fRecovery, fSwitching, 57, fUseProfile, fUseBuffs, fVerbose );
   767	        Map_Stmap45SetSclLoadFeedbackWithEntries( 0.0, 0.0, 0.0, NULL, 0, 0 );
   768	        ABC_FREE( pBoundedPressureRatios );
   769	        Abc_Stmap59LoadStatsFree( &LoadStats );
   770	        if ( pNtkRes == NULL )
   771	        {
   772	            if ( fTempMap )
   773	                Abc_NtkDelete( pNtkMap );
