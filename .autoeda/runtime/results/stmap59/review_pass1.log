   581	    fUseProfile = 0;
   582	    fUseBuffs   = 0;
   583	    fVerbose    = 0;
   584	    Extra_UtilGetoptReset();
   585	    while ( ( c = Extra_UtilGetopt( argc, argv, "DABFSGMarspfuovh" ) ) != EOF )
   586	    {
   587	        switch ( c )
   588	        {
   589	        case 'D':
   590	            if ( globalUtilOptind >= argc )
   591	            {
   592	                Abc_Print( -1, "Command line switch \"-D\" should be followed by a floating point number.\n" );
   593	                goto usage;
   594	            }
   595	            DelayTarget = (float)atof(argv[globalUtilOptind]);
   596	            globalUtilOptind++;
   597	            if ( DelayTarget <= 0.0 )
   598	                goto usage;
   599	            break;
   600	        case 'A':
   601	            if ( globalUtilOptind >= argc )
   602	            {
   603	                Abc_Print( -1, "Command line switch \"-A\" should be followed by a floating point number.\n" );
   604	                goto usage;
   605	            }
   606	            AreaMulti = (float)atof(argv[globalUtilOptind]);
   607	            globalUtilOptind++;
   608	            break;
   609	        case 'B':
   610	            if ( globalUtilOptind >= argc )
   611	            {
   612	                Abc_Print( -1, "Command line switch \"-B\" should be followed by a floating point number.\n" );
   613	                goto usage;
   614	            }
   615	            DelayMulti = (float)atof(argv[globalUtilOptind]);
   616	            globalUtilOptind++;
   617	            break;
   618	        case 'F':
   619	            if ( globalUtilOptind >= argc )
   620	            {
   621	                Abc_Print( -1, "Command line switch \"-F\" should be followed by a floating point number.\n" );
   622	                goto usage;
   623	            }
   624	            LogFan = (float)atof(argv[globalUtilOptind]);
   625	            globalUtilOptind++;
   626	            if ( LogFan < 0.0 )
   627	                goto usage;
   628	            break;
   629	        case 'S':
