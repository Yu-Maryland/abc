   650	            break;
   651	        case 'M':
   652	            if ( globalUtilOptind >= argc )
   653	            {
   654	                Abc_Print( -1, "Command line switch \"-M\" should be followed by a positive integer.\n" );
   655	                goto usage;
   656	            }
   657	            nGatesMin = atoi(argv[globalUtilOptind]);
