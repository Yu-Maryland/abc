   102	static void Abc_Stmap59TopInsert( float * pRatios, int * pNodes, const char ** ppGates, int * pFanouts, float * pLoads, float * pCaps, float Ratio, int Node, const char * pGate, int Fanouts, float Load, float Cap )
   103	{
   104	    int i, k;
   105	    if ( Ratio <= pRatios[4] )
   106	        return;
   107	    for ( i = 0; i < 5; i++ )
   108	    {
   109	        if ( Ratio <= pRatios[i] )
   110	            continue;
   111	        for ( k = 4; k > i; k-- )
   112	        {
   113	            pRatios[k] = pRatios[k-1];
   114	            pNodes[k] = pNodes[k-1];
   115	            ppGates[k] = ppGates[k-1];
   116	            pFanouts[k] = pFanouts[k-1];
   117	            pLoads[k] = pLoads[k-1];
   118	            pCaps[k] = pCaps[k-1];
   119	        }
   120	        pRatios[i] = Ratio;
   121	        pNodes[i] = Node;
   122	        ppGates[i] = pGate;
   123	        pFanouts[i] = Fanouts;
   124	        pLoads[i] = Load;
   125	        pCaps[i] = Cap;
   126	        return;
   127	    }
   128	}
