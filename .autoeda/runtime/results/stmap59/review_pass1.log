   527	/**Function*************************************************************
   528	
   529	  Synopsis    [Runs the stmap59 mapper probe.]
   530	
   531	  Description [stmap59 repeats the stmap58 bounded transfer while tracking the
   532	  formerly useful stmap56 cut-only AIG ID 27645. The goal is to distinguish
   533	  whether the bounded table loses the cut-only seed because this AIG's raw
   534	  pressure is capped too low, its sink fallback creates paired evidence, or it
   535	  is absent from the first-pass pressure table.]
   536	
   537	  SideEffects []
   538	
   539	  SeeAlso     []
   540	
   541	***********************************************************************/
   542	int Abc_CommandStmap59( Abc_Frame_t * pAbc, int argc, char ** argv )
   543	{
   544	    Abc_Ntk_t * pNtk, * pNtkMap, * pNtkRes, * pNtkFirst;
   545	    Abc_Stmap59LoadStats_t LoadStats;
   546	    Abc_Stmap59BoundedStats_t BoundedStats;
   547	    float * pBoundedPressureRatios = NULL;
   548	    char Buffer[100];
   549	    double DelayTarget;
   550	    double AreaMulti;
   551	    double DelayMulti;
   552	    float LogFan = 0;
   553	    float Slew = 0; // choose based on the library
   554	    float Gain = 250; // base SCL/genlib gain for low and moderate pressure
   555	    float LowGain, SelectedGain;
   556	    int nGatesMin = 0;
   557	    int fAreaOnly;
   558	    int fRecovery;
   559	    int fSweep;
   560	    int fSwitching;
   561	    int fSkipFanout;
   562	    int fUseProfile;
   563	    int fUseBuffs;
   564	    int fVerbose;
   565	    int c, fTempMap = 0;
