    63	/**Function*************************************************************
    64	
    65	  Synopsis    [Runs the stmap81 watched-parent phase-retention probe.]
    66	
    67	  Description [stmap81 reuses stmap80 diagnostics and enables a narrow
    68	  final-pass mapper policy probe: for the configured downstream parent, exact
    69	  or phase-aware area recovery may keep a child-phase-0 candidate when it is
    70	  within a small timing and area-premium window of the current best cut.]
    71	
    72	  SideEffects []
    73	
    74	  SeeAlso     []
    75	
    76	***********************************************************************/
    77	int Abc_CommandStmap81( Abc_Frame_t * pAbc, int argc, char ** argv )
    78	{
    79	    Abc_Ntk_t * pNtk, * pNtkRes;
    80	    int i, RetValue, ChildAigId, ParentAigId, WatchAigs[1];
    81	    extern int Abc_CommandStmap65( Abc_Frame_t * pAbc, int argc, char ** argv );
    82	    extern void Map_Stmap75SetFinalCriticalAigDiag( int fEnable, int WatchAigId );
    83	    extern void Map_Stmap75SetFinalCriticalAigDiagLabel( const char * pLabel );
    84	    extern void Map_Stmap75PrintFinalCriticalAigSummary( void );
    85	    extern void Abc_Stmap74EnableFinalCriticalScope( Abc_Ntk_t * pNtk, const char * pLabel );
    86	    extern void Abc_Stmap76EnablePhaseSurvivalScope( Abc_Ntk_t * pNtk, const char * pLabel, int * pWatchAigIds, int nWatchAigs );
    87	    extern void Abc_Stmap77SetReconstructionDiag( int fEnable, const char * pLabel, int * pWatchAigIds, int nWatchAigs );
    88	    extern void Abc_Stmap77PrintReconstructionSummary( void );
    89	    extern void Abc_Stmap78SetDemandPathDiag( int fEnable, const char * pLabel, int WatchAigId, int DownstreamAigId );
    90	    extern void Abc_Stmap78PrintDemandPathSummary( void );
    91	    extern void Abc_Stmap79SetParentCutDiag( int fEnable, const char * pLabel, int ChildAigId, int ParentAigId );
    92	    extern void Abc_Stmap79PrintParentCutSummary( void );
    93	    extern void Map_Stmap80SetCandidateCutDiag( int fEnable, const char * pLabel, int ParentAigId, int ChildAigId );
    94	    extern void Map_Stmap80PrintCandidateCutSummary( void );
    95	    extern void Map_Stmap81SetParentPhaseBias( int fEnable, const char * pLabel, int ParentAigId, int ChildAigId );
    96	    extern void Map_Stmap81PrintParentPhaseBiasSummary( void );
    97	
    98	    for ( i = 1; i < argc; i++ )
    99	    {
   100	        if ( !strcmp( argv[i], "-h" ) )
   101	            goto usage;
   102	    }
   103	
   104	    pNtk = Abc_FrameReadNtk( pAbc );
   105	    Abc_Stmap81WatchAigsForNetwork( pNtk, &ChildAigId, &ParentAigId );
   106	    WatchAigs[0] = ChildAigId;
   107	    printf( "stmap81 diagnostic: inherited-policy = stmap65  mapper-selected-match-watch = %d  network = %s  child-aig = %d  parent-aig = %d  source = stmap80-parent-phase0-policy-probe  reconstruction-phase-trace = 1  demand-path-trace = 1  parent-cut-trace = 1  candidate-cut-trace = 1  parent-phase-bias = 1  final-phase-survival = 1  mapping-policy-change = watched-parent-child-phase0-window\n",
   108	        ChildAigId >= 0, pNtk && Abc_NtkName(pNtk) ? Abc_NtkName(pNtk) : "?",
   109	        ChildAigId, ParentAigId );
   110	    Map_Stmap75SetFinalCriticalAigDiag( ChildAigId >= 0, ChildAigId );
   111	    Map_Stmap75SetFinalCriticalAigDiagLabel( "stmap81" );
   112	    Abc_Stmap77SetReconstructionDiag( ChildAigId >= 0, "stmap81", WatchAigs, ChildAigId >= 0 ? 1 : 0 );
   113	    Abc_Stmap78SetDemandPathDiag( ChildAigId >= 0, "stmap81", ChildAigId, ParentAigId );
   114	    Abc_Stmap79SetParentCutDiag( ChildAigId >= 0, "stmap81", ChildAigId, ParentAigId );
   115	    Map_Stmap80SetCandidateCutDiag( ChildAigId >= 0, "stmap81", ParentAigId, ChildAigId );
   116	    Map_Stmap81SetParentPhaseBias( ChildAigId >= 0, "stmap81", ParentAigId, ChildAigId );
   117	    RetValue = Abc_CommandStmap65( pAbc, argc, argv );
   118	    Abc_Stmap77PrintReconstructionSummary();
   119	    Abc_Stmap78PrintDemandPathSummary();
   120	    Abc_Stmap79PrintParentCutSummary();
   121	    Map_Stmap80PrintCandidateCutSummary();
   122	    Map_Stmap81PrintParentPhaseBiasSummary();
   123	    Map_Stmap81SetParentPhaseBias( 0, "stmap81", -1, -1 );
   124	    Map_Stmap80SetCandidateCutDiag( 0, "stmap81", -1, -1 );
   125	    Abc_Stmap79SetParentCutDiag( 0, "stmap81", -1, -1 );
   126	    Abc_Stmap78SetDemandPathDiag( 0, "stmap81", -1, -1 );
   127	    Abc_Stmap77SetReconstructionDiag( 0, "stmap81", NULL, 0 );
   128	    Map_Stmap75PrintFinalCriticalAigSummary();
   129	    Map_Stmap75SetFinalCriticalAigDiag( 0, -1 );
   130	    if ( RetValue == 0 )
   131	    {
   132	        pNtkRes = Abc_FrameReadNtk( pAbc );
   133	        Abc_Stmap74EnableFinalCriticalScope( pNtkRes, "stmap81" );
   134	        Abc_Stmap76EnablePhaseSurvivalScope( pNtkRes, "stmap81", WatchAigs, ChildAigId >= 0 ? 1 : 0 );
   135	    }
   136	    return RetValue;
   137	
   138	usage:
   139	    Abc_Print( -2, "usage: stmap81 [-DABFSG float] [-M num] [-arspfuovh]\n" );
   140	    Abc_Print( -2, "\t              performs stmap81 bounded-pressure mapping with a watched-parent child-phase-0 policy probe\n" );
   141	    Abc_Print( -2, "\t-D float : sets the global required times [default = not used]\n" );
   142	    Abc_Print( -2, "\t-A float : \"area multiplier\" to bias gate selection [default = 0.00]\n" );
   143	    Abc_Print( -2, "\t-B float : \"delay multiplier\" to bias gate selection [default = 0.00]\n" );
   144	    Abc_Print( -2, "\t-F float : the logarithmic fanout delay parameter [default = 0.00]\n" );
   145	    Abc_Print( -2, "\t-S float : the slew parameter used to generate the library [default = 0.00]\n" );
   146	    Abc_Print( -2, "\t-G float : the SCL/genlib gain parameter used to generate the library [default = 250.00]\n" );
   147	    Abc_Print( -2, "\t-M num   : skip gate classes whose size is less than this [default = 0]\n" );
   148	    Abc_Print( -2, "\t-a       : toggles area-only mapping [default = no]\n" );
   149	    Abc_Print( -2, "\t-r       : toggles area recovery [default = yes]\n" );
   150	    Abc_Print( -2, "\t-s       : toggles sweep after mapping [default = no]\n" );
   151	    Abc_Print( -2, "\t-p       : optimizes power by minimizing switching [default = no]\n" );
   152	    Abc_Print( -2, "\t-f       : disables the bounded-pressure SCL feedback mapper mode [default = yes]\n" );
   153	    Abc_Print( -2, "\t-u       : use standard-cell profile [default = no]\n" );
   154	    Abc_Print( -2, "\t-o       : toggles using buffers to decouple combinational outputs [default = no]\n" );
   155	    Abc_Print( -2, "\t-v       : toggles verbose output [default = no]\n" );
   156	    Abc_Print( -2, "\t-h       : print the command usage\n" );
   157	    return 1;
   158	}
