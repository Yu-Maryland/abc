    20	static int Abc_Stmap81WatchAigsForNetwork( Abc_Ntk_t * pNtk, int * pChildAig, int * pParentAig )
    21	{
    22	    char * pName = pNtk ? Abc_NtkName(pNtk) : NULL;
    23	    char * pBase, * pSlash, * pBackslash;
    24	    *pChildAig = -1;
    25	    *pParentAig = -1;
    26	    if ( pName == NULL )
    27	        return 0;
    28	    pSlash = strrchr( pName, '/' );
    29	    pBackslash = strrchr( pName, '\\' );
    30	    if ( pSlash && (!pBackslash || pSlash > pBackslash) )
    31	        pBase = pSlash + 1;
    32	    else if ( pBackslash )
    33	        pBase = pBackslash + 1;
    34	    else
    35	        pBase = pName;
    36	    if ( !strcmp( pBase, "i10" ) )
    37	    {
    38	        *pChildAig = 855;
    39	        *pParentAig = 861;
    40	        return 1;
    41	    }
    42	    if ( !strcmp( pBase, "ode" ) )
    43	    {
    44	        *pChildAig = 5219;
    45	        *pParentAig = 5229;
    46	        return 1;
    47	    }
    48	    if ( !strcmp( pBase, "or1200_flat" ) || !strcmp( pBase, "or1200" ) )
    49	    {
    50	        *pChildAig = 11491;
    51	        *pParentAig = 13829;
    52	        return 1;
    53	    }
    54	    if ( !strcmp( pBase, "syn2" ) )
    55	    {
    56	        *pChildAig = 18002;
    57	        *pParentAig = 18467;
    58	        return 1;
    59	    }
    60	    return 0;
    61	}
