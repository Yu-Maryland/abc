int Abc_CommandStmap46( Abc_Frame_t * pAbc, int argc, char ** argv )
{
    Abc_Ntk_t * pNtk, * pNtkMap, * pNtkRes, * pNtkFirst;
    Abc_Stmap46LoadStats_t LoadStats;
    char Buffer[100];
