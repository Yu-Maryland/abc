  6789	/**Function*************************************************************
  6790	
  6791	  Synopsis    [Find the best matching of the cut.]
  6792	
  6793	  Description [The parameters: the node (pNode), the cut (pCut), the phase to be matched 
  6794	  (fPhase), and the upper bound on the arrival times of the cut (fWorstLimit). This 
  6795	  procedure goes through the matching supergates up to the phase assignment, and selects the
  6796	  best supergate, which will be used to map the cut. As a result of calling this procedure
  6797	  the matching information is written into pMatch.]
  6798	               
  6799	  SideEffects []
  6800	
  6801	  SeeAlso     []
  6802	
  6803	***********************************************************************/
  6804	int Map_MatchNodeCut( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase, float fWorstLimit )
  6805	{
  6806	    Map_Match_t MatchBest, * pMatch = pCut->M + fPhase;
  6807	    Map_Super_t * pSuper;
  6808	    int i, Counter;
  6809	
  6810	    // save the current match of the cut
  6811	    MatchBest = *pMatch;
  6812	    // go through the supergates
  6813	    for ( pSuper = pMatch->pSupers, Counter = 0; pSuper; pSuper = pSuper->pNext, Counter++ )
  6814	    {
  6815	        p->nMatches++;
  6816	        // this is an attempt to reduce the runtime of matching and area 
  6817	        // at the cost of rare and very minor increase in delay
  6818	        // (the supergates are sorted by increasing area)
  6819	        if ( Counter == 30 )
  6820	           break;
  6821	
  6822	        // go through different phases of the given match and supergate
  6823	        pMatch->pSuperBest = pSuper;
  6824	        for ( i = 0; i < (int)pSuper->nPhases; i++ )
  6825	        {
  6826	            p->nPhases++;
  6827	            // find the overall phase of this match
  6828	            pMatch->uPhaseBest = pMatch->uPhase ^ pSuper->uPhases[i];
  6829	            if ( p->fMappingMode == 0 )
  6830	            {
  6831	                // get the arrival time
  6832	                Map_TimeCutComputeArrival( pNode, pCut, fPhase, fWorstLimit );
  6833	                // skip the cut if the arrival times exceed the required times
  6834	                if ( pMatch->tArrive.Worst > fWorstLimit + p->fEpsilon )
  6835	                    continue;
  6836	                // get the area (area flow)
  6837	                pMatch->AreaFlow = Map_CutGetAreaFlow( pCut, fPhase );
  6838	            }
  6839	            else
  6840	            {
  6841	                // get the area (area flow)
  6842	                if ( p->fMappingMode == 2 || p->fMappingMode == 3 )
  6843	                    pMatch->AreaFlow = Map_CutGetAreaDerefed( pCut, fPhase );
  6844	                else if ( p->fMappingMode == 4 )
  6845	                    pMatch->AreaFlow = Map_SwitchCutGetDerefed( pNode, pCut, fPhase );
  6846	                else 
  6847	                    pMatch->AreaFlow = Map_CutGetAreaFlow( pCut, fPhase );
  6848	                // skip if the cut is too large
  6849	                if ( pMatch->AreaFlow > MatchBest.AreaFlow + p->fEpsilon )
  6850	                    continue;
  6851	                // get the arrival time
  6852	                Map_TimeCutComputeArrival( pNode, pCut, fPhase, fWorstLimit );
  6853	                // skip the cut if the arrival times exceed the required times
  6854	                if ( pMatch->tArrive.Worst > fWorstLimit + p->fEpsilon )
  6855	                    continue;
  6856	            }
  6857	
  6858	            // if the cut is non-trivial, compare it
  6859	            if ( Map_MatchCompare( p, &MatchBest, pMatch, p->fMappingMode ) )
  6860	            {
  6861	                MatchBest = *pMatch;
  6862	                // if we are mapping for delay, the worst-case limit should be reduced
  6863	                if ( p->fMappingMode == 0 )
  6864	                    fWorstLimit = MatchBest.tArrive.Worst;
  6865	            }
  6866	        }
  6867	    }
  6868	    // set the best match
  6869	    *pMatch = MatchBest;
  6870	
  6871	    // recompute the arrival time and area (area flow) of this cut
  6872	    if ( pMatch->pSuperBest )
  6873	    {
  6874	        Map_TimeCutComputeArrival( pNode, pCut, fPhase, MAP_FLOAT_LARGE );
  6875	        if ( p->fMappingMode == 2 || p->fMappingMode == 3 )
  6876	            pMatch->AreaFlow = Map_CutGetAreaDerefed( pCut, fPhase );
  6877	        else if ( p->fMappingMode == 4 )
  6878	            pMatch->AreaFlow = Map_SwitchCutGetDerefed( pNode, pCut, fPhase );
  6879	        else 
  6880	            pMatch->AreaFlow = Map_CutGetAreaFlow( pCut, fPhase );
  6881	    }
  6882	    return 1;
  6883	}
