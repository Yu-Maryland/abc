    73	/**Function*************************************************************
    74	
    75	  Synopsis    [Runs the stmap92 final-critical emitted-AIG drive/load target probe.]
    76	
    77	  Description [stmap92 targets the AIG/phase that survives into final critical
    78	  timing and prefers same-phase mapper alternatives with a better drive/load
    79	  proxy.]
    80	
    81	  SideEffects []
    82	
    83	  SeeAlso     []
    84	
    85	***********************************************************************/
    86	int Abc_CommandStmap92( Abc_Frame_t * pAbc, int argc, char ** argv )
    87	{
    88	    Abc_Ntk_t * pNtk, * pNtkRes;
    89	    int i, RetValue, ChildAigId, ParentAigId, ChildPhase, ParentPhase, WatchAigs[2], nWatchAigs = 0;
    90	    extern int Abc_CommandStmap65( Abc_Frame_t * pAbc, int argc, char ** argv );
    91	    extern void Map_Stmap75SetFinalCriticalAigDiag( int fEnable, int WatchAigId );
