    97	    extern void Abc_Stmap77SetReconstructionDiag( int fEnable, const char * pLabel, int * pWatchAigIds, int nWatchAigs );
    98	    extern void Abc_Stmap77PrintReconstructionSummary( void );
    99	    extern void Abc_Stmap78SetDemandPathDiag( int fEnable, const char * pLabel, int WatchAigId, int DownstreamAigId );
   100	    extern void Abc_Stmap78PrintDemandPathSummary( void );
   101	    extern void Abc_Stmap79SetParentCutDiag( int fEnable, const char * pLabel, int ChildAigId, int ParentAigId );
   102	    extern void Abc_Stmap79PrintParentCutSummary( void );
   103	    extern void Map_Stmap80SetCandidateCutDiag( int fEnable, const char * pLabel, int ParentAigId, int ChildAigId );
   104	    extern void Map_Stmap80PrintCandidateCutSummary( void );
   105	    extern void Map_Stmap92SetEmittedDriveTarget( int fEnable, const char * pLabel, int AigId, int Phase );
   106	    extern void Map_Stmap92PrintEmittedDriveTargetSummary( void );
   107	
   108	    for ( i = 1; i < argc; i++ )
   109	    {
   110	        if ( !strcmp( argv[i], "-h" ) )
   111	            goto usage;
   112	    }
   113	
   114	    pNtk = Abc_FrameReadNtk( pAbc );
   115	    Abc_Stmap92WatchAigsForNetwork( pNtk, &ChildAigId, &ParentAigId, &ChildPhase, &ParentPhase );
   116	    if ( ChildAigId >= 0 )
   117	        WatchAigs[nWatchAigs++] = ChildAigId;
   118	    if ( ParentAigId >= 0 )
   119	        WatchAigs[nWatchAigs++] = ParentAigId;
   120	    printf( "stmap92 diagnostic: inherited-policy = stmap65  mapper-selected-match-watch = %d  network = %s  final-critical-aig = %d  downstream-aig = %d  selected-watch-count = %d  dual-phase-survival-watch-count = %d  emitted-drive-target = %d  target-phase = %d  source = stmap92-final-critical-emitted-drive-load-policy-probe  reconstruction-phase-trace = 1  demand-path-trace = 1  parent-cut-trace = 1  candidate-cut-trace = 1  final-phase-survival = 1  mapping-policy-change = watched-final-critical-emitted-drive-load-target\n",
   121	        nWatchAigs > 0, pNtk && Abc_NtkName(pNtk) ? Abc_NtkName(pNtk) : "?",
   122	        ChildAigId, ParentAigId, nWatchAigs, nWatchAigs,
   123	        ChildAigId >= 0, ChildPhase );
   124	    Map_Stmap75SetFinalCriticalAigDiagArray( nWatchAigs > 0, WatchAigs, nWatchAigs );
   125	    Map_Stmap75SetFinalCriticalAigDiagLabel( "stmap92" );
   126	    Abc_Stmap77SetReconstructionDiag( nWatchAigs > 0, "stmap92", WatchAigs, nWatchAigs );
   127	    Abc_Stmap78SetDemandPathDiag( ChildAigId >= 0, "stmap92", ChildAigId, ParentAigId );
   128	    Abc_Stmap79SetParentCutDiag( ChildAigId >= 0, "stmap92", ChildAigId, ParentAigId );
   129	    Map_Stmap80SetCandidateCutDiag( ChildAigId >= 0, "stmap92", ParentAigId, ChildAigId );
   130	    Map_Stmap92SetEmittedDriveTarget( ChildAigId >= 0, "stmap92", ChildAigId, ChildPhase );
   131	    RetValue = Abc_CommandStmap65( pAbc, argc, argv );
   132	    Abc_Stmap77PrintReconstructionSummary();
   133	    Abc_Stmap78PrintDemandPathSummary();
   134	    Abc_Stmap79PrintParentCutSummary();
   135	    Map_Stmap80PrintCandidateCutSummary();
   136	    Map_Stmap92PrintEmittedDriveTargetSummary();
   137	    Map_Stmap92SetEmittedDriveTarget( 0, "stmap92", -1, 0 );
   138	    Map_Stmap80SetCandidateCutDiag( 0, "stmap92", -1, -1 );
   139	    Abc_Stmap79SetParentCutDiag( 0, "stmap92", -1, -1 );
   140	    Abc_Stmap78SetDemandPathDiag( 0, "stmap92", -1, -1 );
   141	    Abc_Stmap77SetReconstructionDiag( 0, "stmap92", NULL, 0 );
   142	    Map_Stmap75PrintFinalCriticalAigSummary();
   143	    Map_Stmap75SetFinalCriticalAigDiag( 0, -1 );
   144	    if ( RetValue == 0 )
   145	    {
   146	        pNtkRes = Abc_FrameReadNtk( pAbc );
   147	        Abc_Stmap74EnableFinalCriticalScope( pNtkRes, "stmap92" );
   148	        Abc_Stmap76EnablePhaseSurvivalScope( pNtkRes, "stmap92", WatchAigs, nWatchAigs );
   149	    }
   150	    return RetValue;
   151	
   152	usage:
   153	    Abc_Print( -2, "usage: stmap92 [-DABFSG float] [-M num] [-arspfuovh]\n" );
   154	    Abc_Print( -2, "\t              performs stmap92 bounded-pressure mapping with benchmark-specific final-critical emitted-AIG drive/load targeting\n" );
   155	    Abc_Print( -2, "\t-D float : sets the global required times [default = not used]\n" );
   156	    Abc_Print( -2, "\t-A float : \"area multiplier\" to bias gate selection [default = 0.00]\n" );
   157	    Abc_Print( -2, "\t-B float : \"delay multiplier\" to bias gate selection [default = 0.00]\n" );
   158	    Abc_Print( -2, "\t-F float : the logarithmic fanout delay parameter [default = 0.00]\n" );
   159	    Abc_Print( -2, "\t-S float : the slew parameter used to generate the library [default = 0.00]\n" );
   160	    Abc_Print( -2, "\t-G float : the SCL/genlib gain parameter used to generate the library [default = 250.00]\n" );
   161	    Abc_Print( -2, "\t-M num   : skip gate classes whose size is less than this [default = 0]\n" );
   162	    Abc_Print( -2, "\t-a       : toggles area-only mapping [default = no]\n" );
   163	    Abc_Print( -2, "\t-r       : toggles area recovery [default = yes]\n" );
   164	    Abc_Print( -2, "\t-s       : toggles sweep after mapping [default = no]\n" );
   165	    Abc_Print( -2, "\t-p       : optimizes power by minimizing switching [default = no]\n" );
   166	    Abc_Print( -2, "\t-f       : disables the bounded-pressure SCL feedback mapper mode [default = yes]\n" );
   167	    Abc_Print( -2, "\t-u       : use standard-cell profile [default = no]\n" );
   168	    Abc_Print( -2, "\t-o       : toggles using buffers to decouple combinational outputs [default = no]\n" );
   169	    Abc_Print( -2, "\t-v       : toggles verbose output [default = no]\n" );
   170	    Abc_Print( -2, "\t-h       : print the command usage\n" );
   171	    return 1;
   172	}
