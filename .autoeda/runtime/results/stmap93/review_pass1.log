  6718	int Map_MatchCompare( Map_Man_t * pMan, Map_Match_t * pM1, Map_Match_t * pM2, int fDoingArea )
  6719	{
  6720	//    if ( pM1->pSuperBest == pM2->pSuperBest )
  6721	//        return 0;
  6722	    if ( !fDoingArea )
  6723	    {
  6724	        // compare the arrival times
  6725	        if ( pM1->tArrive.Worst < pM2->tArrive.Worst - pMan->fEpsilon )
  6726	            return 0;
  6727	        if ( pM1->tArrive.Worst > pM2->tArrive.Worst + pMan->fEpsilon )
  6728	            return 1;
  6729	        // compare the areas or area flows
  6730	        if ( pM1->AreaFlow < pM2->AreaFlow - pMan->fEpsilon )
  6731	            return 0;
  6732	        if ( pM1->AreaFlow > pM2->AreaFlow + pMan->fEpsilon )
  6733	            return 1;
  6734	        // compare the fanout limits
  6735	        if ( pM1->pSuperBest->nFanLimit > pM2->pSuperBest->nFanLimit )
  6736	            return 0;
  6737	        if ( pM1->pSuperBest->nFanLimit < pM2->pSuperBest->nFanLimit )
  6738	            return 1;
  6739	        // compare the number of leaves
  6740	        if ( pM1->pSuperBest->nFanins < pM2->pSuperBest->nFanins )
  6741	            return 0;
  6742	        if ( pM1->pSuperBest->nFanins > pM2->pSuperBest->nFanins )
  6743	            return 1;
  6744	        // otherwise prefer the old cut
  6745	        return 0;
  6746	    }
  6747	    else
  6748	    {
  6749	        // compare the areas or area flows
  6750	        if ( pM1->AreaFlow < pM2->AreaFlow - pMan->fEpsilon )
  6751	            return 0;
  6752	        if ( pM1->AreaFlow > pM2->AreaFlow + pMan->fEpsilon )
  6753	            return 1;
  6754	
  6755	        // make decision based on cell profile
  6756	        if ( pMan->fUseProfile && pM1->pSuperBest && pM1->pSuperBest )
  6757	        {
  6758	            int M1req = Mio_GateReadProfile(pM1->pSuperBest->pRoot);
  6759	            int M2req = Mio_GateReadProfile(pM2->pSuperBest->pRoot);
  6760	            int M1act = Mio_GateReadProfile2(pM1->pSuperBest->pRoot);
  6761	            int M2act = Mio_GateReadProfile2(pM2->pSuperBest->pRoot);
  6762	            //printf( "%d %d  ", M1req, M2req );
  6763	            if ( M1act < M1req && M2act > M2req )
  6764	                return 0;
  6765	            if ( M2act < M2req && M1act > M1req )
  6766	                return 1;
  6767	        }
  6768	
  6769	        // compare the arrival times
  6770	        if ( pM1->tArrive.Worst < pM2->tArrive.Worst - pMan->fEpsilon )
  6771	            return 0;
  6772	        if ( pM1->tArrive.Worst > pM2->tArrive.Worst + pMan->fEpsilon )
  6773	            return 1;
  6774	        // compare the fanout limits
  6775	        if ( pM1->pSuperBest->nFanLimit > pM2->pSuperBest->nFanLimit )
  6776	            return 0;
  6777	        if ( pM1->pSuperBest->nFanLimit < pM2->pSuperBest->nFanLimit )
  6778	            return 1;
  6779	        // compare the number of leaves
  6780	        if ( pM1->pSuperBest->nFanins < pM2->pSuperBest->nFanins )
  6781	            return 0;
  6782	        if ( pM1->pSuperBest->nFanins > pM2->pSuperBest->nFanins )
  6783	            return 1;
  6784	        // otherwise prefer the old cut
  6785	        return 0;
  6786	    }
  6787	}
