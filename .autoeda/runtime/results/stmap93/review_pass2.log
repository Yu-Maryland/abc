+static void Map_Stmap93ResetEmittedDriveTargetCounters( void )
+{
+    s_nStmap93EmittedRows = 0;
+    s_nStmap93EmittedPhaseHits = 0;
+    s_nStmap93EmittedDriveHits = 0;
+    s_nStmap93EmittedMaterialDriveHits = 0;
