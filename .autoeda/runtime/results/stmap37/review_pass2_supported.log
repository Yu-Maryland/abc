#include "base/abc/abc.h"
#include "base/main/main.h"
#include "map/mio/mio.h"
#include "map/scl/sclLib.h"
#include "misc/extra/extra.h"
#include <string.h>

ABC_NAMESPACE_IMPL_START

#define ABC_STMAP37_MAX_HOTSPOTS 64

typedef struct Abc_Stmap37LoadStats_t_
{
    int fAvailable;
    int nNodes;
    int nMatched;
    int nPins;
    int nOver;
    int nHotspotRoots;
    int nHotspotCone;
    int nHotspots;
    float RatioSum;
    float RatioMax;
    float TopRatios[5];
    float TopLoads[5];
    float TopCaps[5];
    const char * pTopGates[5];
    int TopNodes[5];
    int TopFanouts[5];
    int HotspotAigIds[ABC_STMAP37_MAX_HOTSPOTS];
    int HotspotNodes[ABC_STMAP37_MAX_HOTSPOTS];
    float HotspotRatios[ABC_STMAP37_MAX_HOTSPOTS];
} Abc_Stmap37LoadStats_t;

static void Abc_Stmap37LoadStatsClear( Abc_Stmap37LoadStats_t * pStats )
{
    memset( pStats, 0, sizeof(Abc_Stmap37LoadStats_t) );
}

/**Function*************************************************************

  Synopsis    [Inserts one mapped-load diagnostic into the top list.]

  Description []

  SideEffects []

  SeeAlso     []

***********************************************************************/
static void Abc_Stmap37TopInsert( float * pRatios, int * pNodes, const char ** ppGates, int * pFanouts, float * pLoads, float * pCaps, float Ratio, int Node, const char * pGate, int Fanouts, float Load, float Cap )
{
    int i, k;
    if ( Ratio <= pRatios[4] )
        return;
    for ( i = 0; i < 5; i++ )
    {
        if ( Ratio <= pRatios[i] )
            continue;
        for ( k = 4; k > i; k-- )
        {
            pRatios[k] = pRatios[k-1];
            pNodes[k] = pNodes[k-1];
            ppGates[k] = ppGates[k-1];
            pFanouts[k] = pFanouts[k-1];
            pLoads[k] = pLoads[k-1];
            pCaps[k] = pCaps[k-1];
        }
        pRatios[i] = Ratio;
        pNodes[i] = Node;
        ppGates[i] = pGate;
        pFanouts[i] = Fanouts;
        pLoads[i] = Load;
        pCaps[i] = Cap;
        return;
    }
}

static int Abc_Stmap37MappedObjAigId( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj )
{
    int Lit;
    if ( pNtk == NULL || pObj == NULL || pNtk->vOrigNodeIds == NULL )
        return -1;
    if ( Abc_ObjId(pObj) >= Vec_IntSize(pNtk->vOrigNodeIds) )
        return -1;
    Lit = Vec_IntEntry( pNtk->vOrigNodeIds, Abc_ObjId(pObj) );
    return Lit >= 0 ? Abc_Lit2Var(Lit) : -1;
}

static void Abc_Stmap37HotspotInsert( Abc_Stmap37LoadStats_t * pStats, int AigId, int NodeId, float Ratio )
{
    int i, k, iMin;
    if ( AigId < 0 || Ratio <= 1.0 )
        return;
    for ( i = 0; i < pStats->nHotspots; i++ )
    {
        if ( pStats->HotspotAigIds[i] != AigId )
            continue;
        if ( Ratio > pStats->HotspotRatios[i] )
        {
            pStats->HotspotRatios[i] = Ratio;
            pStats->HotspotNodes[i] = NodeId;
        }
        return;
    }
    if ( pStats->nHotspots < ABC_STMAP37_MAX_HOTSPOTS )
    {
        i = pStats->nHotspots++;
        pStats->HotspotAigIds[i] = AigId;
        pStats->HotspotNodes[i] = NodeId;
        pStats->HotspotRatios[i] = Ratio;
        for ( k = i; k > 0 && pStats->HotspotRatios[k] > pStats->HotspotRatios[k-1]; k-- )
        {
            ABC_SWAP( int, pStats->HotspotAigIds[k], pStats->HotspotAigIds[k-1] );
            ABC_SWAP( int, pStats->HotspotNodes[k], pStats->HotspotNodes[k-1] );
            ABC_SWAP( float, pStats->HotspotRatios[k], pStats->HotspotRatios[k-1] );
        }
        return;
    }
    iMin = 0;
    for ( i = 1; i < pStats->nHotspots; i++ )
        if ( pStats->HotspotRatios[i] < pStats->HotspotRatios[iMin] )
            iMin = i;
    if ( Ratio <= pStats->HotspotRatios[iMin] )
        return;
    pStats->HotspotAigIds[iMin] = AigId;
    pStats->HotspotNodes[iMin] = NodeId;
    pStats->HotspotRatios[iMin] = Ratio;
    for ( i = 0; i < pStats->nHotspots; i++ )
    {
        for ( k = i + 1; k < pStats->nHotspots; k++ )
        {
            if ( pStats->HotspotRatios[i] >= pStats->HotspotRatios[k] )
                continue;
            ABC_SWAP( int, pStats->HotspotAigIds[i], pStats->HotspotAigIds[k] );
            ABC_SWAP( int, pStats->HotspotNodes[i], pStats->HotspotNodes[k] );
            ABC_SWAP( float, pStats->HotspotRatios[i], pStats->HotspotRatios[k] );
        }
    }
}

static void Abc_Stmap37CollectHotspotCone( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap37LoadStats_t * pStats, float Ratio )
{
    Abc_Obj_t * pFanin;
    int i, AigId;
    if ( Ratio <= 1.0 )
        return;
    AigId = Abc_Stmap37MappedObjAigId( pNtk, pObj );
    if ( AigId >= 0 )
    {
        pStats->nHotspotRoots++;
        Abc_Stmap37HotspotInsert( pStats, AigId, Abc_ObjId(pObj), Ratio );
    }
    Abc_ObjForEachFanin( pObj, pFanin, i )
    {
        AigId = Abc_Stmap37MappedObjAigId( pNtk, pFanin );
        if ( AigId < 0 )
            continue;
        pStats->nHotspotCone++;
        Abc_Stmap37HotspotInsert( pStats, AigId, Abc_ObjId(pFanin), 0.85 * Ratio );
    }
}

