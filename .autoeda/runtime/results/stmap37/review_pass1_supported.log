   763	static float Map_MatchStmap36StrongPenaltyFactor( Map_Node_t * pNode, Map_Cut_t * pCut, Map_Match_t * pMatch, float ArrivalDelta, float ArrivalGainMargin, float Slack, float SlackMargin, float Epsilon, float * pLeafLoadAvg, float * pLoadDriveRatio, int * pFanLimit )
   764	{
   765	    float Penalty, LoadDriveRatio;
   766	    Penalty = Map_MatchStmap34StrongPenaltyFactor( pNode, pCut, pMatch, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon, pLeafLoadAvg, pLoadDriveRatio, pFanLimit );
   767	    LoadDriveRatio = pLoadDriveRatio ? *pLoadDriveRatio : 0.0;
   768	    if ( Penalty > 0.0 && s_Stmap36SclFeedback > 0.0 && LoadDriveRatio > 1.0 )
   769	        Penalty += 0.03 * s_Stmap36SclFeedback * (LoadDriveRatio - 1.0) / LoadDriveRatio;
   770	    return Penalty > 0.75 ? 0.75 : Penalty;
   771	}
