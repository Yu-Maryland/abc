   176	/**Function*************************************************************
   177	
   178	  Synopsis    [Returns direct SCL input-pin load driven by a mapped node.]
   179	
   180	  Description []
   181	
   182	  SideEffects []
   183	
   184	  SeeAlso     []
   185	
   186	***********************************************************************/
   187	static float Abc_Stmap37FanoutLoad( SC_Lib * pLib, Abc_Obj_t * pObj, int * pFanouts, int * pPins )
   188	{
   189	    Abc_Obj_t * pFanout;
   190	    Mio_Gate_t * pGateFan;
   191	    SC_Cell * pCellFan;
   192	    float Load = 0.0;
   193	    int i, iFanin, CellId;
   194	    *pFanouts = 0;
   195	    *pPins = 0;
   196	    Abc_ObjForEachFanout( pObj, pFanout, i )
   197	    {
   198	        (*pFanouts)++;
   199	        if ( !Abc_ObjIsNode(pFanout) || pFanout->pData == NULL )
   200	            continue;
   201	        iFanin = Abc_NodeFindFanin( pFanout, pObj );
   202	        if ( iFanin < 0 )
   203	            continue;
   204	        pGateFan = (Mio_Gate_t *)pFanout->pData;
   205	        CellId = Abc_SclCellFind( pLib, Mio_GateReadName(pGateFan) );
   206	        if ( CellId < 0 )
   207	            continue;
   208	        pCellFan = SC_LibCell( pLib, CellId );
   209	        if ( pCellFan == NULL || iFanin >= pCellFan->n_inputs )
   210	            continue;
   211	        Load += SC_CellPinCap( pCellFan, iFanin );
   212	        (*pPins)++;
   213	    }
   214	    return Load;
   215	}
   216	
   217	/**Function*************************************************************
   218	
   219	  Synopsis    [Prints direct SCL load diagnostics for the mapped network.]
   220	
   221	  Description []
   222	
   223	  SideEffects []
   224	
   225	  SeeAlso     []
   226	
   227	***********************************************************************/
   228	static void Abc_Stmap37CollectSclLoadStats( Abc_Ntk_t * pNtk, Abc_Stmap37LoadStats_t * pStats )
   229	{
   230	    SC_Lib * pLib = (SC_Lib *)Abc_FrameReadLibScl();
   231	    Abc_Obj_t * pObj;
   232	    Mio_Gate_t * pGate;
   233	    SC_Cell * pCell;
   234	    float Load, MaxCap, Ratio;
   235	    int i, CellId, Fanouts, Pins;
   236	    Abc_Stmap37LoadStatsClear( pStats );
   237	    if ( pLib == NULL || !Abc_SclHasDelayInfo(pLib) )
   238	        return;
   239	    pStats->fAvailable = 1;
   240	    Abc_NtkForEachNode( pNtk, pObj, i )
   241	    {
   242	        pStats->nNodes++;
   243	        if ( pObj->pData == NULL )
   244	            continue;
   245	        pGate = (Mio_Gate_t *)pObj->pData;
   246	        CellId = Abc_SclCellFind( pLib, Mio_GateReadName(pGate) );
   247	        if ( CellId < 0 )
   248	            continue;
   249	        pCell = SC_LibCell( pLib, CellId );
   250	        if ( pCell == NULL || pCell->n_outputs == 0 )
   251	            continue;
   252	        MaxCap = SC_CellPin( pCell, pCell->n_inputs )->max_out_cap;
   253	        if ( MaxCap <= 0.0 )
   254	            continue;
   255	        Load = Abc_Stmap37FanoutLoad( pLib, pObj, &Fanouts, &Pins );
   256	        Ratio = Load / MaxCap;
   257	        pStats->RatioSum += Ratio;
   258	        if ( pStats->RatioMax < Ratio )
   259	            pStats->RatioMax = Ratio;
   260	        if ( Ratio > 1.0 )
   261	            pStats->nOver++;
   262	        pStats->nMatched++;
   263	        pStats->nPins += Pins;
   264	        Abc_Stmap37TopInsert( pStats->TopRatios, pStats->TopNodes, pStats->pTopGates, pStats->TopFanouts, pStats->TopLoads, pStats->TopCaps,
   265	            Ratio, Abc_ObjId(pObj), Mio_GateReadName(pGate), Fanouts, Load, MaxCap );
   266	        Abc_Stmap37CollectHotspotCone( pNtk, pObj, pStats, Ratio );
   267	    }
   268	}
