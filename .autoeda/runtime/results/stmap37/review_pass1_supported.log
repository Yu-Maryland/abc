   102	static void Abc_Stmap37HotspotInsert( Abc_Stmap37LoadStats_t * pStats, int AigId, int NodeId, float Ratio )
   103	{
   104	    int i, k, iMin;
   105	    if ( AigId < 0 || Ratio <= 1.0 )
   106	        return;
   107	    for ( i = 0; i < pStats->nHotspots; i++ )
   108	    {
   109	        if ( pStats->HotspotAigIds[i] != AigId )
   110	            continue;
   111	        if ( Ratio > pStats->HotspotRatios[i] )
   112	        {
   113	            pStats->HotspotRatios[i] = Ratio;
   114	            pStats->HotspotNodes[i] = NodeId;
   115	        }
   116	        return;
   117	    }
   118	    if ( pStats->nHotspots < ABC_STMAP37_MAX_HOTSPOTS )
   119	    {
   120	        i = pStats->nHotspots++;
   121	        pStats->HotspotAigIds[i] = AigId;
   122	        pStats->HotspotNodes[i] = NodeId;
   123	        pStats->HotspotRatios[i] = Ratio;
   124	        for ( k = i; k > 0 && pStats->HotspotRatios[k] > pStats->HotspotRatios[k-1]; k-- )
   125	        {
   126	            ABC_SWAP( int, pStats->HotspotAigIds[k], pStats->HotspotAigIds[k-1] );
   127	            ABC_SWAP( int, pStats->HotspotNodes[k], pStats->HotspotNodes[k-1] );
   128	            ABC_SWAP( float, pStats->HotspotRatios[k], pStats->HotspotRatios[k-1] );
   129	        }
   130	        return;
   131	    }
   132	    iMin = 0;
   133	    for ( i = 1; i < pStats->nHotspots; i++ )
   134	        if ( pStats->HotspotRatios[i] < pStats->HotspotRatios[iMin] )
   135	            iMin = i;
   136	    if ( Ratio <= pStats->HotspotRatios[iMin] )
   137	        return;
   138	    pStats->HotspotAigIds[iMin] = AigId;
   139	    pStats->HotspotNodes[iMin] = NodeId;
   140	    pStats->HotspotRatios[iMin] = Ratio;
   141	    for ( i = 0; i < pStats->nHotspots; i++ )
   142	    {
   143	        for ( k = i + 1; k < pStats->nHotspots; k++ )
   144	        {
   145	            if ( pStats->HotspotRatios[i] >= pStats->HotspotRatios[k] )
   146	                continue;
   147	            ABC_SWAP( int, pStats->HotspotAigIds[i], pStats->HotspotAigIds[k] );
   148	            ABC_SWAP( int, pStats->HotspotNodes[i], pStats->HotspotNodes[k] );
   149	            ABC_SWAP( float, pStats->HotspotRatios[i], pStats->HotspotRatios[k] );
   150	        }
   151	    }
   152	}
