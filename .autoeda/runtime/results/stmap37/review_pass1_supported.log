    91	static int Abc_Stmap37MappedObjAigId( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj )
    92	{
    93	    int Lit;
    94	    if ( pNtk == NULL || pObj == NULL || pNtk->vOrigNodeIds == NULL )
    95	        return -1;
    96	    if ( Abc_ObjId(pObj) >= Vec_IntSize(pNtk->vOrigNodeIds) )
    97	        return -1;
    98	    Lit = Vec_IntEntry( pNtk->vOrigNodeIds, Abc_ObjId(pObj) );
    99	    return Lit >= 0 ? Abc_Lit2Var(Lit) : -1;
   100	}
