   299	static float Abc_Stmap37FeedbackSeverity( Abc_Stmap37LoadStats_t * pStats )
   300	{
   301	    float OverFrac, MaxPart, OverPart, Severity;
   302	    if ( !pStats->fAvailable || pStats->nMatched == 0 )
   303	        return 0.0;
   304	    OverFrac = (float)pStats->nOver / (float)pStats->nMatched;
   305	    MaxPart = pStats->RatioMax > 4.0 ? (pStats->RatioMax - 4.0) / 8.0 : 0.0;
   306	    OverPart = OverFrac > 0.002 ? (OverFrac - 0.002) / 0.006 : 0.0;
   307	    if ( MaxPart > 1.0 )
   308	        MaxPart = 1.0;
   309	    if ( OverPart > 1.0 )
   310	        OverPart = 1.0;
   311	    Severity = 0.65 * MaxPart + 0.35 * OverPart;
   312	    return Severity > 1.0 ? 1.0 : Severity;
   313	}
