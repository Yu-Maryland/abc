   773	static float s_Stmap37SclMaxLoadRatio = 0.0;
   774	static float s_Stmap37SclOverFrac = 0.0;
   775	static float s_Stmap37SclFeedback = 0.0;
   776	static int * s_pStmap37SclHotspotIds = NULL;
   777	static float * s_pStmap37SclHotspotRatios = NULL;
   778	static int s_nStmap37SclHotspots = 0;
