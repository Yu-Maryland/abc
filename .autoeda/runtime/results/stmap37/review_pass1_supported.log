   154	static void Abc_Stmap37CollectHotspotCone( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap37LoadStats_t * pStats, float Ratio )
   155	{
   156	    Abc_Obj_t * pFanin;
   157	    int i, AigId;
   158	    if ( Ratio <= 1.0 )
   159	        return;
   160	    AigId = Abc_Stmap37MappedObjAigId( pNtk, pObj );
   161	    if ( AigId >= 0 )
   162	    {
   163	        pStats->nHotspotRoots++;
   164	        Abc_Stmap37HotspotInsert( pStats, AigId, Abc_ObjId(pObj), Ratio );
   165	    }
   166	    Abc_ObjForEachFanin( pObj, pFanin, i )
   167	    {
   168	        AigId = Abc_Stmap37MappedObjAigId( pNtk, pFanin );
   169	        if ( AigId < 0 )
   170	            continue;
   171	        pStats->nHotspotCone++;
   172	        Abc_Stmap37HotspotInsert( pStats, AigId, Abc_ObjId(pFanin), 0.85 * Ratio );
   173	    }
   174	}
