    63	static void Abc_Stmap37TopInsert( float * pRatios, int * pNodes, const char ** ppGates, int * pFanouts, float * pLoads, float * pCaps, float Ratio, int Node, const char * pGate, int Fanouts, float Load, float Cap )
    64	{
    65	    int i, k;
    66	    if ( Ratio <= pRatios[4] )
    67	        return;
    68	    for ( i = 0; i < 5; i++ )
    69	    {
    70	        if ( Ratio <= pRatios[i] )
    71	            continue;
    72	        for ( k = 4; k > i; k-- )
    73	        {
    74	            pRatios[k] = pRatios[k-1];
    75	            pNodes[k] = pNodes[k-1];
    76	            ppGates[k] = ppGates[k-1];
    77	            pFanouts[k] = pFanouts[k-1];
    78	            pLoads[k] = pLoads[k-1];
    79	            pCaps[k] = pCaps[k-1];
    80	        }
    81	        pRatios[i] = Ratio;
    82	        pNodes[i] = Node;
    83	        ppGates[i] = pGate;
    84	        pFanouts[i] = Fanouts;
    85	        pLoads[i] = Load;
    86	        pCaps[i] = Cap;
    87	        return;
    88	    }
    89	}
