   780	void Map_Stmap37SetSclLoadFeedback( float MaxLoadRatio, float OverFrac, float Severity, int * pAigIds, float * pRatios, int nHotspots )
   781	{
   782	    s_Stmap37SclMaxLoadRatio = MaxLoadRatio;
   783	    s_Stmap37SclOverFrac = OverFrac;
   784	    s_Stmap37SclFeedback = Severity;
   785	    s_pStmap37SclHotspotIds = pAigIds;
   786	    s_pStmap37SclHotspotRatios = pRatios;
   787	    s_nStmap37SclHotspots = nHotspots;
   788	}
   789	
   790	static float Map_MatchStmap37HotspotRatio( Map_Node_t * pNode )
   791	{
   792	    int AigId, i;
   793	    if ( s_Stmap37SclFeedback <= 0.0 || s_pStmap37SclHotspotIds == NULL || s_pStmap37SclHotspotRatios == NULL )
   794	        return 0.0;
   795	    if ( pNode == NULL || pNode->Num < 0 )
   796	        return 0.0;
   797	    AigId = Map_NodeReadAigId( pNode );
   798	    if ( AigId < 0 )
   799	        return 0.0;
   800	    for ( i = 0; i < s_nStmap37SclHotspots; i++ )
   801	        if ( s_pStmap37SclHotspotIds[i] == AigId )
   802	            return s_pStmap37SclHotspotRatios[i];
   803	    return 0.0;
   804	}
   805	
   806	static float Map_MatchStmap37StrongPenaltyFactor( Map_Node_t * pNode, Map_Cut_t * pCut, Map_Match_t * pMatch, float ArrivalDelta, float ArrivalGainMargin, float Slack, float SlackMargin, float Epsilon, float * pLeafLoadAvg, float * pLoadDriveRatio, int * pFanLimit, float * pHotspotRatio )
   807	{
   808	    float Penalty, LoadDriveRatio, HotspotRatio, LocalFeedback;
   809	    Penalty = Map_MatchStmap34StrongPenaltyFactor( pNode, pCut, pMatch, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon, pLeafLoadAvg, pLoadDriveRatio, pFanLimit );
   810	    LoadDriveRatio = pLoadDriveRatio ? *pLoadDriveRatio : 0.0;
   811	    HotspotRatio = Map_MatchStmap37HotspotRatio( pNode );
   812	    if ( pHotspotRatio )
   813	        *pHotspotRatio = HotspotRatio;
   814	    if ( Penalty > 0.0 && s_Stmap37SclFeedback > 0.0 && HotspotRatio > 1.0 && LoadDriveRatio > 1.0 )
   815	    {
   816	        LocalFeedback = (HotspotRatio - 1.0) / 4.0;
   817	        if ( LocalFeedback > 1.0 )
   818	            LocalFeedback = 1.0;
   819	        Penalty += 0.05 * s_Stmap37SclFeedback * LocalFeedback * (LoadDriveRatio - 1.0) / LoadDriveRatio;
   820	    }
   821	    return Penalty > 0.75 ? 0.75 : Penalty;
   822	}
   823	
   824	/**Function*************************************************************
   825	
   826	  Synopsis    [Returns 1 if a fanout/load proxy should reject this cut.]
   827	
   828	  Description [Mode 1 is the classic map -f guard. Mode 2 is the stmap1
   829	  selective guard, which only rejects wider cuts when the node has higher
   830	  estimated fanout. Mode 3 is the stmap2 guard, which uses the same fanout
   831	  thresholds only during area recovery and only when the current phase has
   832	  slack over the mapper required time. Mode 4 is the stmap3 guard, which
   833	  narrows the intervention to high-fanout nodes with only shallow positive
   834	  slack. Mode 5 is the stmap4 split-phase guard: stmap1-style guarding in
   835	  delay matching and stmap2-style slack-aware guarding in area recovery.
   836	  Mode 6 is the stmap5 shape-gated split-phase guard: the delay pass only
   837	  uses stmap1-style guarding in very large mapper graphs, while area recovery
   838	  keeps the stmap2 slack-aware guard. Mode 7 is the stmap6 area-sensitive
   839	  shape-gated guard: the delay pass keeps the stmap5 graph-size gate, small
   840	  mapper graphs keep the stmap2 slack-aware recovery guard, and exact-area
   841	  recovery on larger graphs checks the cut after matching so materially cheaper
   842	  cuts can override the fanout/load proxy. Mode 8 is the stmap7 criticality-
   843	  sensitive version of mode 7: exact-area recovery on larger graphs allows the
   844	  override only with deeper mapper slack and outside the highest fanout bucket.
   845	  Mode 9 is the stmap8 arrival-bounded version of mode 8: the area-saving
   846	  override also requires the candidate match to stay within one quarter of an
   847	  inverter delay of the existing mapper arrival. Mode 10 is the stmap9
   848	  middle-slack area-relief version of mode 9: it keeps the highest fanout
   849	  bucket protected, but in the one-to-two inverter slack bucket it allows a
   850	  wide cut only when it is arrival-neutral and saves at least one inverter
   851	  area. Mode 11 is the stmap10 depth-qualified version of mode 10: the
   852	  middle-slack relief is allowed only for shallow and medium-depth nodes.
   853	  Mode 12 is the stmap11 tight-depth version of mode 11: the middle-slack
   854	  relief is allowed only for shallower nodes. Mode 13 is the stmap12
   855	  fanout-bucket split version of mode 12: the tight-depth middle-slack relief
   856	  is allowed only in the lower moderate fanout bucket. Mode 14 is stmap13,
   857	  which keeps mode 13 behavior while recording guard-hit counters. Mode 15 is
   858	  stmap14, which keeps the same bucket and counters but requires a stronger
   859	  middle-slack area-flow saving. Mode 16 is stmap15, which restores the
   860	  one-inverter relief threshold only after the current run has observed a high
   861	  lower-moderate/middle-slack exact-area profile. Mode 17 is stmap16, which
   862	  keeps mode 16 behavior and prints per-relief diagnostics. Mode 18 is stmap17,
   863	  which uses the one-inverter post-profile threshold only for candidates with
   864	  materially better mapper arrival. Mode 19 is stmap18, which keeps mode 18
   865	  decisions and adds near-miss diagnostics for candidates rejected by the
   866	  timing-quality/profile fallback. Mode 20 is stmap19, which allows the
   867	  one-inverter threshold before profile-open only for candidates with the same
   868	  material mapper-arrival improvement. Mode 21 is stmap20, which keeps the
   869	  mode 20 pre-profile seed but restricts it to shallow nodes. Mode 22 is
   870	  stmap21, which keeps the shallow seed and admits deeper pre-profile seeds
   871	  only when the arrival gain is unusually large. Mode 23 is stmap22, which
   872	  relaxes the deep pre-profile seed boundary to a moderate arrival gain. Mode
   873	  24 is stmap23, which keeps the strong deep seeds but allows moderate deep
   874	  seeds only when the existing mapper slack is near the critical side of the
   875	  middle-slack window. Mode 25 is stmap24, which tightens the moderate deep
   876	  slack gate to the lower edge of that critical window. Mode 26 is stmap25,
   877	  which keeps stmap24 and admits at most one moderate deep seed from the next
   878	  slack band as an ablation diagnostic. Mode 27 is stmap26, which skips the
   879	  first such moderate seed and admits only the second qualifying seed. Mode 28
   880	  is stmap27, which reopens the next slack band except for the high-reference,
   881	  low-slack, stronger-moderate signature isolated by stmap26. Mode 29 is
   882	  stmap28, which replaces that hard signature blocker with a high-reference
   883	  moderate-seed area penalty that scales with reference count, slack risk, and
   884	  arrival-gain risk. Mode 30 is stmap29, which keeps the same seed band but
   885	  makes the penalty a continuous load-risk gradient. Mode 31 is stmap30,
   886	  which keeps that moderate-seed gradient and adds a smaller continuous
   887	  penalty to high-reference strong deep seeds. Mode 32 is stmap31, which keeps
   888	  mode 31's moderate penalty but dampens the strong-seed gain slope. Mode 33
   889	  is stmap32, which adds a cut-leaf load proxy to the strong-seed penalty. Mode
   890	  34 is stmap33, which normalizes that load proxy by supergate fanout limit.
   891	  Mode 35 is stmap34, which uses a bounded sublinear load/drive curve. Mode
   892	  36 is stmap35, which preserves that mapper curve while command-level SCL
   893	  load/max-cap diagnostics are emitted. Mode 37 is stmap36, which strengthens
   894	  the bounded curve according to direct SCL over-cap severity measured by a
   895	  command-layer first pass. Mode 38 is stmap37, which applies that feedback
   896	  only when the current mapper node appears in the first-pass over-cap
   897	  hotspot set.]
   898	
   899	  SideEffects []
   900	
   901	  SeeAlso     []
   902	
   903	***********************************************************************/
   904	static int Map_MatchSkipCutForFanout( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase )
   905	{
   906	    Map_Cut_t * pCutBest;
   907	    Map_Match_t * pMatchBest;
   908	    float Slack, SlackMargin, SlackLimit;
   909	
   910	    if ( !p->fSkipFanout )
   911	        return 0;
   912	    if ( p->fSkipFanout == 2 )
   913	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   914	    if ( p->fSkipFanout == 3 )
   915	    {
   916	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   917	            return 0;
   918	        pCutBest = pNode->pCutBest[fPhase];
   919	        if ( pCutBest == NULL )
   920	            return 0;
   921	        pMatchBest = pCutBest->M + fPhase;
   922	        if ( pMatchBest->pSuperBest == NULL )
   923	            return 0;
   924	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   925	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   926	        if ( Slack <= SlackMargin + p->fEpsilon )
   927	            return 0;
   928	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   929	    }
   930	    if ( p->fSkipFanout == 4 )
   931	    {
   932	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   933	            return 0;
   934	        pCutBest = pNode->pCutBest[fPhase];
   935	        if ( pCutBest == NULL )
   936	            return 0;
   937	        pMatchBest = pCutBest->M + fPhase;
   938	        if ( pMatchBest->pSuperBest == NULL || p->pSuperLib == NULL )
   939	            return 0;
   940	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   941	        SlackMargin = p->pSuperLib->tDelayInv.Worst;
   942	        SlackLimit = 2.0 * SlackMargin;
   943	        if ( Slack <= p->fEpsilon || Slack > SlackLimit + p->fEpsilon )
   944	            return 0;
   945	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   946	    }
   947	    if ( p->fSkipFanout == 5 )
   948	    {
   949	        if ( p->fMappingMode == 0 )
   950	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   951	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   952	            return 0;
   953	        pCutBest = pNode->pCutBest[fPhase];
   954	        if ( pCutBest == NULL )
   955	            return 0;
   956	        pMatchBest = pCutBest->M + fPhase;
   957	        if ( pMatchBest->pSuperBest == NULL )
   958	            return 0;
   959	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   960	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   961	        if ( Slack <= SlackMargin + p->fEpsilon )
   962	            return 0;
   963	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   964	    }
   965	    if ( p->fSkipFanout == 6 )
   966	    {
   967	        if ( p->fMappingMode == 0 )
   968	        {
   969	            if ( p->vMapObjs->nSize <= 20000 )
   970	                return 0;
   971	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   972	        }
   973	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   974	            return 0;
   975	        pCutBest = pNode->pCutBest[fPhase];
   976	        if ( pCutBest == NULL )
   977	            return 0;
   978	        pMatchBest = pCutBest->M + fPhase;
   979	        if ( pMatchBest->pSuperBest == NULL )
   980	            return 0;
   981	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   982	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   983	        if ( Slack <= SlackMargin + p->fEpsilon )
   984	            return 0;
   985	        return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   986	    }
   987	    if ( p->fSkipFanout == 7 )
   988	    {
   989	        if ( p->fMappingMode == 0 )
   990	        {
   991	            if ( p->vMapObjs->nSize <= 20000 )
   992	                return 0;
   993	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   994	        }
   995	        if ( p->fMappingMode >= 1 && p->fMappingMode <= 3 && p->vMapObjs->nSize <= 8000 )
   996	        {
   997	            pCutBest = pNode->pCutBest[fPhase];
   998	            if ( pCutBest == NULL )
   999	                return 0;
  1000	            pMatchBest = pCutBest->M + fPhase;
  1001	            if ( pMatchBest->pSuperBest == NULL )
  1002	                return 0;
  1003	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
  1004	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
  1005	            if ( Slack <= SlackMargin + p->fEpsilon )
  1006	                return 0;
  1007	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
  1008	        }
  1009	        if ( p->fMappingMode == 1 )
  1010	        {
  1011	            pCutBest = pNode->pCutBest[fPhase];
  1012	            if ( pCutBest == NULL )
  1013	                return 0;
  1014	            pMatchBest = pCutBest->M + fPhase;
  1015	            if ( pMatchBest->pSuperBest == NULL )
  1016	                return 0;
  1017	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
  1018	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
  1019	            if ( Slack <= SlackMargin + p->fEpsilon )
  1020	                return 0;
  1021	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
  1022	        }
  1023	        return 0;
  1024	    }
  1025	    if ( p->fSkipFanout >= 8 && p->fSkipFanout <= 38 )
  1026	    {
  1027	        if ( p->fMappingMode == 0 )
  1028	        {
  1029	            if ( p->vMapObjs->nSize <= 20000 )
  1030	                return 0;
  1031	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
  1032	        }
  1033	        if ( p->fMappingMode >= 1 && p->fMappingMode <= 3 && p->vMapObjs->nSize <= 8000 )
  1034	        {
  1035	            pCutBest = pNode->pCutBest[fPhase];
  1036	            if ( pCutBest == NULL )
  1037	                return 0;
  1038	            pMatchBest = pCutBest->M + fPhase;
  1039	            if ( pMatchBest->pSuperBest == NULL )
  1040	                return 0;
  1041	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
  1042	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
  1043	            if ( Slack <= SlackMargin + p->fEpsilon )
  1044	                return 0;
  1045	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
  1046	        }
  1047	        if ( p->fMappingMode == 1 )
  1048	        {
  1049	            pCutBest = pNode->pCutBest[fPhase];
  1050	            if ( pCutBest == NULL )
  1051	                return 0;
  1052	            pMatchBest = pCutBest->M + fPhase;
  1053	            if ( pMatchBest->pSuperBest == NULL )
  1054	                return 0;
  1055	            Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
  1056	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
  1057	            if ( Slack <= SlackMargin + p->fEpsilon )
  1058	                return 0;
  1059	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
  1060	        }
  1061	        return 0;
  1062	    }
  1063	    return (pNode->nRefs > 3 && pCut->nLeaves > 2) || (pNode->nRefs > 1 && pCut->nLeaves > 3);
  1064	}
  1065	
  1066	/**Function*************************************************************
  1067	
  1068	  Synopsis    [Returns 1 if an stmap area-sensitive mode should reject a cut.]
  1069	
  1070	  Description [The area-sensitive guards are evaluated after matching the
  1071	  candidate cut because their hypotheses need the candidate's actual mapper
  1072	  area. In stmap6 exact-area recovery, a wide high-fanout cut is rejected only
  1073	  when the existing match has slack and the candidate does not save at least
  1074	  half an inverter area. In stmap7, the area-saving override additionally
  1075	  requires more than two inverter delays of slack and excludes the highest
  1076	  fanout-risk bucket. In stmap8, the override is further rejected when the
  1077	  candidate match worsens mapper arrival by more than one quarter of an
  1078	  inverter delay. In stmap9, middle-slack candidates can recover area only
  1079	  when they are outside the highest fanout bucket, do not worsen mapper
  1080	  arrival, and save at least one inverter area. In stmap10, that middle-slack
  1081	  relief also requires the mapper node to be no deeper than level 96. In
  1082	  stmap11, that depth window is tightened to level 64. In stmap12, the same
  1083	  tight-depth relief is allowed only in the lower moderate fanout bucket. In
  1084	  stmap13, the same decision path also records exact-area guard statistics. In
  1085	  stmap14, the lower-moderate middle-slack relief must save two inverter areas
  1086	  instead of one. In stmap15, one-inverter relief is restored only after the
  1087	  mapper observes a high lower-moderate/middle-slack profile. In stmap16, the
  1088	  same behavior also reports each admitted relief choice. In stmap17, the
  1089	  adaptive one-inverter relief threshold also requires a material mapper-arrival
  1090	  improvement; arrival-neutral choices keep the stricter two-inverter fallback.
  1091	  In stmap18, the same decisions are preserved while near-miss rejected
  1092	  middle-slack candidates are logged. In stmap19, pre-profile one-inverter
  1093	  relief is seeded only by candidates with the same material arrival gain. In
  1094	  stmap20, the pre-profile seed is further limited to shallow nodes. In
  1095	  stmap21, deeper pre-profile seeds are allowed only with a much larger mapper
  1096	  arrival gain. In stmap22, the same deep-seed path is relaxed to a moderate
  1097	  mapper-arrival gain. In stmap23, moderate deep seeds also need near-critical
  1098	  existing mapper slack. In stmap24, the moderate deep slack gate is tightened
  1099	  to the lower edge of the critical slack window. In stmap25, the stmap24 rule
  1100	  is kept, and one moderate deep seed from the next slack band is admitted for
  1101	  ablation. In stmap26, the first such moderate seed is skipped and only the
  1102	  second qualifying seed is admitted. In stmap27, moderate deep candidates in
  1103	  the next slack band are admitted unless they match the high-reference,
  1104	  low-slack, stronger-moderate signature isolated by stmap26. In stmap28, that
  1105	  hard blocker is replaced by a soft area-margin penalty on high-reference
  1106	  moderate seeds whose slack and arrival-gain ratios resemble load-risky
  1107	  choices. In stmap29, the high-reference penalty is made continuous over the
  1108	  same seed band. In stmap30, the same load-risk surface is extended to
  1109	  high-reference strong deep seeds with a smaller continuous penalty. In
  1110	  stmap31, the strong-seed gain slope is damped to probe the penalty threshold.
  1111	  In stmap32, a cut-leaf load proxy adds a candidate-cut fanout-shape term to
  1112	  the strong-seed penalty. In stmap33, the cut-leaf term is normalized by the
  1113	  selected supergate fanout limit to test a library-derived drive/load signal.
  1114	  In stmap34, the drive-normalized term uses a bounded sublinear curve so high
  1115	  load/drive ratios do not automatically saturate the area margin. Stmap35
  1116	  preserves the stmap34 mapper decision surface and adds direct SCL
  1117	  mapped-load diagnostics in the command layer. Stmap36 feeds the aggregate
  1118	  direct SCL load/max-cap severity from a first pass back into the same bounded
  1119	  strong-seed area margin. Stmap37 restricts that SCL feedback to first-pass
  1120	  over-cap hotspot AIG IDs and their immediate mapped fanin cone.]
