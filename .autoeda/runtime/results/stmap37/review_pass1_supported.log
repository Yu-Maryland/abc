   270	static void Abc_Stmap37PrintSclLoadStats( const char * pLabel, Abc_Stmap37LoadStats_t * pStats )
   271	{
   272	    int i;
   273	    if ( !pStats->fAvailable )
   274	    {
   275	        printf( "stmap37 %s stats: unavailable = 1\n", pLabel );
   276	        return;
   277	    }
   278	    printf( "stmap37 %s stats: nodes = %d  matched = %d  fanout-pins = %d  over-max = %d  avg-load-ratio = %.3f  max-load-ratio = %.3f\n",
   279	        pLabel, pStats->nNodes, pStats->nMatched, pStats->nPins, pStats->nOver,
   280	        pStats->nMatched ? pStats->RatioSum / (float)pStats->nMatched : 0.0, pStats->RatioMax );
   281	    for ( i = 0; i < 5 && pStats->TopRatios[i] > 0.0; i++ )
   282	        printf( "stmap37 %s top: rank = %d  node = %d  gate = %s  fanouts = %d  load = %.3f  max-cap = %.3f  load-ratio = %.3f\n",
   283	            pLabel, i + 1, pStats->TopNodes[i], pStats->pTopGates[i] ? pStats->pTopGates[i] : "?",
   284	            pStats->TopFanouts[i], pStats->TopLoads[i], pStats->TopCaps[i], pStats->TopRatios[i] );
   285	}
