--- abcStmap_39.c ---
/**CFile****************************************************************

  FileName    [abcStmap_39.c]

  SystemName  [ABC: Logic synthesis and verification system.]

  PackageName [Versioned AutoEDA standard-cell mapper experiments.]

  Synopsis    [stmap39 command.]

***********************************************************************/

#include "base/abc/abc.h"
#include "base/main/main.h"
#include "map/mio/mio.h"
#include "map/scl/sclLib.h"
#include "misc/extra/extra.h"
#include <string.h>

ABC_NAMESPACE_IMPL_START

#define ABC_STMAP39_MAX_HOTSPOTS 4096
#define ABC_STMAP39_TRACK_AIG_ID 5548

typedef struct Abc_Stmap39LoadStats_t_
{
    int fAvailable;
    int nNodes;
    int nMatched;
    int nPins;
    int nOver;
    int nHotspotRoots;
    int nHotspotFanin;
    int nHotspotFanout;
    int nHotspots;
    int TrackedNode;
    float RatioSum;
    float RatioMax;
    float TrackedRatio;
    float TopRatios[5];
    float TopLoads[5];
    float TopCaps[5];
    const char * pTopGates[5];
    int TopNodes[5];
    int TopFanouts[5];
    int HotspotAigIds[ABC_STMAP39_MAX_HOTSPOTS];
    int HotspotNodes[ABC_STMAP39_MAX_HOTSPOTS];
    float HotspotRatios[ABC_STMAP39_MAX_HOTSPOTS];
} Abc_Stmap39LoadStats_t;

static void Abc_Stmap39LoadStatsClear( Abc_Stmap39LoadStats_t * pStats )
{
    memset( pStats, 0, sizeof(Abc_Stmap39LoadStats_t) );
}

/**Function*************************************************************

  Synopsis    [Inserts one mapped-load diagnostic into the top list.]

  Description []

  SideEffects []

  SeeAlso     []

***********************************************************************/
static void Abc_Stmap39TopInsert( float * pRatios, int * pNodes, const char ** ppGates, int * pFanouts, float * pLoads, float * pCaps, float Ratio, int Node, const char * pGate, int Fanouts, float Load, float Cap )
{
    int i, k;
    if ( Ratio <= pRatios[4] )
        return;
    for ( i = 0; i < 5; i++ )
    {
        if ( Ratio <= pRatios[i] )
            continue;
        for ( k = 4; k > i; k-- )
        {
            pRatios[k] = pRatios[k-1];
            pNodes[k] = pNodes[k-1];
            ppGates[k] = ppGates[k-1];
            pFanouts[k] = pFanouts[k-1];
            pLoads[k] = pLoads[k-1];
            pCaps[k] = pCaps[k-1];
        }
        pRatios[i] = Ratio;
        pNodes[i] = Node;
        ppGates[i] = pGate;
        pFanouts[i] = Fanouts;
        pLoads[i] = Load;
        pCaps[i] = Cap;
        return;
    }
}

static int Abc_Stmap39MappedObjAigId( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj )
{
    int Lit;
    if ( pNtk == NULL || pObj == NULL || pNtk->vOrigNodeIds == NULL )
        return -1;
    if ( Abc_ObjId(pObj) >= Vec_IntSize(pNtk->vOrigNodeIds) )
        return -1;
    Lit = Vec_IntEntry( pNtk->vOrigNodeIds, Abc_ObjId(pObj) );
    return Lit >= 0 ? Abc_Lit2Var(Lit) : -1;
}

static void Abc_Stmap39HotspotInsert( Abc_Stmap39LoadStats_t * pStats, int AigId, int NodeId, float Ratio )
{
    int i, k, iMin;
    if ( AigId < 0 || Ratio <= 1.0 )
        return;
    if ( AigId == ABC_STMAP39_TRACK_AIG_ID && Ratio > pStats->TrackedRatio )
    {
        pStats->TrackedRatio = Ratio;
        pStats->TrackedNode = NodeId;
    }
    for ( i = 0; i < pStats->nHotspots; i++ )
    {
        if ( pStats->HotspotAigIds[i] != AigId )
            continue;
        if ( Ratio > pStats->HotspotRatios[i] )
        {
            pStats->HotspotRatios[i] = Ratio;
            pStats->HotspotNodes[i] = NodeId;
        }
        return;
    }
    if ( pStats->nHotspots < ABC_STMAP39_MAX_HOTSPOTS )
    {
        i = pStats->nHotspots++;
        pStats->HotspotAigIds[i] = AigId;
        pStats->HotspotNodes[i] = NodeId;
        pStats->HotspotRatios[i] = Ratio;
        for ( k = i; k > 0 && pStats->HotspotRatios[k] > pStats->HotspotRatios[k-1]; k-- )
        {
            ABC_SWAP( int, pStats->HotspotAigIds[k], pStats->HotspotAigIds[k-1] );
            ABC_SWAP( int, pStats->HotspotNodes[k], pStats->HotspotNodes[k-1] );
            ABC_SWAP( float, pStats->HotspotRatios[k], pStats->HotspotRatios[k-1] );
        }
        return;
    }
    iMin = 0;
    for ( i = 1; i < pStats->nHotspots; i++ )
        if ( pStats->HotspotRatios[i] < pStats->HotspotRatios[iMin] )
            iMin = i;
    if ( Ratio <= pStats->HotspotRatios[iMin] )
        return;
    pStats->HotspotAigIds[iMin] = AigId;
    pStats->HotspotNodes[iMin] = NodeId;
    pStats->HotspotRatios[iMin] = Ratio;
    for ( k = iMin; k > 0 && pStats->HotspotRatios[k] > pStats->HotspotRatios[k-1]; k-- )
    {
        ABC_SWAP( int, pStats->HotspotAigIds[k], pStats->HotspotAigIds[k-1] );
        ABC_SWAP( int, pStats->HotspotNodes[k], pStats->HotspotNodes[k-1] );
        ABC_SWAP( float, pStats->HotspotRatios[k], pStats->HotspotRatios[k-1] );
    }
}

static void Abc_Stmap39InsertConsumerFanins( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap39LoadStats_t * pStats, float Ratio, int Depth )
{
    Abc_Obj_t * pFanin;
    int i, AigId;
    if ( pObj == NULL || Ratio <= 1.0 || Depth <= 0 )
        return;
    Abc_ObjForEachFanin( pObj, pFanin, i )
    {
        AigId = Abc_Stmap39MappedObjAigId( pNtk, pFanin );
        if ( AigId >= 0 )
        {
            pStats->nHotspotFanin++;
            Abc_Stmap39HotspotInsert( pStats, AigId, Abc_ObjId(pFanin), Ratio );
        }
        Abc_Stmap39InsertConsumerFanins( pNtk, pFanin, pStats, 0.78 * Ratio, Depth - 1 );
    }
}

static void Abc_Stmap39CollectHotspotCone( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap39LoadStats_t * pStats, float Ratio )
{
    Abc_Obj_t * pFanout, * pFanout2;
    int i, k, AigId;
    if ( Ratio <= 1.0 )
        return;
    AigId = Abc_Stmap39MappedObjAigId( pNtk, pObj );
    if ( AigId >= 0 )
    {
        pStats->nHotspotRoots++;
        Abc_Stmap39HotspotInsert( pStats, AigId, Abc_ObjId(pObj), 0.90 * Ratio );
    }
    Abc_ObjForEachFanout( pObj, pFanout, i )
    {
        AigId = Abc_Stmap39MappedObjAigId( pNtk, pFanout );
        if ( AigId >= 0 )
        {
            pStats->nHotspotFanout++;
            Abc_Stmap39HotspotInsert( pStats, AigId, Abc_ObjId(pFanout), Ratio );
        }
        Abc_Stmap39InsertConsumerFanins( pNtk, pFanout, pStats, 0.86 * Ratio, 3 );
        Abc_ObjForEachFanout( pFanout, pFanout2, k )
        {
            AigId = Abc_Stmap39MappedObjAigId( pNtk, pFanout2 );
            if ( AigId < 0 )
                continue;
            pStats->nHotspotFanout++;
            Abc_Stmap39HotspotInsert( pStats, AigId, Abc_ObjId(pFanout2), 0.66 * Ratio );
        }
    }
}

/**Function*************************************************************

  Synopsis    [Returns direct SCL input-pin load driven by a mapped node.]

  Description []

  SideEffects []

  SeeAlso     []

***********************************************************************/
static float Abc_Stmap39FanoutLoad( SC_Lib * pLib, Abc_Obj_t * pObj, int * pFanouts, int * pPins )
{
    Abc_Obj_t * pFanout;
    Mio_Gate_t * pGateFan;
    SC_Cell * pCellFan;
    float Load = 0.0;
    int i, iFanin, CellId;
    *pFanouts = 0;
    *pPins = 0;
    Abc_ObjForEachFanout( pObj, pFanout, i )
    {
        (*pFanouts)++;
        if ( !Abc_ObjIsNode(pFanout) || pFanout->pData == NULL )
            continue;
        iFanin = Abc_NodeFindFanin( pFanout, pObj );
        if ( iFanin < 0 )
            continue;
        pGateFan = (Mio_Gate_t *)pFanout->pData;
        CellId = Abc_SclCellFind( pLib, Mio_GateReadName(pGateFan) );
        if ( CellId < 0 )
            continue;
        pCellFan = SC_LibCell( pLib, CellId );

exec
/bin/zsh -lc "sed -n '240,520p' src/base/abci/abcStmap_39.c" in /Users/cunxiy/Documents/research/autoresearch-eda/abc-harness
 succeeded in 0ms:
        pCellFan = SC_LibCell( pLib, CellId );
        if ( pCellFan == NULL || iFanin >= pCellFan->n_inputs )
            continue;
        Load += SC_CellPinCap( pCellFan, iFanin );
        (*pPins)++;
    }
    return Load;
}

/**Function*************************************************************

  Synopsis    [Prints direct SCL load diagnostics for the mapped network.]

  Description []

  SideEffects []

  SeeAlso     []

***********************************************************************/
static void Abc_Stmap39CollectSclLoadStats( Abc_Ntk_t * pNtk, Abc_Stmap39LoadStats_t * pStats )
{
    SC_Lib * pLib = (SC_Lib *)Abc_FrameReadLibScl();
    Abc_Obj_t * pObj;
    Mio_Gate_t * pGate;
    SC_Cell * pCell;
    float Load, MaxCap, Ratio;
    int i, CellId, Fanouts, Pins;
    Abc_Stmap39LoadStatsClear( pStats );
    if ( pLib == NULL || !Abc_SclHasDelayInfo(pLib) )
        return;
    pStats->fAvailable = 1;
    Abc_NtkForEachNode( pNtk, pObj, i )
    {
        pStats->nNodes++;
        if ( pObj->pData == NULL )
            continue;
        pGate = (Mio_Gate_t *)pObj->pData;
        CellId = Abc_SclCellFind( pLib, Mio_GateReadName(pGate) );
        if ( CellId < 0 )
            continue;
        pCell = SC_LibCell( pLib, CellId );
        if ( pCell == NULL || pCell->n_outputs == 0 )
            continue;
        MaxCap = SC_CellPin( pCell, pCell->n_inputs )->max_out_cap;
        if ( MaxCap <= 0.0 )
            continue;
        Load = Abc_Stmap39FanoutLoad( pLib, pObj, &Fanouts, &Pins );
        Ratio = Load / MaxCap;
        pStats->RatioSum += Ratio;
        if ( pStats->RatioMax < Ratio )
            pStats->RatioMax = Ratio;
        if ( Ratio > 1.0 )
            pStats->nOver++;
        pStats->nMatched++;
        pStats->nPins += Pins;
        Abc_Stmap39TopInsert( pStats->TopRatios, pStats->TopNodes, pStats->pTopGates, pStats->TopFanouts, pStats->TopLoads, pStats->TopCaps,
            Ratio, Abc_ObjId(pObj), Mio_GateReadName(pGate), Fanouts, Load, MaxCap );
        Abc_Stmap39CollectHotspotCone( pNtk, pObj, pStats, Ratio );
    }
}

static void Abc_Stmap39PrintSclLoadStats( const char * pLabel, Abc_Stmap39LoadStats_t * pStats )
{
    int i;
    if ( !pStats->fAvailable )
    {
        printf( "stmap39 %s stats: unavailable = 1\n", pLabel );
        return;
    }
    printf( "stmap39 %s stats: nodes = %d  matched = %d  fanout-pins = %d  over-max = %d  avg-load-ratio = %.3f  max-load-ratio = %.3f\n",
        pLabel, pStats->nNodes, pStats->nMatched, pStats->nPins, pStats->nOver,
        pStats->nMatched ? pStats->RatioSum / (float)pStats->nMatched : 0.0, pStats->RatioMax );
    for ( i = 0; i < 5 && pStats->TopRatios[i] > 0.0; i++ )
        printf( "stmap39 %s top: rank = %d  node = %d  gate = %s  fanouts = %d  load = %.3f  max-cap = %.3f  load-ratio = %.3f\n",
            pLabel, i + 1, pStats->TopNodes[i], pStats->pTopGates[i] ? pStats->pTopGates[i] : "?",
            pStats->TopFanouts[i], pStats->TopLoads[i], pStats->TopCaps[i], pStats->TopRatios[i] );
}

static void Abc_Stmap39PrintHotspots( Abc_Stmap39LoadStats_t * pStats )
{
    int i;
    if ( !pStats->fAvailable )
        return;
    printf( "stmap39 consumer-pressure stats: roots = %d  consumer-fanin = %d  consumer-fanout = %d  selected = %d  capacity = %d  tracked-aig = %d  tracked-node = %d  tracked-ratio = %.3f\n",
        pStats->nHotspotRoots, pStats->nHotspotFanin, pStats->nHotspotFanout,
        pStats->nHotspots, ABC_STMAP39_MAX_HOTSPOTS, ABC_STMAP39_TRACK_AIG_ID,
        pStats->TrackedNode, pStats->TrackedRatio );
    for ( i = 0; i < pStats->nHotspots && i < 10; i++ )
        printf( "stmap39 consumer-pressure: rank = %d  aig-id = %d  mapped-node = %d  consumer-load-ratio = %.3f\n",
            i + 1, pStats->HotspotAigIds[i], pStats->HotspotNodes[i], pStats->HotspotRatios[i] );
}

static float Abc_Stmap39FeedbackSeverity( Abc_Stmap39LoadStats_t * pStats )
{
    float OverFrac, MaxPart, OverPart, Severity;
    if ( !pStats->fAvailable || pStats->nMatched == 0 )
        return 0.0;
    OverFrac = (float)pStats->nOver / (float)pStats->nMatched;
    MaxPart = pStats->RatioMax > 4.0 ? (pStats->RatioMax - 4.0) / 8.0 : 0.0;
    OverPart = OverFrac > 0.002 ? (OverFrac - 0.002) / 0.006 : 0.0;
    if ( MaxPart > 1.0 )
        MaxPart = 1.0;
    if ( OverPart > 1.0 )
        OverPart = 1.0;
    Severity = 0.65 * MaxPart + 0.35 * OverPart;
    return Severity > 1.0 ? 1.0 : Severity;
}

