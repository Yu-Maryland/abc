    95	static int Abc_Stmap39MappedObjAigId( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj )
    96	{
    97	    int Lit;
    98	    if ( pNtk == NULL || pObj == NULL || pNtk->vOrigNodeIds == NULL )
    99	        return -1;
   100	    if ( Abc_ObjId(pObj) >= Vec_IntSize(pNtk->vOrigNodeIds) )
   101	        return -1;
   102	    Lit = Vec_IntEntry( pNtk->vOrigNodeIds, Abc_ObjId(pObj) );
   103	    return Lit >= 0 ? Abc_Lit2Var(Lit) : -1;
   104	}
   105	
   106	static void Abc_Stmap39HotspotInsert( Abc_Stmap39LoadStats_t * pStats, int AigId, int NodeId, float Ratio )
   107	{
   108	    int i, k, iMin;
   109	    if ( AigId < 0 || Ratio <= 1.0 )
   110	        return;
   111	    if ( AigId == ABC_STMAP39_TRACK_AIG_ID && Ratio > pStats->TrackedRatio )
   112	    {
   113	        pStats->TrackedRatio = Ratio;
   114	        pStats->TrackedNode = NodeId;
   115	    }
   116	    for ( i = 0; i < pStats->nHotspots; i++ )
   117	    {
   118	        if ( pStats->HotspotAigIds[i] != AigId )
   119	            continue;
   120	        if ( Ratio > pStats->HotspotRatios[i] )
   121	        {
   122	            pStats->HotspotRatios[i] = Ratio;
   123	            pStats->HotspotNodes[i] = NodeId;
   124	            for ( k = i; k > 0 && pStats->HotspotRatios[k] > pStats->HotspotRatios[k-1]; k-- )
   125	            {
   126	                ABC_SWAP( int, pStats->HotspotAigIds[k], pStats->HotspotAigIds[k-1] );
   127	                ABC_SWAP( int, pStats->HotspotNodes[k], pStats->HotspotNodes[k-1] );
   128	                ABC_SWAP( float, pStats->HotspotRatios[k], pStats->HotspotRatios[k-1] );
   129	            }
   130	        }
   131	        return;
   132	    }
   133	    if ( pStats->nHotspots < ABC_STMAP39_MAX_HOTSPOTS )
   134	    {
   135	        i = pStats->nHotspots++;
   136	        pStats->HotspotAigIds[i] = AigId;
   137	        pStats->HotspotNodes[i] = NodeId;
   138	        pStats->HotspotRatios[i] = Ratio;
   139	        for ( k = i; k > 0 && pStats->HotspotRatios[k] > pStats->HotspotRatios[k-1]; k-- )
   140	        {
   141	            ABC_SWAP( int, pStats->HotspotAigIds[k], pStats->HotspotAigIds[k-1] );
   142	            ABC_SWAP( int, pStats->HotspotNodes[k], pStats->HotspotNodes[k-1] );
   143	            ABC_SWAP( float, pStats->HotspotRatios[k], pStats->HotspotRatios[k-1] );
   144	        }
   145	        return;
   146	    }
   147	    iMin = 0;
   148	    for ( i = 1; i < pStats->nHotspots; i++ )
   149	        if ( pStats->HotspotRatios[i] < pStats->HotspotRatios[iMin] )
   150	            iMin = i;
   151	    if ( Ratio <= pStats->HotspotRatios[iMin] )
   152	        return;
   153	    pStats->HotspotAigIds[iMin] = AigId;
   154	    pStats->HotspotNodes[iMin] = NodeId;
   155	    pStats->HotspotRatios[iMin] = Ratio;
   156	    for ( k = iMin; k > 0 && pStats->HotspotRatios[k] > pStats->HotspotRatios[k-1]; k-- )
   157	    {
   158	        ABC_SWAP( int, pStats->HotspotAigIds[k], pStats->HotspotAigIds[k-1] );
   159	        ABC_SWAP( int, pStats->HotspotNodes[k], pStats->HotspotNodes[k-1] );
   160	        ABC_SWAP( float, pStats->HotspotRatios[k], pStats->HotspotRatios[k-1] );
   161	    }
   162	}
   163	
   164	static void Abc_Stmap39InsertConsumerFanins( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap39LoadStats_t * pStats, float Ratio, int Depth )
   165	{
   166	    Abc_Obj_t * pFanin;
   167	    int i, AigId;
   168	    if ( pObj == NULL || Ratio <= 1.0 || Depth <= 0 )
   169	        return;
   170	    Abc_ObjForEachFanin( pObj, pFanin, i )
   171	    {
   172	        AigId = Abc_Stmap39MappedObjAigId( pNtk, pFanin );
   173	        if ( AigId >= 0 )
   174	        {
   175	            pStats->nHotspotFanin++;
   176	            Abc_Stmap39HotspotInsert( pStats, AigId, Abc_ObjId(pFanin), Ratio );
   177	        }
   178	        Abc_Stmap39InsertConsumerFanins( pNtk, pFanin, pStats, 0.78 * Ratio, Depth - 1 );
   179	    }
   180	}
   180	}
   181	
   182	static void Abc_Stmap39CollectHotspotCone( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap39LoadStats_t * pStats, float Ratio )
   183	{
   184	    Abc_Obj_t * pFanout, * pFanout2;
   185	    int i, k, AigId;
   186	    if ( Ratio <= 1.0 )
   187	        return;
   188	    AigId = Abc_Stmap39MappedObjAigId( pNtk, pObj );
   189	    if ( AigId >= 0 )
   190	    {
   191	        pStats->nHotspotRoots++;
   192	        Abc_Stmap39HotspotInsert( pStats, AigId, Abc_ObjId(pObj), 0.90 * Ratio );
   193	    }
   194	    Abc_ObjForEachFanout( pObj, pFanout, i )
   195	    {
   196	        AigId = Abc_Stmap39MappedObjAigId( pNtk, pFanout );
   197	        if ( AigId >= 0 )
   198	        {
   199	            pStats->nHotspotFanout++;
   200	            Abc_Stmap39HotspotInsert( pStats, AigId, Abc_ObjId(pFanout), Ratio );
   201	        }
   202	        Abc_Stmap39InsertConsumerFanins( pNtk, pFanout, pStats, 0.86 * Ratio, 3 );
   203	        Abc_ObjForEachFanout( pFanout, pFanout2, k )
   204	        {
   205	            AigId = Abc_Stmap39MappedObjAigId( pNtk, pFanout2 );
   206	            if ( AigId < 0 )
   207	                continue;
   208	            pStats->nHotspotFanout++;
   209	            Abc_Stmap39HotspotInsert( pStats, AigId, Abc_ObjId(pFanout2), 0.66 * Ratio );
   210	        }
   211	    }
   212	}
   213	
   214	/**Function*************************************************************
   215	
   216	  Synopsis    [Returns direct SCL input-pin load driven by a mapped node.]
   217	
   218	  Description []
   219	
   220	  SideEffects []
   221	
   222	  SeeAlso     []
   223	
   224	***********************************************************************/
   225	static float Abc_Stmap39FanoutLoad( SC_Lib * pLib, Abc_Obj_t * pObj, int * pFanouts, int * pPins )
   226	{
   227	    Abc_Obj_t * pFanout;
   228	    Mio_Gate_t * pGateFan;
   229	    SC_Cell * pCellFan;
   230	    float Load = 0.0;
   231	    int i, iFanin, CellId;
   232	    *pFanouts = 0;
   233	    *pPins = 0;
   234	    Abc_ObjForEachFanout( pObj, pFanout, i )
   235	    {
   236	        (*pFanouts)++;
   237	        if ( !Abc_ObjIsNode(pFanout) || pFanout->pData == NULL )
   238	            continue;
   239	        iFanin = Abc_NodeFindFanin( pFanout, pObj );
   240	        if ( iFanin < 0 )
   241	            continue;
   242	        pGateFan = (Mio_Gate_t *)pFanout->pData;
   243	        CellId = Abc_SclCellFind( pLib, Mio_GateReadName(pGateFan) );
   244	        if ( CellId < 0 )
   245	            continue;
   246	        pCellFan = SC_LibCell( pLib, CellId );
   247	        if ( pCellFan == NULL || iFanin >= pCellFan->n_inputs )
   248	            continue;
   249	        Load += SC_CellPinCap( pCellFan, iFanin );
   250	        (*pPins)++;
   251	    }
   252	    return Load;
   253	}
   254	
   255	/**Function*************************************************************
   256	
   257	  Synopsis    [Prints direct SCL load diagnostics for the mapped network.]
   258	
   259	  Description []
   260	
   261	  SideEffects []
   262	
   263	  SeeAlso     []
   264	
   265	***********************************************************************/
   266	static void Abc_Stmap39CollectSclLoadStats( Abc_Ntk_t * pNtk, Abc_Stmap39LoadStats_t * pStats )
   267	{
   268	    SC_Lib * pLib = (SC_Lib *)Abc_FrameReadLibScl();
   269	    Abc_Obj_t * pObj;
   270	    Mio_Gate_t * pGate;
   271	    SC_Cell * pCell;
   272	    float Load, MaxCap, Ratio;
   273	    int i, CellId, Fanouts, Pins;
   274	    Abc_Stmap39LoadStatsClear( pStats );
   275	    if ( pLib == NULL || !Abc_SclHasDelayInfo(pLib) )
   276	        return;
   277	    pStats->fAvailable = 1;
   278	    Abc_NtkForEachNode( pNtk, pObj, i )
   279	    {
   280	        pStats->nNodes++;
   281	        if ( pObj->pData == NULL )
   282	            continue;
   283	        pGate = (Mio_Gate_t *)pObj->pData;
   284	        CellId = Abc_SclCellFind( pLib, Mio_GateReadName(pGate) );
   285	        if ( CellId < 0 )
   286	            continue;
   287	        pCell = SC_LibCell( pLib, CellId );
   288	        if ( pCell == NULL || pCell->n_outputs == 0 )
   289	            continue;
   290	        MaxCap = SC_CellPin( pCell, pCell->n_inputs )->max_out_cap;
   291	        if ( MaxCap <= 0.0 )
   292	            continue;
   293	        Load = Abc_Stmap39FanoutLoad( pLib, pObj, &Fanouts, &Pins );
   294	        Ratio = Load / MaxCap;
   295	        pStats->RatioSum += Ratio;
   296	        if ( pStats->RatioMax < Ratio )
   297	            pStats->RatioMax = Ratio;
   298	        if ( Ratio > 1.0 )
   299	            pStats->nOver++;
   300	        pStats->nMatched++;
   301	        pStats->nPins += Pins;
   302	        Abc_Stmap39TopInsert( pStats->TopRatios, pStats->TopNodes, pStats->pTopGates, pStats->TopFanouts, pStats->TopLoads, pStats->TopCaps,
   303	            Ratio, Abc_ObjId(pObj), Mio_GateReadName(pGate), Fanouts, Load, MaxCap );
   304	        Abc_Stmap39CollectHotspotCone( pNtk, pObj, pStats, Ratio );
   305	    }
   306	}
   307	
   308	static void Abc_Stmap39PrintSclLoadStats( const char * pLabel, Abc_Stmap39LoadStats_t * pStats )
   309	{
   310	    int i;
   311	    if ( !pStats->fAvailable )
   312	    {
   313	        printf( "stmap39 %s stats: unavailable = 1\n", pLabel );
   314	        return;
   315	    }
   316	    printf( "stmap39 %s stats: nodes = %d  matched = %d  fanout-pins = %d  over-max = %d  avg-load-ratio = %.3f  max-load-ratio = %.3f\n",
   317	        pLabel, pStats->nNodes, pStats->nMatched, pStats->nPins, pStats->nOver,
   318	        pStats->nMatched ? pStats->RatioSum / (float)pStats->nMatched : 0.0, pStats->RatioMax );
   319	    for ( i = 0; i < 5 && pStats->TopRatios[i] > 0.0; i++ )
   320	        printf( "stmap39 %s top: rank = %d  node = %d  gate = %s  fanouts = %d  load = %.3f  max-cap = %.3f  load-ratio = %.3f\n",
   321	            pLabel, i + 1, pStats->TopNodes[i], pStats->pTopGates[i] ? pStats->pTopGates[i] : "?",
   322	            pStats->TopFanouts[i], pStats->TopLoads[i], pStats->TopCaps[i], pStats->TopRatios[i] );
   323	}
   324	
   325	static void Abc_Stmap39PrintHotspots( Abc_Stmap39LoadStats_t * pStats )
   326	{
   327	    int i;
   328	    if ( !pStats->fAvailable )
   329	        return;
   330	    printf( "stmap39 consumer-pressure stats: roots = %d  consumer-fanin = %d  consumer-fanout = %d  selected = %d  capacity = %d  tracked-aig = %d  tracked-node = %d  tracked-ratio = %.3f\n",
   331	        pStats->nHotspotRoots, pStats->nHotspotFanin, pStats->nHotspotFanout,
   332	        pStats->nHotspots, ABC_STMAP39_MAX_HOTSPOTS, ABC_STMAP39_TRACK_AIG_ID,
   333	        pStats->TrackedNode, pStats->TrackedRatio );
   334	    for ( i = 0; i < pStats->nHotspots && i < 10; i++ )
   335	        printf( "stmap39 consumer-pressure: rank = %d  aig-id = %d  mapped-node = %d  consumer-load-ratio = %.3f\n",
   336	            i + 1, pStats->HotspotAigIds[i], pStats->HotspotNodes[i], pStats->HotspotRatios[i] );
   337	}
   338	
   339	static float Abc_Stmap39FeedbackSeverity( Abc_Stmap39LoadStats_t * pStats )
   340	{
   341	    float OverFrac, MaxPart, OverPart, Severity;
   342	    if ( !pStats->fAvailable || pStats->nMatched == 0 )
   343	        return 0.0;
   344	    OverFrac = (float)pStats->nOver / (float)pStats->nMatched;
   345	    MaxPart = pStats->RatioMax > 4.0 ? (pStats->RatioMax - 4.0) / 8.0 : 0.0;
   346	    OverPart = OverFrac > 0.002 ? (OverFrac - 0.002) / 0.006 : 0.0;
   347	    if ( MaxPart > 1.0 )
   348	        MaxPart = 1.0;
   349	    if ( OverPart > 1.0 )
   350	        OverPart = 1.0;
   351	    Severity = 0.65 * MaxPart + 0.35 * OverPart;
   352	    return Severity > 1.0 ? 1.0 : Severity;
   353	}
   354	
   355	/**Function*************************************************************
   356	
   357	  Synopsis    [Runs the stmap39 mapper probe.]
   358	
   359	  Description [stmap39 measures direct SCL load/max-cap pressure after an
   360	  initial map and feeds a consumer-pressure table into a second mapper pass,
   361	  including over-cap drivers, downstream consumers, and consumer fanin cones.]
   362	
   363	  SideEffects []
   364	
   365	  SeeAlso     []
   366	
   367	***********************************************************************/
   368	int Abc_CommandStmap39( Abc_Frame_t * pAbc, int argc, char ** argv )
   369	{
   370	    Abc_Ntk_t * pNtk, * pNtkMap, * pNtkRes, * pNtkFirst;
   371	    Abc_Stmap39LoadStats_t LoadStats;
   372	    char Buffer[100];
   373	    double DelayTarget;
   374	    double AreaMulti;
   375	    double DelayMulti;
   376	    float LogFan = 0;
   377	    float Slew = 0; // choose based on the library
   378	    float Gain = 250; // keep classic map gain to isolate the SCL load diagnostic
   379	    int nGatesMin = 0;
   380	    int fAreaOnly;
   380	    int fAreaOnly;
   381	    int fRecovery;
   382	    int fSweep;
   383	    int fSwitching;
   384	    int fSkipFanout;
   385	    int fUseProfile;
   386	    int fUseBuffs;
   387	    int fVerbose;
   388	    int c, fTempMap = 0;
   389	    float OverFrac, Feedback;
   390	    extern Abc_Ntk_t * Abc_NtkMap( Abc_Ntk_t * pNtk, Mio_Library_t* userLib, double DelayTarget, double AreaMulti, double DelayMulti, float LogFan, float Slew, float Gain, int nGatesMin, int fRecovery, int fSwitching, int fSkipFanout, int fUseProfile, int fUseBuffs, int fVerbose );
   391	    extern int Abc_NtkFraigSweep( Abc_Ntk_t * pNtk, int fUseInv, int fExdc, int fVerbose, int fVeryVerbose );
   392	    extern void Map_Stmap39SetSclLoadFeedback( float MaxLoadRatio, float OverFrac, float Severity, int * pAigIds, float * pRatios, int nHotspots );
   393	
   394	    pNtk = Abc_FrameReadNtk(pAbc);
   395	    DelayTarget = -1;
   396	    AreaMulti   = 0;
   397	    DelayMulti  = 0;
   398	    fAreaOnly   = 0;
   399	    fRecovery   = 1;
   400	    fSweep      = 0;
   401	    fSwitching  = 0;
   402	    fSkipFanout = 40; // consumer-pressure SCL feedback pass over the stmap35 mapper surface; -f disables it
   403	    fUseProfile = 0;
   404	    fUseBuffs   = 0;
   405	    fVerbose    = 0;
   406	    Extra_UtilGetoptReset();
   407	    while ( ( c = Extra_UtilGetopt( argc, argv, "DABFSGMarspfuovh" ) ) != EOF )
   408	    {
   409	        switch ( c )
   410	        {
   411	        case 'D':
   412	            if ( globalUtilOptind >= argc )
   413	            {
   414	                Abc_Print( -1, "Command line switch \"-D\" should be followed by a floating point number.\n" );
   415	                goto usage;
   416	            }
   417	            DelayTarget = (float)atof(argv[globalUtilOptind]);
   418	            globalUtilOptind++;
   419	            if ( DelayTarget <= 0.0 )
   420	                goto usage;
   421	            break;
   422	        case 'A':
   423	            if ( globalUtilOptind >= argc )
   424	            {
   425	                Abc_Print( -1, "Command line switch \"-A\" should be followed by a floating point number.\n" );
   426	                goto usage;
   427	            }
   428	            AreaMulti = (float)atof(argv[globalUtilOptind]);
   429	            globalUtilOptind++;
   430	            break;
   431	        case 'B':
   432	            if ( globalUtilOptind >= argc )
   433	            {
   434	                Abc_Print( -1, "Command line switch \"-B\" should be followed by a floating point number.\n" );
   435	                goto usage;
   436	            }
   437	            DelayMulti = (float)atof(argv[globalUtilOptind]);
   438	            globalUtilOptind++;
   439	            break;
   440	        case 'F':
   441	            if ( globalUtilOptind >= argc )
   442	            {
   443	                Abc_Print( -1, "Command line switch \"-F\" should be followed by a floating point number.\n" );
   444	                goto usage;
   445	            }
   446	            LogFan = (float)atof(argv[globalUtilOptind]);
   447	            globalUtilOptind++;
   448	            if ( LogFan < 0.0 )
   449	                goto usage;
   450	            break;
   451	        case 'S':
   452	            if ( globalUtilOptind >= argc )
   453	            {
   454	                Abc_Print( -1, "Command line switch \"-S\" should be followed by a floating point number.\n" );
   455	                goto usage;
   456	            }
   457	            Slew = (float)atof(argv[globalUtilOptind]);
   458	            globalUtilOptind++;
   459	            if ( Slew <= 0.0 )
   460	                goto usage;
   461	            break;
   462	        case 'G':
   463	            if ( globalUtilOptind >= argc )
   464	            {
   465	                Abc_Print( -1, "Command line switch \"-G\" should be followed by a floating point number.\n" );
   466	                goto usage;
   467	            }
   468	            Gain = (float)atof(argv[globalUtilOptind]);
   469	            globalUtilOptind++;
   470	            if ( Gain <= 0.0 )
   471	                goto usage;
   472	            break;
   473	        case 'M':
   474	            if ( globalUtilOptind >= argc )
   475	            {
   476	                Abc_Print( -1, "Command line switch \"-M\" should be followed by a positive integer.\n" );
   477	                goto usage;
   478	            }
   479	            nGatesMin = atoi(argv[globalUtilOptind]);
   480	            globalUtilOptind++;
   481	            if ( nGatesMin < 0 )
   482	                goto usage;
   483	            break;
   484	        case 'a':
   485	            fAreaOnly ^= 1;
   486	            break;
   487	        case 'r':
   488	            fRecovery ^= 1;
   489	            break;
   490	        case 's':
   491	            fSweep ^= 1;
   492	            break;
   493	        case 'p':
   494	            fSwitching ^= 1;
   495	            break;
   496	        case 'f':
   497	            fSkipFanout = fSkipFanout ? 0 : 40;
   498	            break;
   499	        case 'u':
   500	            fUseProfile ^= 1;
   501	            break;
   502	        case 'o':
   503	            fUseBuffs ^= 1;
   504	            break;
   505	        case 'v':
   506	            fVerbose ^= 1;
   507	            break;
   508	        case 'h':
   509	            goto usage;
   510	        default:
   511	            goto usage;
   512	        }
   513	    }
   514	
   515	    if ( pNtk == NULL )
   516	    {
   517	        Abc_Print( -1, "Empty network.\n" );
   518	        return 1;
   519	    }
   520	
   521	    if ( fAreaOnly )
   522	        DelayTarget = ABC_INFINITY;
   523	
   524	    Map_Stmap39SetSclLoadFeedback( 0.0, 0.0, 0.0, NULL, NULL, 0 );
   525	    pNtkMap = pNtk;
   526	    if ( !Abc_NtkIsStrash(pNtk) )
   527	    {
   528	        pNtkMap = Abc_NtkStrash( pNtk, 0, 0, 0 );
   529	        if ( pNtkMap == NULL )
   530	        {
   531	            Abc_Print( -1, "Strashing before stmap39 has failed.\n" );
   532	            return 1;
   533	        }
   534	        pNtkMap = Abc_NtkBalance( pNtkRes = pNtkMap, 0, 0, 1 );
   535	        Abc_NtkDelete( pNtkRes );
   536	        if ( pNtkMap == NULL )
   537	        {
   538	            Abc_Print( -1, "Balancing before stmap39 has failed.\n" );
   539	            return 1;
   540	        }
   541	        fTempMap = 1;
   542	        Abc_Print( 0, "The network was strashed and balanced before stmap39.\n" );
   543	    }
   544	
   545	    if ( fSkipFanout )
   546	    {
   547	        pNtkFirst = Abc_NtkMap( pNtkMap, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, Gain, nGatesMin, fRecovery, fSwitching, 36, fUseProfile, fUseBuffs, fVerbose );
   548	        if ( pNtkFirst == NULL )
   549	        {
   550	            if ( fTempMap )
   551	                Abc_NtkDelete( pNtkMap );
   552	            Abc_Print( -1, "stmap39 has failed.\n" );
   553	            return 1;
   554	        }
   555	        Abc_Stmap39CollectSclLoadStats( pNtkFirst, &LoadStats );
   556	        Abc_Stmap39PrintSclLoadStats( "feedback-load", &LoadStats );
   557	        Abc_Stmap39PrintHotspots( &LoadStats );
   558	        OverFrac = LoadStats.nMatched ? (float)LoadStats.nOver / (float)LoadStats.nMatched : 0.0;
   559	        Feedback = Abc_Stmap39FeedbackSeverity( &LoadStats );
   560	        printf( "stmap39 feedback: remap = 1  active = %d  max-load-ratio = %.3f  over-max-frac = %.6f  severity = %.3f  consumer-pressures = %d\n",
   561	            Feedback > 0.0 && LoadStats.nHotspots > 0, LoadStats.RatioMax, OverFrac, Feedback, LoadStats.nHotspots );
   562	        Abc_NtkDelete( pNtkFirst );
   563	        Map_Stmap39SetSclLoadFeedback( LoadStats.RatioMax, OverFrac, Feedback, LoadStats.HotspotAigIds, LoadStats.HotspotRatios, LoadStats.nHotspots );
   564	        pNtkRes = Abc_NtkMap( pNtkMap, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, Gain, nGatesMin, fRecovery, fSwitching, 40, fUseProfile, fUseBuffs, fVerbose );
   565	        Map_Stmap39SetSclLoadFeedback( 0.0, 0.0, 0.0, NULL, NULL, 0 );
   566	        if ( pNtkRes == NULL )
   567	        {
   568	            if ( fTempMap )
