   737	static void Abc_Stmap76PrintFanoutContext( SC_Man * pTime, Abc_Obj_t * pObj, int WatchIndex, int WatchAigId, int Phase, float Criticality, float Slack, float LoadRatio )
   738	{
   739	    Abc_Obj_t * pFanout, * pBestFanout = NULL;
   740	    Mio_Gate_t * pGate, * pBestGate;
   741	    float FanoutCriticality, FanoutSlack, BestFanoutCriticality = -1.0, BestFanoutSlack = 0.0;
   742	    int i, nCoFanouts = 0, nNodeFanouts = 0;
   743	    int BestFanoutAigId = -1, BestFanoutPhase = -1;
   744	
   745	    if ( pTime == NULL || pTime->pNtk == NULL || pObj == NULL )
   746	        return;
   747	    Abc_ObjForEachFanout( pObj, pFanout, i )
   748	    {
   749	        if ( Abc_ObjIsCo(pFanout) )
   750	        {
   751	            nCoFanouts++;
   752	            continue;
   753	        }
   754	        if ( !Abc_ObjIsNode(pFanout) )
   755	            continue;
   756	        nNodeFanouts++;
   757	        FanoutCriticality = Abc_Stmap64FinalCriticality( pTime, pFanout, &FanoutSlack );
   758	        if ( pBestFanout == NULL || FanoutCriticality > BestFanoutCriticality ||
   759	             (FanoutCriticality == BestFanoutCriticality && FanoutSlack < BestFanoutSlack) )
   760	        {
   761	            pBestFanout = pFanout;
   762	            BestFanoutCriticality = FanoutCriticality;
   763	            BestFanoutSlack = FanoutSlack;
   764	            Abc_Stmap76ObjAigPhase( pTime->pNtk, pFanout, &BestFanoutAigId, &BestFanoutPhase );
   765	        }
   766	    }
   767	    pGate = pObj ? (Mio_Gate_t *)pObj->pData : NULL;
   768	    pBestGate = pBestFanout ? (Mio_Gate_t *)pBestFanout->pData : NULL;
   769	    printf( "%s phase-output-context: watch-index = %d  aig-id = %d  phase = %d  top-node = %d  top-gate = %s  top-criticality = %.3f  top-slack = %.6f  top-load-ratio = %.3f  final-fanouts = %d  node-fanouts = %d  co-fanouts = %d  best-fanout-node = %d  best-fanout-aig-id = %d  best-fanout-phase = %d  best-fanout-gate = %s  best-fanout-criticality = %.3f  best-fanout-slack = %.6f\n",
   770	        s_pStmap76PhaseSurvivalLabel, WatchIndex, WatchAigId, Phase, Abc_ObjId(pObj),
   771	        pGate ? Mio_GateReadName(pGate) : "?", Criticality, Slack, LoadRatio,
   772	        Abc_ObjFanoutNum(pObj), nNodeFanouts, nCoFanouts,
   773	        pBestFanout ? Abc_ObjId(pBestFanout) : -1, BestFanoutAigId, BestFanoutPhase,
   774	        pBestGate ? Mio_GateReadName(pBestGate) : "?", pBestFanout ? BestFanoutCriticality : 0.0,
   775	        pBestFanout ? BestFanoutSlack : 0.0 );
   776	}
   777	
   778	static void Abc_Stmap76PrintPhaseSurvival( SC_Man * pTime )
   779	{
   780	    Abc_Ntk_t * pNtk;
   781	    Abc_Obj_t * pObj;
   782	    Mio_Gate_t * pGate0, * pGate1;
   783	    float BestCriticality[ABC_STMAP76_MAX_WATCH_AIGS][2];
   784	    float BestSlack[ABC_STMAP76_MAX_WATCH_AIGS][2];
   785	    float BestLoadRatio[ABC_STMAP76_MAX_WATCH_AIGS][2];
   786	    int Counts[ABC_STMAP76_MAX_WATCH_AIGS][2];
   787	    int BestNode[ABC_STMAP76_MAX_WATCH_AIGS][2];
   788	    int i, k, AigId, Phase, WatchIndex, nMatchedAigs = 0;
   789	    float Criticality, Slack, LoadRatio;
   790	
   791	    if ( !s_fStmap76PhaseSurvivalScope )
   792	        return;
   793	    if ( pTime == NULL || pTime->pNtk == NULL ||
   794	         pTime->pNtk != s_pStmap76PhaseSurvivalNtk ||
   795	         pTime->pNtk->vOrigNodeIds == NULL ||
   796	         pTime->pNtk->vOrigNodeIds != s_pStmap76PhaseSurvivalOrigIds )
   797	    {
   798	        Abc_Stmap76ClearPhaseSurvivalScope();
   799	        return;
   800	    }
   801	    pNtk = pTime->pNtk;
   802	    for ( i = 0; i < ABC_STMAP76_MAX_WATCH_AIGS; i++ )
   803	    {
   804	        for ( k = 0; k < 2; k++ )
   805	        {
   806	            Counts[i][k] = 0;
   807	            BestNode[i][k] = -1;
   808	            BestCriticality[i][k] = -1.0;
   809	            BestSlack[i][k] = 0.0;
   810	            BestLoadRatio[i][k] = 0.0;
   811	        }
   812	    }
   813	    Abc_NtkForEachNode( pNtk, pObj, i )
   814	    {
   815	        if ( !Abc_Stmap76ObjAigPhase( pNtk, pObj, &AigId, &Phase ) )
   816	            continue;
   817	        WatchIndex = Abc_Stmap76WatchIndex( AigId );
   818	        if ( WatchIndex < 0 || Phase < 0 || Phase > 1 )
   819	            continue;
   820	        Counts[WatchIndex][Phase]++;
   821	        Criticality = Abc_Stmap64FinalCriticality( pTime, pObj, &Slack );
   822	        LoadRatio = Abc_Stmap64FinalLoadRatio( pTime, pObj, NULL, NULL );
   823	        if ( BestNode[WatchIndex][Phase] < 0 || Criticality > BestCriticality[WatchIndex][Phase] ||
   824	             (Criticality == BestCriticality[WatchIndex][Phase] && Slack < BestSlack[WatchIndex][Phase]) ||
   825	             (Criticality == BestCriticality[WatchIndex][Phase] && Slack == BestSlack[WatchIndex][Phase] && LoadRatio > BestLoadRatio[WatchIndex][Phase]) )
   826	        {
   827	            BestNode[WatchIndex][Phase] = Abc_ObjId(pObj);
   828	            BestCriticality[WatchIndex][Phase] = Criticality;
   829	            BestSlack[WatchIndex][Phase] = Slack;
   830	            BestLoadRatio[WatchIndex][Phase] = LoadRatio;
   831	        }
   832	    }
   833	    for ( i = 0; i < s_nStmap76WatchAigs; i++ )
   834	        if ( Counts[i][0] + Counts[i][1] > 0 )
   835	            nMatchedAigs++;
   836	    printf( "%s phase-survival stats: watched-aigs = %d  matched-aigs = %d  final-delay = %.3f\n",
   837	        s_pStmap76PhaseSurvivalLabel, s_nStmap76WatchAigs, nMatchedAigs, pTime->MaxDelay );
   838	    for ( i = 0; i < s_nStmap76WatchAigs; i++ )
   839	    {
   840	        pGate0 = BestNode[i][0] >= 0 && (pObj = Abc_NtkObj( pNtk, BestNode[i][0] )) ? (Mio_Gate_t *)pObj->pData : NULL;
   841	        pGate1 = BestNode[i][1] >= 0 && (pObj = Abc_NtkObj( pNtk, BestNode[i][1] )) ? (Mio_Gate_t *)pObj->pData : NULL;
   842	        printf( "%s phase-survival: watch-index = %d  aig-id = %d  final-nodes = %d  phase0-nodes = %d  phase0-best-node = %d  phase0-best-gate = %s  phase0-best-criticality = %.3f  phase0-best-slack = %.6f  phase0-best-load-ratio = %.3f  phase1-nodes = %d  phase1-best-node = %d  phase1-best-gate = %s  phase1-best-criticality = %.3f  phase1-best-slack = %.6f  phase1-best-load-ratio = %.3f\n",
   843	            s_pStmap76PhaseSurvivalLabel, i, s_Stmap76WatchAigIds[i], Counts[i][0] + Counts[i][1],
   844	            Counts[i][0], BestNode[i][0], pGate0 ? Mio_GateReadName(pGate0) : "?",
   845	            BestNode[i][0] >= 0 ? BestCriticality[i][0] : 0.0,
   846	            BestNode[i][0] >= 0 ? BestSlack[i][0] : 0.0,
   847	            BestNode[i][0] >= 0 ? BestLoadRatio[i][0] : 0.0,
   848	            Counts[i][1], BestNode[i][1], pGate1 ? Mio_GateReadName(pGate1) : "?",
   849	            BestNode[i][1] >= 0 ? BestCriticality[i][1] : 0.0,
   850	            BestNode[i][1] >= 0 ? BestSlack[i][1] : 0.0,
   851	            BestNode[i][1] >= 0 ? BestLoadRatio[i][1] : 0.0 );
   852	        for ( k = 0; k < 2; k++ )
   853	            if ( BestNode[i][k] >= 0 )
   854	                Abc_Stmap76PrintFanoutContext( pTime, Abc_NtkObj( pNtk, BestNode[i][k] ), i, s_Stmap76WatchAigIds[i], k, BestCriticality[i][k], BestSlack[i][k], BestLoadRatio[i][k] );
   855	    }
   856	    Abc_Stmap76ClearPhaseSurvivalScope();
   857	}
