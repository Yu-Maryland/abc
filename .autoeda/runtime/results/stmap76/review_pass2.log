  1674	static void Map_Stmap64WriteWitnessSlot( int i, Map_Node_t * pNode, int AigId, int fPhase, float NodePressureRatio, float CutPressureRatio, float Slack, float AreaSave, float ArrivalDelta, float ArrivalGainMargin )
  1675	{
  1676	    s_Stmap64WitnessAigIds[i] = AigId;
  1677	    s_Stmap64WitnessPhases[i] = fPhase ? 1 : 0;
  1678	    s_Stmap64WitnessNodes[i] = pNode->Num;
  1679	    s_Stmap64WitnessNodePressureRatios[i] = NodePressureRatio;
  1680	    s_Stmap64WitnessCutPressureRatios[i] = CutPressureRatio;
  1681	    s_Stmap64WitnessSlacks[i] = Slack;
  1682	    s_Stmap64WitnessAreaSaves[i] = AreaSave;
  1683	    s_Stmap64WitnessArrivalDeltas[i] = ArrivalDelta;
  1684	    s_Stmap64WitnessArrivalGainMargins[i] = ArrivalGainMargin;
  1685	    s_Stmap64WitnessFeedbacks[i] = s_Stmap45SclFeedback;
  1686	}
  1687	
  1688	static void Map_Stmap64RecordCutOnlyWitnessRaw( Map_Node_t * pNode, int AigId, int fPhase, float NodePressureRatio, float CutPressureRatio, float Slack, float AreaSave, float ArrivalDelta, float ArrivalGainMargin )
  1689	{
  1690	    int i;
  1691	    if ( pNode == NULL || AigId < 0 )
  1692	        return;
  1693	    fPhase = fPhase ? 1 : 0;
  1694	    for ( i = 0; i < s_nStmap64CutOnlyWitnesses; i++ )
  1695	    {
  1696	        if ( s_Stmap64WitnessAigIds[i] != AigId || s_Stmap64WitnessPhases[i] != fPhase )
  1697	            continue;
  1698	        Map_Stmap64WriteWitnessSlot( i, pNode, AigId, fPhase, NodePressureRatio, CutPressureRatio, Slack, AreaSave, ArrivalDelta, ArrivalGainMargin );
  1699	        return;
  1700	    }
  1701	    if ( s_nStmap64CutOnlyWitnesses >= MAP_STMAP64_MAX_WITNESSES )
  1702	        return;
  1703	    i = s_nStmap64CutOnlyWitnesses++;
  1704	    Map_Stmap64WriteWitnessSlot( i, pNode, AigId, fPhase, NodePressureRatio, CutPressureRatio, Slack, AreaSave, ArrivalDelta, ArrivalGainMargin );
  1705	}
  1706	
  1707	static void Map_Stmap64RecordCutOnlyWitness( Map_Node_t * pNode, int AigId, int fPhase, float NodePressureRatio, float CutPressureRatio, float Slack, float AreaSave, float ArrivalDelta, float ArrivalGainMargin )
  1708	{
  1709	    if ( !s_fStmap64CutOnlyWitnessDiag )
  1710	        return;
  1711	    Map_Stmap64RecordCutOnlyWitnessRaw( pNode, AigId, fPhase, NodePressureRatio, CutPressureRatio, Slack, AreaSave, ArrivalDelta, ArrivalGainMargin );
  1712	}
