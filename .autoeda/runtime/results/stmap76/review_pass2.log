   635	        s_pStmap64FinalWitnessNtk = pNewNtk;
   636	        s_pStmap64FinalWitnessOrigIds = pNewOrigNodeIds;
   637	    }
   638	    if ( s_fStmap74FinalCriticalScope &&
   639	         s_pStmap74FinalCriticalNtk == pOldNtk &&
   640	         s_pStmap74FinalCriticalOrigIds == pOldOrigNodeIds )
   641	    {
   642	        s_pStmap74FinalCriticalNtk = pNewNtk;
   643	        s_pStmap74FinalCriticalOrigIds = pNewOrigNodeIds;
   644	    }
   645	    if ( s_fStmap76PhaseSurvivalScope &&
   646	         s_pStmap76PhaseSurvivalNtk == pOldNtk &&
   647	         s_pStmap76PhaseSurvivalOrigIds == pOldOrigNodeIds )
   648	    {
   649	        s_pStmap76PhaseSurvivalNtk = pNewNtk;
   650	        s_pStmap76PhaseSurvivalOrigIds = pNewOrigNodeIds;
   651	    }
   652	}
