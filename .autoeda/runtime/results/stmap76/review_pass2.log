+    float BestSlack[ABC_STMAP76_MAX_WATCH_AIGS][2];
+    float BestLoadRatio[ABC_STMAP76_MAX_WATCH_AIGS][2];
+    int Counts[ABC_STMAP76_MAX_WATCH_AIGS][2];
+    int BestNode[ABC_STMAP76_MAX_WATCH_AIGS][2];
