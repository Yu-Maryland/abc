   859	static void Abc_Stmap74PrintFinalCriticalLineage( SC_Man * pTime )
   860	{
   861	    enum { ABC_STMAP74_TOP = 12 };
   862	    Abc_Ntk_t * pNtk;
   863	    Abc_Obj_t * pObj;
   864	    Mio_Gate_t * pGate;
   865	    float TopCriticality[ABC_STMAP74_TOP], TopSlack[ABC_STMAP74_TOP], TopLoad[ABC_STMAP74_TOP];
   866	    float TopMaxCap[ABC_STMAP74_TOP], TopLoadRatio[ABC_STMAP74_TOP], TopArrival[ABC_STMAP74_TOP];
   867	    float TopDeparture[ABC_STMAP74_TOP], TopSlew[ABC_STMAP74_TOP];
   868	    int TopObjs[ABC_STMAP74_TOP], TopAigIds[ABC_STMAP74_TOP], TopPhases[ABC_STMAP74_TOP];
   869	    int i, k, nNodes = 0, nGe050 = 0, nGe075 = 0, nSlack5 = 0;
   870	    int ObjId, Lit, AigId, Phase, Fanouts, Slot;
   871	    float Slack, Criticality, Load, MaxCap, LoadRatio, Arrival, Departure, Slew;
   872	
   873	    if ( !s_fStmap74FinalCriticalScope )
   874	        return;
   875	    if ( pTime == NULL || pTime->pNtk == NULL ||
   876	         pTime->pNtk != s_pStmap74FinalCriticalNtk ||
   877	         pTime->pNtk->vOrigNodeIds == NULL ||
   878	         pTime->pNtk->vOrigNodeIds != s_pStmap74FinalCriticalOrigIds )
   879	    {
   880	        Abc_Stmap74ClearFinalCriticalScope();
   881	        return;
   882	    }
   883	    pNtk = pTime->pNtk;
   884	    for ( i = 0; i < ABC_STMAP74_TOP; i++ )
   885	    {
   886	        TopObjs[i] = -1;
   887	        TopAigIds[i] = -1;
   888	        TopPhases[i] = -1;
   889	        TopCriticality[i] = TopLoadRatio[i] = TopLoad[i] = TopMaxCap[i] = 0.0;
   890	        TopSlack[i] = TopArrival[i] = TopDeparture[i] = TopSlew[i] = 0.0;
   891	    }
   892	    Abc_NtkForEachNode( pNtk, pObj, i )
   893	    {
   894	        nNodes++;
   895	        Criticality = Abc_Stmap64FinalCriticality( pTime, pObj, &Slack );
   896	        if ( Criticality >= 0.50 )
   897	            nGe050++;
   898	        if ( Criticality >= 0.75 )
   899	            nGe075++;
   900	        if ( Slack <= 5.0 )
   901	            nSlack5++;
   902	        LoadRatio = Abc_Stmap64FinalLoadRatio( pTime, pObj, &Load, &MaxCap );
   903	        Arrival = Abc_SclObjTimeMax( pTime, pObj );
   904	        Departure = Abc_MaxFloat( Abc_SclObjDept( pTime, pObj )->rise, Abc_SclObjDept( pTime, pObj )->fall );
   905	        Slew = (float)Abc_SclObjSlewMax( pTime, pObj );
   906	        Slot = -1;
   907	        for ( k = 0; k < ABC_STMAP74_TOP; k++ )
   908	        {
   909	            if ( TopObjs[k] < 0 || Criticality > TopCriticality[k] ||
   910	                 (Criticality == TopCriticality[k] && Slack < TopSlack[k]) ||
   911	                 (Criticality == TopCriticality[k] && Slack == TopSlack[k] && LoadRatio > TopLoadRatio[k]) )
   912	            {
   913	                Slot = k;
   914	                break;
   915	            }
   916	        }
   917	        if ( Slot < 0 )
   918	            continue;
   919	        for ( k = ABC_STMAP74_TOP - 1; k > Slot; k-- )
   920	        {
   921	            TopObjs[k] = TopObjs[k-1];
   922	            TopAigIds[k] = TopAigIds[k-1];
   923	            TopPhases[k] = TopPhases[k-1];
   924	            TopCriticality[k] = TopCriticality[k-1];
   925	            TopSlack[k] = TopSlack[k-1];
   926	            TopLoad[k] = TopLoad[k-1];
   927	            TopMaxCap[k] = TopMaxCap[k-1];
   928	            TopLoadRatio[k] = TopLoadRatio[k-1];
   929	            TopArrival[k] = TopArrival[k-1];
   930	            TopDeparture[k] = TopDeparture[k-1];
   931	            TopSlew[k] = TopSlew[k-1];
   932	        }
   933	        ObjId = Abc_ObjId(pObj);
   934	        Lit = ObjId < Vec_IntSize(pNtk->vOrigNodeIds) ? Vec_IntEntry( pNtk->vOrigNodeIds, ObjId ) : -1;
   935	        AigId = Lit >= 0 ? Abc_Lit2Var(Lit) : -1;
   936	        Phase = Lit >= 0 ? Abc_LitIsCompl(Lit) : -1;
   937	        TopObjs[Slot] = ObjId;
   938	        TopAigIds[Slot] = AigId;
   939	        TopPhases[Slot] = Phase;
   940	        TopCriticality[Slot] = Criticality;
   941	        TopSlack[Slot] = Slack;
   942	        TopLoad[Slot] = Load;
   943	        TopMaxCap[Slot] = MaxCap;
   944	        TopLoadRatio[Slot] = LoadRatio;
   945	        TopArrival[Slot] = Arrival;
   946	        TopDeparture[Slot] = Departure;
   947	        TopSlew[Slot] = Slew;
   948	    }
   949	    printf( "%s final-critical stats: nodes = %d  final-delay = %.3f  criticality-ge-0p50 = %d  criticality-ge-0p75 = %d  slack-le-5ps = %d\n",
   950	        s_pStmap74FinalCriticalLabel, nNodes, pTime->MaxDelay, nGe050, nGe075, nSlack5 );
   951	    for ( i = 0; i < ABC_STMAP74_TOP && TopObjs[i] >= 0; i++ )
   952	    {
   953	        pObj = Abc_NtkObj( pNtk, TopObjs[i] );
   954	        pGate = pObj ? (Mio_Gate_t *)pObj->pData : NULL;
   955	        Fanouts = pObj ? Abc_ObjFanoutNum(pObj) : 0;
   956	        printf( "%s final-critical lineage: rank = %d  final-node = %d  aig-id = %d  phase = %d  final-gate = %s  final-fanouts = %d  final-criticality = %.3f  final-slack = %.6f  final-arrival = %.6f  final-departure = %.6f  final-slew = %.6f  final-load = %.3f  final-max-cap = %.3f  final-load-ratio = %.3f\n",
   957	            s_pStmap74FinalCriticalLabel, i + 1, TopObjs[i], TopAigIds[i], TopPhases[i],
   958	            pGate ? Mio_GateReadName(pGate) : "?", Fanouts, TopCriticality[i], TopSlack[i],
   959	            TopArrival[i], TopDeparture[i], TopSlew[i], TopLoad[i], TopMaxCap[i],
   960	            TopLoadRatio[i] );
   961	    }
   962	    Abc_Stmap76PrintPhaseSurvival( pTime );
   963	    Abc_Stmap74ClearFinalCriticalScope();
   964	}
