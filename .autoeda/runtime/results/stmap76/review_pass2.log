   707	static int Abc_Stmap76WatchIndex( int AigId )
   708	{
   709	    int i;
   710	    for ( i = 0; i < s_nStmap76WatchAigs; i++ )
   711	        if ( s_Stmap76WatchAigIds[i] == AigId )
   712	            return i;
