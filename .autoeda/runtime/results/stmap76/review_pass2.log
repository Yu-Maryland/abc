  1721	static void Map_Stmap68RecordBlockedStrongWitness( Map_Node_t * pNode, Map_Cut_t * pCut, int AigId, int fPhase, float NodePressureRatio, float CutPressureRatio, float Slack, float AreaSave, float ArrivalDelta, float ArrivalGainMargin, float PenaltyFactor, float AreaMargin, float CutLeafLoadAvg, int FanLimit, float LoadDriveRatio )
  1722	{
  1723	    const char * pLabel;
  1724	    int i, Before, After, fDuplicate = 0;
  1725	    if ( (!s_fStmap68BlockedStrongWitnessDiag && !s_fStmap72PathProximityWitnessDiag) || pNode == NULL || AigId < 0 )
  1726	        return;
  1727	    pLabel = s_fStmap72PathProximityWitnessDiag ? "stmap72" : "stmap68";
  1728	    fPhase = fPhase ? 1 : 0;
  1729	    s_nStmap68BlockedStrongWitnessSources++;
  1730	    for ( i = 0; i < s_nStmap64CutOnlyWitnesses; i++ )
  1731	    {
  1732	        if ( s_Stmap64WitnessAigIds[i] == AigId && s_Stmap64WitnessPhases[i] == fPhase )
  1733	        {
  1734	            fDuplicate = 1;
  1735	            break;
  1736	        }
  1737	    }
  1738	    Before = s_nStmap64CutOnlyWitnesses;
  1739	    if ( !fDuplicate )
  1740	        Map_Stmap64RecordCutOnlyWitnessRaw( pNode, AigId, fPhase, NodePressureRatio, CutPressureRatio, Slack, AreaSave, ArrivalDelta, ArrivalGainMargin );
  1741	    After = s_nStmap64CutOnlyWitnesses;
  1742	    if ( s_nStmap68BlockedStrongWitnessSources <= 64 )
  1743	        printf( "%s blocked-strong witness source: index = %d  node = %d  aig-id = %d  level = %u  refs = %d  leaves = %d  phase = %d  stored = %d  duplicate = %d  slack = %.6f  area-save = %.6f  arrival-delta = %.6f  arrival-gain-margin = %.6f  penalty-factor = %.3f  area-margin = %.6f  cut-leaf-load-avg = %.3f  fanout-limit = %d  load-drive-ratio = %.3f  node-sink-pressure-ratio = %.3f  cut-sink-pressure-ratio = %.3f  scl-feedback = %.3f\n",
  1744	            pLabel, s_nStmap68BlockedStrongWitnessSources, pNode->Num, AigId, pNode->Level, pNode->nRefs,
  1745	            pCut ? (int)pCut->nLeaves : 0, fPhase, After > Before, fDuplicate, Slack, AreaSave,
  1746	            ArrivalDelta, ArrivalGainMargin, PenaltyFactor, AreaMargin, CutLeafLoadAvg, FanLimit,
  1747	            LoadDriveRatio, NodePressureRatio, CutPressureRatio, s_Stmap45SclFeedback );
  1748	}
