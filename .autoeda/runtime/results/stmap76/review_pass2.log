   690	void Abc_Stmap76EnablePhaseSurvivalScope( Abc_Ntk_t * pNtk, const char * pLabel, int * pWatchAigIds, int nWatchAigs )
   691	{
   692	    int i;
   693	    Abc_Stmap76ClearPhaseSurvivalScope();
   694	    if ( pNtk == NULL || pNtk->vOrigNodeIds == NULL || pWatchAigIds == NULL || nWatchAigs <= 0 )
   695	        return;
   696	    for ( i = 0; i < nWatchAigs && s_nStmap76WatchAigs < ABC_STMAP76_MAX_WATCH_AIGS; i++ )
   697	        if ( pWatchAigIds[i] >= 0 )
   698	            s_Stmap76WatchAigIds[s_nStmap76WatchAigs++] = pWatchAigIds[i];
   699	    if ( s_nStmap76WatchAigs == 0 )
   700	        return;
   701	    s_fStmap76PhaseSurvivalScope = 1;
   702	    s_pStmap76PhaseSurvivalNtk = pNtk;
   703	    s_pStmap76PhaseSurvivalOrigIds = pNtk->vOrigNodeIds;
   704	    s_pStmap76PhaseSurvivalLabel = pLabel && pLabel[0] ? pLabel : "stmap76";
   705	}
