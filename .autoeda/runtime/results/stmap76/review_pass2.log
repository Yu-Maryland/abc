  1647	int Map_Stmap64ReadCutOnlyWitness( int i, int * pAigId, int * pPhase, int * pNode, float * pNodePressureRatio, float * pCutPressureRatio, float * pSlack, float * pAreaSave, float * pArrivalDelta, float * pArrivalGainMargin, float * pFeedback )
  1648	{
  1649	    if ( i < 0 || i >= s_nStmap64CutOnlyWitnesses )
  1650	        return 0;
  1651	    if ( pAigId )
  1652	        *pAigId = s_Stmap64WitnessAigIds[i];
  1653	    if ( pPhase )
  1654	        *pPhase = s_Stmap64WitnessPhases[i];
  1655	    if ( pNode )
  1656	        *pNode = s_Stmap64WitnessNodes[i];
  1657	    if ( pNodePressureRatio )
  1658	        *pNodePressureRatio = s_Stmap64WitnessNodePressureRatios[i];
  1659	    if ( pCutPressureRatio )
  1660	        *pCutPressureRatio = s_Stmap64WitnessCutPressureRatios[i];
  1661	    if ( pSlack )
  1662	        *pSlack = s_Stmap64WitnessSlacks[i];
  1663	    if ( pAreaSave )
  1664	        *pAreaSave = s_Stmap64WitnessAreaSaves[i];
  1665	    if ( pArrivalDelta )
  1666	        *pArrivalDelta = s_Stmap64WitnessArrivalDeltas[i];
  1667	    if ( pArrivalGainMargin )
  1668	        *pArrivalGainMargin = s_Stmap64WitnessArrivalGainMargins[i];
  1669	    if ( pFeedback )
  1670	        *pFeedback = s_Stmap64WitnessFeedbacks[i];
  1671	    return 1;
  1672	}
