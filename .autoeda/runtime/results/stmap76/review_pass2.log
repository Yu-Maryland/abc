   716	static int Abc_Stmap76ObjAigPhase( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, int * pAigId, int * pPhase )
   717	{
   718	    int Lit;
   719	    if ( pAigId )
   720	        *pAigId = -1;
   721	    if ( pPhase )
   722	        *pPhase = -1;
   723	    if ( pNtk == NULL || pObj == NULL || pNtk->vOrigNodeIds == NULL )
   724	        return 0;
   725	    if ( Abc_ObjId(pObj) < 0 || Abc_ObjId(pObj) >= Vec_IntSize(pNtk->vOrigNodeIds) )
   726	        return 0;
   727	    Lit = Vec_IntEntry( pNtk->vOrigNodeIds, Abc_ObjId(pObj) );
   728	    if ( Lit < 0 )
   729	        return 0;
   730	    if ( pAigId )
   731	        *pAigId = Abc_Lit2Var(Lit);
   732	    if ( pPhase )
   733	        *pPhase = Abc_LitIsCompl(Lit);
   734	    return 1;
   735	}
