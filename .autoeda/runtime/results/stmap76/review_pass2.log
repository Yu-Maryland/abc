  1807	
  1808	static float Map_Stmap73AcceptedWitnessScore( float NodePressureRatio, float CutPressureRatio, float Slack, float ArrivalDelta, float ArrivalGainMargin )
  1809	{
  1810	    float Pressure = NodePressureRatio > CutPressureRatio ? NodePressureRatio : CutPressureRatio;
  1811	    float Tightness = Slack > 0.0f ? 1.0f / (1.0f + Slack) : 1.0f;
  1812	    float SpeedGain = ArrivalDelta < 0.0f ? -ArrivalDelta / 20.0f : 0.0f;
  1813	    float MarginGain = ArrivalGainMargin > 0.0f ? ArrivalGainMargin / 20.0f : 0.0f;
  1814	    if ( SpeedGain > 1.0f )
  1815	        SpeedGain = 1.0f;
  1816	    if ( MarginGain > 1.0f )
  1817	        MarginGain = 1.0f;
  1818	    return Pressure + 0.25f * Tightness + 0.10f * SpeedGain + 0.05f * MarginGain;
  1819	}
  1820	
  1821	static float Map_Stmap73AcceptedWitnessScoreSlot( int i )
  1822	{
  1823	    return Map_Stmap73AcceptedWitnessScore(
  1824	        s_Stmap64WitnessNodePressureRatios[i],
  1825	        s_Stmap64WitnessCutPressureRatios[i],
  1826	        s_Stmap64WitnessSlacks[i],
  1827	        s_Stmap64WitnessArrivalDeltas[i],
  1828	        s_Stmap64WitnessArrivalGainMargins[i] );
  1829	}
