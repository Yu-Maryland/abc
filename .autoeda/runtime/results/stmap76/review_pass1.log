   247	def run_flow(kind, bench):
   248	    safe = safe_name(bench)
   249	    if kind == "baseline":
   250	        flow = f"read_lib {LIB}; read {bench}; resyn; resyn2; dch -v; map; topo; buffer; upsize -v; dnsize -v; stime"
   251	    else:
   252	        flow = f"read_lib {LIB}; read {bench}; resyn; resyn2; dch -v; {COMMAND}; topo; buffer; upsize -v; dnsize -v; stime"
   253	    log = RESULTS / f"{kind}_{safe}.log"
   254	    exit_file = RESULTS / f"{kind}_{safe}.exit"
   255	    rc, text = run_abc(flow, log, exit_file)
   256	    metrics = parse_stime(text)
   257	    return {
   258	        "benchmark": bench,
   259	        "kind": kind,
   260	        "returncode": rc,
   261	        "metrics": metrics,
   262	        "stats": parse_stats(text) if kind == "candidate" else {},
   263	        "multi_stats": parse_multi_stats(text) if kind == "candidate" else {},
   264	        "log": str(log.relative_to(ROOT)),
   265	        "command": f"./abc -c \"{flow}\"",
   266	    }
