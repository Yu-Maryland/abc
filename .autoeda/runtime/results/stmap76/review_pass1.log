   196	def safe_name(bench):
   197	    return bench.replace("/", "_").replace(".", "_")
   198	
   199	
   200	def clean(text):
   201	    return ANSI_RE.sub("", text)
   202	
   203	
   204	def run_abc(command, log_path, exit_path):
   205	    proc = subprocess.run(
   206	        [str(ABC), "-c", command],
   207	        cwd=ROOT,
   208	        text=True,
   209	        stdout=subprocess.PIPE,
   210	        stderr=subprocess.STDOUT,
   211	        timeout=TIMEOUT,
   212	    )
   213	    log_path.write_text(proc.stdout)
   214	    exit_path.write_text(f"{proc.returncode}\n")
   215	    return proc.returncode, proc.stdout
   216	
   217	
   218	def parse_stime(text):
   219	    matches = STIME_RE.findall(clean(text))
   220	    if not matches:
   221	        return None
   222	    area, delay = matches[-1]
   223	    return {"stime_area": float(area), "stime_delay_ps": float(delay)}
   224	
   225	
   226	def parse_stats(text):
   227	    out = {}
   228	    plain = clean(text)
   229	    for name, pattern in STAT_PATTERNS.items():
   230	        matches = list(pattern.finditer(plain))
   231	        if not matches:
   232	            continue
   233	        out[name] = matches[-1].groupdict()
   234	    return out
   235	
   236	
   237	def parse_multi_stats(text):
   238	    out = {}
   239	    plain = clean(text)
   240	    for name, pattern in MULTI_STAT_PATTERNS.items():
   241	        matches = [m.groupdict() for m in pattern.finditer(plain)]
   242	        if matches:
   243	            out[name] = matches
   244	    return out
