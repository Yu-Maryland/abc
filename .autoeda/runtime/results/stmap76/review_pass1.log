   277	
   278	def run_cec(bench):
   279	    safe = safe_name(bench)
   280	    orig_flow = f"read_lib {LIB}; read {bench}"
   281	    cand_flow = f"read_lib {LIB}; read {bench}; resyn; resyn2; dch -v; {COMMAND}; topo; buffer; upsize -v; dnsize -v; stime"
   282	    rc_orig, orig = write_aig(bench, "orig", orig_flow)
   283	    rc_cand, cand = write_aig(bench, COMMAND, cand_flow)
   284	    log = RESULTS / f"cec_{safe}.log"
   285	    exit_file = RESULTS / f"cec_{safe}.exit"
   286	    if rc_orig != 0 or rc_cand != 0:
   287	        log.write_text(f"write failed: orig={rc_orig} candidate={rc_cand}\n")
   288	        exit_file.write_text("1\n")
   289	        return {"benchmark": bench, "passed": False, "returncode": 1, "log": str(log.relative_to(ROOT))}
   290	    rc, text = run_abc(f"cec {orig} {cand}", log, exit_file)
   291	    passed = rc == 0 and ("Networks are equivalent" in text or "Networks are equivalent after structural hashing" in text)
   292	    return {
   293	        "benchmark": bench,
   294	        "passed": passed,
   295	        "returncode": rc,
   296	        "original": str(orig.relative_to(ROOT)),
   297	        "candidate": str(cand.relative_to(ROOT)),
   298	        "log": str(log.relative_to(ROOT)),
   299	    }
