   354	            "seed_area_save": row.get("seed_area_save", ""),
   355	            "seed_arrival_delta": row.get("seed_arrival_delta", ""),
   356	        })
   357	    ranking.sort(key=lambda r: (-_float_value(r, "final_criticality"), _float_value(r, "final_slack", 1.0e9), r["benchmark"], int(r["rank"])))
   358	    for index, row in enumerate(ranking, start=1):
   359	        row["rank"] = index
