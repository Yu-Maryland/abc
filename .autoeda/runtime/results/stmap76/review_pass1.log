    20	static int Abc_Stmap76WatchAigForNetwork( Abc_Ntk_t * pNtk )
    21	{
    22	    char * pName = pNtk ? Abc_NtkName(pNtk) : NULL;
    23	    char * pBase, * pSlash, * pBackslash;
    24	    if ( pName == NULL )
    25	        return -1;
    26	    pSlash = strrchr( pName, '/' );
    27	    pBackslash = strrchr( pName, '\\' );
    28	    if ( pSlash && (!pBackslash || pSlash > pBackslash) )
    29	        pBase = pSlash + 1;
    30	    else if ( pBackslash )
    31	        pBase = pBackslash + 1;
    32	    else
    33	        pBase = pName;
    34	    if ( !strcmp( pBase, "i10" ) )
    35	        return 855;
    36	    if ( !strcmp( pBase, "ode" ) )
    37	        return 5219;
    38	    if ( !strcmp( pBase, "or1200_flat" ) || !strcmp( pBase, "or1200" ) )
    39	        return 11491;
    40	    if ( !strcmp( pBase, "syn2" ) )
    41	        return 18002;
    42	    return -1;
    43	}
