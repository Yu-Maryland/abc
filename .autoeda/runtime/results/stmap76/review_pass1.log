  1910	
  1911	static float Map_MatchStmap45CutPressureRatio( Map_Cut_t * pCut )
  1912	{
  1913	    Map_Node_t * pLeaf;
  1914	    float Ratio, RatioMax = 0.0;
  1915	    int i;
  1916	    if ( pCut == NULL )
  1917	        return 0.0;
  1918	    for ( i = 0; i < (int)pCut->nLeaves; i++ )
  1919	    {
  1920	        pLeaf = Map_Regular( pCut->ppLeaves[i] );
  1921	        if ( pLeaf == NULL )
  1922	            continue;
  1923	        Ratio = Map_MatchStmap45NodePressureRatio( pLeaf, NULL );
  1924	        if ( RatioMax < Ratio )
  1925	            RatioMax = Ratio;
  1926	    }
  1927	    return RatioMax;
  1928	}
