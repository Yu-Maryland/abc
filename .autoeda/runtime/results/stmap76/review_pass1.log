   302	def write_csv(path, rows, fields):
   303	    with path.open("w", newline="") as f:
   304	        writer = csv.DictWriter(f, fieldnames=fields)
   305	        writer.writeheader()
   306	        for row in rows:
   307	            writer.writerow(row)
