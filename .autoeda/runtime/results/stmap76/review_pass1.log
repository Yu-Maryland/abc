  1944	    if ( pLeafNode )
  1945	        *pLeafNode = -1;
  1946	    if ( pLeafAigId )
  1947	        *pLeafAigId = -1;
  1948	    if ( pCut == NULL || iLeaf < 0 || iLeaf >= (int)pCut->nLeaves )
  1949	        return;
  1950	    pLeaf = Map_Regular( pCut->ppLeaves[iLeaf] );
  1951	    if ( pLeaf == NULL )
