    45	/**Function*************************************************************
    46	
    47	  Synopsis    [Runs the stmap76 phase-survival diagnostic.]
    48	
    49	  Description [stmap76 keeps the reviewed stmap65 mapping policy unchanged,
    50	  reuses the stmap75 selected-match watch for the final-critical AIG ID of the
    51	  current required benchmark, and records which phase(s) survive in the final
    52	  post-buffer/post-size network.]
    53	
    54	  SideEffects []
    55	
    56	  SeeAlso     []
    57	
    58	***********************************************************************/
    59	int Abc_CommandStmap76( Abc_Frame_t * pAbc, int argc, char ** argv )
    60	{
    61	    Abc_Ntk_t * pNtk, * pNtkRes;
    62	    int i, RetValue, WatchAigId, WatchAigs[1];
    63	    extern int Abc_CommandStmap65( Abc_Frame_t * pAbc, int argc, char ** argv );
    64	    extern void Map_Stmap75SetFinalCriticalAigDiag( int fEnable, int WatchAigId );
    65	    extern void Map_Stmap75SetFinalCriticalAigDiagLabel( const char * pLabel );
    66	    extern void Map_Stmap75PrintFinalCriticalAigSummary( void );
    67	    extern void Abc_Stmap74EnableFinalCriticalScope( Abc_Ntk_t * pNtk, const char * pLabel );
    68	    extern void Abc_Stmap76EnablePhaseSurvivalScope( Abc_Ntk_t * pNtk, const char * pLabel, int * pWatchAigIds, int nWatchAigs );
    69	
    70	    for ( i = 1; i < argc; i++ )
    71	    {
    72	        if ( !strcmp( argv[i], "-h" ) )
    73	            goto usage;
    74	    }
    75	
    76	    pNtk = Abc_FrameReadNtk( pAbc );
    77	    WatchAigId = Abc_Stmap76WatchAigForNetwork( pNtk );
    78	    printf( "stmap76 diagnostic: inherited-policy = stmap65  mapper-selected-match-watch = %d  network = %s  watch-aig = %d  source = stmap74-final-critical-top-aigs  final-phase-survival = 1  mapping-policy-change = 0\n",
    79	        WatchAigId >= 0, pNtk && Abc_NtkName(pNtk) ? Abc_NtkName(pNtk) : "?", WatchAigId );
    80	    Map_Stmap75SetFinalCriticalAigDiag( WatchAigId >= 0, WatchAigId );
    81	    Map_Stmap75SetFinalCriticalAigDiagLabel( "stmap76" );
    82	    RetValue = Abc_CommandStmap65( pAbc, argc, argv );
    83	    Map_Stmap75PrintFinalCriticalAigSummary();
    84	    Map_Stmap75SetFinalCriticalAigDiag( 0, -1 );
    85	    if ( RetValue == 0 )
    86	    {
    87	        pNtkRes = Abc_FrameReadNtk( pAbc );
    88	        WatchAigs[0] = WatchAigId;
    89	        Abc_Stmap74EnableFinalCriticalScope( pNtkRes, "stmap76" );
    90	        Abc_Stmap76EnablePhaseSurvivalScope( pNtkRes, "stmap76", WatchAigs, WatchAigId >= 0 ? 1 : 0 );
    91	    }
    92	    return RetValue;
    93	
    94	usage:
    95	    Abc_Print( -2, "usage: stmap76 [-DABFSG float] [-M num] [-arspfuovh]\n" );
    96	    Abc_Print( -2, "\t              performs stmap76 bounded-pressure mapping with selected-vs-final phase survival diagnostics\n" );
    97	    Abc_Print( -2, "\t-D float : sets the global required times [default = not used]\n" );
    98	    Abc_Print( -2, "\t-A float : \"area multiplier\" to bias gate selection [default = 0.00]\n" );
    99	    Abc_Print( -2, "\t-B float : \"delay multiplier\" to bias gate selection [default = 0.00]\n" );
   100	    Abc_Print( -2, "\t-F float : the logarithmic fanout delay parameter [default = 0.00]\n" );
   101	    Abc_Print( -2, "\t-S float : the slew parameter used to generate the library [default = 0.00]\n" );
   102	    Abc_Print( -2, "\t-G float : the SCL/genlib gain parameter used to generate the library [default = 250.00]\n" );
   103	    Abc_Print( -2, "\t-M num   : skip gate classes whose size is less than this [default = 0]\n" );
   104	    Abc_Print( -2, "\t-a       : toggles area-only mapping [default = no]\n" );
   105	    Abc_Print( -2, "\t-r       : toggles area recovery [default = yes]\n" );
   106	    Abc_Print( -2, "\t-s       : toggles sweep after mapping [default = no]\n" );
   107	    Abc_Print( -2, "\t-p       : optimizes power by minimizing switching [default = no]\n" );
   108	    Abc_Print( -2, "\t-f       : disables the bounded-pressure SCL feedback mapper mode [default = yes]\n" );
   109	    Abc_Print( -2, "\t-u       : use standard-cell profile [default = no]\n" );
   110	    Abc_Print( -2, "\t-o       : toggles using buffers to decouple combinational outputs [default = no]\n" );
   111	    Abc_Print( -2, "\t-v       : toggles verbose output [default = no]\n" );
   112	    Abc_Print( -2, "\t-h       : print the command usage\n" );
   113	    return 1;
   114	}
