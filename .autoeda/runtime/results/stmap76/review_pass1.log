  1897	
  1898	static float Map_MatchStmap45NodePressureRatio( Map_Node_t * pNode, int * pAigId )
  1899	{
  1900	    int AigId;
  1901	    if ( pAigId )
  1902	        *pAigId = -1;
  1903	    if ( pNode == NULL || pNode->Num < 0 )
  1904	        return 0.0;
  1905	    AigId = Map_NodeReadAigId( pNode );
  1906	    if ( pAigId )
  1907	        *pAigId = AigId;
  1908	    return Map_MatchStmap45PressureLookup( AigId );
