   317	def write_path_proximity(multi_stats_by_name):
   318	    source_classes = {}
   319	    for name, label in (
   320	        ("accepted_pressure_witness_source", "accepted-pressure"),
   321	        ("near_strong_node_diag", "near-strong-node"),
   322	        ("blocked_strong_witness_source", "blocked-strong-pressure"),
   323	        ("pressure_near_witness_source", "pressure-near"),
