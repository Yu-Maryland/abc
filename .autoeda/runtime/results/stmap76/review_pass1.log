   269	def write_aig(bench, suffix, flow):
   270	    safe = safe_name(bench)
   271	    aig = RESULTS / f"cec_{safe}_{suffix}.aig"
   272	    log = RESULTS / f"cec_{safe}_{suffix}_write.log"
   273	    exit_file = RESULTS / f"cec_{safe}_{suffix}_write.exit"
   274	    rc, _ = run_abc(f"{flow}; strash; write_aiger {aig}", log, exit_file)
   275	    return rc, aig
