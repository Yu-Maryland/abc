  1807	
  1808	static float Map_Stmap73AcceptedWitnessScore( float NodePressureRatio, float CutPressureRatio, float Slack, float ArrivalDelta, float ArrivalGainMargin )
  1809	{
  1810	    float Pressure = NodePressureRatio > CutPressureRatio ? NodePressureRatio : CutPressureRatio;
  1811	    float Tightness = Slack > 0.0f ? 1.0f / (1.0f + Slack) : 1.0f;
  1812	    float SpeedGain = ArrivalDelta < 0.0f ? -ArrivalDelta / 20.0f : 0.0f;
  1813	    float MarginGain = ArrivalGainMargin > 0.0f ? ArrivalGainMargin / 20.0f : 0.0f;
  1814	    if ( SpeedGain > 1.0f )
  1815	        SpeedGain = 1.0f;
  1816	    if ( MarginGain > 1.0f )
  1817	        MarginGain = 1.0f;
  1818	    return Pressure + 0.25f * Tightness + 0.10f * SpeedGain + 0.05f * MarginGain;
  1819	}
  1820	
  1821	static float Map_Stmap73AcceptedWitnessScoreSlot( int i )
  1822	{
  1823	    return Map_Stmap73AcceptedWitnessScore(
  1824	        s_Stmap64WitnessNodePressureRatios[i],
  1825	        s_Stmap64WitnessCutPressureRatios[i],
  1826	        s_Stmap64WitnessSlacks[i],
  1827	        s_Stmap64WitnessArrivalDeltas[i],
  1828	        s_Stmap64WitnessArrivalGainMargins[i] );
  1829	}
  1830	
  1831	static void Map_Stmap73RecordAcceptedPressureWitness( Map_Node_t * pNode, Map_Cut_t * pCut, int AigId, int fPhase, const char * pClass, float NodePressureRatio, float CutPressureRatio, float Slack, float AreaSave, float ArrivalDelta, float ArrivalGainMargin, float PenaltyFactor, float AreaMargin, int fPressureAgreement, int fPressureNear, int fCutOnlyPressure, int fAreaCap )
  1832	{
  1833	    int i, Slot = -1, fDuplicate = 0, fStored = 0, fReplaced = 0;
  1834	    float Score, WorstScore;
  1835	    if ( !s_fStmap73AcceptedPressureWitnessDiag || pNode == NULL || AigId < 0 )
  1836	        return;
  1837	    if ( NodePressureRatio < 1.0f && CutPressureRatio < 1.0f )
  1838	        return;
  1839	    fPhase = fPhase ? 1 : 0;
  1840	    Score = Map_Stmap73AcceptedWitnessScore( NodePressureRatio, CutPressureRatio, Slack, ArrivalDelta, ArrivalGainMargin );
  1841	    s_nStmap73AcceptedPressureWitnessSources++;
  1842	    for ( i = 0; i < s_nStmap64CutOnlyWitnesses; i++ )
  1843	    {
  1844	        if ( s_Stmap64WitnessAigIds[i] == AigId && s_Stmap64WitnessPhases[i] == fPhase )
  1845	        {
  1846	            fDuplicate = 1;
  1847	            if ( Score > Map_Stmap73AcceptedWitnessScoreSlot( i ) + 0.0001f )
  1848	            {
  1849	                Slot = i;
  1850	                fReplaced = 1;
  1851	            }
  1852	            break;
  1853	        }
  1854	    }
  1855	    if ( Slot < 0 && !fDuplicate )
  1856	    {
  1857	        if ( s_nStmap64CutOnlyWitnesses < MAP_STMAP64_MAX_WITNESSES )
  1858	            Slot = s_nStmap64CutOnlyWitnesses++;
  1859	        else
  1860	        {
  1861	            Slot = 0;
  1862	            WorstScore = Map_Stmap73AcceptedWitnessScoreSlot( 0 );
  1863	            for ( i = 1; i < s_nStmap64CutOnlyWitnesses; i++ )
  1864	            {
  1865	                if ( Map_Stmap73AcceptedWitnessScoreSlot( i ) < WorstScore )
  1866	                {
  1867	                    Slot = i;
  1868	                    WorstScore = Map_Stmap73AcceptedWitnessScoreSlot( i );
  1869	                }
  1870	            }
  1871	            if ( Score <= WorstScore + 0.0001f )
  1872	                Slot = -1;
  1873	            else
  1874	                fReplaced = 1;
  1875	        }
  1876	    }
  1877	    if ( Slot >= 0 )
  1878	    {
  1879	        Map_Stmap64WriteWitnessSlot( Slot, pNode, AigId, fPhase, NodePressureRatio, CutPressureRatio, Slack, AreaSave, ArrivalDelta, ArrivalGainMargin );
  1880	        fStored = 1;
  1881	    }
  1882	    if ( s_nStmap73AcceptedPressureWitnessSources <= 64 || fStored || fReplaced )
  1883	        printf( "stmap73 accepted-pressure witness source: index = %d  node = %d  aig-id = %d  level = %u  refs = %d  leaves = %d  phase = %d  class = %s  stored = %d  replaced = %d  duplicate = %d  witness-score = %.6f  slack = %.6f  area-save = %.6f  arrival-delta = %.6f  arrival-gain-margin = %.6f  penalty-factor = %.3f  area-margin = %.6f  pressure-agreement = %d  pressure-near = %d  cut-only = %d  area-cap = %d  node-sink-pressure-ratio = %.3f  cut-sink-pressure-ratio = %.3f  scl-feedback = %.3f\n",
  1884	            s_nStmap73AcceptedPressureWitnessSources, pNode->Num, AigId, pNode->Level, pNode->nRefs,
  1885	            pCut ? (int)pCut->nLeaves : 0, fPhase, pClass ? pClass : "unknown", fStored, fReplaced,
  1886	            fDuplicate, Score, Slack, AreaSave, ArrivalDelta, ArrivalGainMargin, PenaltyFactor,
  1887	            AreaMargin, fPressureAgreement, fPressureNear, fCutOnlyPressure, fAreaCap,
  1888	            NodePressureRatio, CutPressureRatio, s_Stmap45SclFeedback );
  1889	}
  1890	
