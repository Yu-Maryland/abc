  1958	
  1959	static void Map_Stmap75PrintSelectedMatches( Map_Man_t * p, Map_Node_t * pNode )
  1960	{
  1961	    Map_Cut_t * pCut;
  1962	    Map_Match_t * pMatch;
  1963	    Mio_Gate_t * pGate;
  1964	    float NodePressureRatio, CutPressureRatio, LeafLoadAvg, LoadDriveRatio;
  1965	    float Arrival, Required, Slack, AreaFlow;
  1966	    int Phase, AigId, WatchIndex, FanLimit, Leaves, LeafNode[6], LeafAigId[6], i;
  1967	
  1968	    if ( !s_fStmap75FinalCriticalAigDiag || p == NULL || pNode == NULL )
  1969	        return;
  1970	    NodePressureRatio = Map_MatchStmap45NodePressureRatio( pNode, &AigId );
