   361	    rank_fields = [
   362	        "rank", "benchmark", "aig_id", "phase", "seed_node", "final_node", "matched",
   363	        "source_classes", "final_criticality", "final_slack", "final_load_ratio",
   364	        "seed_node_pressure_ratio", "seed_cut_pressure_ratio", "seed_slack",
   365	        "seed_area_save", "seed_arrival_delta",
   366	    ]
   367	    write_csv(RESULTS / "path_proximity_ranking.csv", ranking, rank_fields)
   368	
