   325	    ):
   326	        for row in multi_stats_by_name.get(name, []):
   327	            aig_id = row.get("aig_id") or row.get("node_aig_id")
   328	            phase = row.get("phase")
   329	            if aig_id in (None, "") or phase in (None, ""):
   330	                continue
   331	            source_classes.setdefault((row["benchmark"], aig_id, phase), set()).add(row.get("source_class", label))
   332	
   333	    ranking = []
   334	    for row in multi_stats_by_name.get("final_witness", []):
   335	        key = (row["benchmark"], row.get("aig_id"), row.get("phase"))
   336	        matched = row.get("matched") == "1"
   337	        criticality = _float_value(row, "final_criticality") if matched else 0.0
   338	        slack = _float_value(row, "final_slack", 1.0e9) if matched else 1.0e9
   339	        ranking.append({
   340	            "benchmark": row["benchmark"],
   341	            "rank": 0,
   342	            "aig_id": row.get("aig_id", ""),
   343	            "phase": row.get("phase", ""),
   344	            "seed_node": row.get("seed_node", ""),
   345	            "final_node": row.get("final_node", ""),
   346	            "matched": row.get("matched", ""),
   347	            "source_classes": "+".join(sorted(source_classes.get(key, set()))),
   348	            "final_criticality": row.get("final_criticality", ""),
   349	            "final_slack": row.get("final_slack", ""),
   350	            "final_load_ratio": row.get("final_load_ratio", ""),
   351	            "seed_node_pressure_ratio": row.get("seed_node_pressure_ratio", ""),
