  1605	static int Map_Stmap92MaybeTargetEmittedDrive( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, Map_Cut_t * pBestCutBefore, int fPhase, int CutOrdinal, Map_Match_t * pMatch, Map_Match_t * pBestBefore, int fAccepted )
  1606	{
  1607	    Map_Node_t * pNodeRegular;
  1608	    Mio_Gate_t * pGate, * pGateBefore;
  1609	    int AigId, fEligible, fOverride;
  1610	    int CandidateFanLimit, BestFanLimit, fFanLimitImproved, fLoadDriveImproved, fDriveImproved;
  1611	    float ArrivalDelta, AreaPremium, AreaRatio, ArrivalWindow, AreaPremiumWindow, AreaRatioWindow;
  1612	    float CandidateLeafLoadAvg, BestLeafLoadAvg, CandidateLoadDriveRatio, BestLoadDriveRatio, LoadDriveRatioMinGain;
  1613	    const char * pAction;
  1614	    if ( !s_fStmap92EmittedDriveTarget || !s_fStmap92EmittedDriveTargetActive || p == NULL || pNode == NULL || pCut == NULL || pMatch == NULL )
  1615	        return fAccepted;
  1616	    pNodeRegular = Map_Regular( pNode );
  1617	    if ( Map_NodeIsConst( pNodeRegular ) )
  1618	        return fAccepted;
  1619	    AigId = Map_NodeReadAigId( pNodeRegular );
  1620	    if ( AigId != s_Stmap92AigId )
  1621	        return fAccepted;
  1622	
  1623	    s_nStmap92EmittedRows++;
  1624	    ArrivalWindow = 0.75f;
  1625	    AreaPremiumWindow = 1.20f;
  1626	    AreaRatioWindow = 2.50f;
  1627	    LoadDriveRatioMinGain = 0.05f;
  1628	    ArrivalDelta = pBestBefore ? pMatch->tArrive.Worst - pBestBefore->tArrive.Worst : MAP_FLOAT_LARGE;
  1629	    AreaPremium = pBestBefore ? pMatch->AreaFlow - pBestBefore->AreaFlow : MAP_FLOAT_LARGE;
  1630	    AreaRatio = (pBestBefore && pBestBefore->AreaFlow > p->fEpsilon) ? pMatch->AreaFlow / pBestBefore->AreaFlow : MAP_FLOAT_LARGE;
  1631	    CandidateLeafLoadAvg = Map_MatchStmap32CutLeafLoadAvg( pCut );
  1632	    BestLeafLoadAvg = pBestCutBefore ? Map_MatchStmap32CutLeafLoadAvg( pBestCutBefore ) : MAP_FLOAT_LARGE;
  1633	    CandidateFanLimit = pMatch && pMatch->pSuperBest ? (int)pMatch->pSuperBest->nFanLimit : 0;
  1634	    BestFanLimit = pBestBefore && pBestBefore->pSuperBest ? (int)pBestBefore->pSuperBest->nFanLimit : 0;
  1635	    CandidateLoadDriveRatio = CandidateFanLimit > 0 ? CandidateLeafLoadAvg / (float)CandidateFanLimit : CandidateLeafLoadAvg;
  1636	    BestLoadDriveRatio = BestFanLimit > 0 ? BestLeafLoadAvg / (float)BestFanLimit : BestLeafLoadAvg;
  1637	    fFanLimitImproved = CandidateFanLimit > BestFanLimit;
  1638	    fLoadDriveImproved = BestLoadDriveRatio < MAP_FLOAT_LARGE / 2 && CandidateLoadDriveRatio + LoadDriveRatioMinGain < BestLoadDriveRatio;
  1639	    fDriveImproved = fFanLimitImproved || fLoadDriveImproved;
  1640	    if ( fPhase == s_Stmap92Phase )
  1641	    {
  1642	        s_nStmap92EmittedPhaseHits++;
  1643	        if ( fDriveImproved )
  1644	            s_nStmap92EmittedDriveHits++;
  1645	    }
  1646	    else
  1647	        s_nStmap92EmittedBlockedPhase++;
  1648	
  1649	    fEligible = 0;
  1650	    fOverride = 0;
  1651	    pAction = "blocked-phase";
  1652	    if ( fPhase == s_Stmap92Phase )
  1653	    {
  1654	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
  1655	        {
  1656	            s_nStmap92EmittedBlockedMode++;
  1657	            pAction = "blocked-mode";
  1658	        }
  1659	        else if ( pBestBefore == NULL || pBestBefore->pSuperBest == NULL || pBestCutBefore == NULL || pMatch->pSuperBest == NULL )
  1660	        {
  1661	            s_nStmap92EmittedBlockedBest++;
  1662	            pAction = "blocked-no-best";
  1663	        }
  1664	        else if ( ArrivalDelta > ArrivalWindow + p->fEpsilon || AreaPremium > AreaPremiumWindow + p->fEpsilon || AreaRatio > AreaRatioWindow + p->fEpsilon )
  1665	        {
  1666	            s_nStmap92EmittedBlockedWindow++;
  1667	            pAction = "blocked-window";
  1668	        }
  1669	        else if ( !fDriveImproved )
  1670	        {
  1671	            s_nStmap92EmittedBlockedDrive++;
  1672	            pAction = "blocked-drive";
  1673	        }
  1674	        else
  1675	        {
  1676	            s_nStmap92EmittedEligible++;
  1677	            fEligible = 1;
  1678	            if ( fAccepted )
  1679	            {
  1680	                s_nStmap92EmittedAlready++;
  1681	                pAction = "already-selected";
  1682	            }
  1683	            else
  1684	            {
  1685	                s_nStmap92EmittedOverrides++;
  1686	                fOverride = 1;
  1687	                pAction = "override";
  1688	                fAccepted = 1;
  1689	            }
  1690	        }
  1691	    }
  1692	
  1693	    if ( fPhase == s_Stmap92Phase || fOverride )
  1694	    {
  1695	        pGate = pMatch && pMatch->pSuperBest ? pMatch->pSuperBest->pRoot : NULL;
  1696	        pGateBefore = pBestBefore && pBestBefore->pSuperBest ? pBestBefore->pSuperBest->pRoot : NULL;
  1697	        printf( "%s emitted-drive-target: index = %d  target-aig = %d  target-phase = %d  mapper-mode = %d  phase = %d  cut-ordinal = %d  action = %s  eligible = %d  override = %d  accepted-before = %d  gate = %s  best-gate = %s  arrival = %.3f  best-arrival = %.3f  arrival-delta = %.3f  area-flow = %.3f  best-area-flow = %.3f  area-premium = %.3f  area-ratio = %.3f  candidate-fanout-limit = %d  best-fanout-limit = %d  fanout-limit-improved = %d  candidate-cut-leaf-load-avg = %.3f  best-cut-leaf-load-avg = %.3f  candidate-load-drive-ratio = %.3f  best-load-drive-ratio = %.3f  load-drive-improved = %d  drive-improved = %d  arrival-window = %.3f  area-premium-window = %.3f  area-ratio-window = %.3f  load-drive-ratio-min-gain = %.3f\n",
  1698	            s_pStmap92EmittedDriveTargetLabel, s_nStmap92EmittedRows,
  1699	            s_Stmap92AigId, s_Stmap92Phase, p->fMappingMode, fPhase,
  1700	            CutOrdinal, pAction, fEligible, fOverride, fAccepted && !fOverride,
  1701	            pGate ? Mio_GateReadName(pGate) : "?",
  1702	            pGateBefore ? Mio_GateReadName(pGateBefore) : "?",
  1703	            pMatch->tArrive.Worst, pBestBefore ? pBestBefore->tArrive.Worst : MAP_FLOAT_LARGE,
  1704	            ArrivalDelta, pMatch->AreaFlow, pBestBefore ? pBestBefore->AreaFlow : MAP_FLOAT_LARGE,
  1705	            AreaPremium, AreaRatio, CandidateFanLimit, BestFanLimit,
  1706	            fFanLimitImproved, CandidateLeafLoadAvg, BestLeafLoadAvg,
  1707	            CandidateLoadDriveRatio, BestLoadDriveRatio, fLoadDriveImproved,
  1708	            fDriveImproved, ArrivalWindow, AreaPremiumWindow, AreaRatioWindow,
  1709	            LoadDriveRatioMinGain );
  1710	    }
  1711	    return fAccepted;
  1712	}
