            fFanLimitImproved, CandidateLeafLoadAvg, BestLeafLoadAvg,
            CandidateLoadDriveRatio, BestLoadDriveRatio, fLoadDriveImproved,
            fDriveImproved, ArrivalWindow, AreaPremiumWindow, AreaRatioWindow,
            LoadDriveRatioMinGain );
    }
    return fAccepted;
}

