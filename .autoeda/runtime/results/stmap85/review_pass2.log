            Abc_Stmap78SetDemandPathActive( 1, "final" );
        if ( Abc_Stmap79ParentCutDiagConfigured() )
            Abc_Stmap79SetParentCutActive( 1, "final" );
        if ( Map_Stmap80CandidateCutDiagConfigured() )
            Map_Stmap80SetCandidateCutActive( 1, "final" );
