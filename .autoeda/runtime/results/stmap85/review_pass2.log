{
    extern void Map_Stmap64ClearCutOnlyWitnesses( void );
    s_fStmap64FinalWitnessScope = 0;
    s_pStmap64FinalWitnessNtk = NULL;
    s_pStmap64FinalWitnessOrigIds = NULL;
