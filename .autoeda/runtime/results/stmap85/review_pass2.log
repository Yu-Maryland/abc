        if ( Abc_Stmap79ParentCutDiagConfigured() )
            Abc_Stmap79SetParentCutActive( 0, "final" );
        if ( Map_Stmap80CandidateCutDiagConfigured() )
            Map_Stmap80SetCandidateCutActive( 0, "final" );
