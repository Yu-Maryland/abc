        Map_Stmap60SetNearMissLeafDiag( 1, ABC_STMAP65_TRACK_NODE );
        Map_Stmap61SetCutOnlyGateDiag( 1, ABC_STMAP65_TRACK_NODE );
        Map_Stmap62SetCutOnlyOrdering( 0 );
        Map_Stmap65SetStrongNodeLoadDropGuard( 1 );
