    if ( pArrivalGainMargin )
        *pArrivalGainMargin = s_Stmap64WitnessArrivalGainMargins[i];
    if ( pFeedback )
        *pFeedback = s_Stmap64WitnessFeedbacks[i];
    return 1;
}

