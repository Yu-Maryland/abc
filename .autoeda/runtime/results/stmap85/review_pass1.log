        *pPhase = s_Stmap64WitnessPhases[i];
    if ( pNode )
        *pNode = s_Stmap64WitnessNodes[i];
    if ( pNodePressureRatio )
        *pNodePressureRatio = s_Stmap64WitnessNodePressureRatios[i];
    if ( pCutPressureRatio )
