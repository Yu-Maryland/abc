            {
                Slot = i;
                fReplaced = 1;
            }
            break;
        }
    }
    if ( Slot < 0 && !fDuplicate )
    {
        if ( s_nStmap64CutOnlyWitnesses < MAP_STMAP64_MAX_WITNESSES )
