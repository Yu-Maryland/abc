    Abc_Print( -2, "usage: stmap63 [-DABFSG float] [-M num] [-arspfuovh]\n" );
    Abc_Print( -2, "\t              performs stmap63 bounded-pressure transfer with load-drop cut-only gating diagnostics\n" );
    Abc_Print( -2, "\t-D float : sets the global required times [default = %s]\n", Buffer );
