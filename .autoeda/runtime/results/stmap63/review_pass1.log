                return 0;
            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
        }
        return 0;
    }
    return (pNode->nRefs > 3 && pCut->nLeaves > 2) || (pNode->nRefs > 1 && pCut->nLeaves > 3);
}

