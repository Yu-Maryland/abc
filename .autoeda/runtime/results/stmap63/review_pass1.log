                return 0;
            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
        }
        if ( p->fMappingMode >= 1 && p->fMappingMode <= 3 && p->vMapObjs->nSize <= 8000 )
        {
            pCutBest = pNode->pCutBest[fPhase];
            if ( pCutBest == NULL )
                return 0;
            pMatchBest = pCutBest->M + fPhase;
            if ( pMatchBest->pSuperBest == NULL )
                return 0;
