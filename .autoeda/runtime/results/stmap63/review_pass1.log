   213	static void Abc_Stmap63PressureInsert( Abc_Stmap63LoadStats_t * pStats, int AigId, int NodeId, float Ratio, float SinkCriticality )
   214	{
   215	    float OldRatio, OldSinkRatio, SinkWeight, SinkRatio;
   216	    if ( AigId < 0 || Ratio <= 1.0 )
   217	        return;
   218	    if ( SinkCriticality < 0.0 )
   219	        SinkCriticality = 0.0;
   220	    if ( SinkCriticality > 1.0 )
   221	        SinkCriticality = 1.0;
   222	    SinkWeight = 0.35 + 0.65 * SinkCriticality;
   223	    SinkRatio = 1.0 + (Ratio - 1.0) * SinkWeight;
   224	    if ( AigId == ABC_STMAP63_TRACK_AIG_ID && Ratio > pStats->TrackedRatio )
   225	    {
   226	        pStats->TrackedRatio = Ratio;
   227	        pStats->TrackedNode = NodeId;
   228	    }
   229	    if ( AigId == ABC_STMAP63_TRACK_AIG_ID && SinkRatio > pStats->TrackedSinkRatio )
   230	        pStats->TrackedSinkRatio = SinkRatio;
   231	    if ( !Abc_Stmap63EnsurePressureCapacity( pStats, AigId ) )
   232	    {
   233	        pStats->nPressureMissed++;
   234	        return;
   235	    }
   236	    OldRatio = pStats->pAigPressureRatios[AigId];
   237	    OldSinkRatio = pStats->pAigSinkPressureRatios[AigId];
   238	    if ( OldRatio == 0.0 )
   239	        pStats->nPressureEntries++;
   240	    else if ( Ratio > OldRatio )
   241	        pStats->nPressureUpdates++;
   242	    if ( Ratio > OldRatio )
   243	        pStats->pAigPressureRatios[AigId] = Ratio;
   244	    if ( SinkRatio <= 1.0 || SinkRatio <= OldSinkRatio )
   245	        return;
   246	    if ( OldSinkRatio == 0.0 )
   247	        pStats->nSinkPressureEntries++;
   248	    else
   249	        pStats->nSinkPressureUpdates++;
   250	    pStats->pAigSinkPressureRatios[AigId] = SinkRatio;
   251	    Abc_Stmap63PressureTopInsert( pStats, AigId, NodeId, SinkRatio );
   252	}
