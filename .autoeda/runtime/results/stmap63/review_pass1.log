   415	static void Abc_Stmap63PrintSclLoadStats( const char * pLabel, Abc_Stmap63LoadStats_t * pStats )
   416	{
   417	    int i;
   418	    if ( !pStats->fAvailable )
   419	    {
   420	        printf( "stmap63 %s stats: unavailable = 1\n", pLabel );
   421	        return;
   422	    }
   423	    printf( "stmap63 %s stats: nodes = %d  matched = %d  fanout-pins = %d  over-max = %d  avg-load-ratio = %.3f  max-load-ratio = %.3f\n",
   424	        pLabel, pStats->nNodes, pStats->nMatched, pStats->nPins, pStats->nOver,
   425	        pStats->nMatched ? pStats->RatioSum / (float)pStats->nMatched : 0.0, pStats->RatioMax );
   426	    printf( "stmap63 %s criticality: timing-delay = %.3f  critical-nodes = %d  avg-criticality = %.3f  max-criticality = %.3f\n",
   427	        pLabel, pStats->TimingDelay, pStats->nCriticalNodes,
   428	        pStats->nMatched ? pStats->CriticalitySum / (float)pStats->nMatched : 0.0,
   429	        pStats->CriticalityMax );
   430	    for ( i = 0; i < 5 && pStats->TopRatios[i] > 0.0; i++ )
   431	        printf( "stmap63 %s top: rank = %d  node = %d  gate = %s  fanouts = %d  load = %.3f  max-cap = %.3f  load-ratio = %.3f\n",
   432	            pLabel, i + 1, pStats->TopNodes[i], pStats->pTopGates[i] ? pStats->pTopGates[i] : "?",
   433	            pStats->TopFanouts[i], pStats->TopLoads[i], pStats->TopCaps[i], pStats->TopRatios[i] );
   434	}
   435	
   436	static void Abc_Stmap63PrintHotspots( Abc_Stmap63LoadStats_t * pStats )
   437	{
   438	    int i;
   439	    if ( !pStats->fAvailable )
   440	        return;
   441	    printf( "stmap63 sink-pressure stats: roots = %d  consumer-fanin = %d  consumer-fanout = %d  raw-pressure-entries = %d  raw-pressure-updates = %d  sink-pressure-entries = %d  sink-pressure-updates = %d  pressure-missed = %d  pressure-capacity = %d  tracked-aig = %d  tracked-node = %d  tracked-raw-ratio = %.3f  tracked-sink-ratio = %.3f\n",
   442	        pStats->nHotspotRoots, pStats->nHotspotFanin, pStats->nHotspotFanout,
   443	        pStats->nPressureEntries, pStats->nPressureUpdates,
   444	        pStats->nSinkPressureEntries, pStats->nSinkPressureUpdates,
   445	        pStats->nPressureMissed,
   446	        pStats->nAigPressureRatios, ABC_STMAP63_TRACK_AIG_ID, pStats->TrackedNode,
   447	        pStats->TrackedRatio, pStats->TrackedSinkRatio );
   448	    for ( i = 0; i < ABC_STMAP63_TOP_PRESSURES && pStats->TopPressureRatios[i] > 0.0; i++ )
   449	        printf( "stmap63 sink-pressure: rank = %d  aig-id = %d  mapped-node = %d  sink-pressure-ratio = %.3f\n",
   450	            i + 1, pStats->TopPressureAigIds[i], pStats->TopPressureNodes[i], pStats->TopPressureRatios[i] );
   451	}
   452	
   453	static float Abc_Stmap63FeedbackSeverity( Abc_Stmap63LoadStats_t * pStats )
   454	{
   455	    float OverFrac, MaxPart, OverPart, Severity;
   456	    if ( !pStats->fAvailable || pStats->nMatched == 0 )
   457	        return 0.0;
   458	    OverFrac = (float)pStats->nOver / (float)pStats->nMatched;
   459	    MaxPart = pStats->RatioMax > 4.0 ? (pStats->RatioMax - 4.0) / 8.0 : 0.0;
   460	    OverPart = OverFrac > 0.002 ? (OverFrac - 0.002) / 0.006 : 0.0;
   461	    if ( MaxPart > 1.0 )
   462	        MaxPart = 1.0;
   463	    if ( OverPart > 1.0 )
   464	        OverPart = 1.0;
   465	    Severity = 0.65 * MaxPart + 0.35 * OverPart;
   466	    return Severity > 1.0 ? 1.0 : Severity;
   467	}
   468	
   469	static float * Abc_Stmap63BuildBoundedPressures( Abc_Stmap63LoadStats_t * pStats, int fSevereTransfer, Abc_Stmap63BoundedStats_t * pBounded )
   470	{
   471	    float * pRatios;
   472	    float RawRatio, SinkRatio, BoundedRatio, Candidate;
   473	    int i;
   474	    memset( pBounded, 0, sizeof(Abc_Stmap63BoundedStats_t) );
   475	    pBounded->fSevereTransfer = fSevereTransfer;
   476	    if ( pStats->nAigPressureRatios <= 0 )
   477	        return NULL;
   478	    pRatios = ABC_ALLOC( float, pStats->nAigPressureRatios );
   479	    if ( pRatios == NULL )
   480	        return NULL;
   481	    for ( i = 0; i < pStats->nAigPressureRatios; i++ )
   482	    {
   483	        RawRatio = pStats->pAigPressureRatios ? pStats->pAigPressureRatios[i] : 0.0f;
   484	        SinkRatio = pStats->pAigSinkPressureRatios ? pStats->pAigSinkPressureRatios[i] : 0.0f;
   485	        BoundedRatio = SinkRatio;
   486	        if ( fSevereTransfer && BoundedRatio > ABC_STMAP63_BOUND_RATIO_CAP )
   487	        {
   488	            BoundedRatio = ABC_STMAP63_BOUND_RATIO_CAP;
   489	            pBounded->nCapped++;
   490	        }
   491	        if ( fSevereTransfer && RawRatio > 1.0f )
   492	        {
   493	            Candidate = 1.0f + ABC_STMAP63_BOUND_RAW_WEIGHT * (RawRatio - 1.0f);
   494	            if ( Candidate > ABC_STMAP63_BOUND_RATIO_CAP )
   495	                Candidate = ABC_STMAP63_BOUND_RATIO_CAP;
   496	            if ( Candidate > BoundedRatio )
   497	            {
   498	                BoundedRatio = Candidate;
   499	                if ( Candidate >= ABC_STMAP63_BOUND_RATIO_CAP )
   500	                    pBounded->nCapped++;
   501	                if ( SinkRatio > 0.0f )
   502	                    pBounded->nLifted++;
   503	                else
   504	                    pBounded->nRawOnly++;
   505	            }
   506	            else if ( SinkRatio > 0.0f )
   507	                pBounded->nSinkFallback++;
   508	        }
   509	        else if ( SinkRatio > 0.0f )
   510	            pBounded->nSinkFallback++;
   511	        pRatios[i] = BoundedRatio;
   512	        if ( BoundedRatio > 0.0f )
   513	            pBounded->nEntries++;
   514	        if ( i == ABC_STMAP63_TRACK_AIG_ID )
   515	            pBounded->TrackedBoundedRatio = BoundedRatio;
   516	    }
   517	    return pRatios;
   518	}
   519	
   520	static void Abc_Stmap63PrintBoundedPressures( Abc_Stmap63LoadStats_t * pStats, Abc_Stmap63BoundedStats_t * pBounded )
   521	{
   522	    printf( "stmap63 bounded-pressure stats: severe-transfer = %d  raw-weight = %.2f  ratio-cap = %.3f  bounded-pressure-entries = %d  lifted = %d  capped = %d  raw-only = %d  sink-fallback = %d  tracked-aig = %d  tracked-raw-ratio = %.3f  tracked-sink-ratio = %.3f  tracked-bounded-ratio = %.3f\n",
   523	        pBounded->fSevereTransfer, ABC_STMAP63_BOUND_RAW_WEIGHT, ABC_STMAP63_BOUND_RATIO_CAP,
   524	        pBounded->nEntries, pBounded->nLifted, pBounded->nCapped,
   525	        pBounded->nRawOnly, pBounded->nSinkFallback, ABC_STMAP63_TRACK_AIG_ID,
   526	        pStats->TrackedRatio, pStats->TrackedSinkRatio, pBounded->TrackedBoundedRatio );
   527	}
   528	
   529	/**Function*************************************************************
   530	
   531	  Synopsis    [Runs the stmap63 mapper probe.]
   532	
   533	  Description [stmap63 repeats the stmap61 bounded transfer and enables a
   534	  command-scoped mapper guard that only opens pre-moderate cut-pressure
   535	  admission when the current node also has a bounded load-pressure signal.]
   536	
   537	  SideEffects []
   538	
   539	  SeeAlso     []
   540	
   541	***********************************************************************/
   542	int Abc_CommandStmap63( Abc_Frame_t * pAbc, int argc, char ** argv )
   543	{
   544	    Abc_Ntk_t * pNtk, * pNtkMap, * pNtkRes, * pNtkFirst;
   545	    Abc_Stmap63LoadStats_t LoadStats;
   546	    Abc_Stmap63BoundedStats_t BoundedStats;
   547	    float * pBoundedPressureRatios = NULL;
   548	    char Buffer[100];
   549	    double DelayTarget;
   550	    double AreaMulti;
   551	    double DelayMulti;
   552	    float LogFan = 0;
   553	    float Slew = 0; // choose based on the library
   554	    float Gain = 250; // base SCL/genlib gain for low and moderate pressure
   555	    float LowGain, SelectedGain;
   556	    int nGatesMin = 0;
   557	    int fAreaOnly;
   558	    int fRecovery;
   559	    int fSweep;
   560	    int fSwitching;
   561	    int fSkipFanout;
   562	    int fUseProfile;
   563	    int fUseBuffs;
   564	    int fVerbose;
   565	    int c, fTempMap = 0;
   566	    int fUseReducedGain, fSevereTransfer;
   567	    float OverFrac, Feedback;
   568	    extern Abc_Ntk_t * Abc_NtkMap( Abc_Ntk_t * pNtk, Mio_Library_t* userLib, double DelayTarget, double AreaMulti, double DelayMulti, float LogFan, float Slew, float Gain, int nGatesMin, int fRecovery, int fSwitching, int fSkipFanout, int fUseProfile, int fUseBuffs, int fVerbose );
   569	    extern int Abc_NtkFraigSweep( Abc_Ntk_t * pNtk, int fUseInv, int fExdc, int fVerbose, int fVeryVerbose );
   570	    extern void Map_Stmap45SetSclLoadFeedbackWithEntries( float MaxLoadRatio, float OverFrac, float Severity, float * pAigPressureRatios, int nAigPressureRatios, int nPressureEntries );
   571	    extern void Map_Stmap60SetNearMissLeafDiag( int fEnable, int TrackNode );
   572	    extern void Map_Stmap61SetCutOnlyGateDiag( int fEnable, int TrackNode );
   573	    extern void Map_Stmap62SetCutOnlyOrdering( int fEnable );
   574	    extern void Map_Stmap63SetCutOnlyLoadDropGuard( int fEnable );
   575	
   576	    pNtk = Abc_FrameReadNtk(pAbc);
   577	    DelayTarget = -1;
   578	    AreaMulti   = 0;
   579	    DelayMulti  = 0;
   580	    fAreaOnly   = 0;
   581	    fRecovery   = 1;
   582	    fSweep      = 0;
   583	    fSwitching  = 0;
   584	    fSkipFanout = 57; // stmap63 reuses reviewed mode 57 plus command-scoped load-drop guard; -f disables it
   585	    fUseProfile = 0;
   586	    fUseBuffs   = 0;
   587	    fVerbose    = 0;
   588	    Extra_UtilGetoptReset();
   589	    while ( ( c = Extra_UtilGetopt( argc, argv, "DABFSGMarspfuovh" ) ) != EOF )
   590	    {
   591	        switch ( c )
   592	        {
   593	        case 'D':
   594	            if ( globalUtilOptind >= argc )
   595	            {
   596	                Abc_Print( -1, "Command line switch \"-D\" should be followed by a floating point number.\n" );
   597	                goto usage;
   598	            }
   599	            DelayTarget = (float)atof(argv[globalUtilOptind]);
   600	            globalUtilOptind++;
   601	            if ( DelayTarget <= 0.0 )
   602	                goto usage;
   603	            break;
   604	        case 'A':
   605	            if ( globalUtilOptind >= argc )
   606	            {
   607	                Abc_Print( -1, "Command line switch \"-A\" should be followed by a floating point number.\n" );
   608	                goto usage;
   609	            }
   610	            AreaMulti = (float)atof(argv[globalUtilOptind]);
   611	            globalUtilOptind++;
   612	            break;
   613	        case 'B':
   614	            if ( globalUtilOptind >= argc )
   615	            {
   616	                Abc_Print( -1, "Command line switch \"-B\" should be followed by a floating point number.\n" );
   617	                goto usage;
   618	            }
   619	            DelayMulti = (float)atof(argv[globalUtilOptind]);
   620	            globalUtilOptind++;
   621	            break;
   622	        case 'F':
   623	            if ( globalUtilOptind >= argc )
   624	            {
   625	                Abc_Print( -1, "Command line switch \"-F\" should be followed by a floating point number.\n" );
   626	                goto usage;
   627	            }
   628	            LogFan = (float)atof(argv[globalUtilOptind]);
   629	            globalUtilOptind++;
   630	            if ( LogFan < 0.0 )
   631	                goto usage;
   632	            break;
   633	        case 'S':
   634	            if ( globalUtilOptind >= argc )
   635	            {
   636	                Abc_Print( -1, "Command line switch \"-S\" should be followed by a floating point number.\n" );
   637	                goto usage;
   638	            }
   639	            Slew = (float)atof(argv[globalUtilOptind]);
   640	            globalUtilOptind++;
   641	            if ( Slew <= 0.0 )
   642	                goto usage;
   643	            break;
   644	        case 'G':
   645	            if ( globalUtilOptind >= argc )
   646	            {
   647	                Abc_Print( -1, "Command line switch \"-G\" should be followed by a floating point number.\n" );
   648	                goto usage;
   649	            }
   650	            Gain = (float)atof(argv[globalUtilOptind]);
   651	            globalUtilOptind++;
   652	            if ( Gain <= 0.0 )
   653	                goto usage;
   654	            break;
   655	        case 'M':
   656	            if ( globalUtilOptind >= argc )
   657	            {
   658	                Abc_Print( -1, "Command line switch \"-M\" should be followed by a positive integer.\n" );
   659	                goto usage;
   660	            }
   661	            nGatesMin = atoi(argv[globalUtilOptind]);
   662	            globalUtilOptind++;
   663	            if ( nGatesMin < 0 )
   664	                goto usage;
   665	            break;
   666	        case 'a':
   667	            fAreaOnly ^= 1;
   668	            break;
   669	        case 'r':
   670	            fRecovery ^= 1;
   671	            break;
   672	        case 's':
   673	            fSweep ^= 1;
   674	            break;
   675	        case 'p':
   676	            fSwitching ^= 1;
   677	            break;
   678	        case 'f':
   679	            fSkipFanout = fSkipFanout ? 0 : 57;
   680	            break;
   681	        case 'u':
   682	            fUseProfile ^= 1;
   683	            break;
   684	        case 'o':
   685	            fUseBuffs ^= 1;
   686	            break;
   687	        case 'v':
   688	            fVerbose ^= 1;
   689	            break;
   690	        case 'h':
   691	            goto usage;
   692	        default:
   693	            goto usage;
   694	        }
   695	    }
   696	
   697	    if ( pNtk == NULL )
   698	    {
   699	        Abc_Print( -1, "Empty network.\n" );
   700	        return 1;
   701	    }
   702	
   703	    if ( fAreaOnly )
   704	        DelayTarget = ABC_INFINITY;
   705	
   706	    Map_Stmap45SetSclLoadFeedbackWithEntries( 0.0, 0.0, 0.0, NULL, 0, 0 );
   707	    Map_Stmap60SetNearMissLeafDiag( 0, -1 );
   708	    Map_Stmap61SetCutOnlyGateDiag( 0, -1 );
   709	    Map_Stmap62SetCutOnlyOrdering( 0 );
   710	    Map_Stmap63SetCutOnlyLoadDropGuard( 0 );
   711	    pNtkMap = pNtk;
   712	    if ( !Abc_NtkIsStrash(pNtk) )
   713	    {
   714	        pNtkMap = Abc_NtkStrash( pNtk, 0, 0, 0 );
   715	        if ( pNtkMap == NULL )
   716	        {
   717	            Abc_Print( -1, "Strashing before stmap63 has failed.\n" );
   718	            return 1;
   719	        }
   720	        pNtkMap = Abc_NtkBalance( pNtkRes = pNtkMap, 0, 0, 1 );
   721	        Abc_NtkDelete( pNtkRes );
   722	        if ( pNtkMap == NULL )
   723	        {
   724	            Abc_Print( -1, "Balancing before stmap63 has failed.\n" );
   725	            return 1;
   726	        }
   727	        fTempMap = 1;
   728	        Abc_Print( 0, "The network was strashed and balanced before stmap63.\n" );
   729	    }
   730	
   731	    if ( fSkipFanout )
   732	    {
   733	        pNtkFirst = Abc_NtkMap( pNtkMap, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, Gain, nGatesMin, fRecovery, fSwitching, 36, fUseProfile, fUseBuffs, fVerbose );
   734	        if ( pNtkFirst == NULL )
   735	        {
   736	            if ( fTempMap )
   737	                Abc_NtkDelete( pNtkMap );
   738	            Abc_Print( -1, "stmap63 has failed.\n" );
   739	            return 1;
   740	        }
   741	        Abc_Stmap63CollectSclLoadStats( pNtkFirst, &LoadStats );
   742	        Abc_Stmap63PrintSclLoadStats( "feedback-load", &LoadStats );
   743	        Abc_Stmap63PrintHotspots( &LoadStats );
   744	        OverFrac = LoadStats.nMatched ? (float)LoadStats.nOver / (float)LoadStats.nMatched : 0.0;
   745	        Feedback = Abc_Stmap63FeedbackSeverity( &LoadStats );
   746	        LowGain = 0.90 * Gain;
   747	        SelectedGain = Gain;
   748	        fUseReducedGain = Feedback >= ABC_STMAP63_SEVERE_THRESHOLD && LoadStats.nPressureEntries >= ABC_STMAP63_PRESSURE_ENTRY_THRESHOLD;
   749	        fSevereTransfer = fUseReducedGain;
   750	        if ( fUseReducedGain && LowGain > 0.0 )
   751	            SelectedGain = LowGain;
   752	        pBoundedPressureRatios = Abc_Stmap63BuildBoundedPressures( &LoadStats, fSevereTransfer, &BoundedStats );
   753	        if ( pBoundedPressureRatios == NULL && LoadStats.nAigPressureRatios > 0 )
   754	        {
   755	            Abc_NtkDelete( pNtkFirst );
   756	            Abc_Stmap63LoadStatsFree( &LoadStats );
   757	            if ( fTempMap )
   758	                Abc_NtkDelete( pNtkMap );
   759	            Abc_Print( -1, "stmap63 bounded-pressure allocation has failed.\n" );
   760	            return 1;
   761	        }
   762	        printf( "stmap63 feedback: remap = 1  active = %d  max-load-ratio = %.3f  over-max-frac = %.6f  severity = %.3f  raw-pressure-entries = %d  sink-pressure-entries = %d  pressure-capacity = %d\n",
   763	            Feedback > 0.0 && LoadStats.nPressureEntries > 0, LoadStats.RatioMax, OverFrac,
   764	            Feedback, LoadStats.nPressureEntries, LoadStats.nSinkPressureEntries,
   765	            LoadStats.nAigPressureRatios );
   766	        printf( "stmap63 blended-gain: base-gain = %.2f  blend-gain = %.2f  selected-gain = %.2f  severity-threshold = 0.850  raw-pressure-threshold = 8000  selected-blend-gain = %d\n",
   767	            Gain, LowGain, SelectedGain, fUseReducedGain );
   768	        Abc_Stmap63PrintBoundedPressures( &LoadStats, &BoundedStats );
   769	        printf( "stmap63 mapper-mode: bounded-pressure-transfer-mode = 57  cut-only-before-moderate = 0  load-drop-cut-only-guard = 1  blended-gain = %.2f  pressure-feed = %s  raw-weight = %.2f  bounded-ratio-cap = %.3f  inherited-cut-only-area-save-cap = 1.35x-inverter  tracked-near-miss-node = %d  cut-only-gate-diag = 1\n",
   770	            SelectedGain, fSevereTransfer ? "bounded-raw" : "sink-fallback",
   771	            ABC_STMAP63_BOUND_RAW_WEIGHT, ABC_STMAP63_BOUND_RATIO_CAP,
   772	            ABC_STMAP63_TRACK_NODE );
   773	        Abc_NtkDelete( pNtkFirst );
   774	        Map_Stmap45SetSclLoadFeedbackWithEntries( LoadStats.RatioMax, OverFrac, Feedback, pBoundedPressureRatios, LoadStats.nAigPressureRatios, BoundedStats.nEntries );
   775	        Map_Stmap60SetNearMissLeafDiag( 1, ABC_STMAP63_TRACK_NODE );
   776	        Map_Stmap61SetCutOnlyGateDiag( 1, ABC_STMAP63_TRACK_NODE );
   777	        Map_Stmap62SetCutOnlyOrdering( 0 );
   778	        Map_Stmap63SetCutOnlyLoadDropGuard( 1 );
   779	        pNtkRes = Abc_NtkMap( pNtkMap, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, SelectedGain, nGatesMin, fRecovery, fSwitching, 57, fUseProfile, fUseBuffs, fVerbose );
   780	        Map_Stmap63SetCutOnlyLoadDropGuard( 0 );
   781	        Map_Stmap62SetCutOnlyOrdering( 0 );
   782	        Map_Stmap61SetCutOnlyGateDiag( 0, -1 );
   783	        Map_Stmap60SetNearMissLeafDiag( 0, -1 );
   784	        Map_Stmap45SetSclLoadFeedbackWithEntries( 0.0, 0.0, 0.0, NULL, 0, 0 );
   785	        ABC_FREE( pBoundedPressureRatios );
   786	        Abc_Stmap63LoadStatsFree( &LoadStats );
   787	        if ( pNtkRes == NULL )
   788	        {
   789	            if ( fTempMap )
   790	                Abc_NtkDelete( pNtkMap );
   791	            Abc_Print( -1, "stmap63 feedback remap has failed.\n" );
   792	            return 1;
   793	        }
   794	    }
   795	    else
   796	    {
   797	        pNtkRes = Abc_NtkMap( pNtkMap, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, Gain, nGatesMin, fRecovery, fSwitching, 0, fUseProfile, fUseBuffs, fVerbose );
   798	        if ( pNtkRes == NULL )
   799	        {
   800	            if ( fTempMap )
   801	                Abc_NtkDelete( pNtkMap );
   802	            Abc_Print( -1, "stmap63 has failed.\n" );
   803	            return 1;
   804	        }
   805	    }
   806	    if ( fTempMap )
   807	        Abc_NtkDelete( pNtkMap );
   808	
   809	    if ( fSweep )
   810	    {
   811	        Abc_NtkFraigSweep( pNtkRes, 0, 0, 0, 0 );
   812	        if ( Abc_NtkHasMapping(pNtkRes) )
   813	        {
   814	            pNtkRes = Abc_NtkDupDfs( pNtk = pNtkRes );
   815	            Abc_NtkDelete( pNtk );
   816	        }
   817	    }
   818	
   819	    Abc_Stmap63CollectSclLoadStats( pNtkRes, &LoadStats );
   820	    Abc_Stmap63PrintSclLoadStats( "scl-load", &LoadStats );
   821	    Abc_Stmap63LoadStatsFree( &LoadStats );
   822	    Abc_FrameReplaceCurrentNetwork( pAbc, pNtkRes );
   823	    return 0;
   824	
   825	usage:
   826	    if ( DelayTarget == -1 )
   827	        sprintf(Buffer, "not used" );
   828	    else
   829	        sprintf(Buffer, "%.3f", DelayTarget );
   830	    Abc_Print( -2, "usage: stmap63 [-DABFSG float] [-M num] [-arspfuovh]\n" );
   831	    Abc_Print( -2, "\t              performs stmap63 bounded-pressure transfer with load-drop cut-only gating diagnostics\n" );
   832	    Abc_Print( -2, "\t-D float : sets the global required times [default = %s]\n", Buffer );
   833	    Abc_Print( -2, "\t-A float : \"area multiplier\" to bias gate selection [default = %.2f]\n", AreaMulti );
   834	    Abc_Print( -2, "\t-B float : \"delay multiplier\" to bias gate selection [default = %.2f]\n", DelayMulti );
   835	    Abc_Print( -2, "\t-F float : the logarithmic fanout delay parameter [default = %.2f]\n", LogFan );
   836	    Abc_Print( -2, "\t-S float : the slew parameter used to generate the library [default = %.2f]\n", Slew );
   837	    Abc_Print( -2, "\t-G float : the SCL/genlib gain parameter used to generate the library [default = %.2f]\n", Gain );
   838	    Abc_Print( -2, "\t-M num   : skip gate classes whose size is less than this [default = %d]\n", nGatesMin );
   839	    Abc_Print( -2, "\t-a       : toggles area-only mapping [default = %s]\n", fAreaOnly? "yes": "no" );
