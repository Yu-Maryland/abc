   307	/**Function*************************************************************
   308	
   309	  Synopsis    [Returns direct SCL input-pin load driven by a mapped node.]
   310	
   311	  Description []
   312	
   313	  SideEffects []
   314	
   315	  SeeAlso     []
   316	
   317	***********************************************************************/
   318	static float Abc_Stmap63FanoutLoad( SC_Lib * pLib, Abc_Obj_t * pObj, int * pFanouts, int * pPins )
   319	{
   320	    Abc_Obj_t * pFanout;
   321	    Mio_Gate_t * pGateFan;
   322	    SC_Cell * pCellFan;
   323	    float Load = 0.0;
   324	    int i, iFanin, CellId;
   325	    *pFanouts = 0;
   326	    *pPins = 0;
   327	    Abc_ObjForEachFanout( pObj, pFanout, i )
   328	    {
   329	        (*pFanouts)++;
   330	        if ( !Abc_ObjIsNode(pFanout) || pFanout->pData == NULL )
   331	            continue;
   332	        iFanin = Abc_NodeFindFanin( pFanout, pObj );
   333	        if ( iFanin < 0 )
   334	            continue;
   335	        pGateFan = (Mio_Gate_t *)pFanout->pData;
   336	        CellId = Abc_SclCellFind( pLib, Mio_GateReadName(pGateFan) );
   337	        if ( CellId < 0 )
   338	            continue;
   339	        pCellFan = SC_LibCell( pLib, CellId );
   340	        if ( pCellFan == NULL || iFanin >= pCellFan->n_inputs )
   341	            continue;
   342	        Load += SC_CellPinCap( pCellFan, iFanin );
   343	        (*pPins)++;
   344	    }
   345	    return Load;
   346	}
