   194	static float Abc_Stmap63ObjCriticality( SC_Man * pTime, Abc_Obj_t * pObj )
   195	{
   196	    float Slack, Window, Criticality;
   197	    if ( pTime == NULL || pObj == NULL || pTime->MaxDelay <= 0.0 )
   198	        return 0.0;
   199	    if ( Abc_ObjId(pObj) < 0 || Abc_ObjId(pObj) >= pTime->nObjs )
   200	        return 0.0;
   201	    Slack = Abc_SclObjGetSlack( pTime, pObj, pTime->MaxDelay );
   202	    if ( Slack < 0.0 )
   203	        Slack = 0.0;
   204	    Window = 0.18 * pTime->MaxDelay;
   205	    if ( Window < 10.0 )
   206	        Window = 10.0;
   207	    Criticality = 1.0 - Slack / Window;
   208	    if ( Criticality < 0.0 )
   209	        return 0.0;
   210	    return Criticality > 1.0 ? 1.0 : Criticality;
   211	}
