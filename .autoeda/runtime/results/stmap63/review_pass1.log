   348	/**Function*************************************************************
   349	
   350	  Synopsis    [Prints direct SCL load diagnostics for the mapped network.]
   351	
   352	  Description []
   353	
   354	  SideEffects []
   355	
   356	  SeeAlso     []
   357	
   358	***********************************************************************/
   359	static void Abc_Stmap63CollectSclLoadStats( Abc_Ntk_t * pNtk, Abc_Stmap63LoadStats_t * pStats )
   360	{
   361	    SC_Lib * pLib = (SC_Lib *)Abc_FrameReadLibScl();
   362	    SC_Man * pTime = NULL;
   363	    Abc_Obj_t * pObj;
   364	    Mio_Gate_t * pGate;
   365	    SC_Cell * pCell;
   366	    float Load, MaxCap, Ratio, Criticality;
   367	    int i, CellId, Fanouts, Pins;
   368	    Abc_Stmap63LoadStatsClear( pStats );
   369	    if ( pLib == NULL || !Abc_SclHasDelayInfo(pLib) )
   370	        return;
   371	    pStats->fAvailable = 1;
   372	    if ( Abc_NtkHasMapping(pNtk) )
   373	    {
   374	        pTime = Abc_SclManStart( pLib, pNtk, 0, 1, 0, 0 );
   375	        pStats->TimingDelay = pTime->MaxDelay;
   376	    }
   377	    Abc_NtkForEachNode( pNtk, pObj, i )
   378	    {
   379	        pStats->nNodes++;
   380	        if ( pObj->pData == NULL )
   381	            continue;
   382	        pGate = (Mio_Gate_t *)pObj->pData;
   383	        CellId = Abc_SclCellFind( pLib, Mio_GateReadName(pGate) );
   384	        if ( CellId < 0 )
   385	            continue;
   386	        pCell = SC_LibCell( pLib, CellId );
   387	        if ( pCell == NULL || pCell->n_outputs == 0 )
   388	            continue;
   389	        MaxCap = SC_CellPin( pCell, pCell->n_inputs )->max_out_cap;
   390	        if ( MaxCap <= 0.0 )
   391	            continue;
   392	        Load = Abc_Stmap63FanoutLoad( pLib, pObj, &Fanouts, &Pins );
   393	        Ratio = Load / MaxCap;
   394	        pStats->RatioSum += Ratio;
   395	        if ( pStats->RatioMax < Ratio )
   396	            pStats->RatioMax = Ratio;
   397	        if ( Ratio > 1.0 )
   398	            pStats->nOver++;
   399	        pStats->nMatched++;
   400	        pStats->nPins += Pins;
   401	        Criticality = Abc_Stmap63ObjCriticality( pTime, pObj );
   402	        pStats->CriticalitySum += Criticality;
   403	        if ( Criticality > 0.0 )
   404	            pStats->nCriticalNodes++;
   405	        if ( pStats->CriticalityMax < Criticality )
   406	            pStats->CriticalityMax = Criticality;
   407	        Abc_Stmap63TopInsert( pStats->TopRatios, pStats->TopNodes, pStats->pTopGates, pStats->TopFanouts, pStats->TopLoads, pStats->TopCaps,
   408	            Ratio, Abc_ObjId(pObj), Mio_GateReadName(pGate), Fanouts, Load, MaxCap );
   409	        Abc_Stmap63CollectHotspotCone( pNtk, pObj, pStats, pTime, Ratio );
   410	    }
   411	    if ( pTime )
   412	        Abc_SclManFree( pTime );
   413	}
