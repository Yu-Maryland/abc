   165	static int Abc_Stmap63EnsurePressureCapacity( Abc_Stmap63LoadStats_t * pStats, int AigId )
   166	{
   167	    float * pNew, * pNewSink;
   168	    int i, nOld, nNew;
   169	    if ( AigId < 0 )
   170	        return 0;
   171	    if ( AigId < pStats->nAigPressureRatios )
   172	        return 1;
   173	    nOld = pStats->nAigPressureRatios;
   174	    nNew = nOld ? nOld : 1024;
   175	    while ( nNew <= AigId )
   176	        nNew *= 2;
   177	    pNew = ABC_REALLOC( float, pStats->pAigPressureRatios, nNew );
   178	    if ( pNew == NULL )
   179	        return 0;
   180	    pStats->pAigPressureRatios = pNew;
   181	    pNewSink = ABC_REALLOC( float, pStats->pAigSinkPressureRatios, nNew );
   182	    if ( pNewSink == NULL )
   183	        return 0;
   184	    pStats->pAigSinkPressureRatios = pNewSink;
   185	    for ( i = nOld; i < nNew; i++ )
   186	    {
   187	        pStats->pAigPressureRatios[i] = 0.0;
   188	        pStats->pAigSinkPressureRatios[i] = 0.0;
   189	    }
   190	    pStats->nAigPressureRatios = nNew;
   191	    return 1;
   192	}
