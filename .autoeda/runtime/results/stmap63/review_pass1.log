void Map_Stmap46SetSclLoadFeedback( float MaxLoadRatio, float OverFrac, float Severity, float * pAigPressureRatios, int nAigPressureRatios )
{
    s_Stmap46SclMaxLoadRatio = MaxLoadRatio;
