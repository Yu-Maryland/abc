                        p->nStmap28ModeratePenaltyBlocked, pNode->Num, pNode->Level, pNode->nRefs,
                        pCut->nLeaves, fPhase, Slack, AreaSave, ArrivalDelta, ArrivalGainMargin,
                        Stmap28PenaltyFactor, AreaMargin );
                }
