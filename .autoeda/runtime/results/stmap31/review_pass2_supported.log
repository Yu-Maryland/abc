            return 1;
        }
    }
    AreaMargin = p->pSuperLib ? 0.5 * p->pSuperLib->AreaInv : 0.0;
    if ( pMatch->AreaFlow < pMatchBest->AreaFlow - AreaMargin - p->fEpsilon )
        return 0;
    if ( fStmap13 )
        p->nStmap13RejectArea++;
    return 1;
}

