   705	        if ( Slack <= 5.0 )
   706	            nSlack5++;
   707	        LoadRatio = Abc_Stmap64FinalLoadRatio( pTime, pObj, &Load, &MaxCap );
   708	        Arrival = Abc_SclObjTimeMax( pTime, pObj );
   709	        Departure = Abc_MaxFloat( Abc_SclObjDept( pTime, pObj )->rise, Abc_SclObjDept( pTime, pObj )->fall );
   710	        Slew = (float)Abc_SclObjSlewMax( pTime, pObj );
   711	        Slot = -1;
   712	        for ( k = 0; k < ABC_STMAP74_TOP; k++ )
