   724	        for ( k = ABC_STMAP74_TOP - 1; k > Slot; k-- )
   725	        {
   726	            TopObjs[k] = TopObjs[k-1];
   727	            TopAigIds[k] = TopAigIds[k-1];
   728	            TopPhases[k] = TopPhases[k-1];
   729	            TopCriticality[k] = TopCriticality[k-1];
   730	            TopSlack[k] = TopSlack[k-1];
   731	            TopLoad[k] = TopLoad[k-1];
   732	            TopMaxCap[k] = TopMaxCap[k-1];
   733	            TopLoadRatio[k] = TopLoadRatio[k-1];
   734	            TopArrival[k] = TopArrival[k-1];
