   764	            TopArrival[i], TopDeparture[i], TopSlew[i], TopLoad[i], TopMaxCap[i],
   765	            TopLoadRatio[i] );
   766	    }
   767	    Abc_Stmap74ClearFinalCriticalScope();
   768	}
