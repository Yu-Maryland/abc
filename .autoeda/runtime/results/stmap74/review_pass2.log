   714	            if ( TopObjs[k] < 0 || Criticality > TopCriticality[k] ||
   715	                 (Criticality == TopCriticality[k] && Slack < TopSlack[k]) ||
   716	                 (Criticality == TopCriticality[k] && Slack == TopSlack[k] && LoadRatio > TopLoadRatio[k]) )
