+            pGate ? Mio_GateReadName(pGate) : "?", Fanouts, TopCriticality[i], TopSlack[i],
+            TopArrival[i], TopDeparture[i], TopSlew[i], TopLoad[i], TopMaxCap[i],
+            TopLoadRatio[i] );
+    }
+    Abc_Stmap74ClearFinalCriticalScope();
+}
