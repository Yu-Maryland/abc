+    s_pStmap74FinalCriticalLabel = pLabel && pLabel[0] ? pLabel : "stmap74";
+    if ( !s_fStmap74FinalCriticalScope )
+        s_pStmap74FinalCriticalLabel = "stmap74";
+}
