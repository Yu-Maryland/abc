        s_nStmap75ActiveWatchAigs = WatchAigId >= 0 ? 1 : 0;
        if ( WatchAigId >= 0 )
            s_Stmap75WatchAigIds[0] = WatchAigId;
    }
    else
    {
        Map_Stmap75ResetFinalCriticalAigDiagState();
