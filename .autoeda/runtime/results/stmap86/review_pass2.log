static void Map_Stmap80ResetCandidateCutCounters( void )
{
    s_nStmap80CandidateCutRows = 0;
    s_nStmap80CandidateCutViable = 0;
    s_nStmap80CandidateCutAccepted = 0;
    s_nStmap80CandidateChildPhase0 = 0;
