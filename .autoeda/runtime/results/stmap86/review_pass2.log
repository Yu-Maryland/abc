         s_pStmap74FinalCriticalNtk == pOldNtk &&
         s_pStmap74FinalCriticalOrigIds == pOldOrigNodeIds )
    {
        s_pStmap74FinalCriticalNtk = pNewNtk;
        s_pStmap74FinalCriticalOrigIds = pNewOrigNodeIds;
    }
    if ( s_fStmap76PhaseSurvivalScope &&
