    if ( OldSinkRatio == 0.0 )
        pStats->nSinkPressureEntries++;
    else
        pStats->nSinkPressureUpdates++;
    pStats->pAigSinkPressureRatios[AigId] = SinkRatio;
    Abc_Stmap65PressureTopInsert( pStats, AigId, NodeId, SinkRatio );
}

