   122	            return 0;
   123	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   124	        SlackMargin = p->pSuperLib->tDelayInv.Worst;
   125	        SlackLimit = 2.0 * SlackMargin;
   126	        if ( Slack <= p->fEpsilon || Slack > SlackLimit + p->fEpsilon )
   127	            return 0;
   128	        return (pNode->nRefs > 6 && pCut->nLeaves > 2) || (pNode->nRefs > 3 && pCut->nLeaves > 3);
   129	    }
   130	    if ( p->fSkipFanout == 5 )
   131	    {
