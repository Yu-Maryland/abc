    93	    if ( !p->fSkipFanout )
    94	        return 0;
    95	    if ( p->fSkipFanout == 2 )
    96	        return (pNode->nRefs > 6 && pCut->nLeaves > 2) || (pNode->nRefs > 3 && pCut->nLeaves > 3);
    97	    if ( p->fSkipFanout == 3 )
    98	    {
    99	        if ( p->fMappingMode < 1 || p->fMappingMode > 3 )
   100	            return 0;
   101	        pCutBest = pNode->pCutBest[fPhase];
   102	        if ( pCutBest == NULL )
   103	            return 0;
   104	        pMatchBest = pCutBest->M + fPhase;
   105	        if ( pMatchBest->pSuperBest == NULL )
   106	            return 0;
   107	        Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   108	        SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   109	        if ( Slack <= SlackMargin + p->fEpsilon )
   110	            return 0;
   111	        return (pNode->nRefs > 6 && pCut->nLeaves > 2) || (pNode->nRefs > 3 && pCut->nLeaves > 3);
   112	    }
