   237	static void Abc_Stmap53InsertConsumerFanins( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap53LoadStats_t * pStats, float Ratio, float SinkCriticality, int Depth )
   238	{
