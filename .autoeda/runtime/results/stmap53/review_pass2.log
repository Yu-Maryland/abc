   115	static int Abc_Stmap53MappedObjAigId( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj )
   116	{
   117	    int Lit;
   118	    if ( pNtk == NULL || pObj == NULL || pNtk->vOrigNodeIds == NULL )
   119	        return -1;
   120	    if ( Abc_ObjId(pObj) >= Vec_IntSize(pNtk->vOrigNodeIds) )
   121	        return -1;
   122	    Lit = Vec_IntEntry( pNtk->vOrigNodeIds, Abc_ObjId(pObj) );
   123	    return Lit >= 0 ? Abc_Lit2Var(Lit) : -1;
   124	}
