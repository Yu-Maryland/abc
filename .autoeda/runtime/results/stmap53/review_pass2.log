   248	            pStats->nHotspotFanin++;
   249	            Abc_Stmap53PressureInsert( pStats, AigId, Abc_ObjId(pFanin), Ratio, SinkCriticality );
   250	        }
   251	        Abc_Stmap53InsertConsumerFanins( pNtk, pFanin, pStats, 0.78 * Ratio, SinkCriticality, Depth - 1 );
   252	    }
   253	}
