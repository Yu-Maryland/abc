   452	/**Function*************************************************************
   453	
   454	  Synopsis    [Runs the stmap52 mapper probe.]
   455	
   456	  Description [stmap52 measures direct SCL load/max-cap pressure after an
   457	  initial base-gain map, keeps the stmap49 high-pressure SCL/genlib gain, and
   458	  remaps with a versioned local area-cap mapper mode. The hypothesis is that
   459	  capping only pressure-agreed moderate area penalties reduces severe-pressure
   460	  area without globally softening the final gain.]
   461	
   462	  SideEffects []
   463	
   464	  SeeAlso     []
   465	
   466	***********************************************************************/
   467	int Abc_CommandStmap52( Abc_Frame_t * pAbc, int argc, char ** argv )
   468	{
   469	    Abc_Ntk_t * pNtk, * pNtkMap, * pNtkRes, * pNtkFirst;
