    Abc_Stmap53CollectSclLoadStats( pNtkRes, &LoadStats );
    Abc_Stmap53PrintSclLoadStats( "scl-load", &LoadStats );
    Abc_Stmap53LoadStatsFree( &LoadStats );
    Abc_FrameReplaceCurrentNetwork( pAbc, pNtkRes );
    return 0;

usage:
    if ( DelayTarget == -1 )
