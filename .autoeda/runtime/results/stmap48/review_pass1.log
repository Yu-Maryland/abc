   255	static void Abc_Stmap48CollectHotspotCone( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap48LoadStats_t * pStats, SC_Man * pTime, float Ratio )
   256	{
   257	    Abc_Obj_t * pFanout, * pFanout2;
   258	    float FanoutCriticality;
   259	    int i, k, AigId;
   260	    if ( Ratio <= 1.0 )
   261	        return;
   262	    AigId = Abc_Stmap48MappedObjAigId( pNtk, pObj );
   263	    if ( AigId >= 0 )
   264	    {
   265	        pStats->nHotspotRoots++;
   266	        Abc_Stmap48PressureInsert( pStats, AigId, Abc_ObjId(pObj), 0.90 * Ratio, Abc_Stmap48ObjCriticality( pTime, pObj ) );
   267	    }
   268	    Abc_ObjForEachFanout( pObj, pFanout, i )
   269	    {
   270	        FanoutCriticality = Abc_Stmap48ObjCriticality( pTime, pFanout );
   271	        AigId = Abc_Stmap48MappedObjAigId( pNtk, pFanout );
   272	        if ( AigId >= 0 )
   273	        {
   274	            pStats->nHotspotFanout++;
   275	            Abc_Stmap48PressureInsert( pStats, AigId, Abc_ObjId(pFanout), Ratio, FanoutCriticality );
   276	        }
   277	        Abc_Stmap48InsertConsumerFanins( pNtk, pFanout, pStats, 0.86 * Ratio, FanoutCriticality, 3 );
   278	        Abc_ObjForEachFanout( pFanout, pFanout2, k )
   279	        {
   280	            FanoutCriticality = Abc_Stmap48ObjCriticality( pTime, pFanout2 );
   281	            AigId = Abc_Stmap48MappedObjAigId( pNtk, pFanout2 );
   282	            if ( AigId < 0 )
   283	                continue;
   284	            pStats->nHotspotFanout++;
   285	            Abc_Stmap48PressureInsert( pStats, AigId, Abc_ObjId(pFanout2), 0.66 * Ratio, FanoutCriticality );
   286	        }
   287	    }
   288	}
