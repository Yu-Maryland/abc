    NodePressureRatio = Map_MatchStmap45NodePressureRatio( pNode, pNodeAigId );
    CutPressureRatio = Map_MatchStmap45CutPressureRatio( pCut );
    if ( pNodePressureRatio )
        *pNodePressureRatio = NodePressureRatio;
    if ( pCutPressureRatio )
