   431	    for ( i = 0; i < ABC_STMAP48_TOP_PRESSURES && pStats->TopPressureRatios[i] > 0.0; i++ )
   432	        printf( "stmap48 sink-pressure: rank = %d  aig-id = %d  mapped-node = %d  sink-pressure-ratio = %.3f\n",
   433	            i + 1, pStats->TopPressureAigIds[i], pStats->TopPressureNodes[i], pStats->TopPressureRatios[i] );
