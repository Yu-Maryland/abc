   119	        return -1;
   120	    if ( Abc_ObjId(pObj) >= Vec_IntSize(pNtk->vOrigNodeIds) )
   121	        return -1;
   122	    Lit = Vec_IntEntry( pNtk->vOrigNodeIds, Abc_ObjId(pObj) );
   123	    return Lit >= 0 ? Abc_Lit2Var(Lit) : -1;
   124	}
