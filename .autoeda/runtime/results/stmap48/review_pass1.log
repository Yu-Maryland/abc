   419	static void Abc_Stmap48PrintHotspots( Abc_Stmap48LoadStats_t * pStats )
   420	{
   421	    int i;
   422	    if ( !pStats->fAvailable )
   423	        return;
   424	    printf( "stmap48 sink-pressure stats: roots = %d  consumer-fanin = %d  consumer-fanout = %d  raw-pressure-entries = %d  raw-pressure-updates = %d  sink-pressure-entries = %d  sink-pressure-updates = %d  pressure-missed = %d  pressure-capacity = %d  tracked-aig = %d  tracked-node = %d  tracked-raw-ratio = %.3f  tracked-sink-ratio = %.3f\n",
   425	        pStats->nHotspotRoots, pStats->nHotspotFanin, pStats->nHotspotFanout,
   426	        pStats->nPressureEntries, pStats->nPressureUpdates,
