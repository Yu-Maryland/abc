+    s_Stmap42SclOverFrac = OverFrac;
+    s_Stmap42SclFeedback = Severity;
+    s_pStmap42SclPressureRatios = pAigPressureRatios;
+    s_nStmap42SclPressureRatios = nAigPressureRatios;
