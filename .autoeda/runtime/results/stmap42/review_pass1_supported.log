        pNtkRes = Abc_NtkMap( pNtkMap, NULL, DelayTarget, AreaMulti, DelayMulti, LogFan, Slew, Gain, nGatesMin, fRecovery, fSwitching, 42, fUseProfile, fUseBuffs, fVerbose );
        Map_Stmap41SetSclLoadFeedback( 0.0, 0.0, 0.0, NULL, 0 );
