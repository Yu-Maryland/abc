/**Function*************************************************************

  Synopsis    [Runs the stmap24 mapper probe.]

  Description [stmap24 tightens the critical-slack moderate deep early-profile
  seed rule: before the adaptive profile opens, one-inverter middle-slack
  relief keeps the stmap20 shallow seeds, keeps stmap21's strong deep seeds,
  and admits moderate deep seeds only when their existing mapper slack is on
  the tightest side of the middle-slack window.]

  SideEffects []

  SeeAlso     []

***********************************************************************/
int Abc_CommandStmap24( Abc_Frame_t * pAbc, int argc, char ** argv )
{
    Abc_Ntk_t * pNtk, * pNtkRes;
    char Buffer[100];
    double DelayTarget;
    double AreaMulti;
    double DelayMulti;
    float LogFan = 0;
    float Slew = 0; // choose based on the library
    float Gain = 250; // keep classic map gain to isolate the critical-slack seed rule
    int nGatesMin = 0;
    int fAreaOnly;
    int fRecovery;
    int fSweep;
    int fSwitching;
    int fSkipFanout;
    int fUseProfile;
    int fUseBuffs;
    int fVerbose;
    int c;
