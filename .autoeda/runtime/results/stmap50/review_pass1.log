    76	/**Function*************************************************************
    77	
    78	  Synopsis    [Inserts one mapped-load diagnostic into the top list.]
    79	
    80	  Description []
    81	
    82	  SideEffects []
    83	
    84	  SeeAlso     []
    85	
    86	***********************************************************************/
    87	static void Abc_Stmap50TopInsert( float * pRatios, int * pNodes, const char ** ppGates, int * pFanouts, float * pLoads, float * pCaps, float Ratio, int Node, const char * pGate, int Fanouts, float Load, float Cap )
    88	{
    89	    int i, k;
    90	    if ( Ratio <= pRatios[4] )
    91	        return;
    92	    for ( i = 0; i < 5; i++ )
    93	    {
    94	        if ( Ratio <= pRatios[i] )
    95	            continue;
    96	        for ( k = 4; k > i; k-- )
    97	        {
    98	            pRatios[k] = pRatios[k-1];
    99	            pNodes[k] = pNodes[k-1];
   100	            ppGates[k] = ppGates[k-1];
   101	            pFanouts[k] = pFanouts[k-1];
   102	            pLoads[k] = pLoads[k-1];
   103	            pCaps[k] = pCaps[k-1];
   104	        }
   105	        pRatios[i] = Ratio;
   106	        pNodes[i] = Node;
   107	        ppGates[i] = pGate;
   108	        pFanouts[i] = Fanouts;
   109	        pLoads[i] = Load;
   110	        pCaps[i] = Cap;
   111	        return;
   112	    }
   113	}
