   452	/**Function*************************************************************
   453	
   454	  Synopsis    [Runs the stmap50 mapper probe.]
   455	
   456	  Description [stmap50 measures direct SCL load/max-cap pressure after an
   457	  initial base-gain map, then reuses the stmap45 pressure-agreement mapper
   458	  mode with a severity-banded SCL/genlib gain for high-severity, large
   459	  pressure cases. The hypothesis is that sub-extreme high pressure can use a
   460	  softer 0.95 gain multiplier to reduce area while reserving the stmap49 0.90
   461	  multiplier for extreme pressure.]
   462	
   463	  SideEffects []
   464	
   465	  SeeAlso     []
   466	
   467	***********************************************************************/
   468	int Abc_CommandStmap50( Abc_Frame_t * pAbc, int argc, char ** argv )
   469	{
   470	    Abc_Ntk_t * pNtk, * pNtkMap, * pNtkRes, * pNtkFirst;
   471	    Abc_Stmap50LoadStats_t LoadStats;
   472	    char Buffer[100];
   473	    double DelayTarget;
   474	    double AreaMulti;
   475	    double DelayMulti;
   476	    float LogFan = 0;
   477	    float Slew = 0; // choose based on the library
   478	    float Gain = 250; // base SCL/genlib gain for low and moderate pressure
   479	    float SoftGain, LowGain, SelectedGain;
   480	    int nGatesMin = 0;
   481	    int fAreaOnly;
   482	    int fRecovery;
   483	    int fSweep;
   484	    int fSwitching;
   485	    int fSkipFanout;
   486	    int fUseProfile;
   487	    int fUseBuffs;
   488	    int fVerbose;
   489	    int c, fTempMap = 0;
   490	    int fUseHighPressureGain, fUseSoftGain, fUseLowGain;
   491	    float OverFrac, Feedback;
