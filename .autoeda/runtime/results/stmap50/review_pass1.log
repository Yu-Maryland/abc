    59	    int TopPressureAigIds[ABC_STMAP50_TOP_PRESSURES];
    60	    int TopPressureNodes[ABC_STMAP50_TOP_PRESSURES];
    61	    float TopPressureRatios[ABC_STMAP50_TOP_PRESSURES];
