+        Abc_Stmap50PrintSclLoadStats( "feedback-load", &LoadStats );
+        Abc_Stmap50PrintHotspots( &LoadStats );
+        OverFrac = LoadStats.nMatched ? (float)LoadStats.nOver / (float)LoadStats.nMatched : 0.0;
+        Feedback = Abc_Stmap50FeedbackSeverity( &LoadStats );
+        SoftGain = 0.95 * Gain;
+        LowGain = 0.90 * Gain;
+        SelectedGain = Gain;
+        fUseHighPressureGain = Feedback >= 0.85 && LoadStats.nSinkPressureEntries >= 8000;
+        fUseLowGain = fUseHighPressureGain && Feedback >= 0.90;
+        fUseSoftGain = fUseHighPressureGain && !fUseLowGain;
+        if ( fUseLowGain && LowGain > 0.0 )
+            SelectedGain = LowGain;
+        else if ( fUseSoftGain && SoftGain > 0.0 )
+            SelectedGain = SoftGain;
+        printf( "stmap50 feedback: remap = 1  active = %d  max-load-ratio = %.3f  over-max-frac = %.6f  severity = %.3f  raw-pressure-entries = %d  sink-pressure-entries = %d  pressure-capacity = %d\n",
+            Feedback > 0.0 && LoadStats.nSinkPressureEntries > 0, LoadStats.RatioMax, OverFrac,
+            Feedback, LoadStats.nPressureEntries, LoadStats.nSinkPressureEntries,
+            LoadStats.nAigPressureRatios );
+        printf( "stmap50 banded-gain: base-gain = %.2f  soft-gain = %.2f  low-gain = %.2f  selected-gain = %.2f  severity-threshold = 0.850  extreme-severity-threshold = 0.900  sink-pressure-threshold = 8000  selected-soft-gain = %d  selected-low-gain = %d\n",
+            Gain, SoftGain, LowGain, SelectedGain, fUseSoftGain, fUseLowGain );
