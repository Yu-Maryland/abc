   115	static int Abc_Stmap50MappedObjAigId( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj )
   116	{
   117	    int Lit;
   118	    if ( pNtk == NULL || pObj == NULL || pNtk->vOrigNodeIds == NULL )
   119	        return -1;
   120	    if ( Abc_ObjId(pObj) >= Vec_IntSize(pNtk->vOrigNodeIds) )
   121	        return -1;
   122	    Lit = Vec_IntEntry( pNtk->vOrigNodeIds, Abc_ObjId(pObj) );
   123	    return Lit >= 0 ? Abc_Lit2Var(Lit) : -1;
   124	}
   125	
   126	static void Abc_Stmap50PressureTopInsert( Abc_Stmap50LoadStats_t * pStats, int AigId, int NodeId, float Ratio )
   127	{
   128	    int i, k;
   129	    if ( Ratio <= pStats->TopPressureRatios[ABC_STMAP50_TOP_PRESSURES-1] )
   130	        return;
   131	    for ( i = 0; i < ABC_STMAP50_TOP_PRESSURES; i++ )
   132	    {
   133	        if ( Ratio <= pStats->TopPressureRatios[i] )
   134	            continue;
   135	        for ( k = ABC_STMAP50_TOP_PRESSURES - 1; k > i; k-- )
   136	        {
   137	            pStats->TopPressureRatios[k] = pStats->TopPressureRatios[k-1];
   138	            pStats->TopPressureAigIds[k] = pStats->TopPressureAigIds[k-1];
   139	            pStats->TopPressureNodes[k] = pStats->TopPressureNodes[k-1];
   140	        }
   141	        pStats->TopPressureRatios[i] = Ratio;
   142	        pStats->TopPressureAigIds[i] = AigId;
   143	        pStats->TopPressureNodes[i] = NodeId;
   144	        return;
   145	    }
   146	}
   147	
   148	static int Abc_Stmap50EnsurePressureCapacity( Abc_Stmap50LoadStats_t * pStats, int AigId )
   149	{
   150	    float * pNew, * pNewSink;
   151	    int i, nOld, nNew;
   152	    if ( AigId < 0 )
   153	        return 0;
   154	    if ( AigId < pStats->nAigPressureRatios )
   155	        return 1;
   156	    nOld = pStats->nAigPressureRatios;
   157	    nNew = nOld ? nOld : 1024;
   158	    while ( nNew <= AigId )
   159	        nNew *= 2;
   160	    pNew = ABC_REALLOC( float, pStats->pAigPressureRatios, nNew );
   161	    if ( pNew == NULL )
   162	        return 0;
   163	    pStats->pAigPressureRatios = pNew;
   164	    pNewSink = ABC_REALLOC( float, pStats->pAigSinkPressureRatios, nNew );
   165	    if ( pNewSink == NULL )
   166	        return 0;
   167	    pStats->pAigSinkPressureRatios = pNewSink;
   168	    for ( i = nOld; i < nNew; i++ )
   169	    {
   170	        pStats->pAigPressureRatios[i] = 0.0;
   171	        pStats->pAigSinkPressureRatios[i] = 0.0;
   172	    }
   173	    pStats->nAigPressureRatios = nNew;
   174	    return 1;
   175	}
   176	
   177	static float Abc_Stmap50ObjCriticality( SC_Man * pTime, Abc_Obj_t * pObj )
   178	{
   179	    float Slack, Window, Criticality;
   180	    if ( pTime == NULL || pObj == NULL || pTime->MaxDelay <= 0.0 )
   181	        return 0.0;
   182	    if ( Abc_ObjId(pObj) < 0 || Abc_ObjId(pObj) >= pTime->nObjs )
   183	        return 0.0;
   184	    Slack = Abc_SclObjGetSlack( pTime, pObj, pTime->MaxDelay );
   185	    if ( Slack < 0.0 )
   186	        Slack = 0.0;
   187	    Window = 0.18 * pTime->MaxDelay;
   188	    if ( Window < 10.0 )
   189	        Window = 10.0;
   190	    Criticality = 1.0 - Slack / Window;
   191	    if ( Criticality < 0.0 )
   192	        return 0.0;
   193	    return Criticality > 1.0 ? 1.0 : Criticality;
   194	}
   195	
   196	static void Abc_Stmap50PressureInsert( Abc_Stmap50LoadStats_t * pStats, int AigId, int NodeId, float Ratio, float SinkCriticality )
   197	{
   198	    float OldRatio, OldSinkRatio, SinkWeight, SinkRatio;
   199	    if ( AigId < 0 || Ratio <= 1.0 )
   200	        return;
   201	    if ( SinkCriticality < 0.0 )
   202	        SinkCriticality = 0.0;
   203	    if ( SinkCriticality > 1.0 )
   204	        SinkCriticality = 1.0;
   205	    SinkWeight = 0.35 + 0.65 * SinkCriticality;
   206	    SinkRatio = 1.0 + (Ratio - 1.0) * SinkWeight;
   207	    if ( AigId == ABC_STMAP50_TRACK_AIG_ID && Ratio > pStats->TrackedRatio )
   208	    {
   209	        pStats->TrackedRatio = Ratio;
   210	        pStats->TrackedNode = NodeId;
   211	    }
   212	    if ( AigId == ABC_STMAP50_TRACK_AIG_ID && SinkRatio > pStats->TrackedSinkRatio )
   213	        pStats->TrackedSinkRatio = SinkRatio;
   214	    if ( !Abc_Stmap50EnsurePressureCapacity( pStats, AigId ) )
   215	    {
   216	        pStats->nPressureMissed++;
   217	        return;
   218	    }
   219	    OldRatio = pStats->pAigPressureRatios[AigId];
   220	    OldSinkRatio = pStats->pAigSinkPressureRatios[AigId];
   221	    if ( OldRatio == 0.0 )
   222	        pStats->nPressureEntries++;
   223	    else if ( Ratio > OldRatio )
   224	        pStats->nPressureUpdates++;
   225	    if ( Ratio > OldRatio )
   226	        pStats->pAigPressureRatios[AigId] = Ratio;
   227	    if ( SinkRatio <= 1.0 || SinkRatio <= OldSinkRatio )
   228	        return;
   229	    if ( OldSinkRatio == 0.0 )
   230	        pStats->nSinkPressureEntries++;
   231	    else
   232	        pStats->nSinkPressureUpdates++;
   233	    pStats->pAigSinkPressureRatios[AigId] = SinkRatio;
   234	    Abc_Stmap50PressureTopInsert( pStats, AigId, NodeId, SinkRatio );
   235	}
   236	
   237	static void Abc_Stmap50InsertConsumerFanins( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap50LoadStats_t * pStats, float Ratio, float SinkCriticality, int Depth )
   238	{
   239	    Abc_Obj_t * pFanin;
   240	    int i, AigId;
   241	    if ( pObj == NULL || Ratio <= 1.0 || Depth <= 0 )
   242	        return;
   243	    Abc_ObjForEachFanin( pObj, pFanin, i )
   244	    {
   245	        AigId = Abc_Stmap50MappedObjAigId( pNtk, pFanin );
   246	        if ( AigId >= 0 )
   247	        {
   248	            pStats->nHotspotFanin++;
   249	            Abc_Stmap50PressureInsert( pStats, AigId, Abc_ObjId(pFanin), Ratio, SinkCriticality );
   250	        }
   251	        Abc_Stmap50InsertConsumerFanins( pNtk, pFanin, pStats, 0.78 * Ratio, SinkCriticality, Depth - 1 );
   252	    }
   253	}
   254	
   255	static void Abc_Stmap50CollectHotspotCone( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, Abc_Stmap50LoadStats_t * pStats, SC_Man * pTime, float Ratio )
   256	{
   257	    Abc_Obj_t * pFanout, * pFanout2;
   258	    float FanoutCriticality;
   259	    int i, k, AigId;
   260	    if ( Ratio <= 1.0 )
---
   260	    if ( Ratio <= 1.0 )
   261	        return;
   262	    AigId = Abc_Stmap50MappedObjAigId( pNtk, pObj );
   263	    if ( AigId >= 0 )
   264	    {
   265	        pStats->nHotspotRoots++;
   266	        Abc_Stmap50PressureInsert( pStats, AigId, Abc_ObjId(pObj), 0.90 * Ratio, Abc_Stmap50ObjCriticality( pTime, pObj ) );
   267	    }
   268	    Abc_ObjForEachFanout( pObj, pFanout, i )
   269	    {
   270	        FanoutCriticality = Abc_Stmap50ObjCriticality( pTime, pFanout );
   271	        AigId = Abc_Stmap50MappedObjAigId( pNtk, pFanout );
   272	        if ( AigId >= 0 )
   273	        {
   274	            pStats->nHotspotFanout++;
   275	            Abc_Stmap50PressureInsert( pStats, AigId, Abc_ObjId(pFanout), Ratio, FanoutCriticality );
   276	        }
   277	        Abc_Stmap50InsertConsumerFanins( pNtk, pFanout, pStats, 0.86 * Ratio, FanoutCriticality, 3 );
   278	        Abc_ObjForEachFanout( pFanout, pFanout2, k )
   279	        {
   280	            FanoutCriticality = Abc_Stmap50ObjCriticality( pTime, pFanout2 );
   281	            AigId = Abc_Stmap50MappedObjAigId( pNtk, pFanout2 );
   282	            if ( AigId < 0 )
   283	                continue;
   284	            pStats->nHotspotFanout++;
   285	            Abc_Stmap50PressureInsert( pStats, AigId, Abc_ObjId(pFanout2), 0.66 * Ratio, FanoutCriticality );
   286	        }
   287	    }
   288	}
