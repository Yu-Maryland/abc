/**Function*************************************************************

  Synopsis    [Runs the stmap96 soft-release sticky emitted-AIG drive/load target probe.]

  Description [stmap96 keeps the relaxed final-critical emitted AIG/phase
  target sticky after an override but lowers the sticky timing-release
  threshold from 2.00 ps to 0.50 ps, allowing locally faster replacements to
  test whether stmap95's forced OAI21 survivor caused the or1200 regression.]

  SideEffects []

  SeeAlso     []

***********************************************************************/
int Abc_CommandStmap96( Abc_Frame_t * pAbc, int argc, char ** argv )
{
    Abc_Ntk_t * pNtk, * pNtkRes;
