  1045	Abc_Obj_t * Abc_NodeFromMapPhase_rec( Abc_Ntk_t * pNtkNew, Map_Node_t * pNodeMap, int fPhase )
  1046	{
  1047	    Abc_Obj_t * pNodePIs[10];
  1048	    Abc_Obj_t * pNodeNew;
  1049	    Map_Node_t ** ppLeaves;
  1050	    Map_Cut_t * pCutBest;
  1051	    Map_Super_t * pSuperBest;
  1052	    unsigned uPhaseBest;
  1053	    int i, fInvPin, nLeaves;
  1054	
  1055	    // make sure the node can be implemented in this phase
  1056	    assert( Map_NodeReadCutBest(pNodeMap, fPhase) != NULL || Map_NodeIsConst(pNodeMap) );
  1057	    // check if the phase is already implemented
  1058	    pNodeNew = (Abc_Obj_t *)Map_NodeReadData( pNodeMap, fPhase );
  1059	    if ( pNodeNew )
  1060	    {
  1061	        Abc_Stmap77RecordReconstructionCache( pNodeMap, fPhase, pNodeNew, "phase" );
  1062	        return pNodeNew;
  1063	    }
  1064	
  1065	    // get the information about the best cut 
  1066	    pCutBest   = Map_NodeReadCutBest( pNodeMap, fPhase );
  1067	    pSuperBest = Map_CutReadSuperBest( pCutBest, fPhase );
  1068	    uPhaseBest = Map_CutReadPhaseBest( pCutBest, fPhase );
  1069	    nLeaves    = Map_CutReadLeavesNum( pCutBest );
  1070	    ppLeaves   = Map_CutReadLeaves( pCutBest );
  1071	    //Vec_Ptr_t * vAnds = Map_CutInternalNodes( pNodeMap, pCutBest );
  1072	
  1073	    // collect the PI nodes
  1074	    for ( i = 0; i < nLeaves; i++ )
  1075	    {
  1076	        fInvPin = ((uPhaseBest & (1 << i)) > 0);
  1077	        Abc_Stmap78RecordLeafDemand( pNodeMap, fPhase, ppLeaves[i], !fInvPin, i, pCutBest, pSuperBest, uPhaseBest );
  1078	        pNodePIs[i] = Abc_NodeFromMap_rec( pNtkNew, ppLeaves[i], !fInvPin );
  1079	        assert( pNodePIs[i] != NULL );
  1080	    }
  1081	
  1082	    // implement the supergate
  1083	    pNodeNew = Abc_NodeFromMapSuper_rec( pNtkNew, pNodeMap, pSuperBest, pNodePIs, nLeaves );
  1084	    Vec_IntWriteEntry( pNtkNew->vOrigNodeIds, pNodeNew->Id, Abc_Var2Lit( Map_NodeReadAigId(pNodeMap), fPhase ) );
  1085	    Map_NodeSetData( pNodeMap, fPhase, (char *)pNodeNew );
  1086	    Abc_Stmap77RecordReconstructionEmit( pNodeMap, fPhase, pNodeNew, pCutBest, pSuperBest, uPhaseBest );
  1087	    return pNodeNew;
  1088	}
  1089	Abc_Obj_t * Abc_NodeFromMap_rec( Abc_Ntk_t * pNtkNew, Map_Node_t * pNodeMap, int fPhase )
  1090	{
  1091	    Abc_Obj_t * pNodeNew, * pNodeInv;
  1092	    int fPushed = 0, fOldPathPhase = -1;
  1093	
  1094	    // check the case of constant node
  1095	    if ( Map_NodeIsConst(pNodeMap) )
  1096	    {
  1097	        pNodeNew = fPhase? Abc_NtkCreateNodeConst1(pNtkNew) : Abc_NtkCreateNodeConst0(pNtkNew);
  1098	        if ( pNodeNew->pData == NULL )
  1099	            printf( "Error creating mapped network: Library does not have a constant %d gate.\n", fPhase );
  1100	        return pNodeNew;
  1101	    }
  1102	
  1103	    Abc_Stmap79RecordParentCuts( pNodeMap );
  1104	    Abc_Stmap78DemandPathPush( pNodeMap, fPhase );
  1105	    fPushed = s_fStmap78DemandPathDiag && s_fStmap78DemandPathActive;
  1106	    Abc_Stmap77RecordReconstructionRequest( pNodeMap, fPhase );
  1107	
  1108	    // check if the phase is already implemented
  1109	    pNodeNew = (Abc_Obj_t *)Map_NodeReadData( pNodeMap, fPhase );
  1110	    if ( pNodeNew )
  1111	    {
  1112	        Abc_Stmap77RecordReconstructionCache( pNodeMap, fPhase, pNodeNew, "request" );
  1113	        if ( fPushed )
  1114	            Abc_Stmap78DemandPathPop();
  1115	        return pNodeNew;
  1116	    }
  1117	
  1118	    // implement the node if the best cut is assigned
  1119	    if ( Map_NodeReadCutBest(pNodeMap, fPhase) != NULL )
  1120	    {
  1121	        pNodeNew = Abc_NodeFromMapPhase_rec( pNtkNew, pNodeMap, fPhase );
  1122	        if ( fPushed )
  1123	            Abc_Stmap78DemandPathPop();
  1124	        return pNodeNew;
  1125	    }
  1125	    }
  1126	
  1127	    // if the cut is not assigned, implement the node
  1128	    assert( Map_NodeReadCutBest(pNodeMap, !fPhase) != NULL || Map_NodeIsConst(pNodeMap) );
  1129	    if ( fPushed )
  1130	        fOldPathPhase = Abc_Stmap78DemandPathSetTopPhase( !fPhase );
  1131	    pNodeNew = Abc_NodeFromMapPhase_rec( pNtkNew, pNodeMap, !fPhase );
  1132	    if ( fPushed && fOldPathPhase >= 0 )
  1133	        Abc_Stmap78DemandPathSetTopPhase( fOldPathPhase );
  1134	
  1135	    // add the inverter
  1136	    pNodeInv = Abc_NtkCreateNode( pNtkNew );
  1137	    Vec_IntWriteEntry( pNtkNew->vOrigNodeIds, pNodeInv->Id, Abc_Var2Lit( Map_NodeReadAigId(pNodeMap), fPhase ) );
  1138	    Abc_ObjAddFanin( pNodeInv, pNodeNew );
  1139	    pNodeInv->pData = Mio_LibraryReadInv((Mio_Library_t *)Abc_FrameReadLibGen());
  1140	
  1141	    // set the inverter
  1142	    Map_NodeSetData( pNodeMap, fPhase, (char *)pNodeInv );
  1143	    Abc_Stmap77RecordReconstructionInverter( pNodeMap, fPhase, pNodeNew, pNodeInv );
  1144	    if ( fPushed )
  1145	        Abc_Stmap78DemandPathPop();
  1146	    return pNodeInv;
  1147	}
  1148	Abc_Ntk_t * Abc_NtkFromMap( Map_Man_t * pMan, Abc_Ntk_t * pNtk, int fUseBuffs )
  1149	{
  1150	    Abc_Ntk_t * pNtkNew;
  1151	    Map_Node_t * pNodeMap;
  1152	    Abc_Obj_t * pNode, * pNodeNew;
  1153	    int i, nDupGates;
  1154	    assert( Map_ManReadBufNum(pMan) == pNtk->nBarBufs );
  1155	    // create the new network
  1156	    pNtkNew = Abc_NtkStartFrom( pNtk, ABC_NTK_LOGIC, ABC_FUNC_MAP );
  1157	    pNtkNew->vOrigNodeIds = Vec_IntStartFull( 2 * Abc_NtkObjNumMax(pNtk) );
  1158	    // make the mapper point to the new network
  1159	    Map_ManCleanData( pMan );
  1160	    Abc_NtkForEachCi( pNtk, pNode, i )
  1161	    {
  1162	        if ( i >= Abc_NtkCiNum(pNtk) - pNtk->nBarBufs )
  1163	            break;
  1164	        Map_NodeSetData( Map_ManReadInputs(pMan)[i], 1, (char *)pNode->pCopy );
  1165	    }
  1166	    Abc_NtkForEachCi( pNtk, pNode, i )
  1167	    {
  1168	        if ( i < Abc_NtkCiNum(pNtk) - pNtk->nBarBufs )
  1169	            continue;
  1170	        Map_NodeSetData( Map_ManReadBufs(pMan)[i - (Abc_NtkCiNum(pNtk) - pNtk->nBarBufs)], 1, (char *)pNode->pCopy );
  1171	    }
  1172	    // assign the mapping of the required phase to the POs
  1173	    Abc_NtkForEachCo( pNtk, pNode, i )
  1174	    {
  1175	        if ( i < Abc_NtkCoNum(pNtk) - pNtk->nBarBufs )
  1176	            continue;
  1177	        pNodeMap = Map_ManReadBufDriver( pMan, i - (Abc_NtkCoNum(pNtk) - pNtk->nBarBufs) );
  1178	        Abc_Stmap77RecordReconstructionDemand( "barbuf", i, pNodeMap, !Map_IsComplement(pNodeMap) );
  1179	        Abc_Stmap78DemandPathSetRoot( "barbuf", i );
  1180	        pNodeNew = Abc_NodeFromMap_rec( pNtkNew, Map_Regular(pNodeMap), !Map_IsComplement(pNodeMap) );
  1181	        assert( !Abc_ObjIsComplement(pNodeNew) );
  1182	        Abc_ObjAddFanin( pNode->pCopy, pNodeNew );
  1183	    }
  1184	    Abc_NtkForEachCo( pNtk, pNode, i )
  1185	    {
  1186	        if ( i >= Abc_NtkCoNum(pNtk) - pNtk->nBarBufs )
  1187	            break;
  1188	        pNodeMap = Map_ManReadOutputs(pMan)[i];
  1189	        Abc_Stmap77RecordReconstructionDemand( "co", i, pNodeMap, !Map_IsComplement(pNodeMap) );
  1190	        Abc_Stmap78DemandPathSetRoot( "co", i );
  1191	        pNodeNew = Abc_NodeFromMap_rec( pNtkNew, Map_Regular(pNodeMap), !Map_IsComplement(pNodeMap) );
  1192	        assert( !Abc_ObjIsComplement(pNodeNew) );
  1193	        Abc_ObjAddFanin( pNode->pCopy, pNodeNew );
  1194	    }
  1195	    // decouple the PO driver nodes to reduce the number of levels
  1196	    nDupGates = Abc_NtkLogicMakeSimpleCos( pNtkNew, !fUseBuffs );
  1197	//    if ( nDupGates && Map_ManReadVerbose(pMan) )
  1198	//        printf( "Duplicated %d gates to decouple the CO drivers.\n", nDupGates );
  1199	    return pNtkNew;
  1200	}
