+    Abc_Stmap79RecordParentCutPhase( pNodeRegular, 0 );
+    Abc_Stmap79RecordParentCutPhase( pNodeRegular, 1 );
+}
+
+void Abc_Stmap79PrintParentCutSummary( void )
