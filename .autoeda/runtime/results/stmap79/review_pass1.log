   600	    if ( fActive )
   601	        Abc_Stmap79ResetParentCutCounters();
   602	    s_fStmap79ParentCutActive = fActive;
   603	    (void)pPassLabel;
   604	}
   605	
   606	static void Abc_Stmap79RecordParentCutPhase( Map_Node_t * pParentMap, int fPhase )
   607	{
   608	    Map_Cut_t * pCutBest;
   609	    Map_Super_t * pSuperBest;
   610	    Map_Node_t ** ppLeaves;
   611	    Mio_Gate_t * pGate;
   612	    unsigned uPhaseBest = 0;
   613	    int nLeaves = 0, i, ChildLeaf = -1, ChildPhase = -1, LeafAigId[6], LeafPhase[6];
   614	    if ( fPhase < 0 || fPhase > 1 || s_Stmap79ParentCutLogged[fPhase] )
   615	        return;
   616	    s_Stmap79ParentCutLogged[fPhase] = 1;
   617	    for ( i = 0; i < 6; i++ )
   618	    {
   619	        LeafAigId[i] = -1;
   620	        LeafPhase[i] = -1;
   621	    }
   622	    pCutBest = Map_NodeReadCutBest( Map_Regular(pParentMap), fPhase );
   623	    if ( pCutBest )
   624	    {
   625	        s_Stmap79ParentCutHasCut[fPhase] = 1;
   626	        pSuperBest = Map_CutReadSuperBest( pCutBest, fPhase );
   627	        pGate = pSuperBest ? Map_SuperReadRoot( pSuperBest ) : NULL;
   628	        uPhaseBest = Map_CutReadPhaseBest( pCutBest, fPhase );
   629	        nLeaves = Map_CutReadLeavesNum( pCutBest );
   630	        ppLeaves = Map_CutReadLeaves( pCutBest );
   631	        for ( i = 0; i < nLeaves && i < 6; i++ )
   632	        {
   633	            LeafAigId[i] = Map_NodeReadAigId( Map_Regular(ppLeaves[i]) );
   634	            LeafPhase[i] = ((uPhaseBest & (1 << i)) > 0) ? 0 : 1;
   635	            if ( LeafAigId[i] == s_Stmap79ChildAigId )
   636	            {
   637	                ChildLeaf = i;
   638	                ChildPhase = LeafPhase[i];
   639	            }
   640	        }
   641	    }
   642	    else
   643	    {
   644	        pSuperBest = NULL;
   645	        pGate = NULL;
   646	    }
   647	    if ( ChildPhase >= 0 && ChildPhase < 2 )
   648	        s_Stmap79ParentCutChildPhase[ChildPhase]++;
   649	    else if ( pCutBest )
   650	        s_nStmap79ParentCutChildMissing++;
   651	    s_nStmap79ParentCutRows++;
   652	    printf( "%s parent-cut: index = %d  parent-aig = %d  child-aig = %d  phase = %d  has-cut = %d  gate = %s  leaves = %d  u-phase-best = %u  fanout-limit = %d  child-leaf-index = %d  child-requested-phase = %d  child-inverted-pin = %d  leaf0-aig-id = %d  leaf0-phase = %d  leaf1-aig-id = %d  leaf1-phase = %d  leaf2-aig-id = %d  leaf2-phase = %d  leaf3-aig-id = %d  leaf3-phase = %d  leaf4-aig-id = %d  leaf4-phase = %d  leaf5-aig-id = %d  leaf5-phase = %d\n",
   653	        s_pStmap79ParentCutLabel, s_nStmap79ParentCutRows,
   654	        s_Stmap79ParentAigId, s_Stmap79ChildAigId, fPhase, pCutBest != NULL,
   655	        pGate ? Mio_GateReadName(pGate) : "?", nLeaves, uPhaseBest,
   656	        pSuperBest ? Map_SuperReadFanoutLimit(pSuperBest) : -1, ChildLeaf,
   657	        ChildPhase, ChildPhase >= 0 ? !ChildPhase : -1,
   658	        LeafAigId[0], LeafPhase[0], LeafAigId[1], LeafPhase[1],
   659	        LeafAigId[2], LeafPhase[2], LeafAigId[3], LeafPhase[3],
   660	        LeafAigId[4], LeafPhase[4], LeafAigId[5], LeafPhase[5] );
   661	}
   662	
   663	static void Abc_Stmap79RecordParentCuts( Map_Node_t * pNodeMap )
   664	{
   665	    Map_Node_t * pNodeRegular;
   666	    if ( !s_fStmap79ParentCutDiag || !s_fStmap79ParentCutActive || pNodeMap == NULL )
   667	        return;
   668	    pNodeRegular = Map_Regular( pNodeMap );
   669	    if ( Map_NodeIsConst( pNodeRegular ) )
   670	        return;
   671	    if ( Map_NodeReadAigId( pNodeRegular ) != s_Stmap79ParentAigId )
   672	        return;
   673	    s_nStmap79ParentCutRequests++;
   674	    Abc_Stmap79RecordParentCutPhase( pNodeRegular, 0 );
   675	    Abc_Stmap79RecordParentCutPhase( pNodeRegular, 1 );
   676	}
   677	
