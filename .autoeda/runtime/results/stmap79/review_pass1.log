   679	{
   680	    printf( "%s parent-cut stats: child-aig = %d  parent-aig = %d  requests = %d  rows = %d  phase0-has-cut = %d  phase1-has-cut = %d  child-phase0 = %d  child-phase1 = %d  child-missing = %d\n",
   681	        s_pStmap79ParentCutLabel, s_Stmap79ChildAigId, s_Stmap79ParentAigId,
   682	        s_nStmap79ParentCutRequests, s_nStmap79ParentCutRows,
   683	        s_Stmap79ParentCutHasCut[0], s_Stmap79ParentCutHasCut[1],
   684	        s_Stmap79ParentCutChildPhase[0], s_Stmap79ParentCutChildPhase[1],
   685	        s_nStmap79ParentCutChildMissing );
   686	}
