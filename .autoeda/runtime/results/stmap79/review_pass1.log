    s_Stmap79ParentCutHasCut[0] = 0;
    s_Stmap79ParentCutHasCut[1] = 0;
    s_Stmap79ParentCutChildPhase[0] = 0;
    s_Stmap79ParentCutChildPhase[1] = 0;
