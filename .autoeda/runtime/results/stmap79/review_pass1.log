static int s_Stmap79ParentCutLogged[2] = { 0, 0 };
static int s_Stmap79ParentCutHasCut[2] = { 0, 0 };
static int s_Stmap79ParentCutChildPhase[2] = { 0, 0 };
static int s_nStmap79ParentCutChildMissing = 0;

