        printf( "stmap65 blended-gain: base-gain = %.2f  blend-gain = %.2f  selected-gain = %.2f  severity-threshold = 0.850  raw-pressure-threshold = 8000  selected-blend-gain = %d\n",
            Gain, LowGain, SelectedGain, fUseReducedGain );
