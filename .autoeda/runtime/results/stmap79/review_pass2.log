    63	/**Function*************************************************************
    64	
    65	  Synopsis    [Runs the stmap79 downstream-parent cut diagnostic.]
    66	
    67	  Description [stmap79 keeps the reviewed stmap65 mapping policy unchanged,
    68	  reuses stmap78 final-demand tracing, and records both selected phases of
    69	  the downstream parent fanout cut to see whether an alternate parent phase
    70	  would request the watched child in the other polarity.]
    71	
    72	  SideEffects []
    73	
    74	  SeeAlso     []
    75	
    76	***********************************************************************/
    77	int Abc_CommandStmap79( Abc_Frame_t * pAbc, int argc, char ** argv )
    78	{
    79	    Abc_Ntk_t * pNtk, * pNtkRes;
    80	    int i, RetValue, ChildAigId, ParentAigId, WatchAigs[1];
    81	    extern int Abc_CommandStmap65( Abc_Frame_t * pAbc, int argc, char ** argv );
    82	    extern void Map_Stmap75SetFinalCriticalAigDiag( int fEnable, int WatchAigId );
    83	    extern void Map_Stmap75SetFinalCriticalAigDiagLabel( const char * pLabel );
    84	    extern void Map_Stmap75PrintFinalCriticalAigSummary( void );
    85	    extern void Abc_Stmap74EnableFinalCriticalScope( Abc_Ntk_t * pNtk, const char * pLabel );
    86	    extern void Abc_Stmap76EnablePhaseSurvivalScope( Abc_Ntk_t * pNtk, const char * pLabel, int * pWatchAigIds, int nWatchAigs );
    87	    extern void Abc_Stmap77SetReconstructionDiag( int fEnable, const char * pLabel, int * pWatchAigIds, int nWatchAigs );
    88	    extern void Abc_Stmap77PrintReconstructionSummary( void );
    89	    extern void Abc_Stmap78SetDemandPathDiag( int fEnable, const char * pLabel, int WatchAigId, int DownstreamAigId );
    90	    extern void Abc_Stmap78PrintDemandPathSummary( void );
    91	    extern void Abc_Stmap79SetParentCutDiag( int fEnable, const char * pLabel, int ChildAigId, int ParentAigId );
    92	    extern void Abc_Stmap79PrintParentCutSummary( void );
    93	
    94	    for ( i = 1; i < argc; i++ )
    95	    {
    96	        if ( !strcmp( argv[i], "-h" ) )
    97	            goto usage;
    98	    }
    99	
   100	    pNtk = Abc_FrameReadNtk( pAbc );
   101	    Abc_Stmap79WatchAigsForNetwork( pNtk, &ChildAigId, &ParentAigId );
   102	    WatchAigs[0] = ChildAigId;
   103	    printf( "stmap79 diagnostic: inherited-policy = stmap65  mapper-selected-match-watch = %d  network = %s  child-aig = %d  parent-aig = %d  source = stmap78-parent-polarity-hypothesis  reconstruction-phase-trace = 1  demand-path-trace = 1  parent-cut-trace = 1  final-phase-survival = 1  mapping-policy-change = 0\n",
   104	        ChildAigId >= 0, pNtk && Abc_NtkName(pNtk) ? Abc_NtkName(pNtk) : "?",
   105	        ChildAigId, ParentAigId );
   106	    Map_Stmap75SetFinalCriticalAigDiag( ChildAigId >= 0, ChildAigId );
   107	    Map_Stmap75SetFinalCriticalAigDiagLabel( "stmap79" );
   108	    Abc_Stmap77SetReconstructionDiag( ChildAigId >= 0, "stmap79", WatchAigs, ChildAigId >= 0 ? 1 : 0 );
   109	    Abc_Stmap78SetDemandPathDiag( ChildAigId >= 0, "stmap79", ChildAigId, ParentAigId );
   110	    Abc_Stmap79SetParentCutDiag( ChildAigId >= 0, "stmap79", ChildAigId, ParentAigId );
   111	    RetValue = Abc_CommandStmap65( pAbc, argc, argv );
   112	    Abc_Stmap77PrintReconstructionSummary();
   113	    Abc_Stmap78PrintDemandPathSummary();
   114	    Abc_Stmap79PrintParentCutSummary();
   115	    Abc_Stmap79SetParentCutDiag( 0, "stmap79", -1, -1 );
   116	    Abc_Stmap78SetDemandPathDiag( 0, "stmap79", -1, -1 );
   117	    Abc_Stmap77SetReconstructionDiag( 0, "stmap79", NULL, 0 );
   118	    Map_Stmap75PrintFinalCriticalAigSummary();
   119	    Map_Stmap75SetFinalCriticalAigDiag( 0, -1 );
   120	    if ( RetValue == 0 )
   121	    {
   122	        pNtkRes = Abc_FrameReadNtk( pAbc );
   123	        Abc_Stmap74EnableFinalCriticalScope( pNtkRes, "stmap79" );
   124	        Abc_Stmap76EnablePhaseSurvivalScope( pNtkRes, "stmap79", WatchAigs, ChildAigId >= 0 ? 1 : 0 );
   125	    }
   126	    return RetValue;
   127	
   128	usage:
   129	    Abc_Print( -2, "usage: stmap79 [-DABFSG float] [-M num] [-arspfuovh]\n" );
   130	    Abc_Print( -2, "\t              performs stmap79 bounded-pressure mapping with downstream parent-cut diagnostics\n" );
   131	    Abc_Print( -2, "\t-D float : sets the global required times [default = not used]\n" );
   132	    Abc_Print( -2, "\t-A float : \"area multiplier\" to bias gate selection [default = 0.00]\n" );
   133	    Abc_Print( -2, "\t-B float : \"delay multiplier\" to bias gate selection [default = 0.00]\n" );
   134	    Abc_Print( -2, "\t-F float : the logarithmic fanout delay parameter [default = 0.00]\n" );
   135	    Abc_Print( -2, "\t-S float : the slew parameter used to generate the library [default = 0.00]\n" );
   136	    Abc_Print( -2, "\t-G float : the SCL/genlib gain parameter used to generate the library [default = 250.00]\n" );
   137	    Abc_Print( -2, "\t-M num   : skip gate classes whose size is less than this [default = 0]\n" );
   138	    Abc_Print( -2, "\t-a       : toggles area-only mapping [default = no]\n" );
