def write_parent_cut_summary(stats_by_name, multi_stats_by_name):
    rows_out = []
    for bench in BENCHMARKS:
        stat_rows = [row for row in stats_by_name.get("parent_cut_stats", []) if row["benchmark"] == bench]
        stat = stat_rows[0] if stat_rows else {}
        cuts = [row for row in multi_stats_by_name.get("parent_cut", []) if row["benchmark"] == bench]
        phase0 = next((row for row in cuts if row.get("phase") == "0"), {})
        phase1 = next((row for row in cuts if row.get("phase") == "1"), {})
        rows_out.append({
            "benchmark": bench,
            "child_aig": stat.get("child_aig", phase0.get("child_aig", phase1.get("child_aig", ""))),
            "parent_aig": stat.get("parent_aig", phase0.get("parent_aig", phase1.get("parent_aig", ""))),
            "requests": stat.get("requests", ""),
            "rows": stat.get("rows", ""),
            "phase0_has_cut": stat.get("phase0_has_cut", phase0.get("has_cut", "")),
            "phase1_has_cut": stat.get("phase1_has_cut", phase1.get("has_cut", "")),
            "child_phase0_count": stat.get("child_phase0", ""),
            "child_phase1_count": stat.get("child_phase1", ""),
            "child_missing": stat.get("child_missing", ""),
            "phase0_gate": phase0.get("gate", ""),
            "phase0_child_requested_phase": phase0.get("child_requested_phase", ""),
            "phase0_child_leaf_index": phase0.get("child_leaf_index", ""),
            "phase1_gate": phase1.get("gate", ""),
            "phase1_child_requested_phase": phase1.get("child_requested_phase", ""),
            "phase1_child_leaf_index": phase1.get("child_leaf_index", ""),
            "parent_child_requested_phases": _join_sorted_values(cuts, "child_requested_phase"),
        })
    write_csv(
        RESULTS / "parent_cut_summary.csv",
        rows_out,
        [
            "benchmark", "child_aig", "parent_aig", "requests", "rows",
            "phase0_has_cut", "phase1_has_cut", "child_phase0_count",
            "child_phase1_count", "child_missing", "phase0_gate",
            "phase0_child_requested_phase", "phase0_child_leaf_index",
            "phase1_gate", "phase1_child_requested_phase",
            "phase1_child_leaf_index", "parent_child_requested_phases",
        ],
    )


def main():
    RESULTS.mkdir(parents=True, exist_ok=True)
    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
        futures = [pool.submit(run_flow, kind, bench) for bench in BENCHMARKS for kind in ("baseline", "candidate")]
        flow_results = [f.result() for f in concurrent.futures.as_completed(futures)]


