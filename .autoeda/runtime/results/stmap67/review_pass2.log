    }

    Abc_Stmap64CollectSclLoadStats( pNtkRes, &LoadStats );
    Abc_Stmap64PrintSclLoadStats( "scl-load", &LoadStats );
    Abc_Stmap64LoadStatsFree( &LoadStats );
    Abc_FrameReplaceCurrentNetwork( pAbc, pNtkRes );
