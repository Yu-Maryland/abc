   563	static float Abc_Stmap64FinalLoadRatio( SC_Man * pTime, Abc_Obj_t * pObj, float * pLoad, float * pMaxCap )
   564	{
   565	    Mio_Gate_t * pGate;
   566	    SC_Cell * pCell;
   567	    float Load, MaxCap;
   568	    int CellId;
   569	    if ( pLoad )
   570	        *pLoad = 0.0;
   571	    if ( pMaxCap )
   572	        *pMaxCap = 0.0;
   573	    if ( pTime == NULL || pTime->pLib == NULL || pObj == NULL || pObj->pData == NULL )
   574	        return 0.0;
   575	    pGate = (Mio_Gate_t *)pObj->pData;
   576	    CellId = Abc_SclCellFind( pTime->pLib, Mio_GateReadName(pGate) );
   577	    if ( CellId < 0 )
   578	        return 0.0;
   579	    pCell = SC_LibCell( pTime->pLib, CellId );
   580	    if ( pCell == NULL || pCell->n_outputs == 0 )
   581	        return 0.0;
   582	    MaxCap = SC_CellPin( pCell, pCell->n_inputs )->max_out_cap;
   583	    if ( MaxCap <= 0.0 )
   584	        return 0.0;
   585	    Load = (float)Abc_SclObjLoadMax( pTime, pObj );
   586	    if ( pLoad )
   587	        *pLoad = Load;
   588	    if ( pMaxCap )
   589	        *pMaxCap = MaxCap;
   590	    return Load / MaxCap;
   591	}
