  Description [stmap66 keeps the reviewed stmap65 mapping policy unchanged
  and enables a command-scoped diagnostic for load-drop candidates whose node
  pressure is just below the strong-node admission threshold.]

  SideEffects []

  SeeAlso     []

***********************************************************************/
int Abc_CommandStmap66( Abc_Frame_t * pAbc, int argc, char ** argv )
{
    int i, RetValue;
    extern int Abc_CommandStmap65( Abc_Frame_t * pAbc, int argc, char ** argv );
    extern void Map_Stmap66SetNearStrongNodeLoadDropDiag( int fEnable );

    for ( i = 1; i < argc; i++ )
    {
        if ( !strcmp( argv[i], "-h" ) )
            goto usage;
    }

    printf( "stmap66 diagnostic: inherited-policy = stmap65  near-strong-node-load-drop = 1  node-pressure-window = [1.15,1.25)  strong-node-threshold = 1.25\n" );
    Map_Stmap66SetNearStrongNodeLoadDropDiag( 1 );
    RetValue = Abc_CommandStmap65( pAbc, argc, argv );
    Map_Stmap66SetNearStrongNodeLoadDropDiag( 0 );
    return RetValue;

usage:
