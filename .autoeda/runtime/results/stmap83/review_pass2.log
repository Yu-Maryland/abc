static int Map_Stmap81ReadChildPhase( Map_Cut_t * pCut, Map_Match_t * pMatch, int ChildAigId, int * pChildLeaf, int * pChildPhase )
{
    int i, LeafAigId;
    unsigned uPhaseBest;
