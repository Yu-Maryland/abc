    *pChildPhase = -1;
    if ( pCut == NULL || pMatch == NULL || pMatch->pSuperBest == NULL )
        return 0;
    uPhaseBest = pMatch->uPhaseBest;
    for ( i = 0; i < pCut->nLeaves && i < 6; i++ )
