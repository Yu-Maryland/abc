   556	static int Map_Stmap82MaybeBlockStickyReplacement( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase, int CutOrdinal, Map_Match_t * pMatch, int fAccepted, int fSticky, Map_Match_t * pStickyMatch, Map_Cut_t * pStickyCut, int StickyCutOrdinal )
   557	{
   558	    int ChildLeaf, ChildPhase;
   559	    float TimingGain;
   560	    const char * pAction;
   561	    if ( !fAccepted || !fSticky || !Map_Stmap82StickyParentPhaseApplies( p, pNode, fPhase ) )
   562	        return fAccepted;
   563	    Map_Stmap81ReadChildPhase( pCut, pMatch, s_Stmap82ChildAigId, &ChildLeaf, &ChildPhase );
   564	    TimingGain = pStickyMatch->tArrive.Worst - pMatch->tArrive.Worst;
   565	    if ( ChildPhase == 0 )
   566	    {
   567	        s_nStmap82StickyAllowedChild0++;
   568	        pAction = "allow-child-phase0";
   569	    }
   570	    else if ( TimingGain > s_Stmap82StickyTimingHoldWindow + p->fEpsilon )
   571	    {
   572	        s_nStmap82StickyAllowedTiming++;
   573	        pAction = "allow-timing";
   574	    }
   575	    else
   576	    {
   577	        s_nStmap82StickyBlocked++;
   578	        pAction = "block-child-missing";
   579	        fAccepted = 0;
   580	    }
   581	    if ( pAction[0] == 'a' )
   582	        s_nStmap82StickyIgnored++;
   583	    printf( "%s sticky-parent-phase: index = %d  parent-aig = %d  child-aig = %d  mapper-mode = %d  phase = %d  action = %s  cut-ordinal = %d  child-leaf-index = %d  child-requested-phase = %d  gate = %s  arrival = %.3f  area-flow = %.3f  sticky-cut-ordinal = %d  sticky-gate = %s  sticky-arrival = %.3f  sticky-area-flow = %.3f  timing-gain = %.3f  timing-hold-window = %.3f\n",
   584	        s_pStmap82StickyParentPhaseLabel, ++s_nStmap82StickyRows,
   585	        s_Stmap82ParentAigId, s_Stmap82ChildAigId, p->fMappingMode, fPhase,
   586	        pAction, CutOrdinal, ChildLeaf, ChildPhase,
   587	        pMatch->pSuperBest ? Mio_GateReadName(pMatch->pSuperBest->pRoot) : "?",
   588	        pMatch->tArrive.Worst, pMatch->AreaFlow,
   589	        StickyCutOrdinal,
   590	        pStickyMatch->pSuperBest ? Mio_GateReadName(pStickyMatch->pSuperBest->pRoot) : "?",
   591	        pStickyMatch->tArrive.Worst, pStickyMatch->AreaFlow, TimingGain, s_Stmap82StickyTimingHoldWindow );
   592	    (void)pStickyCut;
   593	    return fAccepted;
   594	}
