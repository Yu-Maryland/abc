   535	static void Map_Stmap82RememberStickyParentPhase( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase, int CutOrdinal, Map_Match_t * pMatch, int fAccepted, int * pfSticky, Map_Match_t * pStickyMatch, Map_Cut_t ** ppStickyCut, int * pStickyCutOrdinal )
   536	{
   537	    int ChildLeaf, ChildPhase;
   538	    if ( !fAccepted || !Map_Stmap82StickyParentPhaseApplies( p, pNode, fPhase ) )
   539	        return;
   540	    if ( !Map_Stmap81ReadChildPhase( pCut, pMatch, s_Stmap82ChildAigId, &ChildLeaf, &ChildPhase ) || ChildPhase != 0 )
   541	        return;
   542	    *pfSticky = 1;
   543	    *pStickyMatch = *pMatch;
   544	    *ppStickyCut = pCut;
   545	    *pStickyCutOrdinal = CutOrdinal;
   546	    s_nStmap82StickySet++;
   547	    printf( "%s sticky-parent-phase: index = %d  parent-aig = %d  child-aig = %d  mapper-mode = %d  phase = %d  action = set-sticky  cut-ordinal = %d  child-leaf-index = %d  child-requested-phase = %d  gate = %s  arrival = %.3f  area-flow = %.3f  sticky-cut-ordinal = %d  sticky-arrival = %.3f  sticky-area-flow = %.3f  timing-hold-window = %.3f\n",
   548	        s_pStmap82StickyParentPhaseLabel, ++s_nStmap82StickyRows,
   549	        s_Stmap82ParentAigId, s_Stmap82ChildAigId, p->fMappingMode, fPhase,
   550	        CutOrdinal, ChildLeaf, ChildPhase,
   551	        pMatch->pSuperBest ? Mio_GateReadName(pMatch->pSuperBest->pRoot) : "?",
   552	        pMatch->tArrive.Worst, pMatch->AreaFlow,
   553	        *pStickyCutOrdinal, pStickyMatch->tArrive.Worst, pStickyMatch->AreaFlow, s_Stmap82StickyTimingHoldWindow );
   554	}
