        LeafAigId = Map_NodeReadAigId( Map_Regular(pCut->ppLeaves[i]) );
        if ( LeafAigId != ChildAigId )
            continue;
        *pChildLeaf = i;
        *pChildPhase = ((uPhaseBest & (1 << i)) > 0) ? 0 : 1;
        return 1;
    }
    return 0;
}

