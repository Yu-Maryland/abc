                data_rows.append(row)
        phases = {row.get("phase"): row for row in data_rows}
        p0 = phases.get("0", {})
        p1 = phases.get("1", {})
        out.append(
            {
                "benchmark": bench,
                "child_aig": stats.get("child_aig", p0.get("child_aig", p1.get("child_aig", "-1"))),
                "parent_aig": stats.get("parent_aig", p0.get("parent_aig", p1.get("parent_aig", "-1"))),
