   342	static void Abc_Stmap54CollectSclLoadStats( Abc_Ntk_t * pNtk, Abc_Stmap54LoadStats_t * pStats )
   343	{
   344	    SC_Lib * pLib = (SC_Lib *)Abc_FrameReadLibScl();
   345	    SC_Man * pTime = NULL;
   346	    Abc_Obj_t * pObj;
   347	    Mio_Gate_t * pGate;
   348	    SC_Cell * pCell;
   349	    float Load, MaxCap, Ratio, Criticality;
   350	    int i, CellId, Fanouts, Pins;
   351	    Abc_Stmap54LoadStatsClear( pStats );
   352	    if ( pLib == NULL || !Abc_SclHasDelayInfo(pLib) )
   353	        return;
   354	    pStats->fAvailable = 1;
   355	    if ( Abc_NtkHasMapping(pNtk) )
   356	    {
   357	        pTime = Abc_SclManStart( pLib, pNtk, 0, 1, 0, 0 );
   358	        pStats->TimingDelay = pTime->MaxDelay;
   359	    }
   360	    Abc_NtkForEachNode( pNtk, pObj, i )
   361	    {
   362	        pStats->nNodes++;
   363	        if ( pObj->pData == NULL )
   364	            continue;
   365	        pGate = (Mio_Gate_t *)pObj->pData;
   366	        CellId = Abc_SclCellFind( pLib, Mio_GateReadName(pGate) );
   367	        if ( CellId < 0 )
   368	            continue;
   369	        pCell = SC_LibCell( pLib, CellId );
   370	        if ( pCell == NULL || pCell->n_outputs == 0 )
   371	            continue;
   372	        MaxCap = SC_CellPin( pCell, pCell->n_inputs )->max_out_cap;
   373	        if ( MaxCap <= 0.0 )
   374	            continue;
   375	        Load = Abc_Stmap54FanoutLoad( pLib, pObj, &Fanouts, &Pins );
   376	        Ratio = Load / MaxCap;
   377	        pStats->RatioSum += Ratio;
   378	        if ( pStats->RatioMax < Ratio )
   379	            pStats->RatioMax = Ratio;
   380	        if ( Ratio > 1.0 )
   381	            pStats->nOver++;
   382	        pStats->nMatched++;
   383	        pStats->nPins += Pins;
   384	        Criticality = Abc_Stmap54ObjCriticality( pTime, pObj );
   385	        pStats->CriticalitySum += Criticality;
   386	        if ( Criticality > 0.0 )
   387	            pStats->nCriticalNodes++;
   388	        if ( pStats->CriticalityMax < Criticality )
   389	            pStats->CriticalityMax = Criticality;
   390	        Abc_Stmap54TopInsert( pStats->TopRatios, pStats->TopNodes, pStats->pTopGates, pStats->TopFanouts, pStats->TopLoads, pStats->TopCaps,
   391	            Ratio, Abc_ObjId(pObj), Mio_GateReadName(pGate), Fanouts, Load, MaxCap );
   392	        Abc_Stmap54CollectHotspotCone( pNtk, pObj, pStats, pTime, Ratio );
   393	    }
   394	    if ( pTime )
   395	        Abc_SclManFree( pTime );
   396	}
