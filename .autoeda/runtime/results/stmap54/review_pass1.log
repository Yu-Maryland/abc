   398	static void Abc_Stmap54PrintSclLoadStats( const char * pLabel, Abc_Stmap54LoadStats_t * pStats )
   399	{
   400	    int i;
   401	    if ( !pStats->fAvailable )
   402	    {
   403	        printf( "stmap54 %s stats: unavailable = 1\n", pLabel );
   404	        return;
   405	    }
   406	    printf( "stmap54 %s stats: nodes = %d  matched = %d  fanout-pins = %d  over-max = %d  avg-load-ratio = %.3f  max-load-ratio = %.3f\n",
   407	        pLabel, pStats->nNodes, pStats->nMatched, pStats->nPins, pStats->nOver,
   408	        pStats->nMatched ? pStats->RatioSum / (float)pStats->nMatched : 0.0, pStats->RatioMax );
   409	    printf( "stmap54 %s criticality: timing-delay = %.3f  critical-nodes = %d  avg-criticality = %.3f  max-criticality = %.3f\n",
   410	        pLabel, pStats->TimingDelay, pStats->nCriticalNodes,
   411	        pStats->nMatched ? pStats->CriticalitySum / (float)pStats->nMatched : 0.0,
   412	        pStats->CriticalityMax );
   413	    for ( i = 0; i < 5 && pStats->TopRatios[i] > 0.0; i++ )
   414	        printf( "stmap54 %s top: rank = %d  node = %d  gate = %s  fanouts = %d  load = %.3f  max-cap = %.3f  load-ratio = %.3f\n",
   415	            pLabel, i + 1, pStats->TopNodes[i], pStats->pTopGates[i] ? pStats->pTopGates[i] : "?",
   416	            pStats->TopFanouts[i], pStats->TopLoads[i], pStats->TopCaps[i], pStats->TopRatios[i] );
   417	}
