    if ( Penalty <= 0.0 )
        return 0.0;
    NodePressureRatio = pNodePressureRatio ? *pNodePressureRatio : 0.0;
    CutPressureRatio = pCutPressureRatio ? *pCutPressureRatio : 0.0;
