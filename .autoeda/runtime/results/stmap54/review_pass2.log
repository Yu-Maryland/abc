    return Criticality > 1.0 ? 1.0 : Criticality;
}

static void Abc_Stmap54PressureInsert( Abc_Stmap54LoadStats_t * pStats, int AigId, int NodeId, float Ratio, float SinkCriticality )
{
    float OldRatio, OldSinkRatio, SinkWeight, SinkRatio;
    if ( AigId < 0 || Ratio <= 1.0 )
        return;
