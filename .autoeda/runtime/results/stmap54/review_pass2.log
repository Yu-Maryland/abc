    Penalty = Map_MatchStmap53ModeratePenaltyFactor( pNode, pCut, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon, pNodePressureRatio, pCutPressureRatio, pNodeAigId, pAreaCap, pPressureNear );
    if ( Penalty > 0.0 )
