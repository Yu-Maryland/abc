    if ( Map_MatchStmap54HasCutOnlyPressureException( pNodePressureRatio ? *pNodePressureRatio : 0.0, pCutPressureRatio ? *pCutPressureRatio : 0.0, ArrivalDelta, ArrivalGainMargin, Slack, SlackMargin, Epsilon ) )
    {
        if ( pCutOnlyPressure )
            *pCutOnlyPressure = 1;
    }
    return 0.0;
}

