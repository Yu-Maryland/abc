    57	    extern int Abc_NtkFraigSweep( Abc_Ntk_t * pNtk, int fUseInv, int fExdc, int fVerbose, int fVeryVerbose );
    58	
    59	    pNtk = Abc_FrameReadNtk(pAbc);
    60	    DelayTarget = -1;
    61	    AreaMulti   = 0;
    62	    DelayMulti  = 0;
    63	    fAreaOnly   = 0;
    64	    fRecovery   = 1;
    65	    fSweep      = 0;
    66	    fSwitching  = 0;
    67	    fSkipFanout = 9; // arrival-bounded exact-area guard; -f disables it
    68	    fUseProfile = 0;
    69	    fUseBuffs   = 0;
    70	    fVerbose    = 0;
    71	    Extra_UtilGetoptReset();
    72	    while ( ( c = Extra_UtilGetopt( argc, argv, "DABFSGMarspfuovh" ) ) != EOF )
    73	    {
    74	        switch ( c )
    75	        {
    76	        case 'D':
