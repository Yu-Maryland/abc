    91	                goto usage;
    92	            }
    93	            AreaMulti = (float)atof(argv[globalUtilOptind]);
    94	            globalUtilOptind++;
    95	            break;
    96	        case 'B':
    97	            if ( globalUtilOptind >= argc )
    98	            {
    99	                Abc_Print( -1, "Command line switch \"-B\" should be followed by a floating point number.\n" );
   100	                goto usage;
   101	            }
   102	            DelayMulti = (float)atof(argv[globalUtilOptind]);
   103	            globalUtilOptind++;
   104	            break;
   105	        case 'F':
