    20	/**Function*************************************************************
    21	
    22	  Synopsis    [Runs the stmap8 mapper probe.]
    23	
    24	  Description [stmap8 tests an arrival-bounded refinement of the stmap7
    25	  criticality-sensitive high-fanout wide-cut guard. It keeps the same
    26	  graph-size, slack, and fanout-bucket gates, but exact-area recovery on
    27	  mid-sized and large graphs may allow an area-saving wide high-fanout cut
    28	  only when the candidate match does not worsen mapper arrival by more than
    29	  one quarter of an inverter delay.]
    30	
    31	  SideEffects []
    32	
    33	  SeeAlso     []
    34	
    35	***********************************************************************/
    36	int Abc_CommandStmap8( Abc_Frame_t * pAbc, int argc, char ** argv )
    37	{
