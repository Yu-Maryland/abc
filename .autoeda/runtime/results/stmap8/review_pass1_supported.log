   290	/**Function*************************************************************
   291	
   292	  Synopsis    [Returns 1 if an stmap area-sensitive mode should reject a cut.]
   293	
   294	  Description [The area-sensitive guards are evaluated after matching the
   295	  candidate cut because their hypotheses need the candidate's actual mapper
   296	  area. In stmap6 exact-area recovery, a wide high-fanout cut is rejected only
   297	  when the existing match has slack and the candidate does not save at least
   298	  half an inverter area. In stmap7, the area-saving override additionally
   299	  requires more than two inverter delays of slack and excludes the highest
   300	  fanout-risk bucket. In stmap8, the override is further rejected when the
   301	  candidate match worsens mapper arrival by more than one quarter of an
   302	  inverter delay.]
   303	
   304	  SideEffects []
   305	
   306	  SeeAlso     []
   307	
   308	***********************************************************************/
   309	static int Map_MatchSkipAreaSensitiveFanout( Map_Man_t * p, Map_Node_t * pNode, Map_Cut_t * pCut, int fPhase, Map_Match_t * pMatchBest, Map_Match_t * pMatch )
   310	{
   311	    float Slack, SlackMargin, SlackGate, ArrivalMargin, AreaMargin;
   312	
   313	    if ( p->fSkipFanout != 7 && p->fSkipFanout != 8 && p->fSkipFanout != 9 )
   314	        return 0;
   315	    if ( p->fMappingMode < 2 || p->fMappingMode > 3 )
   316	        return 0;
   317	    if ( p->vMapObjs->nSize <= 8000 )
   318	        return 0;
   319	    if ( !Map_MatchCutHasStmapFanoutRisk( pNode, pCut ) )
   320	        return 0;
   321	    if ( pMatchBest == NULL || pMatchBest->pSuperBest == NULL || pMatch == NULL || pMatch->pSuperBest == NULL )
   322	        return 0;
   323	    Slack = pNode->tRequired[fPhase].Worst - pMatchBest->tArrive.Worst;
   324	    SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   325	    if ( p->fSkipFanout == 8 || p->fSkipFanout == 9 )
   326	    {
   327	        SlackGate = 2.0 * SlackMargin;
   328	        if ( Slack <= SlackGate + p->fEpsilon )
   329	            return 1;
   330	        if ( Map_MatchCutHasStmapHighestFanoutRisk( pNode, pCut ) )
   331	            return 1;
   332	    }
   333	    if ( Slack <= SlackMargin + p->fEpsilon )
   334	        return 0;
   335	    if ( p->fSkipFanout == 9 )
   336	    {
   337	        ArrivalMargin = 0.25 * SlackMargin;
   338	        if ( pMatch->tArrive.Worst > pMatchBest->tArrive.Worst + ArrivalMargin + p->fEpsilon )
   339	            return 1;
   340	    }
   341	    AreaMargin = p->pSuperLib ? 0.5 * p->pSuperLib->AreaInv : 0.0;
   342	    if ( pMatch->AreaFlow < pMatchBest->AreaFlow - AreaMargin - p->fEpsilon )
   343	        return 0;
   344	    return 1;
   345	}
