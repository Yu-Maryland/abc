   280	            SlackMargin = p->pSuperLib ? p->pSuperLib->tDelayInv.Worst : 0.0;
   281	            if ( Slack <= SlackMargin + p->fEpsilon )
   282	                return 0;
   283	            return Map_MatchCutHasStmapFanoutRisk( pNode, pCut );
   284	        }
   285	        return 0;
   286	    }
   287	    return (pNode->nRefs > 3 && pCut->nLeaves > 2) || (pNode->nRefs > 1 && pCut->nLeaves > 3);
   288	}
