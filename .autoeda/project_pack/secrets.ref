version: 1
credential_policy:
  store_raw_secrets_in_project_pack: false
  git_auth_reference: existing local git credential configuration
  agent_auth_reference: existing Codex CLI authentication
  review_auth_reference: existing Codex CLI authentication
  environment: inherit from launcher process
agent_auth:
  selected_backend: codex
  codex:
    auth_reference: existing_codex_cli_login
    launch:
      binary: codex
      args:
      - exec
      - --model
      - gpt-5.5
      - -c
      - model_reasoning_effort="xhigh"
      - -c
      - service_tier="fast"
      - --enable
      - multi_agent
      - --dangerously-bypass-approvals-and-sandbox
review_tools:
  selected_tool: codex_review
  codex_review:
    auth_reference: existing_codex_cli_login
    binary: codex
    args:
    - exec
    - review
    - --uncommitted
    - --model
    - gpt-5.5
    - -c
    - model_reasoning_effort="xhigh"
    - -c
    - service_tier="fast"
    - --dangerously-bypass-approvals-and-sandbox
  claude:
    binary: claude
    args:
    - -p
    - --dangerously-skip-permissions
    - --model
    - claude-sonnet-4-6
    - --effort
    - medium
refresh_policy:
  on_expiry: block_and_alert
  missing_local_auth: block_and_alert
